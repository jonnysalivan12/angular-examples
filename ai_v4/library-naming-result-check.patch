+test('tagStrings: poprawne wartości przechodzą bez zmian', () => {
+  assert.deepEqual(tagStrings({ scope: 'frontend-app', type: 'ui', context: 'simulation' }),
+    ['scope:frontend-app', 'type:ui', 'context:simulation']);
+});

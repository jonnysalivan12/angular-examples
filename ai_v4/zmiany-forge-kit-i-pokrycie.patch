index 0000000..340d219
--- /dev/null
+++ b/scripts/generators/library/readme.test.js
@@ -0,0 +1,81 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+
+import { buildLibraryReadme } from './readme.js';
+import { checkReadme } from '../../validators/readme-validator.js';
+
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * README szkieletu sprawdzane TYM SAMYM kodem, co lint repozytorium.
+ *
+ * Sprawdzenie idzie przez `checkReadme`, a nie przez wzorce w teście: gdyby
+ * wymagania README się zmieniły, test o wzorcach nadal by przechodził, a szkielet
+ * generatora zacząłby produkować biblioteki z czerwonym lintem. Tak łapie zmianę.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+const PROJEKT = 'frontend-app-auth-ui';
+
+function readme(overrides = {}) {
+  return buildLibraryReadme({ name: PROJEKT, type: 'ui', context: 'auth', scope: 'frontend-app', ...overrides });
+}
+
+test('buildLibraryReadme: wynik przechodzi regule README bez zastrzezen', () => {
+  const naruszenia = checkReadme({ projectName: PROJEKT, directory: 'libs/x', readmeText: readme() });
+
+  assert.deepEqual(naruszenia, []);
+});
+
+test('buildLibraryReadme: opis nie jest wypelnieniem szablonu, a mowi o warstwie i kontekscie', () => {
+  const tekst = readme();
+
+  assert.match(tekst, /description: Biblioteka warstwy `ui` w kontekście `auth`/);
+  assert.match(tekst, /czeka na opisanie/, 'brak opisu wlasciwego jest widoczny, nie zamaskowany');
+});
+
+test('buildLibraryReadme: kazde polecenie w SWOJEJ sekcji — da sie uruchomic jedno bez drugiego', () => {
+  const tekst = readme();
+
+  assert.match(tekst, /### Linter\n\n```bash\nnx lint frontend-app-auth-ui\n```/);
+  assert.match(tekst, /### Testy\n\n```bash\nnx test frontend-app-auth-ui\n```/);
+});
+
+test('buildLibraryReadme: nazwa w metadanych zgadza sie z projektem — inaczej regula zglasza rozjazd', () => {
+  const naruszenia = checkReadme({ projectName: 'inna-nazwa', directory: 'libs/x', readmeText: readme() });
+
+  assert.ok(naruszenia.some((entry) => entry.kind === 'name-mismatch'));
+});
+
+test('buildLibraryReadme: brak pol semantycznych nie psuje ksztaltu pliku', () => {
+  const naruszenia = checkReadme({
+    projectName: PROJEKT,
+    directory: 'libs/x',
+    readmeText: buildLibraryReadme({ name: PROJEKT }),
+  });
+
+  assert.deepEqual(naruszenia, []);
+});
+
+/* ── opis właściwy — README budowane ponownie na końcu przebiegu ───────────── */
+
+const OPIS_WLASCIWY = 'Zbiera formularz logowania i jego stany walidacji. Sięga się po nią, gdy ekran ma przyjąć dane uwierzytelniające.';
+
+test('buildLibraryReadme: z opisem wlasciwym status to active, a zdanie o czekaniu znika', () => {
+  const tekst = readme({ description: OPIS_WLASCIWY });
+
+  assert.match(tekst, /description: Zbiera formularz logowania/);
+  assert.match(tekst, /status: active/);
+  assert.ok(!tekst.includes('czeka na opisanie'));
+});
+
+test('buildLibraryReadme: opis wlasciwy tez przechodzi regule README', () => {
+  const naruszenia = checkReadme({
+    projectName: PROJEKT,
+    directory: 'libs/x',
+    readmeText: readme({ description: OPIS_WLASCIWY }),
+  });
+
+  assert.deepEqual(naruszenia, []);
+});
+
+test('buildLibraryReadme: pusty opis to nadal szkielet — nadpisanie niczym nie kasuje treści', () => {
+  assert.match(readme({ description: '   ' }), /status: experimental/);
+});
diff --git a/scripts/generators/ngxs/command-catalog.js b/scripts/generators/ngxs/command-catalog.js
new file mode 100644
index 0000000..2f44c9f
--- /dev/null
+++ b/scripts/generators/ngxs/command-catalog.js
@@ -0,0 +1,79 @@
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Powierzchnia CLI generatora stanu — JEDNO źródło poleceń i ich opcji.
+ *
+ * Czytają z niego dwaj konsumenci: pomoc CLI (`utils/arg-parser.js`) oraz
+ * sprawdzenie treści planu w warstwie agentów. Wcześniej pomoc była jedynym
+ * spisem opcji i rozjechała się z kodem — `add-state-action` czyta
+ * `--payload-content`, `--payload-imports` i `--content`, których pomoc nie
+ * wymieniała, a `init-state` czyta `--shared-prefix`.
+ *
+ * Nazwy opcji stoją tu w formie CLI (z myślnikami). Parser normalizuje je do
+ * postaci wielbłądziej, więc porównania z tym katalogiem robi się PRZED
+ * normalizacją — tak jak czyta je człowiek i tak jak stoją w planie.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+/**
+ * Polecenia generatora stanu: nazwa → argumenty wymagane i opcjonalne.
+ *
+ * `required` niesie argumenty, bez których polecenie rzuca; `optional` — resztę,
+ * którą polecenie faktycznie czyta. Wartością wpisu jest podpowiedź wartości
+ * do linii użycia; `<true|false>` znaczy flagę, którą parser normalizuje.
+ */
+export const NGXS_COMMANDS = Object.freeze({
+  'init-state': Object.freeze({
+    required: Object.freeze({ '--name': '<stateName>' }),
+    optional: Object.freeze({ '--path': '<state-folder>', '--nested': '<true|false>', '--shared-prefix': '<importPrefix>' }),
+  }),
+  'add-state-action': Object.freeze({
+    required: Object.freeze({ '--name': '<action.name>' }),
+    optional: Object.freeze({
+      '--path': '<state-folder>',
+      '--with-payload': '<true|false>',
+      '--with-effect': '<true|false>',
+      '--payload-content': '<payloadFields>',
+      '--payload-imports': '<payloadImports>',
+      '--content': '<actionBody>',
+    }),
+  }),
+  'add-async-state-action': Object.freeze({
+    required: Object.freeze({ '--name': '<action.name>' }),
+    optional: Object.freeze({
+      '--path': '<state-folder>',
+      '--request-with-payload': '<true|false>',
+      '--success-with-payload': '<true|false>',
+      '--failure-with-payload': '<true|false>',
+    }),
+  }),
+  'add-api': Object.freeze({
+    required: Object.freeze({ '--name': '<methodName>' }),
+    optional: Object.freeze({ '--path': '<api-service-folder>' }),
+  }),
+});
+
+/** Nazwy poleceń w kolejności katalogu. */
+export function commandNames() {
+  return Object.keys(NGXS_COMMANDS);
+}
+
+/**
+ * Wszystkie argumenty polecenia (wymagane + opcjonalne), w formie CLI.
+ * @param {string} command
+ * @returns {string[]} pusta lista dla polecenia poza katalogiem.
+ */
+export function commandArguments(command) {
+  const entry = NGXS_COMMANDS[command];
+  return entry ? [...Object.keys(entry.required), ...Object.keys(entry.optional)] : [];
+}
+
+/**
+ * Linia użycia polecenia: wymagane gołe, opcjonalne w nawiasach kwadratowych.
+ * @param {string} command
+ * @returns {string}
+ */
+export function usageLine(command) {
+  const entry = NGXS_COMMANDS[command];
+  if (!entry) return '';
+  const required = Object.entries(entry.required).map(([argument, hint]) => `${argument} ${hint}`);
+  const optional = Object.entries(entry.optional).map(([argument, hint]) => `[${argument} ${hint}]`);
+  return [command, ...required, ...optional].join(' ');
+}
diff --git a/scripts/generators/ngxs/command-catalog.test.js b/scripts/generators/ngxs/command-catalog.test.js
new file mode 100644
index 0000000..1e4b41d
--- /dev/null
+++ b/scripts/generators/ngxs/command-catalog.test.js
@@ -0,0 +1,57 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import path from 'node:path';
+
+import { NGXS_COMMANDS, commandNames, commandArguments, usageLine } from './command-catalog.js';
+
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Katalog polecen CLI generatora stanu. Poza ksztaltem sprawdzamy zgodnosc
+ * z KODEM polecen: katalog jest zrodlem dla pomocy CLI i dla sprawdzenia tresci
+ * planu, wiec argument czytany przez polecenie, a nieobecny w katalogu, znaczy,
+ * ze jedno z dwoch klamie.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+const COMMANDS_DIR = path.join(import.meta.dirname, 'commands');
+
+/** Nazwa pliku polecenia — ta sama konwencja co nazwa polecenia CLI. */
+function commandFile(command) {
+  return path.join(COMMANDS_DIR, `${command}.js`);
+}
+
+/** Argument w formie CLI z nazwy w formie wielbladziej, jak normalizuje ja parser. */
+function toCliArgument(camelName) {
+  return '--' + camelName.replace(/[A-Z]/g, (letter) => `-${letter.toLowerCase()}`);
+}
+
+test('katalog: kazde polecenie ma plik i wymaga --name', () => {
+  assert.deepEqual(commandNames(), ['init-state', 'add-state-action', 'add-async-state-action', 'add-api']);
+
+  for (const command of commandNames()) {
+    assert.ok(fs.existsSync(commandFile(command)), `polecenie '${command}' bez pliku w commands/`);
+    assert.deepEqual(Object.keys(NGXS_COMMANDS[command].required), ['--name']);
+  }
+});
+
+test('katalog: argumenty czytane przez polecenie stoja w katalogu', () => {
+  // Pomoc CLI byla wczesniej jedynym spisem i rozjechala sie z kodem: brakowalo
+  // --payload-content, --payload-imports i --content polecenia add-state-action.
+  for (const command of commandNames()) {
+    const source = fs.readFileSync(commandFile(command), 'utf8');
+    const read = new Set([...source.matchAll(/\boptions\.([a-zA-Z][a-zA-Z0-9]*)/g)].map((match) => match[1]));
+    const known = new Set(commandArguments(command));
+
+    for (const name of read) {
+      assert.ok(known.has(toCliArgument(name)), `'${command}' czyta '${name}', czego katalog nie wymienia`);
+    }
+  }
+});
+
+test('commandArguments: polecenie spoza katalogu daje pusta liste', () => {
+  assert.deepEqual(commandArguments('nie-ma-takiego'), []);
+  assert.equal(usageLine('nie-ma-takiego'), '');
+});
+
+test('usageLine: wymagane gole, opcjonalne w nawiasach kwadratowych', () => {
+  assert.equal(usageLine('add-api'), 'add-api --name <methodName> [--path <api-service-folder>]');
+});

+
+test('repair: zlecenie rundy zapisane osobnym plikiem, poza wynikiem', async () => {
+  await inTempCwd(async () => {
+    const paths = withArtifacts();
+
+    await runStage({
+      featureDir: '006-baner',
+      taskId: 'T1',
+      findingIds: ['AC-1'],

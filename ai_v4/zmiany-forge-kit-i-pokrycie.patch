index 0000000..7f8aae2
--- /dev/null
+++ b/.ai-agentic-workspace/workflows/forge-kit/gates/project-references.js
@@ -0,0 +1,314 @@
+/* eslint-disable @nx/enforce-module-boundaries */
+
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Odwołania do projektów w tekście agenta — ścieżki katalogów i aliasy importu.
+ * Jedno sprawdzenie na każde miejsce, w którym takie odwołanie może paść.
+ *
+ * `libraryNamingViolations` osądza WYNIK derywacji, więc widzi odwołanie wyłącznie
+ * tam, gdzie plan podał trójkę scope/kontekst/typ. Odwołanie napisane wprost — w zakresie
+ * zadania, w kroku implementacji, w propozycji dla człowieka — przez derywację nie
+ * przechodzi i przez to było dla bramek niewidzialne. Stąd `libs/shared/common/core-state`
+ * w propozycji i `…/auth/ui/login-form` w zakresie zadania: obie przeszły, bo nikt
+ * nie czytał ścieżek jako ścieżek.
+ *
+ * Ścieżka i alias to dwa zapisy tej samej wiedzy, więc podlegają temu samemu rozbiorowi
+ * na człony: kontekst, typ, opcjonalna nazwa. Różnią się bazą (`libs/shared` kontra
+ * prefiks aliasu) i tym, że alias kończy się na barrelu — w głąb biblioteki się nie
+ * schodzi. Każdy człon da się osądzić z konwencji, bez sięgania do indeksu.
+ *
+ * Sprawdzenia są trzy i są rozłączne:
+ *
+ *   • KSZTAŁT ŚCIEŻKI — czy układa się we wzorzec `<baza>/<kontekst>/<typ>[/<nazwa>]`,
+ *     a to, co głębiej, leży w `src/`.
+ *
+ *   • KSZTAŁT ALIASU — czy układa się we wzorzec `@<prefiks>/[<scope>/]<kontekst>/<typ>[/<nazwa>]`
+ *     i kończy na barrelu. Wymaga listy prefiksów workspace'u, żeby nie sądzić
+ *     `@angular/core` konwencją tego repozytorium.
+ *
+ *   • MIEJSCE — czy ścieżka wskazuje na projekt obecny w indeksie albo planowany
+ *     w tym planie, a jeśli sięga w jego głąb, to czy trafia w jego wnętrze.
+ *     Wymaga listy projektów, więc ma sens dopiero na planie.
+ *
+ * Wołający bez listy prefiksów albo bez listy projektów dostaje pozostałe sprawdzenia —
+ * przy intencji, która powstaje przed planem, jest to jedyny sensowny tryb.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+import { BARREL_ONLY_TYPES, LIBRARY_NAMING, LIBRARY_TYPES } from '../../../../scripts/config/library.js';
+
+/** Katalog źródeł projektu — wszystko, co należy do jego wnętrza, leży pod nim. */
+const SOURCE_DIR = 'src';
+
+/** Czy `segments` zaczyna się dokładnie od członów `prefix`. */
+function startsWithSegments(segments, prefix) {
+  return prefix.every((segment, index) => segments[index] === segment);
+}
+
+/**
+ * Wzorzec fragmentu wyglądającego na ścieżkę projektu. Korzenie bierzemy z konwencji,
+ * a nie z literału, żeby repozytorium o innym układzie katalogów nie wymagało zmiany
+ * tutaj. Gwiazdka jest członem dozwolonym, bo zakresy zadań bywają globami
+ * (`apps/<app>/src/**\/app.routes.ts`); nawias, przecinek i cudzysłów do ścieżki nie
+ * należą, więc kończą dopasowanie i proza wokół ścieżki jej nie zanieczyszcza.
+ */
+function projectPathPattern(cfg) {
+  const roots = [...new Set([cfg.sharedBase, cfg.appsBase, cfg.appProjectsBase].map((base) => String(base).split('/')[0]))];
+  return new RegExp(String.raw`(?<![\w./-])(?:${roots.join('|')})\/[\w.*-]+(?:\/[\w.*-]+)*`, 'g');
+}
+
+/**
+ * Ścieżki projektów wyłuskane z dowolnego tekstu, bez powtórzeń.
+ *
+ * @param {string} text
+ * @param {object} [naming] — override konwencji (domyślnie LIBRARY_NAMING)
+ * @returns {string[]}
+ */
+export function extractProjectPaths(text, naming = {}) {
+  const cfg = { ...LIBRARY_NAMING, ...naming };
+  const found = new Set();
+  for (const match of String(text ?? '').matchAll(projectPathPattern(cfg))) {
+    // Kropka i ukośnik na końcu należą do zdania, nie do ścieżki — inaczej ta sama
+    // ścieżka na końcu zdania i w środku zdania byłaby dwiema różnymi wartościami.
+    const value = match[0].replace(/[./]+$/, '');
+    if (value.includes('/')) found.add(value);
+  }
+  return [...found];
+}
+
+/**
+ * Rozkład ścieżki biblioteki na bazę i człony po niej. `null` gdy ścieżka nie leży
+ * pod żadną bazą bibliotek — wtedy konwencja bibliotek nic o niej nie orzeka.
+ */
+function libraryPathParts(value, cfg) {
+  const segments = value.split('/');
+  const sharedBase = cfg.sharedBase.split('/');
+  const appsBase = cfg.appsBase.split('/');
+
+  if (startsWithSegments(segments, sharedBase)) {
+    return { rest: segments.slice(sharedBase.length) };
+  }
+  if (startsWithSegments(segments, appsBase)) {
+    // Baza bibliotek app-owych obejmuje jeszcze człon aplikacji — dopiero za nim
+    // zaczyna się `<kontekst>/<typ>`.
+    const rest = segments.slice(appsBase.length);
+    return { rest: rest.slice(1) };
+  }
+  return null;
+}
+
+/** Rozkład ścieżki projektu aplikacji. `null` gdy ścieżka nie leży pod bazą aplikacji. */
+function appPathParts(value, cfg) {
+  const segments = value.split('/');
+  const base = cfg.appProjectsBase.split('/');
+  if (!startsWithSegments(segments, base)) return null;
+  const rest = segments.slice(base.length);
+  if (rest.length === 0) return null;
+  return { rest: rest.slice(1) };
+}
+
+/**
+ * Czy człony za katalogiem projektu należą do jego wnętrza: kod w `src/`, katalog
+ * konfiguracyjny z kropką na początku (`.storybook`) albo pojedynczy plik w korzeniu
+ * projektu (`project.json`, `README.md`).
+ */
+function isProjectInternal(tail) {
+  if (tail.length === 0) return true;
+  if (tail[0] === SOURCE_DIR) return true;
+  if (tail[0].startsWith('.')) return true;
+  return tail.length === 1 && tail[0].includes('.');
+}
+
+/** Naruszenie kształtu dla ścieżki pod bazą bibliotek; `null` gdy kształt poprawny. */
+function libraryShapeNote(rest) {
+  // Sama baza albo sam katalog kontekstu — realny katalog nad bibliotekami, nie błąd.
+  if (rest.length <= 1) return null;
+
+  const [, type, ...tail] = rest;
+  if (!LIBRARY_TYPES.includes(type)) {
+    return `'${type}' nie jest typem biblioteki (${LIBRARY_TYPES.join(', ')})`
+      + ` — ścieżka nie układa się we wzorzec '<baza>/<kontekst>/<typ>[/<nazwa>]'`;
+  }
+  if (isProjectInternal(tail)) return null;
+
+  if (BARREL_ONLY_TYPES.includes(type)) {
+    return `typ '${type}' nie ma segmentu nazwy, więc '${tail[0]}' musiałby być katalogiem`
+      + ` w '${SOURCE_DIR}/lib/', a nie kolejną biblioteką`;
+  }
+  const afterName = tail.slice(1);
+  if (isProjectInternal(afterName)) return null;
+  return `za nazwą '${tail[0]}' wnętrze biblioteki zaczyna się od '${SOURCE_DIR}/'`
+    + ` — '${afterName.join('/')}' leży poza nim`;
+}
+
+/** Naruszenie kształtu dla ścieżki pod bazą aplikacji; `null` gdy kształt poprawny. */
+function appShapeNote(rest) {
+  if (isProjectInternal(rest)) return null;
+  return `wnętrze aplikacji zaczyna się od '${SOURCE_DIR}/' — '${rest.join('/')}' leży poza nim`;
+}
+
+/**
+ * Naruszenie kształtu jednej ścieżki. `null` gdy ścieżka jest poprawna ALBO gdy leży
+ * poza bazami projektów — konwencja bibliotek nie rozciąga się na resztę repozytorium.
+ *
+ * @param {string} value
+ * @param {object} [naming]
+ * @returns {string|null}
+ */
+export function projectPathShapeNote(value, naming = {}) {
+  const cfg = { ...LIBRARY_NAMING, ...naming };
+  const library = libraryPathParts(value, cfg);
+  if (library) return libraryShapeNote(library.rest);
+  const app = appPathParts(value, cfg);
+  if (app) return appShapeNote(app.rest);
+  return null;
+}
+
+/**
+ * Wzorzec aliasu importu: `@<prefiks>/<człon>[/<człon>…]`. Znak słowa, kropka albo
+ * drugie `@` przed dopasowaniem je odcina, żeby adres pocztowy ani fragment dłuższego
+ * identyfikatora nie trafił tu jako alias. Gwiazdki nie ma — alias nie bywa globem.
+ */
+const ALIAS_PATTERN = /(?<![\w@./-])@[\w-]+(?:\/[\w.-]+)+/g;
+
+/**
+ * Aliasy importu wyłuskane z dowolnego tekstu, bez powtórzeń.
+ * @param {string} text
+ * @returns {string[]}
+ */
+export function extractLibraryAliases(text) {
+  const found = new Set();
+  for (const match of String(text ?? '').matchAll(ALIAS_PATTERN)) {
+    found.add(match[0].replace(/[./]+$/, ''));
+  }
+  return [...found];
+}
+
+/**
+ * Naruszenie kształtu jednego aliasu. `null` gdy alias jest poprawny ALBO gdy nie
+ * podlega tej konwencji.
+ *
+ * Alias niesie te same człony co ścieżka — kontekst, typ, opcjonalną nazwę — więc
+ * osądza je ta sama para list co ścieżkę: `LIBRARY_TYPES` i `BARREL_ONLY_TYPES`.
+ * Różnica jest jedna: alias kończy się na barrelu, bo tamtędy chodzą importy.
+ *
+ * @param {string} value
+ * @param {object} options
+ * @param {Set<string>} options.aliasPrefixes — prefiksy aliasów tego workspace'u
+ * @param {object} [options.naming]
+ * @returns {string|null}
+ */
+export function libraryAliasShapeNote(value, { aliasPrefixes, naming = {} } = {}) {
+  const cfg = { ...LIBRARY_NAMING, ...naming };
+  const [prefix, ...rest] = value.slice(1).split('/');
+
+  // Cudzy prefiks — `@angular/core` nie ma się do czego stosować w tej konwencji.
+  if (!aliasPrefixes?.has(prefix)) return null;
+
+  // Alias biblioteki reużywalnej powtarza człon scope przed kontekstem; app-owy nie,
+  // bo aplikację niesie już prefiks. Rozróżnia je pierwszy człon — co zakłada, że
+  // żaden kontekst nie nazywa się tak jak scope reużywalny.
+  const segments = rest[0] === cfg.sharedScope ? rest.slice(1) : rest;
+
+  // Mniej niż kontekst i typ. Cudzy pakiet odsiał już prefiks, więc krótki alias
+  // pod NASZYM prefiksem nie jest niczyim pakietem — jest zepsutym odwołaniem do
+  // naszej biblioteki. Najczęstsza postać: nazwa projektu (człony sklejone
+  // myślnikiem) wstawiona w miejsce aliasu — po prefiksie zostaje jeden człon.
+  if (segments.length < 2) {
+    const lone = segments[segments.length - 1] ?? '';
+    const hint = lone.includes('-')
+      ? `; '${lone}' wygląda na nazwę projektu — w aliasie człony rozdziela ukośnik, nie myślnik`
+      : '';
+    return `alias bez pary '<kontekst>/<typ>' — wzorzec to '@<prefiks>/[<scope>/]<kontekst>/<typ>[/<nazwa>]'${hint}`;
+  }
+
+  const [, type, ...tail] = segments;
+  if (!LIBRARY_TYPES.includes(type)) {
+    return `'${type}' nie jest typem biblioteki (${LIBRARY_TYPES.join(', ')})`
+      + ` — alias nie układa się we wzorzec '@<prefiks>/[<scope>/]<kontekst>/<typ>[/<nazwa>]'`;
+  }
+  if (tail.length === 0) return null;
+  if (tail[0] === SOURCE_DIR) {
+    return `alias kończy się na barrelu biblioteki — '${tail.join('/')}' sięga w jej wnętrze`;
+  }
+  if (BARREL_ONLY_TYPES.includes(type)) {
+    return `typ '${type}' nie ma segmentu nazwy — '${tail[0]}' nie jest osobną biblioteką,`
+      + ` tylko katalogiem w '${SOURCE_DIR}/lib/' tej jednej`;
+  }
+  if (tail.length > 1) {
+    return `alias kończy się na barrelu biblioteki — '${tail.slice(1).join('/')}' sięga w jej wnętrze`;
+  }
+  return null;
+}
+
+/**
+ * Czy ścieżka trzyma się granic znanych projektów: wskazuje na projekt, na jego
+ * wnętrze albo na katalog nad nim. `null` gdy tak; komunikat, gdy nie.
+ *
+ * Sprawdzenie kształtu czyta ścieżkę bez listy projektów, więc ostatnie człony przed
+ * `src/` bierze za nazwę biblioteki. Segment wsunięty w środek — `…/auth/state/auth/src`
+ * — jest dla niego biblioteką `auth` typu `state`, czyli kształtem legalnym, a lista
+ * projektów mówi, że takiej biblioteki nie ma, jest za to projekt `…/auth/state`. Bez
+ * zestawienia obu ta jedna ścieżka miała dwa czytania i każde sprawdzenie brało to,
+ * przy którym milczy: kształt czytał ją jako bibliotekę głębszą, miejsce jako wnętrze
+ * płytszej. Tak weszła do zakresu zadania, odbiła koderowi zapisy w prawdziwym `src/lib`
+ * i przesunęła cały kod o jeden segment w bok.
+ *
+ * Właścicielem jest NAJDŁUŻSZY pasujący katalog — projekt bywa zagnieżdżony w katalogu
+ * innego projektu i wtedy o wnętrzu orzeka ten bliższy.
+ *
+ * @param {string} value
+ * @param {Set<string>} projectDirectories
+ * @returns {string|null}
+ */
+export function projectContainmentNote(value, projectDirectories) {
+  if (projectDirectories.has(value)) return null;
+
+  // Katalog NAD projektami — realne miejsce na dysku, nie odwołanie do projektu.
+  for (const directory of projectDirectories) {
+    if (directory.startsWith(`${value}/`)) return null;
+  }
+
+  let owner = null;
+  for (const directory of projectDirectories) {
+    if (value.startsWith(`${directory}/`) && directory.length > (owner?.length ?? 0)) owner = directory;
+  }
+  if (owner === null) {
+    return 'nie wskazuje na żaden projekt — ani istniejący w indeksie, ani planowany w tym planie';
+  }
+
+  const tail = value.slice(owner.length + 1).split('/');
+  if (isProjectInternal(tail)) return null;
+  return `leży w projekcie '${owner}', a jego wnętrze zaczyna się od '${SOURCE_DIR}/'`
+    + ` — '${tail.join('/')}' nie jest ani wnętrzem tego projektu, ani osobnym projektem`;
+}
+
+/**
+ * Wszystkie naruszenia odwołań w tekście: najpierw ścieżki, potem aliasy.
+ *
+ * @param {string} text — dowolny tekst agenta (zakres zadania, markdown, propozycja)
+ * @param {object} [options]
+ * @param {Set<string>|null} [options.projectDirectories] — katalogi znanych projektów;
+ *        `null` (domyślnie) wyłącza sprawdzenie istnienia
+ * @param {Set<string>|null} [options.aliasPrefixes] — prefiksy aliasów workspace'u;
+ *        `null` (domyślnie) wyłącza sprawdzenie aliasów
+ * @param {object} [options.naming] — override konwencji
+ * @returns {Array<{reference: string, kind: 'shape'|'place'|'alias', note: string}>}
+ */
+export function projectReferenceViolations(text, { projectDirectories = null, aliasPrefixes = null, naming = {} } = {}) {
+  const violations = [];
+  for (const value of extractProjectPaths(text, naming)) {
+    const shape = projectPathShapeNote(value, naming);
+    if (shape) {
+      violations.push({ reference: value, kind: 'shape', note: shape });
+      continue;
+    }
+    if (!projectDirectories) continue;
+    const place = projectContainmentNote(value, projectDirectories);
+    if (place) violations.push({ reference: value, kind: 'place', note: place });
+  }
+  if (!aliasPrefixes) return violations;
+  for (const value of extractLibraryAliases(text)) {
+    const shape = libraryAliasShapeNote(value, { aliasPrefixes, naming });
+    if (shape) violations.push({ reference: value, kind: 'alias', note: shape });
+  }
+  return violations;
+}

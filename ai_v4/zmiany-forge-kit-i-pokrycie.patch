+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+
+import { selectReviewFindings } from './repair-task.js';
+
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Selekcja ustaleń do naprawy: wybór człowieka (identyfikatory z raportu PK3)
+ * zamieniany na treść dla brifu. Adresowalne są wyłącznie problemy.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+const REVIEW = {
+  verdicts: [
+    { ac: 'AC-1', verdict: 'covered', evidence: 'libs/auth/src/f.ts:12' },
+    { ac: 'AC-2', verdict: 'uncovered', why: 'żadna dodana linia nie dotyka przycisku', expectedIn: 'libs/auth/src/ui' },
+    { ac: 'AC-3', verdict: 'unverified', why: 'odnośnik nie wskazuje dodanej linii' },
+  ],
+  violations: [
+    { rule: 'state.md#ngxs', at: 'libs/auth/src/f.ts:14', why: 'mutacja stanu poza akcją' },
+  ],
+};
+
+test('selectReviewFindings: AC bez pokrycia i naruszenia adresowalne, treść niesie powód', () => {
+  const { findings, unknown } = selectReviewFindings(REVIEW, ['AC-2', 'V1']);
+
+  assert.deepEqual(unknown, []);
+  assert.deepEqual(findings.map((finding) => finding.id), ['AC-2', 'V1']);
+  assert.match(findings[0].text, /kryterium AC-2 niepokryte: żadna dodana linia/);
+  assert.match(findings[0].text, /szukane w: libs\/auth\/src\/ui/);
+  assert.match(findings[1].text, /naruszenie state\.md#ngxs @ libs\/auth\/src\/f\.ts:14/);
+});
+
+test('selectReviewFindings: kryterium niezweryfikowane też jest materiałem naprawy', () => {
+  const { findings } = selectReviewFindings(REVIEW, ['AC-3']);
+  assert.match(findings[0].text, /kryterium AC-3 niezweryfikowane/);
+});
+
+test('selectReviewFindings: kryterium pokryte i zmyślony identyfikator wracają jako nieznane', () => {
+  const { findings, unknown } = selectReviewFindings(REVIEW, ['AC-1', 'V9', 'X']);
+
+  assert.deepEqual(findings, [], 'pokryte kryterium nie jest materiałem naprawy');
+  assert.deepEqual(unknown, ['AC-1', 'V9', 'X'], 'zły wybór jest głośny, nie cicho pusty');
+});
+
+test('selectReviewFindings: pusty wybór → pusta lista, nie błąd', () => {
+  assert.deepEqual(selectReviewFindings(REVIEW, []), { findings: [], unknown: [] });
+  assert.deepEqual(selectReviewFindings({}, ['AC-2']).unknown, ['AC-2'], 'recenzja bez werdyktów nie zna niczego');
+});

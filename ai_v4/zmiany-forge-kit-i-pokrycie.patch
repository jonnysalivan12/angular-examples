index 0000000..5341fde
--- /dev/null
+++ b/.ai-agentic-workspace/workflows/forge-kit/coder/task-scope.js
@@ -0,0 +1,78 @@
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Zakres ZAPISU zadania — cały katalog biblioteki, do której zadanie należy.
+ *
+ * Jednostką własności jest biblioteka, nie podkatalog. Plan rozdziela zadania po
+ * bibliotekach i kontraktach, więc granica zapisu wypada dokładnie na katalogu
+ * biblioteki. Węższa granica nie chroni przed niczym, czego nie łapią bramki po
+ * turze, a kosztuje tury: koder odbity na własnym `src/lib` może już tylko pytać
+ * człowieka albo pisać tam, gdzie mu wolno, choć to złe miejsce.
+ *
+ * Katalog jest WYLICZANY, nie przepisywany z planu. Ścieżka napisana ręcznie bywa
+ * o segment obok — a zakres zadania jest granicą zapisu, więc taka pomyłka nie
+ * kończy się ustaleniem do poprawy, tylko kodem w złym miejscu.
+ *
+ * Z planu zostają wyłącznie wpisy LEŻĄCE POZA katalogiem biblioteki: powłoka
+ * aplikacji, pliki tłumaczeń, biblioteka usuwana w całości. Wpisy wewnątrz są już
+ * pokryte katalogiem i tylko powielałyby tę samą wiedzę.
+ *
+ * Biblioteka, której plan nie opisuje ani polami strukturalnymi, ani deklaracją
+ * katalogu, zostaje przy zakresie z planu — nie ma z czego wyliczyć granicy.
+ *
+ * Skutek uboczny jest pożądany: harmonogram fal rozdziela zadania o zachodzących
+ * zakresach, więc dwa zadania jednej biblioteki nigdy nie trafią do jednej fali
+ * i nie rozjadą się na barrelu w równoległych drzewach.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+import { deriveLibraryNaming } from '../../../../scripts/generators/utils/library-naming.js';
+
+/** Ścieżka bez separatorów systemowych i bez ukośnika na końcu. */
+function normalize(value) {
+  return String(value ?? '').replace(/\\/g, '/').replace(/\/+$/, '');
+}
+
+/**
+ * Katalog biblioteki: z pól strukturalnych (biblioteki zakładane w tym planie),
+ * a gdy ich nie ma — z deklaracji katalogu. `null`, gdy plan nie niesie żadnego
+ * z tych pól — wtedy katalogu nie ma z czego wyliczyć.
+ *
+ * @param {object} args
+ * @param {object} args.plan — znormalizowany plan
+ * @param {string} args.name — nazwa biblioteki
+ * @param {object} [args.naming] — override konwencji nazewniczej
+ * @returns {string|null}
+ */
+export function libraryDirectory({ plan, name, naming = {} }) {
+  const library = (plan?.binding?.libraries ?? []).find((entry) => entry.name === name);
+  if (!library) return null;
+
+  if (library.structure) {
+    const canonical = deriveLibraryNaming(library.structure, naming);
+    if (canonical) return normalize(canonical.directory);
+  }
+  return library.declared?.path ? normalize(library.declared.path) : null;
+}
+
+/** Czy wpis zakresu leży w katalogu biblioteki (sam katalog też). */
+function withinDirectory(entry, directory) {
+  const value = normalize(entry);
+  return value === directory || value.startsWith(`${directory}/`);
+}
+
+/**
+ * Zakres zapisu zadania.
+ * @param {object} args
+ * @param {object} args.plan — znormalizowany plan
+ * @param {string} args.taskId
+ * @param {object} [args.naming] — override konwencji nazewniczej (testy bez I/O)
+ * @returns {string[]} katalog biblioteki + wpisy planu spoza niego
+ */
+export function taskScopes({ plan, taskId, naming = {} }) {
+  const task = (plan?.tasks ?? []).find((entry) => entry.id === taskId);
+  if (!task) return [];
+
+  const declared = task.scope ?? [];
+  const directory = libraryDirectory({ plan, name: task.library, naming });
+  if (!directory) return declared;
+
+  return [directory, ...declared.filter((entry) => !withinDirectory(entry, directory))];
+}

+    () => librarySpec({ scope: 'apps', type: 'ui', context: 'auth' }, NAMING),
+    /nieznany zakres 'apps'/,
+  );
+});
+
+test('librarySpec: komunikat o zakresie mówi, co się psuje, i wymienia zakresy dostępne', () => {
+  assert.throws(
+    () => librarySpec({ scope: 'apps', type: 'ui', context: 'auth' }, NAMING),
+    /tagiem 'scope:apps'.*żadna reguła granic nie ma za źródło.*dostępne: shared,.*web\./s,
+  );
+});
+
+test('librarySpec: core i state nadal przyjmują nazwę', () => {
+  for (const type of ['core', 'state']) {
+    const spec = librarySpec({ scope: 'shared', type, context: 'common', name: 'api' }, NAMING);
+    assert.equal(spec.name, `shared-common-${type}-api`);
+  }
+});
diff --git a/scripts/generators/library/readme.js b/scripts/generators/library/readme.js
new file mode 100644
index 0000000..bf02626
--- /dev/null
+++ b/scripts/generators/library/readme.js
@@ -0,0 +1,86 @@
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * README nowej biblioteki — część produktu generatora, nie praca do dopisania.
+ *
+ * Biblioteka bez README łamie regułę lintu `eslint-rules/library-readme`, więc
+ * `nx lint` świeci na czerwono od chwili jej powstania. Plik leży w korzeniu
+ * biblioteki, a zadania potokowe bywają węższe niż biblioteka — dwa zadania
+ * dzielą jedną i każde dostaje swój podkatalog. Wtedy README nie należy do
+ * zakresu ŻADNEGO z nich: koder widzi czerwony lint, nie ma prawa tknąć pliku
+ * i zostaje mu pytanie do człowieka. Biblioteka powstaje raz, maszynowo, więc
+ * to ten sam krok ma zostawić ją kompletną — tak samo jak zostawia alias importu.
+ *
+ * Opis szkieletu jest WYPROWADZONY z pól semantycznych i jawnie mówi, że czeka na
+ * treść. To świadomy kompromis: spełnia wymóg formalny i nie udaje opisu, którego
+ * nikt jeszcze nie napisał.
+ *
+ * Opis właściwy powstaje na końcu przebiegu, gdy biblioteka ma już kod i przeszła
+ * weryfikację — wcześniej nie ma z czego go napisać. Ta sama funkcja buduje wtedy
+ * plik ponownie, z opisem podanym wprost i statusem `active`.
+ *
+ * ⚠ LUSTRO: kształt pliku wynika z `scripts/config/readme.js` i jest sprawdzany
+ * przez `checkReadme` w walidatorze README. Zmiana wymagań tam wymaga zmiany tutaj.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+import { README_COMMAND_SECTIONS } from '../../config/readme.js';
+
+/** Zdanie doklejane do opisu — znika, gdy ktoś napisze opis właściwy. */
+const OPIS_DO_UZUPELNIENIA = 'Zakres odpowiedzialności czeka na opisanie.';
+
+/** Nagłówek pliku: nazwa projektu bez przedrostka zakresu czyta się lepiej niż pełna. */
+function tytul(name) {
+  return `# ${name}`;
+}
+
+/**
+ * Opis wyprowadzony z pól semantycznych. Nie może zaczynać się od słowa, które
+ * walidator uznaje za wypełnienie szablonu (`opis`, `TODO`, `TBD`, `[`, `<`).
+ */
+function opis({ name, type, context, scope }) {
+  const czym = type ? `warstwy \`${type}\`` : 'bez zadeklarowanej warstwy';
+  const gdzie = context ? ` w kontekście \`${context}\`` : '';
+  const czyja = scope ? ` (zakres \`${scope}\`)` : '';
+  return `Biblioteka ${czym}${gdzie}${czyja}. Szkielet założony generatorem jako \`${name}\`. ${OPIS_DO_UZUPELNIENIA}`;
+}
+
+/**
+ * Buduje treść README spełniającą wymagania walidatora: blok metadanych z polami
+ * name/description/status oraz osobna sekcja per polecenie nx.
+ *
+ * Dwa wywołania, dwa momenty. Bez `description` powstaje szkielet: opis wyprowadzony
+ * z pól semantycznych i status `experimental`. Z `description` powstaje plik gotowy —
+ * opis napisany po tym, jak biblioteka dostała kod i przeszła weryfikację, i status
+ * `active`. Kształt pliku jest w obu przypadkach ten sam, więc nadpisanie na końcu
+ * niczego nie psuje.
+ *
+ * @param {object} args
+ * @param {string} args.name — nazwa projektu nx (musi zgadzać się z project.json)
+ * @param {string} [args.type] — typ biblioteki
+ * @param {string} [args.context] — kontekst biznesowy
+ * @param {string} [args.scope] — zakres (aplikacja albo `shared`)
+ * @param {string} [args.description] — opis właściwy; brak = opis szkieletu
+ * @returns {string} treść pliku README.md, zakończona znakiem nowej linii
+ */
+export function buildLibraryReadme({ name, type = '', context = '', scope = '', description = '' }) {
+  const sekcje = README_COMMAND_SECTIONS
+    .map(({ heading, target }) => [`### ${heading}`, '', '```bash', `nx ${target} ${name}`, '```'].join('\n'))
+    .join('\n\n');
+
+  const opisWlasciwy = String(description ?? '').trim();
+
+  return [
+    tytul(name),
+    '',
+    '## Metadata',
+    '',
+    '```yaml',
+    `name: ${name}`,
+    `description: ${opisWlasciwy || opis({ name, type, context, scope })}`,
+    `status: ${opisWlasciwy ? 'active' : 'experimental'}`,
+    '```',
+    '',
+    '## Polecenia',
+    '',
+    sekcje,
+    '',
+  ].join('\n');
+}
diff --git a/scripts/generators/library/readme.test.js b/scripts/generators/library/readme.test.js

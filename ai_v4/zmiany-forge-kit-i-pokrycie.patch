+
+test('taskCommandLine: polecenie bez argumentów i polecenie nieznane', () => {
+  assert.equal(taskCommandLine('add-api'), 'node scripts/generators/ngxs/index.js add-api');
+  assert.equal(taskCommandLine('widmo --name x'), '', 'nieznane polecenie nie dostaje wymyślonej linii');

--- /dev/null
+++ b/scripts/coverage/vitest-coverage.test.js
@@ -0,0 +1,173 @@
+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { coverageOptionsFor, layerTypeOf } from './vitest-coverage.js';
+
+/** Ustawienia takiego kształtu, jaki podaje konfiguracja vitest przestrzeni roboczej. */
+const SETTINGS = {
+  thresholds: {
+    ui: { statements: 80, branches: 70, functions: 75, lines: 80 },
+    util: { statements: 85, branches: 75, functions: 80, lines: 85 },
+    core: { statements: 85, branches: 75, functions: 80, lines: 85 },
+    app: { statements: 80, branches: 70, functions: 75, lines: 80 },
+    model: null,
+  },
+  provider: 'v8',
+  reporters: ['text', 'lcov'],
+  coverageDir: 'coverage',
+};
+
+/**
+ * Zbiór plików udający repozytorium.
+ *
+ * @param {Record<string, string>} files — ścieżka POSIX → treść
+ */
+function fakeIo(files) {
+  const normalize = (path) => String(path).replace(/\\/g, '/');
+  return {
+    exists: (path) => normalize(path) in files,
+    readFile: (path) => {
+      const key = normalize(path);
+      if (!(key in files)) throw new Error(`brak pliku '${key}'`);
+      return files[key];
+    },
+  };
+}
+
+/** Repozytorium z jednym projektem o podanych tagach. */
+function repoWith(projectPath, tags, name = 'projekt') {
+  return fakeIo({
+    '/repo/tsconfig.base.json': '{}',
+    [`/repo/${projectPath}/project.json`]: JSON.stringify({ name, tags }),
+  });
+}
+
+describe('layerTypeOf', () => {
+  it('zwraca wartość tagu typu', () => {
+    assert.equal(layerTypeOf(['scope:shared', 'type:util', 'context:common']), 'util');
+  });
+
+  it('zwraca null, gdy projekt nie nosi tagu typu', () => {
+    assert.equal(layerTypeOf(['scope:shared']), null);
+  });
+
+  it('znosi brak tagów', () => {
+    assert.equal(layerTypeOf(undefined), null);
+  });
+});
+
+describe('coverageOptionsFor', () => {
+  it('składa sekcję z progiem właściwym dla typu warstwy', () => {
+    const io = repoWith('libs/shared/common/util', ['scope:shared', 'type:util'], 'shared-common-util');
+
+    const options = coverageOptionsFor('/repo/libs/shared/common/util', SETTINGS, io);
+
+    assert.equal(options.provider, 'v8');
+    assert.deepEqual(options.reporter, ['text', 'lcov']);
+    assert.deepEqual(options.thresholds, SETTINGS.thresholds.util);
+  });
+
+  it('liczy ścieżkę raportu z głębokości katalogu projektu', () => {
+    const io = repoWith('libs/shared/common/core/api', ['type:core']);
+
+    const options = coverageOptionsFor('/repo/libs/shared/common/core/api', SETTINGS, io);
+
+    assert.equal(options.reportsDirectory, '../../../../../coverage/libs/shared/common/core/api');
+  });
+
+  it('liczy ścieżkę raportu także dla płytkiego katalogu aplikacji', () => {
+    const io = repoWith('apps/frontend-app', ['scope:frontend-app', 'type:app']);
+
+    const options = coverageOptionsFor('/repo/apps/frontend-app', SETTINGS, io);
+
+    assert.equal(options.reportsDirectory, '../../coverage/apps/frontend-app');
+    assert.deepEqual(options.thresholds, SETTINGS.thresholds.app);
+  });
+
+  it('pomija klucz progu dla warstwy bez zachowania', () => {
+    const io = repoWith('libs/shared/common/model', ['type:model']);
+
+    const options = coverageOptionsFor('/repo/libs/shared/common/model', SETTINGS, io);
+
+    assert.equal('thresholds' in options, false);
+    assert.equal(options.provider, 'v8');
+  });
+
+  it('zwraca kopie, więc konsument nie sięga do ustawień przez wynik', () => {
+    const io = repoWith('libs/shared/common/util', ['type:util']);
+
+    const first = coverageOptionsFor('/repo/libs/shared/common/util', SETTINGS, io);
+    first.thresholds.lines = 1;
+    first.reporter.push('html');
+    const second = coverageOptionsFor('/repo/libs/shared/common/util', SETTINGS, io);
+
+    assert.equal(second.thresholds.lines, 85);
+    assert.deepEqual(second.reporter, ['text', 'lcov']);
+  });
+
+  it('zatrzymuje bieg, gdy nie podano ustawień pokrycia', () => {
+    const io = repoWith('libs/shared/common/util', ['type:util']);
+
+    assert.throws(
+      () => coverageOptionsFor('/repo/libs/shared/common/util', undefined, io),
+      /brak ustawień pokrycia/,
+    );
+  });
+
+  it('zatrzymuje bieg, gdy ustawienia są niekompletne', () => {
+    const io = repoWith('libs/shared/common/util', ['type:util']);
+
+    assert.throws(
+      () => coverageOptionsFor('/repo/libs/shared/common/util', { thresholds: {}, provider: 'v8' }, io),
+      /brak ustawień pokrycia/,
+    );
+  });
+
+  it('zatrzymuje bieg, gdy projekt nie nosi tagu typu', () => {
+    const io = repoWith('libs/shared/common/util', ['scope:shared'], 'shared-common-util');
+
+    assert.throws(
+      () => coverageOptionsFor('/repo/libs/shared/common/util', SETTINGS, io),
+      /shared-common-util.*type:/s,
+    );
+  });
+
+  it('zatrzymuje bieg, gdy typ nie ma progu w ustawieniach', () => {
+    const io = repoWith('libs/shared/common/util', ['type:wymyslony']);
+
+    assert.throws(
+      () => coverageOptionsFor('/repo/libs/shared/common/util', SETTINGS, io),
+      /wymyslony/,
+    );
+  });
+
+  it('zatrzymuje bieg, gdy brakuje project.json', () => {
+    const io = fakeIo({ '/repo/tsconfig.base.json': '{}' });
+
+    assert.throws(
+      () => coverageOptionsFor('/repo/libs/shared/common/util', SETTINGS, io),
+      /project\.json/,
+    );
+  });
+
+  it('zatrzymuje bieg, gdy project.json jest nieczytelny', () => {
+    const io = fakeIo({
+      '/repo/tsconfig.base.json': '{}',
+      '/repo/libs/shared/common/util/project.json': '{ to nie jest json',
+    });
+
+    assert.throws(
+      () => coverageOptionsFor('/repo/libs/shared/common/util', SETTINGS, io),
+      /JSON/,
+    );
+  });
+
+  it('zatrzymuje bieg, gdy katalog leży poza repozytorium', () => {
+    const io = fakeIo({ '/gdzie-indziej/libs/x/project.json': '{}' });
+
+    assert.throws(
+      () => coverageOptionsFor('/gdzie-indziej/libs/x', SETTINGS, io),
+      /poza repozytorium/,
+    );
+  });
+});

@@ -0,0 +1,34 @@
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Bufor logów na czas aktywnego pytania.
+ *
+ * Zadania fali biegną równolegle i piszą do jednego terminala, a pytajnik rysuje
+ * prompt raz i odrysowuje go dopiero po naciśnięciu klawisza. Każda linia logu
+ * wypisana w czasie oczekiwania spycha więc pytanie poza ekran: przebieg wygląda
+ * na zawieszony, a odpowiedź nigdy nie pada, bo nie widać, że ktoś o nią pyta.
+ *
+ * Między `hold()` a `release()` linie trafiają do bufora zamiast na ekran;
+ * `release()` wypuszcza je w kolejności powstania — nic nie ginie, tylko czeka.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+/**
+ * @param {(message: string) => void} write — właściwe wypisanie linii
+ * @returns {{write: (message: string) => void, hold: () => void, release: () => void}}
+ */
+export function makeLogBuffer(write) {
+  const held = [];
+  let holding = false;
+
+  return {
+    write(message) {
+      if (holding) held.push(message);
+      else write(message);
+    },
+    hold() {
+      holding = true;
+    },
+    release() {
+      holding = false;
+      while (held.length > 0) write(held.shift());
+    },
+  };
+}

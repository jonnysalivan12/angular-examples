diff --git a/.ai-agentic-workspace/scripts/shell-command.js b/.ai-agentic-workspace/scripts/shell-command.js
new file mode 100644
index 0000000..2e309e3
--- /dev/null
+++ b/.ai-agentic-workspace/scripts/shell-command.js
@@ -0,0 +1,35 @@
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Powłoka poleceń tekstowych — jeden kontrakt dla wszystkich wołających:
+ * polecenie stringiem przez shell, NIGDY nie rzuca, zwraca kod wyjścia
+ * i złączone stdout+stderr. Kod wyjścia bywa sygnałem treści, nie błędu
+ * (np. `git diff --no-index` kończy się kodem 1 przy różnicach).
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+import { exec as childExec } from 'node:child_process';
+
+const MAX_BUFFER = 16 * 1024 * 1024;
+
+/**
+ * Wykonuje polecenie powłoki; nigdy nie rzuca.
+ * @param {string} command
+ * @param {{cwd?: string}} [options]
+ * @returns {Promise<{exitCode: number, output: string}>}
+ */
+export function execCommand(command, { cwd } = {}) {
+  return new Promise((resolve) => {
+    childExec(command, { cwd, maxBuffer: MAX_BUFFER }, (error, stdout, stderr) => {
+      resolve({ exitCode: error ? (error.code ?? 1) : 0, output: `${stdout ?? ''}${stderr ?? ''}` });
+    });
+  });
+}
+
+/**
+ * Wariant związany z katalogiem: wołający jednoargumentowi dostają stałe `cwd`,
+ * a opcja `cwd` konkretnego wywołania ma pierwszeństwo — jedno wywołanie
+ * obsługuje oba style użycia.
+ * @param {string} defaultCwd
+ * @returns {(command: string, options?: {cwd?: string}) => Promise<{exitCode: number, output: string}>}
+ */
+export function makeExecCommand(defaultCwd) {
+  return (command, options = {}) => execCommand(command, { cwd: options.cwd ?? defaultCwd });
+}

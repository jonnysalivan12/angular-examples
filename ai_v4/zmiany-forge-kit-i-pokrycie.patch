index 0000000..5fa469c
--- /dev/null
+++ b/.ai-agentic-workspace/workflows/forge-kit/gates/plan-references.test.js
@@ -0,0 +1,230 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+
+import {
+  planReferenceViolations, declaredSymbolsOf, generatorNamesOf, REFERENCE_CLASSES,
+} from './plan-references.js';
+
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Inwentarz klas odwołań: to samo pytanie („czy to, o czym plan mówi, należy
+ * do planu?") zadane o różne rodzaje tokenu. Bramka pisana per pole obejmowała
+ * dziewięć rodzajów z dwudziestu kilku i model trafiał w szczeliny.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+const PORTS = {
+  declaredSymbols: new Set(['LoginFormComponent', 'AuthStateService', 'AuthStateService.login']),
+  generatorNames: new Set(['auth', 'auth.login']),
+  resolveSymbol: (name) => ['ApiService', 'MarkerService'].includes(name),
+  resolveStandardSection: (file, section) => {
+    if (file !== 'state.md') return 'no-file';
+    return section === 'core-slices' ? true : 'no-section';
+  },
+  knownRoutes: new Set(['/workspace', '/']),
+  aliasPrefixes: new Set(['gdprrt']),
+};
+
+/* ── nazwy z kodu ──────────────────────────────────────────────────────────── */
+
+test('nazwa niezadeklarowana → error, choćby plan pisał o niej jako o istniejącej', () => {
+  // Przypadek z przebiegu: plan pisał „istniejący authGuard", a w repozytorium
+  // nie było ani jednego guardu. Żadne z trzynastu sprawdzeń nie czytało symboli.
+  const violations = planReferenceViolations('T6: trasa z guardem authGuard (istniejący)', PORTS);
+
+  assert.equal(violations.length, 1);
+  assert.equal(violations[0].kind, 'code-name');
+  assert.equal(violations[0].severity, 'error');
+  assert.equal(violations[0].reference, 'authGuard');
+  assert.match(violations[0].note, /ani kontraktem tego planu, ani parametrem generatora/);
+});
+
+test('nazwa metody frameworka pada, chociaż metoda naprawdę istnieje', () => {
+  // Sedno reguły: plan rozstrzyga umiejscowienie, nie sposób wykonania. Poprzednia
+  // wersja pytała „czy istnieje", więc kryterium akceptacji z nazwą metody
+  // przechodziło — i koder dostawał przesądzoną implementację.
+  const ports = { ...PORTS, resolveSymbol: () => true };
+  const violations = planReferenceViolations('AC-3: submit wywołuje markAllAsTouched i blokuje request', ports);
+
+  assert.equal(violations.length, 1);
+  assert.equal(violations[0].reference, 'markAllAsTouched');
+  assert.match(violations[0].note, /istnieje w repozytorium, ale plan go nie deklaruje/);
+});
+
+test('nazwa zadeklarowana przez plan przechodzi; człon rozstrzyga po właścicielu', () => {
+  const text = 'T4 buduje LoginFormComponent na AuthStateService.login';
+
+  assert.deepEqual(planReferenceViolations(text, PORTS), []);
+});
+
+test('nazwa podana generatorowi przechodzi — dopiero generator ją utworzy', () => {
+  const plan = { tasks: [{ generators: ['add-api --name loginUser --path libs/x/api'] }] };
+  const ports = { ...PORTS, generatorNames: generatorNamesOf(plan) };
+
+  assert.deepEqual(planReferenceViolations('T1: metoda loginUser woła zasób logowania', ports), []);
+});
+
+test('katalog w wywołaniu nie przepuszcza klasy — tę deklaruje `provides`', () => {
+  // Kebab z wywołania NIE jest przekładany na notację klasy. Gdyby był, komponent
+  // z makiety mógłby stanąć w planie bez wpisu w `provides`, a właśnie ten wpis
+  // wyznacza mu jedno zadanie-właściciela.
+  const plan = { tasks: [{ generators: ['component libs/apps/frontend-app/auth/ui/src/lib/login-form'] }] };
+  const ports = { ...PORTS, declaredSymbols: new Set(), generatorNames: generatorNamesOf(plan) };
+
+  const violations = planReferenceViolations('T2: zakłada LoginFormComponent', ports);
+
+  assert.equal(violations.length, 1);
+  assert.equal(violations[0].reference, 'LoginFormComponent');
+});
+
+test('skrótowce i nazwy własne technologii nie są nazwami z kodu', () => {
+  // Fałszywy alarm kosztuje turę naprawczą planera, więc rozpoznanie wymaga małej
+  // litery za wielką — skrótowiec przez ten warunek nie przechodzi.
+  const text = 'żądanie POST na NGXS, dane w JWT, wymóg RODO, opis w TypeScript, PostgreSQL po stronie API, RxJS';
+
+  assert.deepEqual(planReferenceViolations(text, PORTS), []);
+});
+
+test('polska proza z wielkich liter na początku zdań nie jest osądzana', () => {
+  const text = 'Zadanie buduje formularz. Potem Smart komponent wiąże fasadę. Dummy tylko emituje.';
+
+  assert.deepEqual(planReferenceViolations(text, PORTS), []);
+});
+
+test('stała w wersalikach z podkreśleniem jest nazwą z kodu', () => {
+  const violations = planReferenceViolations('token AUTH_SESSION_PORT wiąże powłoka', PORTS);
+
+  assert.equal(violations.length, 1);
+  assert.equal(violations[0].reference, 'AUTH_SESSION_PORT');
+});
+
+test('klucz YAML nie jest odwołaniem — i nawrót nie skraca go do trafienia', () => {
+  // Część maszynowa planu wchodzi do tego samego tekstu co proza. Bez strażnika
+  // końca słowa silnik obchodzi wykluczenie dwukropka nawrotem: `importPath:`
+  // dawało trafienie `importPat`.
+  const text = 'dependsOn: [x]\n- { providedByTask: T5, importPath: alias }\nMAX_LINES: 70';
+
+  assert.deepEqual(planReferenceViolations(text, PORTS), []);
+});
+
+test('to samo odwołanie powtórzone w planie jest jednym ustaleniem', () => {
+  const violations = planReferenceViolations('authGuard raz, authGuard drugi raz', PORTS);
+
+  assert.equal(violations.length, 1);
+});
+
+/* ── zależności zewnętrzne ─────────────────────────────────────────────────── */
+
+test('paczka zewnętrzna → warn: bywa wyborem mechanizmu, bywa wskazaniem dostawcy', () => {
+  const violations = planReferenceViolations('token trwały przez @ngxs/storage-plugin', PORTS);
+
+  assert.equal(violations.length, 1);
+  assert.equal(violations[0].kind, 'package');
+  assert.equal(violations[0].severity, 'warn');
+  assert.equal(violations[0].reference, '@ngxs/storage-plugin');
+});
+
+test('alias importu tego workspace nie jest zależnością zewnętrzną', () => {
+  assert.deepEqual(planReferenceViolations('import z @gdprrt/auth/state', PORTS), []);
+});
+
+/* ── odsyłacze do standardów ───────────────────────────────────────────────── */
+
+test('odsyłacz do nieistniejącej sekcji i do nieistniejącego pliku → dwa różne komunikaty', () => {
+  const violations = planReferenceViolations('reguła ← state.md#widmo oraz ← widmo.md#cokolwiek', PORTS);
+
+  assert.equal(violations.length, 2);
+  assert.match(violations.find((entry) => entry.reference === 'state.md#widmo').note, /nie ma sekcji 'widmo'/);
+  assert.match(violations.find((entry) => entry.reference === 'widmo.md#cokolwiek').note, /nie istnieje/);
+});
+
+test('odsyłacz do istniejącej sekcji przechodzi', () => {
+  assert.deepEqual(planReferenceViolations('← state.md#core-slices', PORTS), []);
+});
+
+/* ── trasy ─────────────────────────────────────────────────────────────────── */
+
+test('trasa nieobecna w aplikacji → warn, nie error (bywa tworzona w tej samej story)', () => {
+  const violations = planReferenceViolations("przekierowuje na '/workspace-selection'", PORTS);
+
+  assert.equal(violations.length, 1);
+  assert.equal(violations[0].kind, 'route');
+  assert.equal(violations[0].severity, 'warn');
+});
+
+test('adres zasobu API nie jest trasą aplikacji', () => {
+  assert.deepEqual(planReferenceViolations("wywołanie POST '/api/login'", PORTS), []);
+});
+
+test('trasa istniejąca przechodzi', () => {
+  assert.deepEqual(planReferenceViolations("nawiguje na '/workspace'", PORTS), []);
+});
+
+/* ── brak portu = brak sprawdzenia ─────────────────────────────────────────── */
+
+test('port pominięty wyłącza swoją klasę, nie zmyśla zakazu', () => {
+  const text = "authGuard, state.md#widmo, '/nieznana-trasa', @ngxs/storage-plugin";
+
+  assert.deepEqual(planReferenceViolations(text, {}), [], 'bez portów żadna klasa nie orzeka');
+  assert.equal(
+    planReferenceViolations(text, { knownRoutes: PORTS.knownRoutes }).length,
+    1,
+    'podany port włącza dokładnie jedną klasę',
+  );
+});
+
+test('nazwa z kodu bez indeksu nadal jest osądzana — rozstrzygają deklaracje planu', () => {
+  // Indeks wybiera tylko treść komunikatu. Werdykt zależy od tego, czy plan nazwę
+  // wprowadza, a to plan wie o sobie sam.
+  const violations = planReferenceViolations('krok wywołuje exhaustMap', { declaredSymbols: new Set() });
+
+  assert.equal(violations.length, 1);
+  assert.match(violations[0].note, /ani kontraktem tego planu/);
+});
+
+test('inwentarz jest DANYMI: każda klasa ma rozpoznanie, rozstrzygnięcie i nazwę', () => {
+  // Nowa klasa odwołania ma być wpisem w tablicy, nie kolejną bramką — dlatego
+  // kształt wpisu jest przedmiotem testu.
+  assert.ok(REFERENCE_CLASSES.length >= 4);
+  for (const entry of REFERENCE_CLASSES) {
+    assert.equal(typeof entry.kind, 'string');
+    assert.equal(typeof entry.noun, 'string');
+    assert.ok(['error', 'warn'].includes(entry.severity));
+    assert.equal(typeof entry.extract, 'function');
+    assert.equal(typeof entry.verdict, 'function');
+  }
+});
+
+/* ── nazwy, które plan wprowadza ───────────────────────────────────────────── */
+
+test('declaredSymbolsOf: provides, consumes, removes i klucze kontraktów, z głowami członów', () => {
+  const plan = {
+    binding: { contracts: [{ key: 'ApiClient.post' }] },
+    tasks: [
+      { id: 'T1', provides: ['ExportFacade.requestExport'], removes: ['OldApi.call'] },
+      { id: 'T2', consumes: ['LoginFormComponent'] },
+    ],
+  };
+
+  const declared = declaredSymbolsOf(plan);
+
+  for (const name of ['ApiClient', 'ApiClient.post', 'ExportFacade', 'OldApi', 'LoginFormComponent']) {
+    assert.ok(declared.has(name), name);
+  }
+});
+
+test('generatorNamesOf: nazwy z wywołań, rozbite po separatorach wywołania', () => {
+  const plan = {
+    tasks: [{
+      generators: [
+        'add-async-state-action --name auth.login --path libs/apps/frontend-app/auth/state/src/lib/state',
+        'component libs/apps/frontend-app/auth/ui/src/lib/login-form',
+      ],
+    }],
+  };
+
+  const names = generatorNamesOf(plan);
+
+  for (const name of ['auth.login', 'auth', 'login-form', 'state']) {
+    assert.ok(names.has(name), name);
+  }
+  assert.ok(!names.has(''), 'puste tokeny nie wchodzą do zbioru');
+});

+const REVIEWS = {
+  reviews: [{
+    taskId: 'T1',
+    status: 'ok',
+    verdicts: [{ ac: 'AC-1', verdict: 'uncovered', why: 'żadna dodana linia nie renderuje banera' }],
+    violations: [{ rule: 'a11y.md#focus', at: 'libs/ui/auth/src/b.ts:7', why: 'brak obsługi fokusu' }],
+  }],
+};
+
+/** Artefakty poprzednich etapów — stan, wynik wykonania, zapis recenzji. */
+function withArtifacts(featureId = '006-baner') {
+  const paths = artifactPaths(featureId);
+  writeJson(paths.planState, { plan: PLAN, storyId: 'US-42' });
+  writeJson(paths.buildResult, { branch: 'forge/US-42/integration', tasks: [] });
+  writeJson(paths.reviews, REVIEWS);
+  return paths;

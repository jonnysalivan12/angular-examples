+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import path from 'node:path';
+
+import { execCommand, makeExecCommand } from './shell-command.js';
+
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Jeden kontrakt powłoki dla wszystkich wołających: nigdy nie rzuca, kod
+ * wyjścia + złączone stdout/stderr, oba style katalogu roboczego.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+test('execCommand: zielone polecenie zwraca exitCode 0 i wyjście', async () => {
+  const result = await execCommand('node -e "console.log(\'dziala\')"');
+  assert.equal(result.exitCode, 0);
+  assert.match(result.output, /dziala/);
+});
+
+test('execCommand: czerwone polecenie NIE rzuca — kod wyjścia wraca wartością', async () => {
+  const result = await execCommand('node -e "console.error(\'powod\'); process.exit(3)"');
+  assert.equal(result.exitCode, 3);
+  assert.match(result.output, /powod/, 'stderr złączone z stdout — treść błędu nie ginie');
+});
+
+test('makeExecCommand: stałe cwd dla wołających jednoargumentowych, opcja wywołania ma pierwszeństwo', async () => {
+  const scriptsDir = path.resolve(import.meta.dirname);
+  const bound = makeExecCommand(scriptsDir);
+
+  const bare = await bound('node -e "console.log(process.cwd())"');
+  assert.ok(bare.output.trim().endsWith('scripts'), `cwd z powiązania: ${bare.output.trim()}`);
+
+  const overridden = await bound('node -e "console.log(process.cwd())"', { cwd: path.dirname(scriptsDir) });
+  assert.ok(!overridden.output.trim().endsWith('scripts'), 'jawne cwd wywołania wygrywa z powiązanym');
+});

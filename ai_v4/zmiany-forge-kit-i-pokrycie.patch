+import { checkReadme } from '../../../../scripts/validators/readme-validator.js';
+
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Krok opisu — sesja modelu na atrapie. Sprawdzenie README idzie przez `checkReadme`,
+ * czyli ten sam kod, którym mierzy regułę lintu: opis napisany na końcu przebiegu ma
+ * przechodzić tak samo jak szkielet, inaczej krok zostawiałby czerwoną bibliotekę.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+const PLAN = {
+  binding: {
+    libraries: [
+      { name: 'frontend-app-auth-ui', status: 'new', structure: { scope: 'frontend-app', tag: 'ui', context: 'auth' } },
+      { name: 'shared-common-util', status: 'existing' },
+    ],
+  },
+};
+
+const NAMING = { prefixByScope: { 'frontend-app': 'gdprrt-app' } };
+const KATALOG = 'libs/apps/frontend-app/auth/ui';
+const OPIS = 'Zbiera formularz logowania i jego stany walidacji. Sięga się po nią, gdy ekran ma przyjąć dane uwierzytelniające bez własnej logiki wysyłki.';
+
+function drzewo(pliki) {
+  return {
+    readFile: (relative) => pliki[relative.split(path.sep).join('/')] ?? null,
+    listFiles: (relative) => Object.keys(pliki)
+      .filter((file) => file.startsWith(`${relative}/`))
+      .map((file) => file.slice(relative.length + 1)),
+  };
+}
+
+const DRZEWO = drzewo({
+  [`${KATALOG}/src/index.ts`]: "export * from './lib/login-form/login-form.component';\n",
+  [`${KATALOG}/src/lib/login-form/login-form.component.ts`]: 'class X {}',
+  [`${KATALOG}/src/lib/login-form/login-form.component.spec.ts`]: 'test',
+});
+
+/* ── wybór bibliotek ──────────────────────────────────────────────────────── */
+
+test('opis dostaje wylacznie biblioteka zalozona w tym przebiegu', () => {
+  const wybrane = newLibraryDescriptions(PLAN, NAMING);
+
+  assert.deepEqual(wybrane.map((entry) => entry.name), ['frontend-app-auth-ui']);
+  assert.equal(wybrane[0].directory, KATALOG);
+  assert.equal(wybrane[0].type, 'ui');
+});
+
+/* ── powierzchnia publiczna ───────────────────────────────────────────────── */
+
+test('powierzchnia to barrel i pliki kodu, bez testow i scen', () => {
+  const surface = librarySurface({ directory: KATALOG, ...DRZEWO });
+
+  assert.match(surface.barrel, /export \* from/);
+  assert.deepEqual(surface.files, ['login-form.component.ts']);
+});
+
+test('pytanie niesie barrel i pliki, a zabrania tekstu poza opisem', () => {
+  const prompt = buildDescriptionPrompt({
+    name: 'frontend-app-auth-ui', type: 'ui', context: 'auth',
+    surface: librarySurface({ directory: KATALOG, ...DRZEWO }),
+  });
+
+  assert.match(prompt, /login-form\.component\.ts/);
+  assert.match(prompt, /ZERO tekstu poza samym opisem/);
+});
+
+/* ── odczyt odpowiedzi ────────────────────────────────────────────────────── */
+
+test('odpowiedz skladana do jednej linii — pole description jest jednoliniowe', () => {
+  const wynik = parseDescription(`${OPIS.replace('. ', '.\n')}\n`);
+
+  assert.equal(wynik.ok, true);
+  assert.ok(!wynik.description.includes('\n'));
+});
+
+test('odpowiedz pusta, za krotka i wygladajaca na szablon jest odrzucona', () => {
+  assert.equal(parseDescription('').ok, false);
+  assert.equal(parseDescription('Biblioteka ui.').ok, false);
+  assert.match(parseDescription('TODO: uzupełnić opis tej biblioteki później, na razie nic.').note, /wypełnienie szablonu/);
+});
+
+test('naglowki i bloki kodu z odpowiedzi nie wchodza do opisu', () => {
+  const wynik = parseDescription(`## Opis\n\n${OPIS}\n\n\`\`\`ts\nexport class X {}\n\`\`\`\n`);
+
+  assert.equal(wynik.ok, true);
+  assert.ok(!wynik.description.includes('#'));
+  assert.ok(!wynik.description.includes('export class'));
+});
+
+/* ── krok jako całość ─────────────────────────────────────────────────────── */
+
+async function uruchom({ odpowiedz = OPIS, pliki = null } = {}) {
+  const zapisane = new Map();
+  const wynik = await describePlanLibraries({
+    plan: PLAN,
+    integrationPath: '/drzewo',
+    naming: NAMING,
+    ask: async () => (odpowiedz instanceof Error ? Promise.reject(odpowiedz) : odpowiedz),
+    ...(pliki ?? DRZEWO),
+    writeText: (fullPath, text) => zapisane.set(fullPath, text),
+  });
+  return { wynik, zapisane };
+}
+
+test('README nadpisane opisem modelu przechodzi regule tak samo jak szkielet', async () => {
+  const { wynik, zapisane } = await uruchom();
+
+  assert.deepEqual(wynik.described, ['frontend-app-auth-ui']);
+  const tekst = zapisane.get(path.join('/drzewo', KATALOG, 'README.md'));
+  assert.deepEqual(checkReadme({ projectName: 'frontend-app-auth-ui', directory: KATALOG, readmeText: tekst }), []);
+});
+
+test('gotowa biblioteka ma status active i traci zdanie o czekaniu na opis', async () => {
+  const { zapisane } = await uruchom();
+  const tekst = zapisane.get(path.join('/drzewo', KATALOG, 'README.md'));
+
+  assert.match(tekst, /status: active/);
+  assert.ok(!tekst.includes('czeka na opisanie'));
+  assert.match(tekst, /description: Zbiera formularz logowania/);
+});
+
+test('zla odpowiedz zostawia szkielet i zglasza ustalenie — praca fal nie przepada', async () => {
+  const { wynik, zapisane } = await uruchom({ odpowiedz: 'krótko' });
+
+  assert.deepEqual(wynik.described, []);
+  assert.equal(zapisane.size, 0, 'README nie jest ruszane, gdy opisu nie ma');
+  assert.match(wynik.findings[0].message, /zostaje szkieletem/);
+  assert.equal(wynik.findings[0].severity, 'warn');
+});
+
+test('sesja, ktora padla, tez nie przerywa kroku', async () => {
+  const { wynik } = await uruchom({ odpowiedz: new Error('brak kredytów') });
+
+  assert.match(wynik.findings[0].message, /sesja opisu padła: brak kredytów/);
+});
+
+test('biblioteka pusta po falach nie idzie do modelu — nie ma czego opisac', async () => {
+  const { wynik, zapisane } = await uruchom({ pliki: drzewo({}) });
+
+  assert.equal(zapisane.size, 0);
+  assert.match(wynik.findings[0].message, /jest pusta po falach/);
+});

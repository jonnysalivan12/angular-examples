--- /dev/null
+++ b/.ai-agentic-workspace/workflows/forge-kit/stages/story-traces.js
@@ -0,0 +1,73 @@
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Ślady story w repozytorium — powłoka nad czystymi funkcjami z `cleanup.js`.
+ *
+ * Osobny moduł, bo pytają o to dwa miejsca: fasada etapów (powtórka kroku, za zgodą
+ * człowieka) i etap planu (sprzątanie na starcie, bezwarunkowe). Etap nie może
+ * czytać fasady, która go importuje, więc powłoka mieszka poniżej obu.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+import fs from 'node:fs';
+
+import { execCommand } from '../../../scripts/shell-command.js';
+import * as config from '../config/global-config.js';
+import { Orchestrator } from '../orchestrator/index.js';
+import { findStoryTraces, purgeStoryTraces } from './cleanup.js';
+
+/** Nazwy podkatalogów; pusto, gdy katalogu nie ma albo nie da się go odczytać. */
+function listDirectories(directory) {
+  try {
+    return fs.readdirSync(directory, { withFileTypes: true })
+      .filter((entry) => entry.isDirectory())
+      .map((entry) => entry.name);
+  } catch {
+    return [];
+  }
+}
+
+/** Kasuje katalog wraz z zawartością; nigdy nie rzuca. */
+function removeDirectory(directory) {
+  try {
+    fs.rmSync(directory, { recursive: true, force: true, maxRetries: 3 });
+    return { ok: !fs.existsSync(directory) };
+  } catch (error) {
+    return { ok: false, output: error.message };
+  }
+}
+
+/**
+ * Ślady poprzedniego biegu story: gałęzie, drzewa znane gitowi, katalogi osierocone.
+ * @param {string} storyId
+ * @returns {Promise<{branches: string[], worktrees: string[], orphans: string[]}>}
+ */
+export function storyTraces(storyId) {
+  return findStoryTraces({
+    storyId,
+    worktreeRoot: config.WORKTREE_ROOT,
+    repoRoot: process.cwd(),
+    execCommand,
+    listDirectories,
+  });
+}
+
+/**
+ * Usuwa ślady poprzedniego biegu story.
+ * @param {object} args
+ * @param {{branches: string[], worktrees: string[], orphans?: string[]}} args.traces
+ * @param {(message: string) => void} [args.onLog]
+ * @returns {Promise<{removedBranches: string[], removedDirectories: string[], failed: Array}>}
+ */
+export function purgeTraces({ traces, onLog }) {
+  return purgeStoryTraces({
+    traces,
+    repoRoot: process.cwd(),
+    execCommand,
+    removeWorktree: ({ worktreePath, repoRoot }) => Orchestrator.removeWorktree({ worktreePath, repoRoot }),
+    removeDirectory,
+    onLog,
+  });
+}
+
+/** Czy ślady w ogóle są — do decyzji „sprzątać czy nie ma czego". */
+export function hasTraces(traces) {
+  return (traces?.branches?.length ?? 0) + (traces?.worktrees?.length ?? 0) + (traces?.orphans?.length ?? 0) > 0;
+}

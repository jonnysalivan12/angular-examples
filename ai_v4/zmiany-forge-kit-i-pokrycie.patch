diff --git a/scripts/validators/coverage-config-validator.js b/scripts/validators/coverage-config-validator.js
new file mode 100644
index 0000000..f9f1a33
--- /dev/null
+++ b/scripts/validators/coverage-config-validator.js
@@ -0,0 +1,170 @@
+#!/usr/bin/env node
+import { existsSync, readFileSync, readdirSync } from 'fs';
+// Importy nazwane, nie domyślne: ten moduł bywa ładowany także spoza ESM,
+// a przy tamtym sposobie ładowania domyślny import wbudowanego modułu jest undefined.
+import { join, relative, resolve, sep } from 'path';
+import { pathToFileURL } from 'url';
+
+import { PRODUCT_BASES, WORKSPACE_FILES } from '../config/workspace.js';
+
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Coverage config validator — sprawdza, czy projekt bierze próg pokrycia ze
+ * wspólnych ustawień przestrzeni roboczej, zamiast opisywać pokrycie po swojemu.
+ *
+ * Generator nx zostawia w nowym projekcie własną sekcję `coverage`: katalog
+ * raportu i silnik, bez progu. Taka sekcja jest składniowo poprawna i nie psuje
+ * żadnego biegu — po prostu pomiar nigdy niczego nie zatrzymuje. Projekt milczący
+ * w ten sposób wygląda dokładnie jak projekt, który progi spełnia.
+ *
+ * Sprawdzenie jest jedno i dotyczy WYNIKU, a nie wejścia: sekcja ma powstać
+ * wywołaniem `coverageFor(__dirname)` z `vitest.coverage.mts`. Sposobów napisania
+ * własnej sekcji jest nieskończenie wiele, a poprawny kształt jest jeden.
+ *
+ * Wykrywane naruszenia:
+ *   1. coverage-inline  — konfiguracja opisuje pokrycie sama, poza wspólnym źródłem
+ *   2. coverage-missing — konfiguracja testów bez sekcji pokrycia w ogóle
+ *
+ * Exit code: 0 gdy zero naruszeń, 1 gdy są (do CI).
+ * Zero zależności spoza repozytorium.
+ *
+ * Użycie:
+ *   node scripts/validators/coverage-config-validator.js [--format=human|json] [--root=.]
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+/** Konfiguracja testów projektu. */
+const CONFIG_FILE = 'vite.config.mts';
+
+/** Funkcja składająca sekcję pokrycia — jedyna dozwolona droga. */
+const SHARED_CALL = /coverage\s*:\s*coverageFor\s*\(\s*__dirname\s*\)/;
+
+/** Obecność sekcji pokrycia w jakiejkolwiek postaci. */
+const ANY_COVERAGE = /coverage\s*:/;
+
+/**
+ * Sprawdza konfigurację jednego projektu.
+ *
+ * @param {object} args
+ * @param {string} args.projectName
+ * @param {string} args.directory — katalog projektu względem korzenia (do raportu)
+ * @param {string} args.configPath — ścieżka konfiguracji względem korzenia
+ * @param {string} args.configSource — treść konfiguracji
+ * @returns {Array<{kind: string, project: string, directory: string, file: string, note: string}>}
+ */
+export function checkCoverageConfig({ projectName, directory, configPath, configSource }) {
+  const source = String(configSource ?? '');
+  if (SHARED_CALL.test(source)) return [];
+
+  const kind = ANY_COVERAGE.test(source) ? 'coverage-inline' : 'coverage-missing';
+  const note = kind === 'coverage-inline'
+    ? 'Konfiguracja opisuje pokrycie sama — sekcja bez progu przechodzi zawsze.'
+      + ' Zastąp ją wywołaniem `coverage: coverageOptionsFor(__dirname)`.'
+    : 'Konfiguracja testów bez sekcji pokrycia — bieg nie zmierzy niczego.'
+      + ' Dodaj `coverage: coverageOptionsFor(__dirname)`.';
+
+  return [{ kind, project: projectName, directory, file: configPath, note }];
+}
+
+/* ── Powłoka CLI ───────────────────────────────────────────────────────────── */
+
+/** Katalogi projektów pod podanym korzeniem — projekt = katalog z project.json. */
+function collectProjects(base) {
+  const results = [];
+
+  function walk(directory) {
+    let entries;
+    try {
+      entries = readdirSync(directory, { withFileTypes: true });
+    } catch {
+      return;
+    }
+
+    if (entries.some((entry) => entry.isFile() && entry.name === WORKSPACE_FILES.project)) {
+      results.push(directory);
+      return;
+    }
+
+    for (const entry of entries) {
+      if (!entry.isDirectory() || entry.name === 'node_modules' || entry.name.startsWith('.')) continue;
+      walk(join(directory, entry.name));
+    }
+  }
+
+  walk(base);
+  return results;
+}
+
+function parseArgs(argv) {
+  const args = {};
+  for (const token of argv) {
+    const match = /^--([\w-]+)(?:=(.*))?$/.exec(token);
+    if (match) args[match[1]] = match[2] ?? true;
+  }
+  return args;
+}
+
+function printHuman({ projects_checked, violations }) {
+  console.log(`coverage-config-validator — sprawdzono ${projects_checked} konfiguracji testów`);
+
+  if (violations.length === 0) {
+    console.log('✓ Każda konfiguracja bierze próg pokrycia ze wspólnego źródła.');
+    return;
+  }
+
+  console.log(`✗ Konfiguracje poza wspólnym źródłem: ${violations.length}\n`);
+  for (const item of violations) {
+    console.log(`  ${item.project}  (${item.file})`);
+    console.log(`    - [${item.kind}] ${item.note}`);
+    console.log();
+  }
+}
+
+function main() {
+  const args = parseArgs(process.argv.slice(2));
+  const root = resolve(args.root || '.');
+  const format = args.format || 'human';
+
+  const violations = [];
+  let checked = 0;
+
+  for (const base of PRODUCT_BASES) {
+    const baseDir = join(root, base);
+    if (!existsSync(baseDir)) continue;
+
+    for (const directory of collectProjects(baseDir)) {
+      const configPath = join(directory, CONFIG_FILE);
+      // Projekt bez konfiguracji testów nie ma czego mierzyć — o to, czy powinien
+      // ją mieć, pyta walidator obecności dowodów, patrząc na treść plików.
+      if (!existsSync(configPath)) continue;
+
+      checked += 1;
+      const projectFile = join(directory, WORKSPACE_FILES.project);
+      let projectName = relative(root, directory).split(sep).join('/');
+      try {
+        projectName = JSON.parse(readFileSync(projectFile, 'utf8')).name ?? projectName;
+      } catch {
+        // Nazwa jest wyłącznie do raportu — nieczytelny project.json nie jest
+        // przedmiotem tego walidatora i ma własne zgłoszenie gdzie indziej.
+      }
+
+      violations.push(...checkCoverageConfig({
+        projectName,
+        directory: relative(root, directory).split(sep).join('/'),
+        configPath: relative(root, configPath).split(sep).join('/'),
+        configSource: readFileSync(configPath, 'utf8'),
+      }));
+    }
+  }
+
+  const report = { projects_checked: checked, violations };
+  if (format === 'json') {
+    console.log(JSON.stringify(report, null, 2));
+  } else {
+    printHuman(report);
+  }
+
+  process.exit(violations.length === 0 ? 0 : 1);
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
+  main();
+}

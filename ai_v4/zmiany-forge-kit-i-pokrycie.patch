+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Pokrycie testami — ustawienia dla wszystkich projektów przestrzeni roboczej.
+ *
+ * To JEDYNE miejsce z tymi wartościami. Konfiguracja testów projektu podaje jedną
+ * rzecz — własny katalog — i dostaje stąd komplet: próg właściwy dla swojej warstwy,
+ * silnik pomiaru, formaty raportu i policzoną ścieżkę wyjściową.
+ *
+ * Próg jest ustalany po TYPIE warstwy, tak samo jak wymóg obecności dowodu:
+ * warstwa mówi, jaki rodzaj zachowania tam mieszka, a rodzaj zachowania rozstrzyga,
+ * ile z niego da się pokryć testem.
+ *
+ * Próg i obecność dowodu odpowiadają na różne pytania i żadne nie zastępuje drugiego.
+ * Walidator obecności (`npm run validate:test-presence`) pyta, czy jednostka ma test,
+ * którego można nie zdać; próg pyta, ile kodu ten test faktycznie wykonał. Jednostka
+ * z pustym testem przechodzi pierwsze pytanie i przewraca się na drugim.
+ * ─────────────────────────────────────────────────────────────────────────── */
+import { coverageOptionsFor } from './scripts/coverage/vitest-coverage.js';
+
+/**
+ * Warstwy z logiką bez widoku: całe ich zachowanie jest osiągalne wywołaniem.
+ *
+ * Gałęzie mają próg niższy od linii: gałąź nieosiągalna z publicznego wejścia —
+ * obrona przed stanem, który typ już wyklucza — daje się pokryć wyłącznie testem
+ * pisanym pod pomiar, a taki test niczego nie dowodzi. Funkcje niżej od linii
+ * z tego samego powodu: akcesor bez własnej treści liczy się jako funkcja.
+ */
+const LOGIC_LAYER = { statements: 85, branches: 75, functions: 80, lines: 85 };
+
+/**
+ * Warstwy z widokiem oraz aplikacja: część zachowania pokazuje scena Storybooka,
+ * a scen pomiar pokrycia nie liczy. Próg jest niższy o tę różnicę — inaczej żądałby
+ * testu jednostkowego na to, czego dowodzi scena.
+ */
+const VIEW_LAYER = { statements: 80, branches: 70, functions: 75, lines: 80 };
+
+/**
+ * Progi w procentach per typ warstwy — liczone na CAŁOŚCI projektu, nie per plik.
+ *
+ * Wartości są wyprowadzone z pomiaru zastanego kodu i zaokrąglone w dół: próg ma
+ * łapać spadek, a nie blokować repozytorium od pierwszego biegu. Najniższy zastany
+ * wynik wśród warstw z logiką to 91.66 / 77.77 / 81.25 / 91.48.
+ *
+ * `model` i `asset` dostają `null`, a nie zero: nie mają zachowania — walidator
+ * obecności dowodów też ich nie pyta — więc pomiar nie ma tam przedmiotu, a liczba
+ * zero sugerowałaby, że coś zmierzono.
+ */
+export const COVERAGE_THRESHOLDS = {
+  ui: VIEW_LAYER,
+  feature: VIEW_LAYER,
+  app: VIEW_LAYER,
+  state: LOGIC_LAYER,
+  core: LOGIC_LAYER,
+  util: LOGIC_LAYER,
+  model: null,
+  asset: null,
+};
+
+/** Silnik liczący pokrycie. */
+export const COVERAGE_PROVIDER = 'v8';
+
+/**
+ * Formaty raportu.
+ *
+ * `text` jest dla człowieka przy biegu lokalnym, `lcov` dla scalenia raportów
+ * wszystkich projektów w jedną liczbę — `scripts/coverage/lcov-summary.js` czyta
+ * wyłącznie ten format. Bez `lcov` scalanie nie ma czego czytać i zgłasza brak
+ * raportu dla projektu, który raport właśnie napisał.
+ */
+export const COVERAGE_REPORTERS = ['text', 'lcov'];
+
+/** Katalog raportów — względem korzenia repozytorium. */
+export const COVERAGE_DIR = 'coverage';
+
+/**
+ * Sekcja `coverage` konfiguracji testów projektu.
+ *
+ * @param projectDir katalog projektu — w konfiguracji zawsze `__dirname`
+ */
+export function coverageFor(projectDir: string) {
+  return coverageOptionsFor(projectDir, {
+    thresholds: COVERAGE_THRESHOLDS,
+    provider: COVERAGE_PROVIDER,
+    reporters: COVERAGE_REPORTERS,
+    coverageDir: COVERAGE_DIR,
+  });
+}

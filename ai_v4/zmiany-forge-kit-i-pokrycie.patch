+});
+
+test('TASK_COMMANDS: --path jest w zadaniu WYMAGANY, choć w CLI jest opcjonalny', () => {
+  // Wymagalność zależy od tego, kto woła: człowiek pracuje w katalogu docelowym,
+  // a zadanie ma `cwd` w korzeniu drzewa roboczego, więc domyślna wartość zawsze myli.
+  for (const command of Object.keys(NGXS_COMMANDS)) {
+    assert.ok(requiredTaskCommandArguments(command).includes('--path'), command);
+    assert.ok(Object.keys(NGXS_COMMANDS[command].optional).includes('--path'), `${command} w CLI zostaje opcjonalny`);
+  }

+    // Suita na gotowej notatce: czerwień, która tu zostaje, dotyczy treści
+    // nienaprawialnej bez człowieka (jego własnych słów albo objętości ustaleń) —
+    // ustalenia wracają wynikiem, żeby audyt i ekran PK2 je pokazały.
+    const gateResult = Gates.intentGates(
+      { resolutions, delegations: keptDelegations, appliedRules: groundedRules, markdown: note },
+      { standardsLoaded },
+    );
+    for (const entry of gateResult.findings) {
       onLog(`PK1: bramka ${entry.gate} — ${entry.message}`);
     }
 
     return {
       note,
+      context,
       resolutions,
-      delegations,
+      delegations: keptDelegations,
       appliedRules: groundedRules,
       standardsLoaded,
       rounds,
+      gateFindings: gateResult.findings,
     };
   } finally {
+    signal?.removeEventListener('abort', onAbort);
     await session.end();
   }
 }

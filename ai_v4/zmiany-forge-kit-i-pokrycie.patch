+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Naprawa po recenzji — brif sesji naprawczej nad zapisaną zmianą zadania.
+ *
+ * Sesja naprawy jest świeża (drzewo odtwarzane z gałęzi story), więc brif niesie
+ * komplet: czego dotyczy zadanie, gdzie wolno pisać i które ustalenia recenzji
+ * naprawić. Ustalenia wybiera CZŁOWIEK — brif bez wyboru nie ma prawa powstać,
+ * bo runda naprawcza nie startuje sama.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+import { taskScopes } from './task-scope.js';
+
+/**
+ * Buduje brif sesji naprawczej po recenzji.
+ *
+ * Dyrektywa stoi na końcu brifu: naprawa ma dotknąć wyłącznie wskazanych
+ * ustaleń — rozszerzanie zmiany „przy okazji" unieważniłoby recenzję, która
+ * oceniała inny diff. Wyjściem poza zakres pozostaje ESKALACJA, jak w każdej
+ * turze kodera.
+ *
+ * @param {object} args
+ * @param {object} args.plan — znormalizowany plan
+ * @param {string} args.taskId
+ * @param {Array<{id: string, text: string}>} args.findings — ustalenia wybrane przez człowieka
+ * @returns {string}
+ * @throws {Error} gdy zadanie nie istnieje albo lista ustaleń jest pusta.
+ */
+export function buildReviewRepairBrief({ plan, taskId, findings }) {
+  const task = (plan?.tasks ?? []).find((candidate) => candidate.id === taskId);
+  if (!task) throw new Error(`buildReviewRepairBrief: zadanie '${taskId}' nie istnieje w planie '${plan?.story}'`);
+  if (!Array.isArray(findings) || findings.length === 0) {
+    throw new Error('buildReviewRepairBrief: brak wybranych ustaleń — rundę naprawczą uruchamia jawny wybór człowieka');
+  }
+
+  const criteria = (plan.acceptanceCriteria ?? []).filter((criterion) => criterion.task === taskId);
+  return [
+    `# Naprawa po recenzji — zadanie ${taskId}${task.title ? ` (${task.title})` : ''}`,
+    '',
+    `Biblioteka: ${task.library}`,
+    '',
+    '## Zakres zadania (jedyne miejsce zmian)',
+    ...taskScopes({ plan, taskId }).map((entry) => `- ${entry}`),
+    '',
+    '## Kryteria akceptacji zadania',
+    ...(criteria.length > 0 ? criteria.map((criterion) => `- ${criterion.id}: ${criterion.text}`) : ['(brak)']),
+    '',
+    '## Ustalenia recenzji do naprawy (wybrane przez człowieka)',
+    ...findings.map((finding) => `- [${finding.id}] ${finding.text}`),
+    '',
+    'Napraw TERAZ wyłącznie powyższe ustalenia recenzji, edytując pliki w zakresie zadania. '
+    + 'Nie rozszerzaj zmiany poza to, czego wymagają ustalenia — recenzja oceniała konkretny diff. '
+    + 'Po zakończeniu odpowiedz dokładnie: GOTOWE + lista zmienionych plików (po jednej ścieżce na linię). '
+    + 'Jeśli naprawa wymaga zmian POZA zakresem zadania — NIE edytuj plików poza zakresem; '
+    + 'odpowiedz w pierwszej linii: ESKALACJA: <jedno pytanie do człowieka z gotową propozycją>.',
+  ].join('\n');
+}

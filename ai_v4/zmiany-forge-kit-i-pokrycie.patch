+    findings.some((entry) => /markAllAsTouched/.test(entry.message)),
+    'nazwa sposobu wykonania zostaje czerwona — zbior deklaracji jest domkniety makieta',
+  );
+});
diff --git a/.ai-agentic-workspace/workflows/forge-kit/gates/plan-references.js b/.ai-agentic-workspace/workflows/forge-kit/gates/plan-references.js

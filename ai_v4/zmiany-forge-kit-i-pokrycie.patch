+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+
+import { stepItems, planStepViolations } from './plan-steps.js';
+
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Ksztalt kroku planu. Katalog polecen wstrzykiwany — tresc kroku osadza sie
+ * wobec powierzchni CLI generatora, wiec test podaje ja wprost.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+const COMMANDS = { 'init-state': {}, 'add-async-state-action': {} };
+const ARGUMENTS = {
+  'init-state': ['--name', '--path', '--nested'],
+  'add-async-state-action': ['--name', '--path', '--request-with-payload'],
+};
+const PORTS = { commands: COMMANDS, argumentsOf: (command) => ARGUMENTS[command] ?? [] };
+
+// ── stepItems ────────────────────────────────────────────────────────────────
+
+test('stepItems: linia bez znacznika kontynuuje pozycje poprzednia', () => {
+  const items = stepItems([
+    '1. T1: wygenerowac stan',
+    '   poleceniem init-state',
+    '2. T2: formularz logowania',
+    '',
+    '- T3: trasa /login',
+  ].join('\n'));
+
+  assert.deepEqual(items, [
+    '1. T1: wygenerowac stan poleceniem init-state',
+    '2. T2: formularz logowania',
+    '- T3: trasa /login',
+  ]);
+});
+
+test('stepItems: pusta tresc daje pusta liste', () => {
+  assert.deepEqual(stepItems(''), []);
+  assert.deepEqual(stepItems(null), []);
+});
+
+// ── sciezki i nazwy plikow ───────────────────────────────────────────────────
+
+test('planStepViolations: nazwa pliku i sciezka projektu w kroku to ustalenia', () => {
+  const violations = planStepViolations({
+    stepsText: [
+      '1. T1: LoginActions namespace w auth-actions.ts; api/login.request.ts opakowuje ApiService',
+      '2. T2: LoginPageComponent (src/lib/login/) — Reactive Form',
+      '3. T3: trasa w apps/frontend-app/src/app/app.routes.ts',
+    ].join('\n'),
+    ...PORTS,
+  });
+
+  const paths = violations.filter((violation) => violation.kind === 'path').map((violation) => violation.value);
+  assert.deepEqual(paths, ['auth-actions.ts', 'api/login.request.ts', 'src/lib/login/', 'apps/frontend-app/src/app/app.routes.ts']);
+  assert.match(violations[0].note, /wytwarza je generator/);
+  assert.match(violations[0].step, /^1\. T1:/, 'ustalenie niesie krok, ktory poprawic');
+});
+
+test('planStepViolations: adres zasobu, trasa i komunikat przechodza', () => {
+  // Tego krok MUSI niesc doslownie — adres zasobu i sciezka trasy zaczynaja sie
+  // ukosnikiem, ale nie sa sciezkami w repozytorium.
+  const violations = planStepViolations({
+    stepsText: [
+      "1. T1: dodac wywolanie '/api/login'; Success przekierowuje na '/workspaces'",
+      "2. T1: Failure mapuje 401→'Nieprawidlowy login lub haslo', 429→'Zbyt wiele prob logowania. Sprobuj za chwile.'",
+      '3. T1: do fasady stanu dodac login() oraz sygnaly isLoading i error',
+    ].join('\n'),
+    ...PORTS,
+  });
+
+  assert.deepEqual(violations, []);
+});
+
+test('planStepViolations: sciezka podana generatorowi argumentem jest parametrem, nie opisem wyniku', () => {
+  const violations = planStepViolations({
+    stepsText: '1. T1: wygenerowac stan poleceniem init-state --name auth --path libs/apps/frontend-app/auth/state/src/lib',
+    ...PORTS,
+  });
+
+  assert.deepEqual(violations, []);
+});
+
+test('planStepViolations: ta sama sciezka powtorzona w kroku to jedno ustalenie', () => {
+  const violations = planStepViolations({
+    stepsText: '1. T1: dopisac do auth-actions.ts, potem znow auth-actions.ts',
+    ...PORTS,
+  });
+
+  assert.equal(violations.length, 1);
+});
+
+// ── polecenia i argumenty generatora ─────────────────────────────────────────
+
+test('planStepViolations: wywolanie generatora z wlasciwymi argumentami przechodzi', () => {
+  const violations = planStepViolations({
+    stepsText: '1. T1: init-state --name auth; add-async-state-action --name auth.login --request-with-payload true',
+    ...PORTS,
+  });
+
+  assert.deepEqual(violations, []);
+});
+
+test('planStepViolations: argument nieznany polecenia wymienionego w kroku', () => {
+  const violations = planStepViolations({
+    stepsText: '1. T1: init-state --name auth --with-effect true',
+    ...PORTS,
+  });
+
+  assert.equal(violations.length, 1);
+  assert.equal(violations[0].kind, 'unknown_argument');
+  assert.equal(violations[0].value, '--with-effect');
+  assert.match(violations[0].note, /init-state nie znają tego argumentu — znane: --name, --path, --nested/);
+});
+
+test('planStepViolations: argumenty osadzane wobec SUMY polecen kroku', () => {
+  // Krok wolno zlozyc z kilku wywolan; wiazanie argumentu z jednym z nich
+  // wymagaloby rozbioru prozy, wiec sprawdzenie lapie argument WYMYSLONY.
+  const violations = planStepViolations({
+    stepsText: '1. T1: init-state --name auth; add-async-state-action --request-with-payload true',
+    ...PORTS,
+  });
+
+  assert.deepEqual(violations, []);
+});
+
+test('planStepViolations: literowka w nazwie polecenia zostawia argumenty bez wlasciciela', () => {
+  const violations = planStepViolations({
+    stepsText: '1. T1: wygenerowac stan poleceniem init-stat --name auth',
+    ...PORTS,
+  });
+
+  assert.equal(violations.length, 1);
+  assert.equal(violations[0].kind, 'unknown_command');
+  assert.match(violations[0].note, /polecenia z katalogu: init-state, add-async-state-action/);
+});
+
+test('planStepViolations: krok bez polecenia i bez argumentow nie ma czego naruszyc', () => {
+  const violations = planStepViolations({
+    stepsText: '1. T1: Success zapisuje tokeny w AuthState',
+    ...PORTS,
+  });
+
+  assert.deepEqual(violations, []);
+});

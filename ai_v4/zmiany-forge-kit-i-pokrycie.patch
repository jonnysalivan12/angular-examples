+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Sekcja `coverage` konfiguracji vitest — składana z metadanych projektu.
+ *
+ * Sam moduł nie niesie ŻADNEJ wartości: progi, silnik, formaty raportu i nazwa
+ * katalogu przychodzą parametrem z `vitest.coverage.mts`, czyli z konfiguracji
+ * narzędzia. Tutaj jest wyłącznie to, czego konfiguracja nie umie zrobić sama —
+ * odczytanie typu warstwy z tagów projektu i policzenie ścieżki raportu.
+ *
+ * Ścieżka jest liczona, a nie wpisywana ręcznie: liczba poziomów `../` zależy od
+ * głębokości katalogu i jest miejscem, w którym łatwo się pomylić bez żadnego
+ * sygnału — zły katalog nie psuje biegu testów, tylko gubi raport.
+ *
+ * Brak metadanych zatrzymuje bieg zamiast go degradować. Projekt bez `project.json`
+ * albo bez tagu typu nie ma z czego wziąć progu; cicho pominięty próg to dokładnie
+ * ten stan, w którym pomiar istnieje, a nigdy niczego nie zatrzymuje.
+ *
+ * I/O jest wstrzykiwane, więc tę samą funkcję woła konfiguracja (ma dysk) i test
+ * (podstawia pliki).
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+import { existsSync, readFileSync } from 'node:fs';
+import { join, relative } from 'node:path';
+
+import { TAG_AXES } from '../config/library.js';
+import { WORKSPACE_FILES, workspaceRootOf } from '../config/workspace.js';
+
+/** Separatory na `/` — ścieżka trafia do konfiguracji, którą czyta też człowiek. */
+function toPosix(value) {
+  return String(value ?? '').replace(/\\/g, '/');
+}
+
+/**
+ * Typ warstwy z tagów projektu.
+ *
+ * @param {string[]} tags — zawartość `tags` z project.json
+ * @returns {string|null} wartość tagu `type:` albo null, gdy projekt go nie nosi
+ */
+export function layerTypeOf(tags) {
+  const prefix = TAG_AXES.type;
+  const tag = (tags ?? []).find((value) => String(value).startsWith(prefix));
+  return tag ? String(tag).slice(prefix.length) : null;
+}
+
+/**
+ * Składa sekcję `coverage` dla projektu leżącego w podanym katalogu.
+ *
+ * @param {string} projectDir — katalog projektu (w konfiguracji: `__dirname`)
+ * @param {object} settings — ustawienia z konfiguracji vitest
+ * @param {Record<string, object|null>} settings.thresholds — progi per typ warstwy
+ * @param {string} settings.provider — silnik liczący pokrycie
+ * @param {string[]} settings.reporters — formaty raportu
+ * @param {string} settings.coverageDir — katalog raportów względem korzenia
+ * @param {object} [io]
+ * @param {(path: string) => boolean} [io.exists]
+ * @param {(path: string) => string} [io.readFile]
+ * @returns {{provider: string, reporter: string[], reportsDirectory: string, thresholds?: object}}
+ * @throws {Error} gdy brakuje ustawień, katalog leży poza repozytorium, nie ma
+ *         project.json, projekt nie nosi tagu typu albo typ jest spoza progów
+ */
+export function coverageOptionsFor(projectDir, settings, io = {}) {
+  const { thresholds, provider, reporters, coverageDir } = settings ?? {};
+  if (!thresholds || !provider || !reporters || !coverageDir) {
+    throw new Error('coverageOptionsFor: brak ustawień pokrycia — oczekiwane pola: thresholds, provider, reporters, coverageDir (patrz vitest.coverage.mts).');
+  }
+
+  const exists = io.exists ?? existsSync;
+  const readFile = io.readFile ?? ((path) => readFileSync(path, 'utf8'));
+
+  const root = workspaceRootOf(projectDir, { exists });
+  if (!root) {
+    throw new Error(`coverageOptionsFor: '${toPosix(projectDir)}' leży poza repozytorium — nie znaleziono ${WORKSPACE_FILES.tsconfigBase} w żadnym katalogu wyżej.`);
+  }
+
+  const projectFile = join(projectDir, WORKSPACE_FILES.project);
+  if (!exists(projectFile)) {
+    throw new Error(`coverageOptionsFor: brak '${toPosix(projectFile)}' — próg pokrycia wynika z tagu typu, a tagi leżą w tym pliku.`);
+  }
+
+  let project;
+  try {
+    project = JSON.parse(readFile(projectFile));
+  } catch (error) {
+    throw new Error(`coverageOptionsFor: '${toPosix(projectFile)}' nie jest poprawnym JSON-em (${error.message}).`);
+  }
+
+  const type = layerTypeOf(project.tags);
+  if (!type) {
+    throw new Error(`coverageOptionsFor: projekt '${project.name ?? toPosix(projectDir)}' nie nosi tagu '${TAG_AXES.type}' — bez niego nie ma z czego wziąć progu pokrycia.`);
+  }
+  if (!(type in thresholds)) {
+    throw new Error(`coverageOptionsFor: typ '${type}' nie ma progu w vitest.coverage.mts (znane: ${Object.keys(thresholds).join(', ')}).`);
+  }
+
+  const projectPath = toPosix(relative(root, projectDir));
+  const reportsDirectory = toPosix(relative(projectDir, join(root, coverageDir, projectPath)));
+  const threshold = thresholds[type];
+
+  return {
+    provider,
+    reporter: [...reporters],
+    reportsDirectory,
+    // Warstwa bez zachowania nie dostaje klucza `thresholds` w ogóle — nieobecny,
+    // a nie pusty, żeby vitest nie miał czego interpretować.
+    ...(threshold ? { thresholds: { ...threshold } } : {}),
+  };
+}
diff --git a/scripts/coverage/vitest-coverage.test.js b/scripts/coverage/vitest-coverage.test.js

index 0000000..0d6a061
--- /dev/null
+++ b/.ai-agentic-workspace/workflows/forge-kit/gates/plan-references.js
@@ -0,0 +1,294 @@
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Odwołania w planie — INWENTARZ KLAS jako dane i JEDNA pętla, która go stosuje.
+ *
+ * Powód istnienia tego pliku jest policzalny. Plan może napisać dwadzieścia kilka
+ * rodzajów wartości; bramka pisana per pole obejmowała dziewięć z nich, a model
+ * generuje z całego rozkładu, więc każda story trafiała w inną szczelinę i wyglądało
+ * to na nowy rodzaj błędu. Zawsze była to ta sama klasa: ODWOŁANIE DO CZEGOŚ, CZEGO
+ * NIE MA — raz ścieżka, raz symbol, raz trasa.
+ *
+ * Stąd kształt: klasa odwołania to WPIS w tablicy (jak je rozpoznać, czym rozstrzygnąć,
+ * jak nazwać w komunikacie), a nie kolejna funkcja. Nowa klasa to nowy wpis; pętla
+ * i miejsca, w których szuka, zostają bez zmian. Miejsc jest jedno: pełny tekst planu,
+ * bo `markdown` obejmuje i część maszynową, i prozę.
+ *
+ * Nazwy z kodu podlegają regule mocniejszej niż istnienie: MUSZĄ być kontraktem tego
+ * planu albo parametrem generatora. Plan rozstrzyga umiejscowienie — bibliotekę, zakres,
+ * katalog, powierzchnię publiczną — a nie sposób wykonania, więc nazwa metody frameworka
+ * jest w nim defektem nawet wtedy, gdy ta metoda istnieje. Reguła zastąpiła sprawdzenie
+ * „czy symbol jest w indeksie", które przepuszczało `markAllAsTouched()` w kryterium
+ * akceptacji, i robi to jednym warunkiem, bez wyliczania operatorów ani funkcji Angulara.
+ *
+ * Rozstrzygnięcia są wstrzykiwane portami — ten plik nie czyta ani dysku, ani indeksu.
+ *
+ * Dwie klasy mieszkają osobno, w `project-references.js`: ścieżki i aliasy. Zostają
+ * tam, bo czyta je też bramka notatki PK1, która powstaje przed planem i nie ma
+ * jeszcze czym rozstrzygać symboli.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+/**
+ * Nazwa pola planu, a nie odwołanie: klucz w części maszynowej stoi przed dwukropkiem.
+ *
+ * Nazwy pól (`dependsOn`, `providedByTask`, `acceptanceCriteria`) mają kształt nazwy
+ * z kodu, bo są nazwami z kodu — tylko należą do KONTRAKTU planu, nie do planu, więc
+ * plan nie ma ich jak zadeklarować. Rozpoznanie po dwukropku wyklucza je wszystkie
+ * naraz i nie wymaga listy rosnącej razem ze schematem.
+ *
+ * Człon `(?!\w)` stoi PRZED sprawdzeniem dwukropka nie dla ozdoby: bez niego silnik
+ * wyrażeń obchodzi wykluczenie nawrotem, skracając dopasowanie o jedną literę
+ * (`importPath:` → trafienie `importPat`, za którym dwukropka już nie widać).
+ * Wymóg końca słowa odbiera nawrotowi każdy krótszy wariant.
+ */
+const FIELD_KEY_LOOKAHEAD = String.raw`(?!\w)(?![ \t]*:)`;
+
+/**
+ * Nazwa w notacji wielbłądziej: co najmniej dwa człony, z których każdy kolejny
+ * zaczyna się wielką literą i ma po niej małą literę albo cyfrę. Opcjonalna składowa
+ * po kropce (`AuthFacade.login`).
+ *
+ * Wymóg małej litery za wielką odsiewa skrótowce — `NGXS`, `POST`, `JWT`, `RODO`,
+ * `RxJS`, `PostgreSQL` przez ten wzorzec nie przechodzą, choć mają wielkie litery
+ * obok siebie. Polska proza nie stawia wielkiej litery w środku wyrazu, więc trafienie
+ * jest nazwą z kodu, a nie słowem zdania.
+ */
+const CODE_NAME_PATTERN = new RegExp(
+  String.raw`(?<![\w.'"/@#$-])([A-Za-z][a-z0-9]*(?:[A-Z][a-z0-9]+)+)(?:\.([A-Za-z][A-Za-z0-9]*))?${FIELD_KEY_LOOKAHEAD}`,
+  'g',
+);
+
+/** Stała w wersalikach: człony rozdzielone podkreśleniem (`AUTH_SESSION_PORT`). */
+const CONSTANT_NAME_PATTERN = new RegExp(
+  String.raw`(?<![\w.'"/@#$-])([A-Z][A-Z0-9]*(?:_[A-Z0-9]+)+)${FIELD_KEY_LOOKAHEAD}`,
+  'g',
+);
+
+/**
+ * Nazwy własne technologii, które mają kształt nazwy z kodu, a nazwą z kodu nie są.
+ * Lista jest krótka i taka zostanie: rośnie tylko o nazwę, która realnie wystąpiła
+ * w prozie planu.
+ */
+const TECHNOLOGY_NAMES = Object.freeze(new Set([
+  'TypeScript', 'JavaScript', 'GitHub', 'GitLab', 'NgRx',
+]));
+
+/**
+ * Zależność zewnętrzna w zapisie z przestrzenią nazw (`@ngxs/storage-plugin`).
+ * Ten sam kształt mają aliasy importu tego workspace'u, więc rozstrzyga je prefiks —
+ * bez listy prefiksów klasa milczy.
+ */
+const PACKAGE_PATTERN = /(?<![\w@./-])@[a-z0-9][a-z0-9-]*\/[a-z0-9][a-z0-9.-]*/g;
+
+/** Odsyłacz do sekcji standardu: `plik.md#identyfikator`. */
+const STANDARD_SECTION_PATTERN = /(?<![\w/-])([\w-]+\.md)#([\w-]+)/g;
+
+/**
+ * Ścieżka trasy w apostrofach — tak zapisuje ją plan, gdy mówi o nawigacji.
+ * Apostrofy są tu istotne: bez nich każdy adres zasobu i każdy fragment ścieżki
+ * pliku trafiałby do tej klasy.
+ */
+const ROUTE_PATTERN = /'(\/[a-z0-9][a-z0-9-]*(?:\/[a-z0-9][a-z0-9-]*)*)'/g;
+
+/** Adresy zasobów API nie są trasami aplikacji, choć mają ten sam kształt. */
+const API_PREFIX = '/api/';
+
+/** Dopasowania wzorca, bez powtórzeń, w kolejności wystąpienia. */
+function matchesOf(text, pattern, pick) {
+  const found = new Map();
+  for (const match of String(text ?? '').matchAll(pattern)) {
+    const entry = pick(match);
+    if (entry && !found.has(entry.value)) found.set(entry.value, entry);
+  }
+  return [...found.values()];
+}
+
+/**
+ * INWENTARZ KLAS ODWOŁAŃ. Każdy wpis mówi trzy rzeczy: jak odwołanie rozpoznać
+ * w tekście, czym je rozstrzygnąć i jak je nazwać człowiekowi.
+ *
+ * `severity` rozdziela dwa rodzaje pewności. Nazwa z kodu i sekcja standardu są
+ * rozstrzygalne na pewno — deklaracjami planu i plikiem standardu — więc czerwone.
+ * Trasa i zależność zewnętrzna wymagają interpretacji (trasa bywa tworzona w tej
+ * samej story; paczka bywa uzasadnionym wskazaniem dostawcy), więc zostają
+ * ostrzeżeniem dla człowieka na punkcie kontrolnym.
+ */
+export const REFERENCE_CLASSES = Object.freeze([
+  Object.freeze({
+    kind: 'code-name',
+    noun: 'nazwa z kodu',
+    severity: 'error',
+    extract: (text) => [
+      ...matchesOf(text, CODE_NAME_PATTERN, (match) => ({
+        value: match[2] ? `${match[1]}.${match[2]}` : match[1],
+        head: match[1],
+      })),
+      ...matchesOf(text, CONSTANT_NAME_PATTERN, (match) => ({ value: match[1], head: match[1] })),
+    ],
+    verdict: (entry, { declaredSymbols, generatorNames, resolveSymbol }) => {
+      // Bez listy deklaracji planu nie ma czym rozstrzygać — każda nazwa byłaby
+      // wtedy błędem, czyli sprawdzenie zmyślałoby zakaz.
+      if (!declaredSymbols) return null;
+      if (TECHNOLOGY_NAMES.has(entry.value)) return null;
+
+      // Trzy sposoby, którymi plan wprowadza nazwę legalnie: deklaruje ją jako
+      // kontrakt (`provides`/`consumes`/`removes`, klucz kontraktu), wskazuje na
+      // składową takiego kontraktu zapisem z kropką (głowa rozstrzyga za człon),
+      // albo podaje ją generatorowi jako parametr.
+      if (declaredSymbols.has(entry.head) || declaredSymbols.has(entry.value)) return null;
+      if (generatorNames?.has(entry.head)) return null;
+
+      // Nazwa istniejąca w repozytorium to inna pomyłka niż nazwa wzięta z frameworka:
+      // pierwsza jest zależnością, o której plan zapomniał powiedzieć, druga jest
+      // sposobem wykonania, który do planu nie należy.
+      return resolveSymbol?.(entry.head)
+        ? 'istnieje w repozytorium, ale plan go nie deklaruje'
+          + ' — dopisz do `consumes` zadania, które go używa, albo do kontraktów z ugruntowaniem plikowym'
+        : 'nie jest ani kontraktem tego planu, ani parametrem generatora'
+          + ' — nazwa z kodu wchodzi do planu tylko tymi dwiema drogami; sposób wykonania rozstrzyga koder'
+          + ' na swoich standardach, a kryterium akceptacji opisuje zachowanie obserwowalne, nie nazwę metody';
+    },
+  }),
+  Object.freeze({
+    kind: 'package',
+    noun: 'zależność zewnętrzna',
+    severity: 'warn',
+    extract: (text) => matchesOf(text, PACKAGE_PATTERN, (match) => ({
+      value: match[0],
+      prefix: match[0].slice(1).split('/')[0],
+    })),
+    verdict: (entry, { aliasPrefixes }) => {
+      if (!aliasPrefixes) return null;
+      // Nasz prefiks znaczy alias importu, czyli miejsce w tym workspace'ie.
+      if (aliasPrefixes.has(entry.prefix)) return null;
+      return 'jest wyborem mechanizmu, a nie miejsca — jeśli plan ma powód wskazać paczkę'
+        + ' (np. dostawcę komponentu), zostaw i zatwierdź; jeśli to sposób wykonania, usuń';
+    },
+  }),
+  Object.freeze({
+    kind: 'standard-section',
+    noun: 'odsyłacz do standardu',
+    severity: 'error',
+    extract: (text) => matchesOf(text, STANDARD_SECTION_PATTERN, (match) => ({
+      value: `${match[1]}#${match[2]}`,
+      file: match[1],
+      section: match[2],
+    })),
+    verdict: (entry, { resolveStandardSection }) => {
+      if (!resolveStandardSection) return null;
+      const found = resolveStandardSection(entry.file, entry.section);
+      if (found === true) return null;
+      return found === 'no-file'
+        ? `plik standardu '${entry.file}' nie istnieje`
+        : `standard '${entry.file}' nie ma sekcji '${entry.section}'`;
+    },
+  }),
+  Object.freeze({
+    kind: 'route',
+    noun: 'trasa',
+    severity: 'warn',
+    extract: (text) => matchesOf(text, ROUTE_PATTERN, (match) => (
+      match[1].startsWith(API_PREFIX) ? null : { value: match[1] }
+    )),
+    verdict: (entry, { knownRoutes }) => {
+      if (!knownRoutes) return null;
+      if (knownRoutes.has(entry.value)) return null;
+      return 'nie istnieje w trasach aplikacji — jeśli nie powstaje w tej story, nawigacja prowadzi w pustkę';
+    },
+  }),
+]);
+
+/**
+ * Wszystkie naruszenia odwołań w tekście planu, klasa po klasie.
+ *
+ * Port pominięty wyłącza swoją klasę: brak danych nie jest naruszeniem. To ta sama
+ * zasada, którą stosują pozostałe bramki — sprawdzenie bez wejścia milczy, zamiast
+ * zmyślać zakaz.
+ *
+ * @param {string} text — pełny tekst planu
+ * @param {object} ports
+ * @param {Set<string>} [ports.declaredSymbols] — symbole, które plan sam deklaruje
+ * @param {Set<string>} [ports.generatorNames] — nazwy podane generatorom w zadaniach
+ * @param {(name: string) => boolean} [ports.resolveSymbol] — czy symbol jest w indeksie kodu
+ * @param {(file: string, section: string) => true|'no-file'|'no-section'} [ports.resolveStandardSection]
+ * @param {Set<string>} [ports.knownRoutes] — ścieżki tras aplikacji
+ * @param {Set<string>} [ports.aliasPrefixes] — prefiksy aliasów importu tego workspace'u
+ * @returns {Array<{kind: string, noun: string, severity: string, reference: string, note: string}>}
+ */
+export function planReferenceViolations(text, ports = {}) {
+  const violations = [];
+  for (const referenceClass of REFERENCE_CLASSES) {
+    for (const entry of referenceClass.extract(text)) {
+      const note = referenceClass.verdict(entry, ports);
+      if (!note) continue;
+      violations.push({
+        kind: referenceClass.kind,
+        noun: referenceClass.noun,
+        severity: referenceClass.severity,
+        reference: entry.value,
+        note,
+      });
+    }
+  }
+  return violations;
+}
+
+/**
+ * Symbole, które plan deklaruje jako swój wytwór albo swoją zależność o znanym miejscu.
+ *
+ * Trzy źródła, bo trzy różne rzeczy znaczą „ten symbol ma właściciela": `provides`
+ * zadania (powstanie w tej story), klucz kontraktu (jest opisany i ugruntowany),
+ * `removes` (istnieje dziś i celowo znika). Nazwa składowej po kropce rozkłada się
+ * na głowę i człon, bo w prozie plan pisze raz `AuthStateService`, raz
+ * `AuthStateService.login`.
+ *
+ * @param {object} plan — znormalizowany plan
+ * @returns {Set<string>}
+ */
+export function declaredSymbolsOf(plan) {
+  const declared = new Set();
+  const add = (key) => {
+    const value = String(key ?? '').trim();
+    if (!value) return;
+    declared.add(value);
+    const head = value.split('.')[0];
+    if (head) declared.add(head);
+  };
+
+  for (const contract of plan?.binding?.contracts ?? []) add(contract.key);
+  for (const task of plan?.tasks ?? []) {
+    for (const key of task.provides ?? []) add(key);
+    for (const key of task.removes ?? []) add(key);
+    for (const key of task.consumes ?? []) add(key);
+  }
+  return declared;
+}
+
+/**
+ * Nazwy, które plan podaje generatorom — drugie legalne wejście nazwy z kodu do planu.
+ *
+ * Wywołanie generatora jest rozstrzygnięciem struktury: parametr `--name` wyznacza
+ * nazwy plików i symboli, które powstaną. Taka nazwa nie ma jeszcze prawa stać
+ * w `provides`, bo dopiero generator ją utworzy, a bez tego źródła bramka kazałaby
+ * planowi deklarować jako kontrakt każdy parametr wywołania.
+ *
+ * Rozbiór jest po separatorach wywołania, nie po składni konkretnego generatora:
+ * bramka poprawności wywołań zna argumenty (gates/generator-calls.js), a tutaj liczy
+ * się wyłącznie zbiór nazw, jakie w wywołaniu wystąpiły.
+ *
+ * @param {object} plan — znormalizowany plan
+ * @returns {Set<string>}
+ */
+export function generatorNamesOf(plan) {
+  const names = new Set();
+  for (const task of plan?.tasks ?? []) {
+    for (const call of task.generators ?? []) {
+      for (const token of String(call ?? '').split(/[\s,=/]+/)) {
+        const value = token.replace(/^-+/, '').trim();
+        if (!value) continue;
+        names.add(value);
+        const head = value.split('.')[0];
+        if (head) names.add(head);
+      }
+    }
+  }
+  return names;
+}
diff --git a/.ai-agentic-workspace/workflows/forge-kit/gates/plan-references.test.js b/.ai-agentic-workspace/workflows/forge-kit/gates/plan-references.test.js

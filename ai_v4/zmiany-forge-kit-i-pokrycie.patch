+  assert.deepEqual(requiredTaskCommandArguments(COMPONENT_COMMAND), []);
+  assert.equal(TASK_COMMANDS[COMPONENT_COMMAND].positional.length > 0, true, 'pozycyjna wartość jest opisana');
+});
+
+test('taskCommandUsage: linia użycia z wymaganymi gołymi i opcjonalnymi w nawiasach', () => {
+  assert.match(taskCommandUsage('init-state'), /^init-state --name <stateName> --path <state-folder>/);
+  assert.match(taskCommandUsage(COMPONENT_COMMAND), /^component <katalog komponentu/);
+  assert.equal(taskCommandUsage('widmo'), '');
+});

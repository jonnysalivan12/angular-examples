index 0000000..099cd0f
--- /dev/null
+++ b/.ai-agentic-workspace/workflows/forge-kit/gates/generator-calls.js
@@ -0,0 +1,157 @@
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Wywołania generatorów zadeklarowane w planie — CZYSTE funkcje nad ich treścią.
+ *
+ * Plan wymienia wywołanie jako polecenie z argumentami (`init-state --name auth`),
+ * a nie jako całą linię powłoki: sposób uruchomienia generatora jest faktem
+ * o repozytorium i dokłada go kod. Dzięki temu sprawdzeniu podlega dokładnie to,
+ * co planer napisał sam — nazwa polecenia, argumenty i ich wartości.
+ *
+ * Sprawdzane są cztery rzeczy, bo tyle da się rozstrzygnąć bez uruchomienia:
+ *   - polecenie istnieje w katalogu,
+ *   - każdy argument należy do TEGO polecenia (nie do sumy poleceń, jak w krokach —
+ *     tutaj wywołanie jest jedno, więc właściciel argumentu jest znany),
+ *   - argumenty wymagane są obecne,
+ *   - ścieżka podana argumentem albo pozycyjnie leży w katalogu zadania.
+ *
+ * Zero I/O — katalog poleceń i zakres zapisu zadania wstrzykuje wołający.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+/** Argument w formie CLI: `--nazwa=wartość` albo `--nazwa` z wartością osobno. */
+const ARGUMENT_PATTERN = /^--[a-z][a-z0-9-]*$/i;
+
+/**
+ * Rozbiera wywołanie na polecenie, argumenty i wartości pozycyjne.
+ *
+ * Wartość argumentu przyjmowana jest w obu zapisach (`--path=x` i `--path x`), bo
+ * oba czyta parser generatora. Wartość zaczynająca się od `--` nie jest wartością —
+ * to następny argument, a poprzedni jest wtedy flagą bez wartości.
+ *
+ * @param {string} call — treść z planu
+ * @returns {{command: string, args: Record<string, string|true>, positionals: string[]}}
+ */
+export function parseGeneratorCall(call) {
+  const tokens = String(call ?? '').trim().split(/\s+/).filter(Boolean);
+  const [command = '', ...rest] = tokens;
+
+  const args = {};
+  const positionals = [];
+  for (let index = 0; index < rest.length; index += 1) {
+    const token = rest[index];
+    const [name, inlineValue] = token.startsWith('--') && token.includes('=')
+      ? [token.slice(0, token.indexOf('=')), token.slice(token.indexOf('=') + 1)]
+      : [token, null];
+
+    if (!ARGUMENT_PATTERN.test(name)) {
+      positionals.push(token);
+      continue;
+    }
+    if (inlineValue !== null) {
+      args[name.toLowerCase()] = inlineValue;
+      continue;
+    }
+    const next = rest[index + 1];
+    if (next !== undefined && !next.startsWith('--')) {
+      args[name.toLowerCase()] = next;
+      index += 1;
+      continue;
+    }
+    args[name.toLowerCase()] = true;
+  }
+
+  return { command, args, positionals };
+}
+
+/**
+ * Naruszenia wywołań generatorów jednego zadania.
+ *
+ * Rodzaje ustaleń:
+ *   - 'unknown_command'   — polecenie poza katalogiem,
+ *   - 'unknown_argument'  — argument nienależący do tego polecenia,
+ *   - 'missing_argument'  — brak argumentu wymaganego,
+ *   - 'missing_path'      — polecenie zakładające plik bez ścieżki,
+ *   - 'path_outside'      — ścieżka poza katalogiem zapisu zadania.
+ *
+ * `writablePrefixes` puste znaczy „nie wiadomo, gdzie zadanie pisze" — wtedy ścieżek
+ * nie osądzamy, bo brak danych nie jest naruszeniem. Katalog biblioteki zadania
+ * wylicza kod, więc pusta lista zdarza się tylko przy planie bez struktury.
+ *
+ * @param {object} args
+ * @param {string[]} args.calls — wywołania zadeklarowane przez zadanie
+ * @param {Record<string, {required?: object, optional?: object, positional?: string, pathArguments?: string[]}>} args.commands
+ * @param {string[]} [args.writablePrefixes] — katalogi, w których zadanie pisze
+ * @returns {Array<{kind: string, call: string, value: string, note: string}>}
+ */
+export function generatorCallViolations({ calls = [], commands = {}, writablePrefixes = [] }) {
+  const knownCommands = Object.keys(commands);
+  const violations = [];
+
+  for (const call of calls) {
+    const text = String(call ?? '').trim();
+    if (!text) continue;
+
+    const { command, args, positionals } = parseGeneratorCall(text);
+    const entry = commands[command];
+    if (!entry) {
+      violations.push({
+        kind: 'unknown_command',
+        call: text,
+        value: command,
+        note: `polecenie poza katalogiem generatorów — dostępne: ${knownCommands.join(', ') || '(katalog pusty)'}`,
+      });
+      continue;
+    }
+
+    const required = Object.keys(entry.required ?? {});
+    const allowed = new Set([...required, ...Object.keys(entry.optional ?? {})]);
+
+    for (const name of Object.keys(args)) {
+      if (allowed.has(name)) continue;
+      violations.push({
+        kind: 'unknown_argument',
+        call: text,
+        value: name,
+        note: `polecenie '${command}' nie zna tego argumentu — znane: ${[...allowed].join(', ') || '(brak)'}`,
+      });
+    }
+
+    for (const name of required) {
+      if (args[name] !== undefined) continue;
+      violations.push({
+        kind: 'missing_argument',
+        call: text,
+        value: name,
+        note: `polecenie '${command}' bez wymaganego argumentu — bez niego generator nie ruszy`,
+      });
+    }
+
+    // Ścieżki: podane argumentem (`--path`) albo pozycyjnie (generator komponentu).
+    const pathValues = [
+      ...(entry.pathArguments ?? []).map((name) => args[name]).filter((value) => typeof value === 'string'),
+      ...(entry.positional ? positionals : []),
+    ];
+
+    if (entry.positional && pathValues.length === 0) {
+      violations.push({
+        kind: 'missing_path',
+        call: text,
+        value: command,
+        note: `polecenie '${command}' zakłada plik i wymaga ścieżki: ${entry.positional}`,
+      });
+      continue;
+    }
+
+    if (writablePrefixes.length === 0) continue;
+    for (const value of pathValues) {
+      const normalized = String(value).replace(/\\/g, '/').replace(/^\.\//, '');
+      if (writablePrefixes.some((prefix) => normalized === prefix || normalized.startsWith(`${prefix}/`))) continue;
+      violations.push({
+        kind: 'path_outside',
+        call: text,
+        value: normalized,
+        note: `ścieżka poza katalogiem, w którym zadanie pisze (${writablePrefixes.join(', ')})`,
+      });
+    }
+  }
+
+  return violations;
+}

+++ b/.ai-agentic-workspace/workflows/forge-kit/gates/plan-steps.js
@@ -0,0 +1,119 @@
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Kształt kroku planu — CZYSTE funkcje nad treścią sekcji KROKI.
+ *
+ * Krok mówi, CO osiągnąć i którym generatorem, a nie jakie pliki powstaną.
+ * Pliki wytwarza generator, a granicą zapisu jest katalog biblioteki zadania,
+ * więc nazwa pliku w kroku opisuje drugi raz coś już rozstrzygniętego — i myli
+ * się w tym, bo planer pisze ją z pamięci. Tak przeszła ścieżka z powtórzonym
+ * członem, na której stanął cały przebieg.
+ *
+ * Wartość podana generatorowi argumentem jest wyjątkiem: to parametr wywołania,
+ * nie opis wyniku. Sprawdzenie zdejmuje więc pary `--argument wartość` przed
+ * szukaniem ścieżek, a same argumenty osądza wobec katalogu poleceń.
+ *
+ * Zero I/O — treść kroków i katalog poleceń wstrzykuje wołający.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+/**
+ * Ścieżka kończąca się rozszerzeniem pliku źródłowego — z członami katalogów albo
+ * bez nich. Rozszerzenie jest tu jedynym pewnym znakiem: adres zasobu
+ * ('/api/login') i ścieżka trasy ('/workspaces') go nie mają, a krok MUSI je nieść
+ * dosłownie. Odsyłacz do standardu (`state.md#effects`) też nie — `.md` na liście
+ * nie stoi, bo wskazuje regułę do przeczytania, nie plik do wytworzenia.
+ */
+const SOURCE_FILE_PATTERN = /(?<![\w-])[\w.@-]+(?:\/[\w.*@-]+)*\.(?:ts|tsx|js|mjs|cjs|html|scss|css|json)(?![\w])/g;
+
+/** Katalog wewnątrz projektu (bez pliku na końcu): człon `libs`, `apps` albo `src`. */
+const PROJECT_DIRECTORY_PATTERN = /(?<![\w-])(?:libs|apps|src)\/[\w./*-]+/g;
+
+/** Argument w formie CLI wraz z wartością — `--nazwa=wartość` albo `--nazwa wartość`. */
+const ARGUMENT_WITH_VALUE_PATTERN = /--[a-z][a-z0-9-]*(?:=\S+|\s+(?!--)[^\s,;]+)?/gi;
+
+/** Sama nazwa argumentu, w formie CLI (z myślnikami, jak w katalogu poleceń). */
+const ARGUMENT_NAME_PATTERN = /--[a-z][a-z0-9-]*/gi;
+
+/**
+ * Kroki jako osobne pozycje: numerowana albo wypunktowana lista, gdzie linia
+ * bez znacznika kontynuuje pozycję poprzednią. Osądzanie linia po linii dzieliłoby
+ * jeden krok na kawałki i gubiło związek argumentu z jego poleceniem.
+ *
+ * @param {string} stepsText — treść sekcji KROKI
+ * @returns {string[]} pozycje w kolejności wystąpienia; pusta lista dla pustej treści.
+ */
+export function stepItems(stepsText) {
+  const items = [];
+  for (const line of String(stepsText ?? '').split('\n')) {
+    if (line.trim() === '') continue;
+    if (/^\s*(?:\d+[.)]|[-*])\s/.test(line) || items.length === 0) items.push([line.trim()]);
+    else items[items.length - 1].push(line.trim());
+  }
+  return items.map((item) => item.join(' '));
+}
+
+/**
+ * Naruszenia kształtu kroków.
+ *
+ * Rodzaje ustaleń:
+ *   - 'path'             — ścieżka albo nazwa pliku w treści kroku,
+ *   - 'unknown_command'  — argument bez polecenia generatora, które by go znało,
+ *   - 'unknown_argument' — argument nienależący do żadnego polecenia z kroku.
+ *
+ * Krok z literówką w nazwie polecenia i z argumentami trafia do 'unknown_command':
+ * żadne znane polecenie nie stoi w tekście, więc argumenty nie mają właściciela.
+ * Literówka BEZ argumentów przechodzi — nie ma po niej śladu, którym dałoby się
+ * ją odróżnić od zwykłego słowa, a koder dostanie od CLI jawny błąd.
+ *
+ * Argumenty osądzane są wobec SUMY poleceń wymienionych w kroku. Krok wolno
+ * złożyć z kilku wywołań, a wiązanie argumentu z jednym z nich wymagałoby
+ * rozbioru prozy — sprawdzenie łapie więc argument wymyślony, nie przestawiony.
+ *
+ * @param {object} args
+ * @param {string} args.stepsText — treść sekcji KROKI planu
+ * @param {Record<string, unknown>} args.commands — katalog poleceń: nazwa → wpis
+ * @param {(command: string) => string[]} args.argumentsOf — argumenty polecenia w formie CLI
+ * @returns {Array<{kind: string, step: string, value: string, note: string}>}
+ */
+export function planStepViolations({ stepsText, commands = {}, argumentsOf = () => [] }) {
+  const knownCommands = Object.keys(commands);
+  const violations = [];
+
+  for (const step of stepItems(stepsText)) {
+    const named = knownCommands.filter((command) => new RegExp(`(?<![\\w-])${command}(?![\\w-])`).test(step));
+    const allowed = new Set(named.flatMap((command) => argumentsOf(command)));
+
+    // Ta sama ścieżka powtórzona w kroku jest jednym błędem do poprawienia,
+    // nie dwoma ustaleniami do przeczytania.
+    const reported = new Set();
+    const report = (kind, value, note) => {
+      if (reported.has(`${kind}:${value}`)) return;
+      reported.add(`${kind}:${value}`);
+      violations.push({ kind, step, value, note });
+    };
+
+    const pathNote = 'krok nie wymienia plików ani katalogów — wytwarza je generator, a granicą zapisu jest katalog biblioteki zadania';
+
+    // Ścieżki z plikiem najpierw, a ich dopasowania zdjęte z tekstu przed szukaniem
+    // katalogów: `apps/x/src/a.ts` pasuje do obu wzorców, a zgłoszone dwa razy raz
+    // z plikiem i raz bez, wyglądałoby jak dwa różne odwołania.
+    let remaining = step.replace(ARGUMENT_WITH_VALUE_PATTERN, ' ');
+    for (const match of remaining.match(SOURCE_FILE_PATTERN) ?? []) {
+      report('path', match, pathNote);
+      remaining = remaining.split(match).join(' ');
+    }
+    for (const match of remaining.match(PROJECT_DIRECTORY_PATTERN) ?? []) {
+      report('path', match, pathNote);
+    }
+
+    for (const argument of step.match(ARGUMENT_NAME_PATTERN) ?? []) {
+      const name = argument.toLowerCase();
+      if (named.length === 0) {
+        report('unknown_command', name, `argument bez polecenia generatora — polecenia z katalogu: ${knownCommands.join(', ') || '(katalog pusty)'}`);
+        continue;
+      }
+      if (!allowed.has(name)) {
+        report('unknown_argument', name, `polecenia ${named.join(', ')} nie znają tego argumentu — znane: ${[...allowed].join(', ') || '(brak)'}`);
+      }
+    }
+  }
+  return violations;
+}

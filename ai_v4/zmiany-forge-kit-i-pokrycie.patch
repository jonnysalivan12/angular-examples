@@ -0,0 +1,78 @@
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Etap naprawy po recenzji — POZA tabelą kroków przepływu.
+ *
+ * Uruchamiany wyłącznie na wskazanie człowieka po lekturze raportu PK3:
+ * człowiek wybiera zadanie i identyfikatory ustaleń (AC-* dla kryteriów bez
+ * pokrycia, V<n> dla naruszeń — numeracja od 1 jak w reviews.json). Bez wyboru
+ * etap odmawia — runda naprawcza nie startuje sama.
+ *
+ * Po zielonej naprawie recenzję trzeba przejść ponownie (etap recenzji jest
+ * powtarzalny) — naprawa zmienia diff, który recenzent oceniał.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+import fs from 'node:fs';
+
+import * as config from '../config/global-config.js';
+import { Orchestrator } from '../orchestrator/index.js';
+import { artifactPaths, readJson, writeArtifact, writeJson } from './paths.js';
+
+/**
+ * @param {object} args
+ * @param {string} args.featureDir — identyfikator funkcjonalności
+ * @param {string} args.taskId — zadanie z raportu PK3
+ * @param {string[]} args.findingIds — wybór człowieka (AC-* / V<n>)
+ * @param {string} [args.model]
+ * @param {(question: object) => Promise<string>} [args.askCoderQuestion] — port pytania w trakcie naprawy
+ * @param {AbortSignal} [args.signal]
+ * @param {(message: string) => void} [args.onLog]
+ * @param {Function} [args.repairTask] — port rundy naprawczej
+ * @returns {Promise<{ok: boolean, result?: object, reason?: string}>}
+ */
+export async function runStage({
+  featureDir, taskId, findingIds = [], model, askCoderQuestion, signal, onLog = () => {},
+  repairTask = Orchestrator.repairTaskAfterReview,
+}) {
+  const paths = artifactPaths(featureDir);
+  if (!fs.existsSync(paths.planState)) return { ok: false, reason: `brak zatwierdzonego planu (${paths.planState})` };
+  if (!fs.existsSync(paths.buildResult)) return { ok: false, reason: `brak wyniku wykonania (${paths.buildResult})` };
+  if (!fs.existsSync(paths.reviews)) return { ok: false, reason: `brak zapisu recenzji (${paths.reviews}) — najpierw etap recenzji` };
+
+  const state = readJson(paths.planState);
+  const reviews = readJson(paths.reviews);
+  const review = (reviews.reviews ?? []).find((entry) => entry.taskId === taskId);
+  if (!review) {
+    const known = (reviews.reviews ?? []).map((entry) => entry.taskId).join(', ') || '(żadne)';
+    return { ok: false, reason: `recenzja nie zna zadania '${taskId}' — zrecenzowane: ${known}` };
+  }
+
+  const { findings, unknown } = Orchestrator.selectReviewFindings(review, findingIds);
+  if (unknown.length > 0) {
+    return { ok: false, reason: `nieznane identyfikatory ustaleń: ${unknown.join(', ')} (dozwolone: AC-* bez pokrycia, V<n> naruszeń)` };
+  }
+  if (findings.length === 0) {
+    return { ok: false, reason: 'rundę naprawczą uruchamia jawny wybór ustaleń — podaj identyfikatory z raportu PK3' };
+  }
+
+  onLog(`naprawa ${taskId}: ${findings.length} ${findings.length === 1 ? 'ustalenie wybrane' : 'ustaleń wybranych'} przez człowieka`);
+  const result = await repairTask({
+    storyId: state.storyId ?? featureDir,
+    taskId,
+    plan: state.plan,
+    findings,
+    worktreeRoot: config.WORKTREE_ROOT,
+    model,
+    askHuman: askCoderQuestion,
+    signal,
+    onLog,
+  });
+
+  // Zlecenie osobnym plikiem, jak przy zadaniach fali: runda naprawcza dostaje
+  // inny brif niż zadanie, więc bez zapisu nie da się sprawdzić, co dostała.
+  const { brief, ...journal } = result;
+  if (brief) writeArtifact(paths.repairBrief(taskId), brief);
+  writeJson(paths.repairResult(taskId), journal);
+  onLog(result.ok
+    ? `naprawa ${taskId} zielona (commit na ${result.branch}) — uruchom ponownie etap recenzji, bo diff się zmienił`
+    : `naprawa ${taskId} nieudana — gałąź nietknięta (${result.error ?? result.question ?? 'szczegóły w wyniku'})`);
+  return { ok: result.ok, result };
+}

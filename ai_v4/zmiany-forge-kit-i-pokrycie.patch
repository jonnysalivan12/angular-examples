--- /dev/null
+++ b/.ai-agentic-workspace/workflows/forge-kit/orchestrator/repair-task.js
@@ -0,0 +1,238 @@
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Runda naprawcza po recenzji — wyłącznie na jawne wskazanie człowieka.
+ *
+ * Zmiana story jest już scalona i zacommitowana, a drzewa robocze sprzątnięte,
+ * więc naprawa odtwarza drzewo Z GAŁĘZI SCALAJĄCEJ i pracuje wprost na niej:
+ * zielony wynik commituje się na gałąź bez scalania, czerwony znika razem
+ * z drzewem — gałąź zostaje nietknięta.
+ *
+ * Reguły te same co w zadaniu kodera: bramka zakresu przed narzędziem, pętla
+ * do zieleni, bramki diffu z dogrywką w żywej sesji, pula kredytów jako
+ * bezpiecznik. Po zielonej naprawie recenzję trzeba przejść PONOWNIE — naprawa
+ * zmienia diff, który recenzent oceniał.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+import path from 'node:path';
+
+import { Copilot } from '../../../scripts/copilot.js';
+import { makeExecCommand } from '../../../scripts/shell-command.js';
+import { getIndex } from '../../../scripts/code-index/index.js';
+import { Coder } from '../coder/index.js';
+import { Gates } from '../gates/index.js';
+import { makeCoderPermissionHandler } from '../coder-permissions.js';
+import * as config from '../config/global-config.js';
+import { Reviewer } from '../reviewer/index.js';
+import { gateDiffWithRepair, makeGuardedAsk } from './coder-task.js';
+import { createWorktree, removeWorktree, commitTask, changedFiles, integrationBranch } from './worktrees.js';
+
+const REPAIR_TIMEOUT_MS = 15 * 60 * 1000;
+
+/**
+ * Zamienia wybór człowieka (identyfikatory z raportu PK3) na ustalenia do brifu.
+ *
+ * Adresowalne są wyłącznie problemy: werdykty bez potwierdzonego pokrycia
+ * (identyfikator = AC) i naruszenia standardów (identyfikator = V<pozycja>,
+ * numerowana od 1 w kolejności zapisu). Kryterium pokryte nie jest materiałem
+ * naprawy, więc jego wybór wraca jako nieznany identyfikator, nie cicha pustka.
+ *
+ * @param {{verdicts?: Array, violations?: Array}} review — zapis recenzji zadania
+ * @param {string[]} selectedIds — wybór człowieka
+ * @returns {{findings: Array<{id: string, text: string}>, unknown: string[]}}
+ */
+export function selectReviewFindings(review, selectedIds = []) {
+  const catalog = new Map();
+  for (const verdict of review?.verdicts ?? []) {
+    if (verdict.verdict === Reviewer.AC_VERDICTS.COVERED) continue;
+    const label = verdict.verdict === Reviewer.AC_VERDICTS.UNCOVERED ? 'niepokryte' : 'niezweryfikowane';
+    catalog.set(verdict.ac, `kryterium ${verdict.ac} ${label}: ${verdict.why}`
+      + (verdict.expectedIn ? ` (szukane w: ${verdict.expectedIn})` : ''));
+  }
+  (review?.violations ?? []).forEach((violation, index) => {
+    catalog.set(`V${index + 1}`, `naruszenie ${violation.rule} @ ${violation.at}: ${violation.why}`);
+  });
+
+  const findings = [];
+  const unknown = [];
+  for (const id of selectedIds) {
+    const text = catalog.get(id);
+    if (text === undefined) unknown.push(id);
+    else findings.push({ id, text });
+  }
+  return { findings, unknown };
+}
+
+/**
+ * Wykonuje rundę naprawczą jednego zadania na gałęzi scalającej story.
+ *
+ * @param {object} args
+ * @param {string} args.storyId
+ * @param {string} args.taskId
+ * @param {object} args.plan — znormalizowany plan (stan etapu planu)
+ * @param {Array<{id: string, text: string}>} args.findings — ustalenia WYBRANE przez człowieka
+ * @param {string} args.worktreeRoot — katalog na drzewa robocze (poza repozytorium)
+ * @param {string} [args.repoRoot]
+ * @param {string} [args.model]
+ * @param {(question: {question: string, choices?: string[]}) => Promise<string>} [args.askHuman]
+ * @param {AbortSignal} [args.signal] — hamulec przebiegu: przerywa turę sesji
+ * @param {(message: string) => void} [args.onLog]
+ * @returns {Promise<object>} wynik naprawy: ok, committed, branch, changedFiles,
+ *          verification, diffGates, escalated/question, usage, durationMs
+ */
+export async function repairTaskAfterReview({
+  storyId, taskId, plan, findings, worktreeRoot,
+  repoRoot = process.cwd(), model, askHuman, signal, onLog = () => {},
+}) {
+  const startedAt = Date.now();
+  if (signal?.aborted) throw new Error('przebieg przerwany — naprawa nie wystartowała');
+
+  const task = (plan?.tasks ?? []).find((candidate) => candidate.id === taskId);
+  if (!task) throw new Error(`repairTaskAfterReview: zadanie '${taskId}' nie istnieje w planie '${plan?.story}'`);
+  // Brif i tak to sprawdza, ale porażka ma paść PRZED założeniem drzewa.
+  if (!Array.isArray(findings) || findings.length === 0) {
+    throw new Error('repairTaskAfterReview: brak wybranych ustaleń — rundę naprawczą uruchamia jawny wybór człowieka');
+  }
+
+  const execCommand = makeExecCommand(repoRoot);
+  const branch = integrationBranch(storyId);
+  const worktreePath = path.join(worktreeRoot, storyId, `repair-${taskId}`);
+
+  // Drzewo WPROST na gałęzi scalającej: commit naprawy ląduje na niej bez
+  // scalania, a czerwona naprawa znika razem z drzewem.
+  const created = await createWorktree({ worktreePath, branch, base: branch, repoRoot, execCommand, onLog });
+  if (!created.ok) {
+    return { storyId, taskId, ok: false, committed: false, branch, error: `drzewo naprawy nie powstało: ${created.output}`, durationMs: Date.now() - startedAt };
+  }
+
+  const allowedScopes = Coder.taskScopes({ plan, taskId });
+  const beforeApi = Coder.barrelSnapshot(Coder.getDb({ root: worktreePath }), [task.library]);
+  const treeChanges = () => changedFiles({ worktreePath, execCommand });
+
+  const runRepairVerification = async () => {
+    const scope = Coder.scopeStep({ changedFiles: await treeChanges(), allowedScopes });
+    if (!scope.ok) {
+      onLog(`naprawa: zakres → RED (${scope.outputTail.split('\n')[0]})`);
+      return { ok: false, steps: [scope] };
+    }
+    return Coder.runVerification({ base: 'HEAD', cwd: worktreePath, onLog });
+  };
+
+  const measureDiffGates = async () => {
+    const files = await treeChanges();
+    const afterApi = Coder.barrelSnapshot(getIndex({ sync: 'force', root: worktreePath }), [task.library]);
+    return { files, gates: Coder.diffGatesForTask({ plan, taskId, changedFiles: files, beforeApi, afterApi }) };
+  };
+
+  const copilot = new Copilot();
+  let unansweredQuestion = null;
+  const guardedAsk = askHuman
+    ? makeGuardedAsk({
+      askHuman,
+      log: onLog,
+      abortSession: () => { void session.abort(); },
+      onUnanswered: (question) => { unansweredQuestion = question; },
+    })
+    : null;
+
+  const session = copilot.create({
+    model: model ?? config.CODER.MODEL,
+    cwd: worktreePath,
+    enableTools: true,
+    progress: true,
+    timeout: REPAIR_TIMEOUT_MS,
+    maxAiCredits: config.WAVE.MAX_AI_CREDITS_PER_TASK,
+    onPermissionRequest: makeCoderPermissionHandler({ onLog }),
+    diagnostics: { file: config.logPath(`repair-${taskId}`) },
+    ...(guardedAsk ? { onUserInput: guardedAsk } : {}),
+    hooks: {
+      onPreToolUse: (input) => {
+        const decision = Gates.toolScopeDecision({
+          toolName: input?.toolName,
+          toolArgs: input?.toolArgs,
+          allowedScopes,
+          workspaceRoot: worktreePath,
+        });
+        if (decision.decision === 'allow') return undefined;
+        onLog(`bramka zakresu odbiła '${input?.toolName}': ${decision.offendingPaths.join(', ')}`);
+        return { permissionDecision: 'deny', permissionDecisionReason: decision.reason };
+      },
+    },
+  });
+  await session.start();
+
+  const onAbort = () => { void session.abort(); };
+  signal?.addEventListener('abort', onAbort, { once: true });
+
+  const brief = Coder.buildReviewRepairBrief({ plan, taskId, findings });
+
+  let implementation;
+  let diffOutcome = null;
+  let error = null;
+  try {
+    implementation = await Coder.implementTask({
+      session,
+      brief,
+      runVerification: runRepairVerification,
+      canAskHuman: Boolean(askHuman),
+      onLog,
+    });
+
+    diffOutcome = await gateDiffWithRepair({
+      measure: measureDiffGates,
+      ask: (prompt) => session.ask(prompt),
+      verify: runRepairVerification,
+      implementationOk: implementation.ok,
+      onLog,
+    });
+    if (diffOutcome.escalation) {
+      implementation = { ...implementation, ok: false, escalated: true, question: diffOutcome.escalation };
+    } else if (diffOutcome.verification) {
+      implementation = { ...implementation, ok: diffOutcome.verification.ok, verification: diffOutcome.verification };
+    }
+  } catch (caught) {
+    error = unansweredQuestion
+      ? `pytanie bez odpowiedzi: „${unansweredQuestion}"`
+      : `naprawa przerwana: ${caught?.message ?? String(caught)}`;
+    onLog(error);
+    implementation = { ok: false, escalated: false, question: unansweredQuestion, verification: null };
+  } finally {
+    signal?.removeEventListener('abort', onAbort);
+    await session.end();
+    await copilot.stop();
+  }
+
+  const green = implementation.ok && (diffOutcome?.gates.ok ?? false);
+  let committed = false;
+  let commitFailed = false;
+  if (green) {
+    const commit = await commitTask({ worktreePath, storyId, taskId, title: 'naprawa po recenzji', execCommand });
+    committed = commit.committed;
+    if (!commit.ok) {
+      commitFailed = true;
+      error = `commit naprawy nie powstał: ${commit.output}`;
+    }
+  }
+
+  // Drzewo znika zawsze; zielona naprawa żyje dalej commitem na gałęzi,
+  // czerwona nie zostawia śladu poza wynikiem.
+  await removeWorktree({ worktreePath, repoRoot, execCommand });
+
+  return {
+    storyId,
+    taskId,
+    ok: green && !commitFailed,
+    committed,
+    branch,
+    brief,
+    findings,
+    changedFiles: diffOutcome?.files ?? [],
+    escalated: implementation.escalated ?? false,
+    question: implementation.question ?? null,
+    verification: implementation.verification ?? null,
+    diffGates: diffOutcome?.gates ?? null,
+    diffRepairRounds: diffOutcome?.repairRounds ?? 0,
+    budgetExhausted: session.budgetExhausted ?? false,
+    error,
+    usage: session.totalUsage ?? null,
+    durationMs: Date.now() - startedAt,
+  };
+}

+ * Standard opisuje katalog komponentu (`…/src/lib/<nazwa>`), a generator nx bierze
+ * ścieżkę pliku bez rozszerzenia. Dwa zapisy tej samej rzeczy dawały dwa komponenty
+ * tej samej nazwy: krok deterministyczny zakładał `icon/icon`, plan `icon`.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+test('componentFilePath: katalog dostaje człon nazwy pliku, gotowa ścieżka zostaje', () => {
+  assert.equal(componentFilePath('libs/shared/common/ui/src/lib/icon'), 'libs/shared/common/ui/src/lib/icon/icon');
+  assert.equal(componentFilePath('libs/shared/common/ui/src/lib/icon/icon'), 'libs/shared/common/ui/src/lib/icon/icon');
+  assert.equal(componentFilePath('libs/x/src/lib/login-form/'), 'libs/x/src/lib/login-form/login-form');
+  assert.equal(componentFilePath('libs\\x\\src\\lib\\badge'), 'libs/x/src/lib/badge/badge');

+import assert from 'node:assert/strict';
+import { describe, it } from 'node:test';
+
+import { checkCoverageConfig } from './coverage-config-validator.js';
+
+/** Wywołanie walidatora dla jednej konfiguracji. */
+function check(configSource) {
+  return checkCoverageConfig({
+    projectName: 'shared-common-ui',
+    directory: 'libs/shared/common/ui',
+    configPath: 'libs/shared/common/ui/vite.config.mts',
+    configSource,
+  });
+}
+
+describe('checkCoverageConfig', () => {
+  it('przepuszcza konfigurację biorącą sekcję ze wspólnego źródła', () => {
+    assert.deepEqual(check('  test: { coverage: coverageFor(__dirname) },'), []);
+  });
+
+  it('znosi odstępy w wywołaniu', () => {
+    assert.deepEqual(check('coverage : coverageFor( __dirname )'), []);
+  });
+
+  it('zgłasza własną sekcję pokrycia', () => {
+    const violations = check("coverage: { reportsDirectory: '../../coverage/x', provider: 'v8' as const },");
+
+    assert.equal(violations.length, 1);
+    assert.equal(violations[0].kind, 'coverage-inline');
+    assert.match(violations[0].note, /bez progu przechodzi zawsze/);
+  });
+
+  it('zgłasza brak sekcji pokrycia', () => {
+    const violations = check("test: { name: 'ui', watch: false },");
+
+    assert.equal(violations.length, 1);
+    assert.equal(violations[0].kind, 'coverage-missing');
+    assert.match(violations[0].note, /nie zmierzy niczego/);
+  });
+
+  it('niesie nazwę projektu i ścieżkę pliku do raportu', () => {

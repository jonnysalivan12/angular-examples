+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+
+import { buildReviewRepairBrief } from './review-repair.js';
+
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Brif naprawy po recenzji: świeża sesja dostaje komplet (zadanie, zakres,
+ * wybrane ustalenia), a bez wyboru człowieka brif nie ma prawa powstać.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+const PLAN = {
+  story: 'US-1',
+  tasks: [{ id: 'T1', title: 'Wylogowanie', library: 'core-auth', scope: ['libs/core/auth/**'] }],
+  acceptanceCriteria: [
+    { id: 'AC-1', text: 'wylogowanie czyści sesję', verification: 'unit', task: 'T1' },
+    { id: 'AC-9', text: 'cudze kryterium', verification: 'unit', task: 'T2' },
+  ],
+};
+
+const FINDINGS = [
+  { id: 'AC-1', text: 'kryterium AC-1 niepokryte: żadna dodana linia nie czyści sesji' },
+  { id: 'V1', text: 'naruszenie state.md#ngxs @ libs/core/auth/src/f.ts:12: mutacja stanu poza akcją' },
+];
+
+test('buildReviewRepairBrief: zadanie, zakres, kryteria zadania i wybrane ustalenia', () => {
+  const brief = buildReviewRepairBrief({ plan: PLAN, taskId: 'T1', findings: FINDINGS });
+
+  assert.match(brief, /^# Naprawa po recenzji — zadanie T1 \(Wylogowanie\)/);
+  assert.match(brief, /Biblioteka: core-auth/);
+  assert.match(brief, /- libs\/core\/auth\/\*\*/);
+  assert.match(brief, /- AC-1: wylogowanie czyści sesję/);
+  assert.doesNotMatch(brief, /AC-9/, 'kryteria innych zadań nie wchodzą do brifu');
+  assert.match(brief, /- \[AC-1\] kryterium AC-1 niepokryte/);
+  assert.match(brief, /- \[V1\] naruszenie state\.md#ngxs/);
+  assert.match(brief, /wyłącznie powyższe ustalenia/, 'naprawa nie rozszerza zmiany poza wybór');
+  assert.match(brief, /GOTOWE/);
+  assert.match(brief, /ESKALACJA/, 'wyjście poza zakres zostaje eskalacją, nie edycją');
+});
+
+test('buildReviewRepairBrief: pusty wybór i nieznane zadanie odrzucone', () => {
+  assert.throws(() => buildReviewRepairBrief({ plan: PLAN, taskId: 'T1', findings: [] }), /jawny wybór człowieka/);
+  assert.throws(() => buildReviewRepairBrief({ plan: PLAN, taskId: 'T9', findings: FINDINGS }), /zadanie 'T9' nie istnieje/);
+});

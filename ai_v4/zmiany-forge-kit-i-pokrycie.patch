@@ -0,0 +1,135 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+
+import { parseGeneratorCall, generatorCallViolations } from './generator-calls.js';
+import { TASK_COMMANDS } from '../../../../scripts/generators/task-commands.js';
+
+const SCOPE = ['libs/apps/frontend-app/auth/state'];
+
+/* ── rozbiór wywołania ─────────────────────────────────────────────────────── */
+
+test('parseGeneratorCall: oba zapisy wartości, flaga bez wartości, wartości pozycyjne', () => {
+  assert.deepEqual(parseGeneratorCall('init-state --name auth --path=libs/x --nested'), {
+    command: 'init-state',
+    args: { '--name': 'auth', '--path': 'libs/x', '--nested': true },
+    positionals: [],
+  });
+
+  assert.deepEqual(parseGeneratorCall('component libs/x/src/lib/badge/badge'), {
+    command: 'component',
+    args: {},
+    positionals: ['libs/x/src/lib/badge/badge'],
+  });
+});
+
+test('parseGeneratorCall: wartość zaczynająca się od myślników to następny argument, nie wartość', () => {
+  const parsed = parseGeneratorCall('add-state-action --with-payload --name auth.login');
+
+  assert.equal(parsed.args['--with-payload'], true);
+  assert.equal(parsed.args['--name'], 'auth.login');
+});
+
+test('parseGeneratorCall: pusta treść daje puste polecenie, nie wyjątek', () => {
+  assert.deepEqual(parseGeneratorCall('  '), { command: '', args: {}, positionals: [] });
+});
+
+/* ── naruszenia ────────────────────────────────────────────────────────────── */
+
+test('poprawne wywołania przechodzą bez ustaleń', () => {
+  const violations = generatorCallViolations({
+    calls: [
+      'init-state --name auth --path libs/apps/frontend-app/auth/state/src/lib',
+      'add-async-state-action --name auth.login --path libs/apps/frontend-app/auth/state/src/lib',
+      'add-api --name login --path libs/apps/frontend-app/auth/state/src/lib/auth/api',
+    ],
+    commands: TASK_COMMANDS,
+    writablePrefixes: SCOPE,
+  });
+
+  assert.deepEqual(violations, []);
+});
+
+test('polecenie stanu bez --path → ustalenie, bo domyślny katalog to korzeń drzewa', () => {
+  // Przypadek z planu: `init-state --name auth` bez ścieżki. Generator liczy
+  // `options.path || process.cwd()`, a `cwd` zadania to korzeń drzewa roboczego —
+  // pliki wylądowałyby poza biblioteką i wyszłoby to dopiero na bramce zakresu.
+  const violations = generatorCallViolations({
+    calls: ['init-state --name auth'],
+    commands: TASK_COMMANDS,
+    writablePrefixes: SCOPE,
+  });
+
+  assert.equal(violations.length, 1);
+  assert.equal(violations[0].kind, 'missing_argument');
+  assert.equal(violations[0].value, '--path');
+});
+
+test('polecenie poza katalogiem → ustalenie z listą dostępnych', () => {
+  const violations = generatorCallViolations({ calls: ['init-store --name auth'], commands: TASK_COMMANDS });
+
+  assert.equal(violations.length, 1, 'polecenia nieznanego nie osądzamy dalej — jego argumenty nie mają właściciela');
+  assert.equal(violations[0].kind, 'unknown_command');
+  assert.match(violations[0].note, /dostępne: init-state/);
+});
+
+test('argument nienależący do TEGO polecenia → ustalenie, choć inne polecenie go zna', () => {
+  const violations = generatorCallViolations({
+    calls: ['init-state --name auth --path libs/x --with-effect true'],
+    commands: TASK_COMMANDS,
+  });
+
+  assert.equal(violations.length, 1);
+  assert.equal(violations[0].kind, 'unknown_argument');
+  assert.equal(violations[0].value, '--with-effect');
+  assert.match(violations[0].note, /'init-state' nie zna tego argumentu/);
+});
+
+test('brak argumentu wymaganego → ustalenie, bo generator nie ruszy', () => {
+  const violations = generatorCallViolations({ calls: ['init-state --path libs/x'], commands: TASK_COMMANDS });
+
+  assert.equal(violations.length, 1);
+  assert.equal(violations[0].kind, 'missing_argument');
+  assert.equal(violations[0].value, '--name');
+});
+
+test('komponent bez ścieżki → ustalenie, bo nie ma gdzie powstać', () => {
+  const violations = generatorCallViolations({ calls: ['component'], commands: TASK_COMMANDS });
+
+  assert.equal(violations.length, 1);
+  assert.equal(violations[0].kind, 'missing_path');
+  assert.match(violations[0].note, /wymaga ścieżki/);
+});
+
+test('ścieżka poza zakresem zapisu zadania → ustalenie z zakresem w treści', () => {
+  const violations = generatorCallViolations({
+    calls: [
+      'init-state --name auth --path libs/shared/common/core/state/src/lib',
+      'component libs/apps/frontend-app/auth/ui/src/lib/badge/badge',
+    ],
+    commands: TASK_COMMANDS,
+    writablePrefixes: SCOPE,
+  });
+
+  assert.equal(violations.length, 2);
+  assert.ok(violations.every((violation) => violation.kind === 'path_outside'));
+  assert.match(violations[0].note, /libs\/apps\/frontend-app\/auth\/state/);
+});
+
+test('bez podanego zakresu ścieżek nie osądzamy — brak danych to nie naruszenie', () => {
+  const violations = generatorCallViolations({
+    calls: ['init-state --name auth --path libs/gdziekolwiek/src/lib'],
+    commands: TASK_COMMANDS,
+  });
+
+  assert.deepEqual(violations, []);
+});
+
+test('ścieżka zapisana separatorem systemowym i z przedrostkiem „./" liczy się tak samo', () => {
+  const violations = generatorCallViolations({
+    calls: ['init-state --name auth --path ./libs\\apps\\frontend-app\\auth\\state/src/lib'],
+    commands: TASK_COMMANDS,
+    writablePrefixes: SCOPE,
+  });
+
+  assert.deepEqual(violations, [], 'zapis ścieżki nie jest treścią sprawdzenia');
+});

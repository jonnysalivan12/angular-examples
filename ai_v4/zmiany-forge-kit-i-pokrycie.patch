+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+
+import { taskScopes } from './task-scope.js';
+
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Zakres zapisu = katalog biblioteki + wpisy planu spoza niego. Konwencja
+ * nazewnicza podstawiana, zeby derywacja katalogu nie schodzila po prefiks
+ * na dysk.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+const NAMING = { prefixByScope: { 'frontend-app': 'app', shared: 'wsp' } };
+
+function plan(overrides = {}) {
+  return {
+    story: '012-login',
+    binding: {
+      libraries: [
+        { name: 'frontend-app-auth-ui', status: 'new', structure: { scope: 'frontend-app', tag: 'ui', context: 'auth' } },
+        { name: 'shared-common-util', status: 'existing' },
+      ],
+    },
+    tasks: [
+      { id: 'T3', library: 'frontend-app-auth-ui', scope: ['libs/apps/frontend-app/auth/ui/src/lib/input'] },
+      { id: 'T4', library: 'frontend-app-auth-ui', scope: ['libs/apps/frontend-app/auth/ui/src/lib/login-form'] },
+      { id: 'T7', library: 'shared-common-util', scope: ['libs/shared/common/util/src/lib/dates'] },
+    ],
+    ...overrides,
+  };
+}
+
+test('taskScopes: zadanie pisze w calym katalogu swojej biblioteki', () => {
+  const scopes = taskScopes({ plan: plan(), taskId: 'T3', naming: NAMING });
+
+  assert.deepEqual(scopes, ['libs/apps/frontend-app/auth/ui']);
+});
+
+test('taskScopes: wpis planu z wnetrza biblioteki nie powiela katalogu', () => {
+  const p = plan();
+  p.tasks[0].scope = [
+    'libs/apps/frontend-app/auth/ui/src/lib/input',
+    'libs/apps/frontend-app/auth/ui/src/index.ts',
+    'libs/apps/frontend-app/auth/ui',
+  ];
+
+  assert.deepEqual(taskScopes({ plan: p, taskId: 'T3', naming: NAMING }), ['libs/apps/frontend-app/auth/ui']);
+});
+
+test('taskScopes: wpis SPOZA biblioteki zostaje — tam plan jest jedynym zrodlem', () => {
+  const p = plan();
+  p.tasks[0].scope = ['libs/apps/frontend-app/auth/ui/src/lib/input', 'apps/frontend-app/src/app/app.routes.ts'];
+
+  assert.deepEqual(taskScopes({ plan: p, taskId: 'T3', naming: NAMING }), [
+    'libs/apps/frontend-app/auth/ui',
+    'apps/frontend-app/src/app/app.routes.ts',
+  ]);
+});
+
+test('taskScopes: zla sciezka z planu nie przesuwa granicy zapisu', () => {
+  // Zakres z realnego przebiegu: powtórzony człon kontekstu wskazywał miejsce obok
+  // biblioteki. Wyliczony katalog obejmuje prawdziwe `src/lib`, więc koder pisze tam,
+  // gdzie testy biblioteki go widzą.
+  const p = plan();
+  p.tasks[0].scope = ['libs/apps/frontend-app/auth/ui/auth/src/**'];
+
+  assert.deepEqual(taskScopes({ plan: p, taskId: 'T3', naming: NAMING }), ['libs/apps/frontend-app/auth/ui']);
+});
+
+test('taskScopes: dwa zadania jednej biblioteki dostaja TEN SAM katalog — stad zachodzace zakresy', () => {
+  const t3 = taskScopes({ plan: plan(), taskId: 'T3', naming: NAMING });
+  const t4 = taskScopes({ plan: plan(), taskId: 'T4', naming: NAMING });
+
+  assert.deepEqual(t3, t4, 'harmonogram rozdzieli je na osobne fale');
+});
+
+test('taskScopes: biblioteka z zadeklarowanym katalogiem tez dostaje granice', () => {
+  const p = plan();
+  p.binding.libraries[1].declared = { path: 'libs/shared/common/util' };
+
+  assert.deepEqual(taskScopes({ plan: p, taskId: 'T7', naming: NAMING }), ['libs/shared/common/util']);
+});
+
+test('taskScopes: biblioteka bez struktury i bez deklaracji zostaje przy zakresie z planu', () => {
+  assert.deepEqual(taskScopes({ plan: plan(), taskId: 'T7', naming: NAMING }), ['libs/shared/common/util/src/lib/dates']);
+});

diff --git a/scripts/generators/task-commands.js b/scripts/generators/task-commands.js
new file mode 100644
index 0000000..bdd95d2
--- /dev/null
+++ b/scripts/generators/task-commands.js
@@ -0,0 +1,159 @@
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Polecenia generatorów, które wykonuje się WEWNĄTRZ biblioteki — jedno źródło
+ * ich powierzchni i sposobu uruchomienia.
+ *
+ * Scaffold samej biblioteki tu nie stoi: jego polecenie w całości derywuje się
+ * z pól strukturalnych planu (`scripts/generators/library/`) i wykonuje się przed
+ * pracą nad zadaniami. Tutaj są polecenia, które ktoś musi wywołać ręcznie, bo ich
+ * parametry są decyzją, a nie derywacją — stan, akcja, wywołanie API, komponent.
+ *
+ * `invocation` jest częścią katalogu, a nie wiedzą wołającego. Plan wymienia samo
+ * polecenie z argumentami (`init-state --name auth`), a pełną linię składa kod:
+ * inaczej sposób uruchomienia generatora byłby przepisywany z pamięci przy każdym
+ * planie i rozjechałby się z repozytorium przy pierwszej zmianie ścieżki skryptu.
+ *
+ * Nazwy argumentów stoją w formie CLI (z myślnikami) — tak, jak czyta je człowiek
+ * i jak stoją w planie.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+import { NGXS_COMMANDS } from './ngxs/command-catalog.js';
+
+/** Sposób uruchomienia generatora stanu — ścieżka skryptu należy do repozytorium. */
+const NGXS_INVOCATION = 'node scripts/generators/ngxs/index.js';
+
+/** Polecenie generatora komponentu Angulara; ścieżkę bierze pozycyjnie, bez flagi. */
+const COMPONENT_INVOCATION = 'npx nx g @nx/angular:component';
+
+/**
+ * Nazwa polecenia zakładającego komponent. Nie jest to nazwa polecenia nx —
+ * to nazwa, pod którą występuje w planie, tak samo krótka jak polecenia stanu.
+ */
+export const COMPONENT_COMMAND = 'component';
+
+/**
+ * Polecenia dostępne w zadaniu: nazwa → sposób uruchomienia i jego argumenty.
+ *
+ * Wpisy stanu pochodzą z katalogu generatora stanu, więc nowy argument tam wystarczy
+ * dopisać raz. Komponent ma argument POZYCYJNY (ścieżkę bez rozszerzenia), bo tak
+ * czyta go generator nx — pole `positional` mówi, czym ta wartość jest.
+ */
+export const TASK_COMMANDS = Object.freeze({
+  ...Object.fromEntries(
+    Object.entries(NGXS_COMMANDS).map(([command, entry]) => [
+      command,
+      Object.freeze({
+        invocation: NGXS_INVOCATION,
+        withCommandName: true,
+        // `--path` jest w katalogu CLI opcjonalny i słusznie: człowiek woła generator
+        // z katalogu, w którym pracuje, więc domyślne `process.cwd()` trafia tam, gdzie
+        // chciał. W zadaniu `cwd` to KORZEŃ drzewa roboczego, więc ta sama domyślna
+        // wartość jest zawsze zła — pliki lądują poza biblioteką zadania i wychodzi to
+        // dopiero na bramce zakresu, po turze kodera. Wymagalność zależy od tego, KTO
+        // woła, nie od polecenia, dlatego stoi tutaj, a nie w katalogu CLI.
+        required: Object.freeze({ ...entry.required, '--path': entry.optional['--path'] ?? '<katalog w bibliotece zadania>' }),
+        optional: Object.freeze(Object.fromEntries(
+          Object.entries(entry.optional).filter(([argument]) => argument !== '--path'),
+        )),
+        pathArguments: Object.freeze(['--path']),
+      }),
+    ]),
+  ),
+  [COMPONENT_COMMAND]: Object.freeze({
+    invocation: COMPONENT_INVOCATION,
+    withCommandName: false,
+    positional: '<katalog komponentu, np. libs/shared/common/ui/src/lib/icon>',
+    required: Object.freeze({}),
+    optional: Object.freeze({}),
+    pathArguments: Object.freeze([]),
+    // Generator nx bierze ścieżkę PLIKU bez rozszerzenia, a standard opisuje KATALOG
+    // komponentu (`…/src/lib/<nazwa>`) — dwa zapisy tej samej rzeczy. Plan podaje ten
+    // ze standardu, człon nazwy pliku dokłada `taskCommandLine`, tak samo jak dokłada
+    // samo polecenie. Bez tego ta sama nazwa miała dwie prawdy: krok deterministyczny
+    // zakładał `icon/icon.component.ts`, a wywołanie z planu `icon.component.ts`.
+    positionalToFilePath: componentFilePath,
+  }),
+});
+
+/**
+ * Ścieżka pliku komponentu z katalogu komponentu — powtórzenie ostatniego członu.
+ *
+ * Katalog już zakończony członem nazwy pliku zostaje bez zmian: `.../icon/icon` jest
+ * tym, czego generator oczekuje, i podanie go wprost nie może dać `icon/icon/icon`.
+ *
+ * @param {string} value — katalog albo gotowa ścieżka pliku
+ * @returns {string}
+ */
+export function componentFilePath(value) {
+  const normalized = String(value ?? '').replace(/\\/g, '/').replace(/\/+$/, '');
+  if (!normalized) return '';
+  const segments = normalized.split('/');
+  const last = segments[segments.length - 1];
+  const previous = segments[segments.length - 2];
+  return last === previous ? normalized : `${normalized}/${last}`;
+}
+
+/** Nazwy poleceń dostępnych w zadaniu, w kolejności katalogu. */
+export function taskCommandNames() {
+  return Object.keys(TASK_COMMANDS);
+}
+
+/**
+ * Wszystkie argumenty polecenia (wymagane + opcjonalne), w formie CLI.
+ * @param {string} command
+ * @returns {string[]} pusta lista dla polecenia poza katalogiem.
+ */
+export function taskCommandArguments(command) {
+  const entry = TASK_COMMANDS[command];
+  return entry ? [...Object.keys(entry.required), ...Object.keys(entry.optional)] : [];
+}
+
+/**
+ * Argumenty, bez których polecenie nie zrobi tego, po co się je woła.
+ * @param {string} command
+ * @returns {string[]}
+ */
+export function requiredTaskCommandArguments(command) {
+  const entry = TASK_COMMANDS[command];
+  return entry ? Object.keys(entry.required) : [];
+}
+
+/**
+ * Pełna linia do wykonania w drzewie roboczym.
+ *
+ * Polecenie z katalogu, argumenty od wołającego — składanie należy tutaj, bo
+ * sposób uruchomienia jest faktem o repozytorium, nie treścią planu.
+ *
+ * @param {string} call — polecenie z argumentami, tak jak stoi w planie
+ * @returns {string} pusta linia dla polecenia poza katalogiem
+ */
+export function taskCommandLine(call) {
+  const trimmed = String(call ?? '').trim();
+  if (!trimmed) return '';
+
+  const [command, ...rest] = trimmed.split(/\s+/);
+  const entry = TASK_COMMANDS[command];
+  if (!entry) return '';
+
+  // Wartość pozycyjna bywa zapisana inaczej, niż oczekuje jej generator — wtedy
+  // katalog przekłada się na ścieżkę pliku tutaj, nie w treści planu.
+  const tokens = entry.positionalToFilePath
+    ? rest.map((token) => (token.startsWith('--') ? token : entry.positionalToFilePath(token)))
+    : rest;
+
+  const tail = tokens.join(' ');
+  const head = entry.withCommandName ? `${entry.invocation} ${command}` : entry.invocation;
+  return tail ? `${head} ${tail}` : head;
+}
+
+/**
+ * Linia użycia polecenia: wymagane gołe, opcjonalne w nawiasach kwadratowych.
+ * @param {string} command
+ * @returns {string}
+ */
+export function taskCommandUsage(command) {
+  const entry = TASK_COMMANDS[command];
+  if (!entry) return '';
+  const required = Object.entries(entry.required).map(([argument, hint]) => `${argument} ${hint}`);
+  const optional = Object.entries(entry.optional).map(([argument, hint]) => `[${argument} ${hint}]`);
+  return [command, ...(entry.positional ? [entry.positional] : []), ...required, ...optional].join(' ');
+}

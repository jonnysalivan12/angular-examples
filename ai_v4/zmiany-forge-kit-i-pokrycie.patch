index 0000000..96a9313
--- /dev/null
+++ b/.ai-agentic-workspace/workflows/forge-kit/orchestrator/library-description.js
@@ -0,0 +1,191 @@
+/* eslint-disable @nx/enforce-module-boundaries */
+
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Opis nowej biblioteki — krok po falach, na gałęzi scalającej.
+ *
+ * Szkielet zakładany przed falami niesie README wyprowadzone z pól semantycznych:
+ * warstwa, kontekst, zakres. To wszystko, co wtedy wiadomo — biblioteka jest pusta,
+ * więc nie ma czego opisywać. Reguła lintu `library-readme` wymaga jednak pliku od
+ * chwili powstania projektu, stąd szkielet.
+ *
+ * Ten krok domyka sprawę na drugim końcu. Biblioteka ma już kod, przeszła bramki
+ * diffu i weryfikację, a jej powierzchnia publiczna jest zamknięta — dopiero teraz
+ * da się powiedzieć, za co odpowiada. Model dostaje tę powierzchnię i pisze opis,
+ * a README powstaje ponownie, ze statusem `active`.
+ *
+ * Krok jest MIĘKKI: biblioteka bez opisu zostaje ze szkieletem i jest zgłaszana jako
+ * ustalenie przebiegu. Twarde przerwanie kosztowałoby całą pracę fal za zdanie prozy.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+import path from 'node:path';
+
+import { buildLibraryReadme } from '../../../../scripts/generators/library/readme.js';
+import { deriveLibraryNaming } from '../../../../scripts/generators/utils/library-naming.js';
+
+/** Barrel biblioteki — jedyny plik, przez który widać ją z zewnątrz. */
+const BARREL = 'src/index.ts';
+
+/** Katalog kodu biblioteki. */
+const SOURCE_DIR = 'src/lib';
+
+/**
+ * Powierzchnia publiczna biblioteki: treść barrela i lista plików kodu.
+ *
+ * Barrel niesie to, co biblioteka udostępnia, a nazwy plików — z czego się składa.
+ * Razem wystarczają na zdanie o odpowiedzialności i mieszczą się w jednym pytaniu,
+ * więc nie podajemy modelowi całych źródeł.
+ *
+ * @param {object} args
+ * @param {string} args.directory — katalog biblioteki względem korzenia drzewa
+ * @param {(relative: string) => string|null} args.readFile — null gdy pliku nie ma
+ * @param {(relative: string) => string[]} args.listFiles — ścieżki plików pod katalogiem
+ * @returns {{barrel: string, files: string[]}}
+ */
+export function librarySurface({ directory, readFile, listFiles }) {
+  const barrel = readFile(`${directory}/${BARREL}`) ?? '';
+  const files = listFiles(`${directory}/${SOURCE_DIR}`)
+    .filter((file) => !/\.(spec|stories)\.[jt]sx?$/.test(file))
+    .map((file) => file.split(/[\\/]/).pop())
+    .sort();
+  return { barrel: barrel.trim(), files };
+}
+
+/**
+ * Pytanie o opis. Zakres zadania jest wąski celowo — model ma napisać zdanie
+ * o odpowiedzialności, a nie streścić implementację.
+ *
+ * @param {object} args
+ * @param {string} args.name
+ * @param {string} [args.type]
+ * @param {string} [args.context]
+ * @param {{barrel: string, files: string[]}} args.surface
+ * @returns {string}
+ */
+export function buildDescriptionPrompt({ name, type = '', context = '', surface }) {
+  return [
+    `Biblioteka \`${name}\` jest gotowa. Napisz jej opis do README.`,
+    '',
+    `Warstwa: \`${type || '(nieokreślona)'}\`. Kontekst: \`${context || '(nieokreślony)'}\`.`,
+    '',
+    'Powierzchnia publiczna (barrel):',
+    '```ts',
+    surface.barrel || '(pusty)',
+    '```',
+    '',
+    `Pliki kodu: ${surface.files.join(', ') || '(brak)'}`,
+    '',
+    'Zasady odpowiedzi:',
+    '- 2–4 zdania o tym, ZA CO biblioteka odpowiada i kiedy się po nią sięga;',
+    '- bez wyliczania nazw plików i bez powtarzania warstwy ani kontekstu;',
+    '- jeden akapit, bez nagłówków, bez listy, bez bloku kodu;',
+    '- ZERO tekstu poza samym opisem — pierwsze słowo odpowiedzi jest pierwszym słowem opisu.',
+  ].join('\n');
+}
+
+/** Początek, po którym walidator uznaje opis za wypełnienie szablonu. */
+const PLACEHOLDER_START = /^(\[|<|TODO|TBD|opis|description)/i;
+
+/** Najkrótszy opis, który jeszcze coś mówi — poniżej to echo nazwy biblioteki. */
+const MIN_DESCRIPTION_LENGTH = 40;
+
+/**
+ * Wyciąga opis z odpowiedzi modelu i orzeka, czy nadaje się do README.
+ *
+ * Odpowiedź składamy do JEDNEJ linii, bo `description` w bloku metadanych jest polem
+ * jednoliniowym; łamanie wierszy z odpowiedzi rozjechałoby YAML.
+ *
+ * @param {string} stdout
+ * @returns {{ok: true, description: string} | {ok: false, note: string}}
+ */
+export function parseDescription(stdout) {
+  const text = String(stdout ?? '')
+    .replace(/```[\s\S]*?```/g, ' ')
+    .replace(/^\s*#{1,6}\s+.*$/gm, ' ')
+    .replace(/\s+/g, ' ')
+    .trim();
+
+  if (text === '') return { ok: false, note: 'model nie zwrócił opisu' };
+  if (text.length < MIN_DESCRIPTION_LENGTH) return { ok: false, note: `opis za krótki (${text.length} znaków)` };
+  if (PLACEHOLDER_START.test(text)) return { ok: false, note: `opis zaczyna się jak wypełnienie szablonu: „${text.slice(0, 40)}"` };
+  return { ok: true, description: text };
+}
+
+/**
+ * Biblioteki planu, które ten przebieg założył — te i tylko te dostają opis.
+ * Biblioteka istniejąca ma już swój, a story go nie zmienia.
+ *
+ * @param {object} plan
+ * @param {object} [naming]
+ * @returns {Array<{name: string, directory: string, type: string, context: string, scope: string}>}
+ */
+export function newLibraryDescriptions(plan, naming = {}) {
+  const out = [];
+  for (const library of plan?.binding?.libraries ?? []) {
+    if (library.status !== 'new' || !library.structure) continue;
+    const canonical = deriveLibraryNaming(library.structure, naming);
+    if (!canonical) continue;
+    const structure = library.structure;
+    out.push({
+      name: canonical.name,
+      directory: canonical.directory,
+      type: String(structure.type ?? structure.tag ?? ''),
+      context: String(structure.context ?? structure.domain ?? ''),
+      scope: String(structure.scope ?? ''),
+    });
+  }
+  return out;
+}
+
+/**
+ * Pisze README z opisem właściwym dla każdej biblioteki założonej w tym przebiegu.
+ *
+ * @param {object} args
+ * @param {object} args.plan — znormalizowany plan
+ * @param {string} args.integrationPath — drzewo scalające z kompletem pracy story
+ * @param {(prompt: string) => Promise<string>} args.ask — port sesji modelu
+ * @param {(relative: string) => string|null} args.readFile
+ * @param {(relative: string) => string[]} args.listFiles
+ * @param {(relative: string, text: string) => void} args.writeText
+ * @param {object} [args.naming]
+ * @param {(message: string) => void} [args.onLog]
+ * @returns {Promise<{described: string[], findings: Array<{severity: string, message: string}>}>}
+ */
+export async function describePlanLibraries({
+  plan, integrationPath, ask, readFile, listFiles, writeText, naming = {}, onLog = () => {},
+}) {
+  const libraries = newLibraryDescriptions(plan, naming);
+  const described = [];
+  const findings = [];
+
+  for (const library of libraries) {
+    const surface = librarySurface({ directory: library.directory, readFile, listFiles });
+    if (surface.barrel === '' && surface.files.length === 0) {
+      findings.push({ severity: 'warn', message: `biblioteka '${library.name}' jest pusta po falach — opis zostaje szkieletem` });
+      continue;
+    }
+
+    let parsed;
+    try {
+      parsed = parseDescription(await ask(buildDescriptionPrompt({ ...library, surface })));
+    } catch (error) {
+      parsed = { ok: false, note: `sesja opisu padła: ${error.message}` };
+    }
+
+    if (!parsed.ok) {
+      findings.push({ severity: 'warn', message: `README '${library.name}' zostaje szkieletem — ${parsed.note}` });
+      continue;
+    }
+
+    writeText(
+      path.join(integrationPath, library.directory, 'README.md'),
+      buildLibraryReadme({ ...library, description: parsed.description }),
+    );
+    described.push(library.name);
+    onLog(`README '${library.name}': opis napisany po weryfikacji`);
+  }
+
+  if (libraries.length > 0 && described.length === 0) {
+    onLog(`README: żadna z ${libraries.length} bibliotek nie dostała opisu — zostają szkielety`);
+  }
+  return { described, findings };
+}

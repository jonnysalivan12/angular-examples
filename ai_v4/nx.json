{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "workspaceLayout": {
    "appsDir": "apps",
    "libsDir": "libs"
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/test-setup.[jt]s",
      "!{projectRoot}/**/*.stories.@(js|jsx|ts|tsx|mdx)",
      "!{projectRoot}/.storybook/**/*",
      "!{projectRoot}/tsconfig.storybook.json"
    ],
    "sharedGlobals": []
  },
  "targetDefaults": {
    "@angular/build:application": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "lint": {
      "cache": true,
      "//": "Klucz to NAZWA celu, nie wykonawca: część projektów dostaje cel lintu z wtyczki wnioskującej, a ta ma wpisane własne wejścia. Wpis po wykonawcy omijałby je, więc zmiana reguły nie unieważniałaby ich pamięci podręcznej — i lint chodziłby po starej regule, nie mówiąc o tym słowa.",
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/eslint.dep-constraints.mjs",
        "{workspaceRoot}/scripts/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ]
    },
    "@nx/esbuild:esbuild": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "@nx/js:tsc": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "@nx/vitest:test": {
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "@nx/angular:ng-packagr-lite": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "@nx/angular:unit-test": {
      "cache": true,
      "inputs": ["default", "^production"]
    },
    "build-storybook": {
      "cache": true,
      "inputs": ["default", "^production", "{projectRoot}/.storybook/**/*", "{projectRoot}/tsconfig.storybook.json"]
    }
  },
  "release": {
    "projects": ["api"],
    "projectsRelationship": "independent",
    "docker": {
      "skipVersionActions": true
    }
  },
  "plugins": [
    {
      "plugin": "@nx/playwright/plugin",
      "options": {
        "targetName": "e2e"
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/docker",
      "options": {
        "buildTarget": "docker:build",
        "runTarget": "docker:run"
      }
    },
    {
      "plugin": "@nx/vite/plugin",
      "//": "Wnioskowanie ograniczone do katalogów, w których stoją projekty. Konfiguracja narzędzia postawiona w korzeniu robi z korzenia projekt, a taki projekt dostaje cel `test` powtarzający bieg wszystkich pozostałych oraz cel `typecheck` wskazujący na tsconfig.base.json — plik będący bazą do dziedziczenia, nie konfiguracją kompilacji: nie deklaruje typów biegacza testów, a nie wyklucza plików *.spec.ts, więc sprawdzenie typów przewracało się na `describe` i `expect`. Właściwy typecheck ma każdy projekt osobno (tsconfig.lib.json / tsconfig.app.json). LUSTRO: te same katalogi co PRODUCT_BASES w scripts/config/workspace.js.",
      "include": ["apps/**", "libs/**"],
      "options": {
        "buildTargetName": "build",
        "serveTargetName": "serve",
        "devTargetName": "dev",
        "previewTargetName": "preview",
        "serveStaticTargetName": "serve-static",
        "typecheckTargetName": "typecheck",
        "buildDepsTargetName": "build-deps",
        "watchDepsTargetName": "watch-deps"
      }
    },
    {
      "plugin": "@nx/vitest",
      "//": "Zasięg jak wyżej — korzeń nie jest projektem.",
      "include": ["apps/**", "libs/**"],
      "options": {
        "testTargetName": "vite:test"
      }
    }
  ],
  "generators": {
    "// lustro": "Który typ biblioteki idzie którą kolekcją rozstrzyga scripts/config/library.js (JS_LIBRARY_TYPES). Zmiana domyślnych poniżej wymaga sprawdzenia bramki verifyGeneratedLibrary w scripts/generators/library/index.js — ona patrzy na produkt i odrzuca bibliotekę z targetem build.",
    "@nx/angular:application": {
      "e2eTestRunner": "playwright",
      "linter": "eslint",
      "style": "scss",
      "unitTestRunner": "vitest-analog"
    },
    "@nx/angular:library": {
      "linter": "eslint",
      "unitTestRunner": "vitest-analog",
      "buildable": false,
      "publishable": false
    },
    "@nx/js:library": {
      "bundler": "none",
      "publishable": false
    },
    "@nx/angular:component": {
      "style": "scss",
      "type": "component",
      "changeDetection": "OnPush",
      "skipTests": true,
      "displayBlock": true,
      "exportDefault": false
    }
  },
  "analytics": false,
  "neverConnectToCloud": true
}

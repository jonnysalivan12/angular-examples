index 0000000..6bf1a19
--- /dev/null
+++ b/.ai-agentic-workspace/workflows/forge-kit/config/worktree-root.js
@@ -0,0 +1,136 @@
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Wybór korzenia drzew roboczych — jedyne miejsce rozstrzygające, na którym
+ * woluminie stanie warsztat kodera.
+ *
+ * Drzewo MUSI leżeć na tym samym woluminie co pakiety, z których korzysta.
+ * `node_modules` drzewa to złączenia do pakietów repozytorium, a esbuild rozwija
+ * złączenie do ścieżki REALNEJ. Wtyczka `angular-css-resource` robi na tej ścieżce
+ * obieg `relative` → `join` względem katalogu roboczego budowania
+ * (`@angular/build`, `css-resource-plugin.js`, linie 99 i 104). Obieg jest
+ * bezstratny wyłącznie w obrębie jednego woluminu:
+ *
+ *   path.relative('C:\\praca', 'D:\\repo\\node_modules\\font.woff2')
+ *     → 'D:\\repo\\node_modules\\font.woff2'   (bez zmian — nie da się zrelatywizować)
+ *   path.join('C:\\praca', 'D:\\repo\\node_modules\\font.woff2')
+ *     → 'C:\\praca\\D:\\repo\\node_modules\\font.woff2'   (ścieżka, której nie ma)
+ *
+ * Efekt: `build:production` w drzewie roboczym pada na ENOENT przy foncie
+ * biblioteki UI, a to samo budowanie w repozytorium jest zielone. Sprawdzenie
+ * wstępne bazy przewraca się wtedy na kodzie, w którym nie ma błędu.
+ *
+ * Dlatego domyślne miejsce jest zaczepione o SAMO REPOZYTORIUM, a nie o katalog
+ * tymczasowy systemu. Katalog tymczasowy bywa na innym dysku niż repozytorium
+ * (na Windows to zwykły układ, nie egzotyka), więc zestaw działałby na jednej
+ * maszynie i padał na drugiej z powodu, którego nie widać w kodzie. Zaczepienie
+ * o repozytorium daje ten sam wolumin z definicji i jedno zachowanie wszędzie.
+ *
+ * Miejscem jest katalog SIOSTRZANY repozytorium, nie katalog w jego środku.
+ * Drzewo jest pełną kopią repozytorium, więc w środku wpada pod każdy wzorzec
+ * `**` i narzędzia widzą drugi komplet projektów o tych samych nazwach: nx
+ * przewraca się na niejednoznacznej nazwie, vitest odmawia startu („Project name
+ * … is not unique"), git pokazuje warsztat jako zmianę do zacommitowania.
+ * Da się to wyciszyć wpisem per narzędzie, ale każde następne narzędzie
+ * przeszukujące repozytorium wymagałoby kolejnego. Katalog obok nie wymaga
+ * żadnego — nic w repozytorium nie ma jak go zobaczyć.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+import fs from 'node:fs';
+import path from 'node:path';
+
+/** Nazwa katalogu z drzewami — ta sama niezależnie od tego, gdzie stanie. */
+export const WORKTREE_DIR_NAME = 'forge-kit-worktrees';
+
+/** Zmienna środowiskowa wymuszająca położenie drzew. */
+export const WORKTREE_ROOT_ENV = 'FORGE_KIT_WORKTREE_ROOT';
+
+/**
+ * Wolumin ścieżki: litera dysku na Windows, `/` na systemach POSIX, `\\serwer\udział`
+ * dla ścieżek sieciowych. Porównanie bez wielkości liter, bo Windows jej nie rozróżnia.
+ * @param {string} target
+ * @returns {string}
+ */
+export function volumeOf(target) {
+  return path.parse(path.resolve(target)).root.toLowerCase();
+}
+
+/** Czy obie ścieżki leżą na tym samym woluminie. */
+export function sameVolume(first, second) {
+  return volumeOf(first) === volumeOf(second);
+}
+
+/** Czy `target` leży wewnątrz `parent` (albo nim jest). */
+function isInside(target, parent) {
+  const relative = path.relative(parent, target);
+  return relative === '' || (!relative.startsWith('..') && !path.isAbsolute(relative));
+}
+
+/** Ścieżka realna albo `null`, gdy celu nie ma. */
+function realPath(target, fsPort) {
+  try {
+    return fsPort.realpathSync(target);
+  } catch {
+    return null;
+  }
+}
+
+/**
+ * Katalog pakietów widziany tak, jak widzi go esbuild — po rozwinięciu wszystkich
+ * dowiązań. Repozytorium osiągane przez złączenie z innego dysku ma inny wolumin
+ * niż jego ścieżka zapisana w konfiguracji, więc porównanie musi iść po realnej.
+ *
+ * Punktem odniesienia jest katalog `node_modules`, nie korzeń repozytorium: to
+ * on bywa dowiązaniem i to jego ścieżka trafia do wtyczki. Bez niego (świeży
+ * klon, testy) zostaje realna ścieżka korzenia.
+ *
+ * @param {string} repoRoot
+ * @param {object} [fsPort]
+ * @returns {string}
+ */
+export function packagesAnchor(repoRoot, fsPort = fs) {
+  const nodeModules = realPath(path.join(repoRoot, 'node_modules'), fsPort);
+  if (nodeModules) return path.dirname(nodeModules);
+  return realPath(repoRoot, fsPort) ?? path.resolve(repoRoot);
+}
+
+/**
+ * Korzeń drzew roboczych dla tego repozytorium: katalog `forge-kit-worktrees`
+ * obok repozytorium.
+ *
+ * Wychodzi od REALNEJ ścieżki pakietów, nie od ścieżki zapisanej w konfiguracji.
+ * Repozytorium osiągane przez złączenie z innego dysku ma obie na różnych
+ * woluminach, a esbuild widzi tę realną — drzewo musi stanąć tam, gdzie on patrzy.
+ *
+ * Wymuszenie zmienną środowiskową jest sprawdzane, nie przyjmowane na słowo:
+ * zły wolumin albo miejsce wewnątrz repozytorium wywraca bieg TU, zamiast oddać
+ * drzewo, w którym coś pada z powodu bez związku z kodem.
+ *
+ * @param {object} args
+ * @param {string} args.repoRoot
+ * @param {Record<string, string|undefined>} [args.env]
+ * @param {object} [args.fsPort]
+ * @returns {{root: string, reason: string}}
+ */
+export function resolveWorktreeRoot({ repoRoot, env = process.env, fsPort = fs }) {
+  const anchor = packagesAnchor(repoRoot, fsPort);
+  const forced = env[WORKTREE_ROOT_ENV];
+
+  if (forced) {
+    const root = path.resolve(forced);
+    if (!sameVolume(root, anchor)) {
+      throw new Error(
+        `${WORKTREE_ROOT_ENV}=${root} leży na woluminie ${volumeOf(root)}, a pakiety na ${volumeOf(anchor)} (${anchor}).` +
+        ' Drzewo robocze na innym woluminie niż node_modules przewraca build:production na ENOENT — wskaż katalog na tym samym woluminie.',
+      );
+    }
+    if (isInside(root, anchor)) {
+      throw new Error(
+        `${WORKTREE_ROOT_ENV}=${root} leży wewnątrz repozytorium (${anchor}).` +
+        ' Drzewo w środku dokłada nx drugi komplet projektów o tych samych nazwach, a vitest odmawia startu' +
+        ' na niejednoznacznej nazwie projektu — wskaż katalog poza repozytorium.',
+      );
+    }
+    return { root, reason: `wymuszone przez ${WORKTREE_ROOT_ENV}` };
+  }
+
+  return { root: path.join(path.dirname(anchor), WORKTREE_DIR_NAME), reason: 'obok repozytorium' };
+}
diff --git a/.ai-agentic-workspace/workflows/forge-kit/config/worktree-root.test.js b/.ai-agentic-workspace/workflows/forge-kit/config/worktree-root.test.js

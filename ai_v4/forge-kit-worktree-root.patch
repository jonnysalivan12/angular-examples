index 0000000..8d75452
--- /dev/null
+++ b/.ai-agentic-workspace/workflows/forge-kit/config/worktree-root.test.js
@@ -0,0 +1,114 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import path from 'node:path';
+
+import { resolveWorktreeRoot, packagesAnchor, sameVolume, volumeOf, WORKTREE_ROOT_ENV } from './worktree-root.js';
+
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Wybor woluminu dla drzew roboczych. Dostep do plikow podstawiany atrapa, bo
+ * test opisuje uklady dyskow, ktorych na maszynie biegu nie ma.
+ *
+ * Litery dyskow maja znaczenie tylko na Windows — na POSIX kazda sciezka ma ten
+ * sam korzen, wiec przypadki miedzydyskowe biegna wylacznie tam.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+const WINDOWS = path.sep === '\\';
+
+/** Atrapa: `realpathSync` zwraca podstawienie z mapy, brak wpisu = sciezka bez zmian. */
+function fsWithLinks(links = {}, missing = []) {
+  return {
+    realpathSync(target) {
+      if (missing.includes(target)) throw new Error(`ENOENT: ${target}`);
+      return links[target] ?? target;
+    },
+  };
+}
+
+test('volumeOf: korzen sciezki bez wzgledu na wielkosc liter', () => {
+  assert.equal(volumeOf('/a/b'), volumeOf('/c/d'));
+  if (!WINDOWS) return;
+  assert.equal(volumeOf('D:\\repo'), volumeOf('d:\\inne\\miejsce'));
+  assert.notEqual(volumeOf('C:\\Temp'), volumeOf('D:\\repo'));
+  assert.equal(sameVolume('D:\\a', 'D:\\b'), true);
+  assert.equal(sameVolume('C:\\a', 'D:\\b'), false);
+});
+
+test('packagesAnchor: punktem odniesienia jest realna sciezka node_modules', () => {
+  const repoRoot = path.resolve('/widoczne/repo');
+  const nodeModules = path.join(repoRoot, 'node_modules');
+  const realRepo = path.resolve('/realne/repo');
+
+  const anchor = packagesAnchor(repoRoot, fsWithLinks({ [nodeModules]: path.join(realRepo, 'node_modules') }));
+  assert.equal(anchor, realRepo, 'zlaczenie node_modules rozwiniete do miejsca docelowego');
+});
+
+test('packagesAnchor: bez node_modules zostaje realna sciezka korzenia', () => {
+  const repoRoot = path.resolve('/widoczne/repo');
+  const nodeModules = path.join(repoRoot, 'node_modules');
+  const realRepo = path.resolve('/realne/repo');
+
+  const anchor = packagesAnchor(repoRoot, fsWithLinks({ [repoRoot]: realRepo }, [nodeModules]));
+  assert.equal(anchor, realRepo);
+});
+
+test('resolveWorktreeRoot: domyslnie katalog obok repozytorium', () => {
+  const repoRoot = path.resolve('/praca/repo');
+
+  const { root, reason } = resolveWorktreeRoot({ repoRoot, env: {}, fsPort: fsWithLinks() });
+  assert.equal(root, path.resolve('/praca/forge-kit-worktrees'));
+  assert.equal(reason, 'obok repozytorium');
+});
+
+test('resolveWorktreeRoot: miejsce nie zalezy od katalogu tymczasowego ani od dysku systemowego', { skip: !WINDOWS }, () => {
+  const { root } = resolveWorktreeRoot({ repoRoot: 'D:\\Workspace\\repo', env: {}, fsPort: fsWithLinks() });
+
+  assert.equal(root, 'D:\\Workspace\\forge-kit-worktrees');
+  assert.equal(volumeOf(root), volumeOf('D:\\Workspace\\repo'), 'drzewa na woluminie pakietow');
+});
+
+test('resolveWorktreeRoot: miejsce liczy sie po rozwinieciu zlaczen, nie po zapisanej sciezce', { skip: !WINDOWS }, () => {
+  // Repozytorium widziane jako C:, w rzeczywistosci na D: — esbuild zobaczy sciezke
+  // realna, wiec drzewo musi stanac obok NIEJ, nie obok widocznej.
+  const fsPort = fsWithLinks({ 'C:\\Workspace\\repo\\node_modules': 'D:\\Realne\\repo\\node_modules' });
+
+  const { root } = resolveWorktreeRoot({ repoRoot: 'C:\\Workspace\\repo', env: {}, fsPort });
+  assert.equal(root, 'D:\\Realne\\forge-kit-worktrees');
+});
+
+test('resolveWorktreeRoot: wymuszenie ze srodowiska ma pierwszenstwo', () => {
+  const repoRoot = path.resolve('/praca/repo');
+  const forced = path.resolve('/praca/warsztat');
+
+  const { root, reason } = resolveWorktreeRoot({
+    repoRoot,
+    env: { [WORKTREE_ROOT_ENV]: forced },
+    fsPort: fsWithLinks(),
+  });
+
+  assert.equal(root, forced);
+  assert.match(reason, new RegExp(WORKTREE_ROOT_ENV));
+});
+
+test('resolveWorktreeRoot: wymuszenie na zlym woluminie zatrzymuje bieg', { skip: !WINDOWS }, () => {
+  assert.throws(
+    () => resolveWorktreeRoot({
+      repoRoot: 'D:\\Workspace\\repo',
+      env: { [WORKTREE_ROOT_ENV]: 'C:\\Temp\\warsztat' },
+      fsPort: fsWithLinks(),
+    }),
+    /woluminie/,
+  );
+});
+
+test('resolveWorktreeRoot: wymuszenie wewnatrz repozytorium zatrzymuje bieg', () => {
+  // Drzewo jest pelna kopia repozytorium, wiec w srodku kazdy projekt istnieje dwa razy.
+  const repoRoot = path.resolve('/praca/repo');
+  assert.throws(
+    () => resolveWorktreeRoot({
+      repoRoot,
+      env: { [WORKTREE_ROOT_ENV]: path.join(repoRoot, '.warsztat') },
+      fsPort: fsWithLinks(),
+    }),
+    /wewnątrz repozytorium/,
+  );
+});

+/**
+ * Wpisy z wyjścia `git worktree list --porcelain` — ścieżka i gałąź, którą drzewo
+ * wypożyczyło. Drzewo odpięte od gałęzi ma `branch: null`.
+ * @param {string} output
+ * @returns {Array<{path: string, branch: string|null}>}
+ */
+export function parseWorktreeEntries(output) {
+  const entries = [];
+  for (const line of String(output ?? '').split('\n')) {
+    // Nowy wpis zaczyna linia `worktree`, reszta pól opisuje wpis otwarty wcześniej.
+    // Podział po liniach, nie po pustej linii: pusta linia jest separatorem formatu,
+    // ale wyjście bywa sklejone i wtedy podział po niej gubiłby wszystkie wpisy poza pierwszym.
+    const worktree = line.match(/^worktree (.+)$/);
+    if (worktree) {
+      entries.push({ path: worktree[1].trim(), branch: null });
+      continue;
+    }
+    const branch = line.match(/^branch refs\/heads\/(.+)$/);
+    if (branch && entries.length > 0) entries[entries.length - 1].branch = branch[1].trim();
+  }
+  return entries;
+}

+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+
+import { componentShellTargets, scaffoldComponentShells } from './component-shells.js';
+
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Szkielety komponentow: sciezka pewna dopiero wtedy, gdy makieta i zakres
+ * zadania wskazuja to samo; istniejacy komponent nietkniety.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+const UI_SCOPE = 'libs/apps/frontend-app/auth/ui/src/lib/login-form/**';
+
+const PLAN = Object.freeze({
+  story: '012-login',
+  tasks: [
+    { id: 'T1', library: 'frontend-app-auth-ui', scope: [UI_SCOPE] },
+    { id: 'T2', library: 'frontend-app-auth-state', scope: ['libs/apps/frontend-app/auth/state/src/lib'] },
+  ],
+});
+
+const FRAMES = Object.freeze([{ ir: { components_to_build: [{ name: 'LoginForm' }, { name: 'Badge' }] } }]);
+
+test('componentShellTargets: nazwa z makiety spotyka katalog z zakresu → sciezka generatora', () => {
+  const targets = componentShellTargets({ plan: PLAN, designFramesByTask: { T1: FRAMES } });
+
+  assert.deepEqual(targets, [{
+    taskId: 'T1',
+    componentName: 'LoginForm',
+    directory: 'libs/apps/frontend-app/auth/ui/src/lib/login-form',
+    path: 'libs/apps/frontend-app/auth/ui/src/lib/login-form/login-form',
+  }]);
+});
+
+test('componentShellTargets: nazwa z makiety bez zakresu zadania NIE dostaje sciezki', () => {
+  const targets = componentShellTargets({ plan: PLAN, designFramesByTask: { T1: FRAMES } });
+
+  assert.deepEqual(targets.map((target) => target.componentName), ['LoginForm'], 'zgadniety katalog to plik w zlej bibliotece');
+});
+
+test('componentShellTargets: zadanie bez ram makiety pomijane', () => {
+  assert.deepEqual(componentShellTargets({ plan: PLAN, designFramesByTask: {} }), []);
+  assert.deepEqual(componentShellTargets({ plan: PLAN, designFramesByTask: { T2: FRAMES } }), [], 'zakres bez katalogu komponentu');
+});
+
+test('componentShellTargets: nazwa wieloslowna dopasowana po zapisie kebab', () => {
+  const plan = { tasks: [{ id: 'T1', scope: ['libs/shared/common/ui/src/lib/button-group/**'] }] };
+  const frames = [{ ir: { components_to_build: [{ name: 'ButtonGroup' }] } }];
+
+  assert.deepEqual(componentShellTargets({ plan, designFramesByTask: { T1: frames } }).map((entry) => entry.componentName), ['ButtonGroup']);
+});
+
+test('componentShellTargets: ta sama sciezka z dwoch zadan wchodzi raz', () => {
+  const plan = { tasks: [{ id: 'T1', scope: [UI_SCOPE] }, { id: 'T2', scope: [UI_SCOPE] }] };
+
+  assert.equal(componentShellTargets({ plan, designFramesByTask: { T1: FRAMES, T2: FRAMES } }).length, 1);
+});
+
+/** Powloka zapisujaca polecenia; `creates` decyduje, czy plik pojawia sie po generacji. */
+function fakeShell({ existing = [], failFor = [], creates = true } = {}) {
+  const files = new Set(existing);
+  const commands = [];
+
+  return {
+    commands,
+    exists: (path) => files.has(path),
+    execCommand: async (command) => {
+      commands.push(command);
+      const path = command.split(' ').pop();
+      if (failFor.includes(path)) return { exitCode: 1, output: 'nx: nie udalo sie' };
+      if (creates) files.add(`${path}.component.ts`);
+      return { exitCode: 0, output: '' };
+    },
+  };
+}
+
+test('scaffoldComponentShells: brak celow → nic nie jest wolane', async () => {
+  const shell = fakeShell();
+  const result = await scaffoldComponentShells({ targets: [], ...shell });
+
+  assert.equal(result.ok, true);
+  assert.deepEqual(shell.commands, []);
+});
+
+test('scaffoldComponentShells: komponent zakladany kanoniczna komenda i weryfikowany', async () => {
+  const shell = fakeShell();
+  const targets = componentShellTargets({ plan: PLAN, designFramesByTask: { T1: FRAMES } });
+
+  const result = await scaffoldComponentShells({ targets, ...shell });
+
+  assert.equal(result.ok, true, JSON.stringify(result.findings));
+  assert.deepEqual(shell.commands, ['npx nx g @nx/angular:component libs/apps/frontend-app/auth/ui/src/lib/login-form/login-form']);
+  assert.deepEqual(result.shells, [{
+    name: 'LoginForm',
+    path: 'libs/apps/frontend-app/auth/ui/src/lib/login-form/login-form',
+    skipped: false,
+    ok: true,
+  }]);
+});
+
+test('scaffoldComponentShells: istniejacy komponent pomijany, nie nadpisywany', async () => {
+  const targets = componentShellTargets({ plan: PLAN, designFramesByTask: { T1: FRAMES } });
+  const shell = fakeShell({ existing: [`${targets[0].path}.component.ts`] });
+
+  const result = await scaffoldComponentShells({ targets, ...shell });
+
+  assert.equal(result.ok, true);
+  assert.equal(result.shells[0].skipped, true);
+  assert.deepEqual(shell.commands, [], 'generator nadpisalby prace, ktora zastal');
+});
+
+test('scaffoldComponentShells: blad generatora → czerwono z wyjsciem polecenia', async () => {
+  const targets = componentShellTargets({ plan: PLAN, designFramesByTask: { T1: FRAMES } });
+  const shell = fakeShell({ failFor: [targets[0].path] });
+
+  const result = await scaffoldComponentShells({ targets, ...shell });
+
+  assert.equal(result.ok, false);
+  assert.match(result.findings[0].message, /kodem 1/);
+  assert.match(result.findings[0].message, /nie udalo sie/);
+});
+
+test('scaffoldComponentShells: zerowy kod wyjscia bez pliku to nadal porazka', async () => {
+  const targets = componentShellTargets({ plan: PLAN, designFramesByTask: { T1: FRAMES } });
+  const shell = fakeShell({ creates: false });
+
+  const result = await scaffoldComponentShells({ targets, ...shell });
+
+  assert.equal(result.ok, false, 'sukces polecenia nie jest dowodem, ze plik powstal');
+  assert.match(result.findings[0].message, /nie utworzył|nie utworzyl/);
+});

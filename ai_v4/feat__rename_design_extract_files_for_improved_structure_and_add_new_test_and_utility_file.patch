+ * @param {(path: string) => string|null} args.readFile
+ * @returns {{id: string, command: string, ok: boolean, exitCode: number, durationMs: number, outputTail: string, skipped: boolean}}
+ */
+export function proofPresenceStep({ changedFiles, libraryType, exists, readFile }) {
+  const violations = libraryType

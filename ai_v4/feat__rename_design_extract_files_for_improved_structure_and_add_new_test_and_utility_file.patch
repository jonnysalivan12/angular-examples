+#!/usr/bin/env node
+import { existsSync, readdirSync, readFileSync } from 'fs';
+// Importy nazwane, nie domyślne: ten moduł bywa ładowany także spoza ESM,
+// a przy tamtym sposobie ładowania domyślny import wbudowanego modułu jest undefined.
+import { join, relative, resolve, sep } from 'path';
+import { pathToFileURL } from 'url';
+
+import { PROOF_KINDS, REQUIRED_PROOFS, PROOF_EXEMPT_PATTERNS, PROOF_EXEMPT_FILES } from '../config/test-presence.js';
+import { TAG_AXES } from '../config/library.js';
+import { WORKSPACE_FILES } from '../config/workspace.js';
+import { hasRuntimeBehavior } from './runtime-behavior.js';
+
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Test presence validator — sprawdza, czy każda jednostka z zachowaniem ma
+ * dowód, którego można nie zdać.
+ *
+ * Pytanie jest inne niż pytanie o pokrycie. Pokrycie mierzy, ile linii wykonał
+ * bieg testów; ten walidator pyta, czy dla danej jednostki KTOKOLWIEK napisał
+ * test. Jednostka bez pliku testu ma pokrycie zero, ale ginie w średniej —
+ * a brak sceny nie rusza pokrycia w ogóle, bo scena go nie liczy.
+ *
+ * Wymóg zależy od TYPU warstwy (`scripts/config/test-presence.js`), nie od nazwy
+ * pliku: warstwa mówi, jakiego rodzaju zachowanie tam mieszka. Warstwy z widokiem
+ * potrzebują sceny obok testu, warstwy z logiką samego testu, a `model` i `asset`
+ * niczego — nie ma tam zachowania, którego brak mógłby się ujawnić.
+ *
+ * Scena wymagana jest wyłącznie od KOMPONENTU. Warstwa z widokiem niesie też
+ * serwisy i strażników; żądanie sceny dla nich produkowałoby zgłoszenia nie do
+ * spełnienia, a takie zgłoszenia uczą, że walidator wolno zignorować.
+ *
+ * O tym, czy plik w ogóle podlega pytaniu, rozstrzyga jego TREŚĆ, a nie nazwa:
+ * interfejs, token wstrzykiwania i lista providerów nie mają zachowania, którego
+ * brak dałoby się pokazać testem (`runtime-behavior.js`).
+ *
+ * Wykrywane naruszenia:
+ *   1. spec-missing     — brak pliku testu obok jednostki
+ *   2. stories-missing  — brak sceny obok komponentu warstwy z widokiem
+ *
+ * Exit code: 0 gdy zero naruszeń, 1 gdy są (do CI).
+ * Zero zależności spoza repozytorium.
+ *
+ * Użycie:
+ *   node scripts/validators/test-presence-validator.js [--format=human|json] [--root=.]
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+/** Rozszerzenie źródła, dla którego pytamy o dowód. */
+const SOURCE_EXTENSION = '.ts';
+
+/** Pliki, które SAME są dowodem — nie pytamy o dowód dla dowodu. */
+const PROOF_FILE = /\.(spec|stories)\.ts$/;
+
+/** Komponent Angulara — jedyna jednostka, od której wymagamy sceny. */
+const COMPONENT_FILE = /\.component\.ts$/;
+
+/** Ścieżka dowodu danego rodzaju obok jednostki. */
+function proofPathFor(sourcePath, kind) {
+  return sourcePath.replace(/\.ts$/, `.${kind}.ts`);
+}
+
+/** Czy plik jest zwolniony z wymogu dowodu. */
+export function isExemptFile(filePath, { exemptFiles = PROOF_EXEMPT_FILES } = {}) {
+  const normalized = String(filePath ?? '').replace(/\\/g, '/');
+  if (exemptFiles.includes(normalized)) return true;
+  return PROOF_EXEMPT_PATTERNS.some((pattern) => new RegExp(pattern).test(normalized));
+}
+
+/**
+ * Typ warstwy z tagów projektu.
+ * @param {{tags?: string[]}} projectJson
+ * @returns {string|null} null, gdy projekt nie deklaruje typu
+ */
+export function libraryTypeOf(projectJson) {
+  // `TAG_AXES.type` niesie już dwukropek — doklejenie własnego dawało prefiks,
+  // którego nie ma żaden tag, więc typ wychodził nierozpoznany dla WSZYSTKICH.
+  const tag = (projectJson?.tags ?? []).find((entry) => String(entry).startsWith(TAG_AXES.type));
+  return tag ? String(tag).slice(TAG_AXES.type.length) : null;
+}
+
+/**
+ * Sprawdza obecność dowodów w jednej bibliotece.
+ *
+ * @param {object} args
+ * @param {string} args.projectName
+ * @param {string} args.directory — katalog biblioteki względem korzenia (do raportu)
+ * @param {string|null} args.libraryType — typ warstwy z tagów
+ * @param {string[]} args.sourceFiles — pliki biblioteki, ścieżki względne korzenia
+ * @param {(path: string) => boolean} args.exists — czy plik istnieje (ścieżka względna korzenia)
+ * @param {(path: string) => string|null} args.readFile — treść pliku; rozstrzyga, czy jest w nim zachowanie
+ * @param {string[]} [args.exemptFiles]
+ * @returns {Array<{kind: string, library: string, directory: string, file: string, note: string}>}
+ */
+export function checkTestPresence({ projectName, directory, libraryType, sourceFiles, exists, readFile, exemptFiles = PROOF_EXEMPT_FILES }) {
+  const required = REQUIRED_PROOFS[libraryType] ?? [];
+  if (required.length === 0) return [];
+
+  const violations = [];
+  for (const file of sourceFiles) {
+    const normalized = String(file).replace(/\\/g, '/');
+    if (!normalized.endsWith(SOURCE_EXTENSION) || PROOF_FILE.test(normalized)) continue;
+    if (isExemptFile(normalized, { exemptFiles })) continue;
+
+    // Treść, nie nazwa: plik z samym interfejsem albo tokenem nie ma zachowania,
+    // więc test na niego sprawdzałby, że kompilator działa.
+    const source = readFile(normalized);
+    if (source === null || source === undefined || !hasRuntimeBehavior(source, normalized)) continue;
+
+    for (const kind of required) {
+      // Scena dotyczy komponentu: serwis warstwy z widokiem nie ma czego pokazać,
+      // a zgłoszenie nie do spełnienia uczy, że walidator wolno zignorować.
+      if (kind === PROOF_KINDS.STORIES && !COMPONENT_FILE.test(normalized)) continue;
+
+      const proofPath = proofPathFor(normalized, kind);
+      if (exists(proofPath)) continue;
+
+      violations.push({
+        kind: `${kind}-missing`,
+        library: projectName,
+        directory,
+        file: normalized,
+        note: kind === PROOF_KINDS.STORIES
+          ? `Komponent bez sceny — brak "${proofPath}".`
+          : `Jednostka bez testu — brak "${proofPath}".`,
+      });
+    }
+  }
+
+  return violations;
+}
+
+/* ── Powłoka CLI ───────────────────────────────────────────────────────────── */
+
+/** Katalogi bibliotek pod `libs/` — biblioteka = katalog z project.json. */
+function collectLibraries(libsRoot) {
+  const results = [];
+
+  function walk(directory) {
+    let entries;
+    try {
+      entries = readdirSync(directory, { withFileTypes: true });
+    } catch {
+      return;
+    }
+
+    if (entries.some((entry) => entry.isFile() && entry.name === WORKSPACE_FILES.project)) {
+      results.push(directory);
+      return;
+    }
+
+    for (const entry of entries) {
+      if (!entry.isDirectory() || entry.name === 'node_modules' || entry.name.startsWith('.')) continue;
+      walk(join(directory, entry.name));
+    }
+  }
+
+  walk(libsRoot);
+  return results;
+}
+
+/** Pliki źródłowe biblioteki (rekurencyjnie), ścieżki względne korzenia. */
+function collectSources(directory, root) {
+  const files = [];
+
+  function walk(current) {
+    let entries;
+    try {
+      entries = readdirSync(current, { withFileTypes: true });
+    } catch {
+      return;
+    }
+
+    for (const entry of entries) {
+      const full = join(current, entry.name);
+      if (entry.isDirectory()) {
+        if (entry.name === 'node_modules' || entry.name.startsWith('.')) continue;
+        walk(full);
+      } else if (entry.name.endsWith(SOURCE_EXTENSION)) {
+        files.push(relative(root, full).split(sep).join('/'));
+      }
+    }
+  }
+
+  walk(directory);
+  return files;
+}
+
+function parseArgs(argv) {
+  const args = {};
+  for (const token of argv) {
+    const match = /^--([\w-]+)(?:=(.*))?$/.exec(token);
+    if (match) args[match[1]] = match[2] ?? true;
+  }
+  return args;
+}
+
+function printHuman({ libraries_checked, violations }) {
+  console.log(`test-presence-validator — sprawdzono ${libraries_checked} bibliotek`);
+
+  if (violations.length === 0) {
+    console.log('✓ Każda jednostka z zachowaniem ma swój dowód.');
+    return;
+  }
+
+  const byLibrary = new Map();
+  for (const item of violations) {
+    if (!byLibrary.has(item.library)) byLibrary.set(item.library, []);
+    byLibrary.get(item.library).push(item);
+  }
+
+  console.log(`✗ Biblioteki z jednostkami bez dowodu: ${byLibrary.size}\n`);
+  for (const [library, items] of byLibrary) {
+    console.log(`  ${library}  (${items[0].directory})`);
+    for (const item of items) console.log(`    - [${item.kind}] ${item.note}`);
+    console.log();
+  }
+}
+
+function main() {
+  const args = parseArgs(process.argv.slice(2));
+  const root = resolve(args.root || '.');
+  const format = args.format || 'human';
+
+  const libsRoot = join(root, 'libs');
+  if (!existsSync(libsRoot)) {
+    process.stderr.write(`test-presence-validator: brak libs/ w ${root}\n`);
+    process.exit(2);
+  }
+
+  const directories = collectLibraries(libsRoot);
+  const violations = [];
+
+  for (const directory of directories) {
+    const projectJson = JSON.parse(readFileSync(join(directory, WORKSPACE_FILES.project), 'utf-8'));
+    violations.push(...checkTestPresence({
+      projectName: projectJson.name ?? relative(root, directory),
+      directory: relative(root, directory).split(sep).join('/'),
+      libraryType: libraryTypeOf(projectJson),
+      sourceFiles: collectSources(directory, root),
+      exists: (relativePath) => existsSync(join(root, relativePath)),
+      readFile: (relativePath) => {
+        const full = join(root, relativePath);
+        return existsSync(full) ? readFileSync(full, 'utf-8') : null;
+      },
+    }));
+  }
+
+  const report = { root, libraries_checked: directories.length, violations_count: violations.length, violations };
+
+  if (format === 'json') console.log(JSON.stringify(report, null, 2));
+  else printHuman(report);
+
+  process.exit(violations.length === 0 ? 0 : 1);
+}
+
+// Powłoka rusza wyłącznie przy bezpośrednim uruchomieniu — import w teście
+// ma dać czyste funkcje, nie wywołać CLI i nie ubić procesu przez process.exit.
+if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
+  main();
+}

+import { classify } from '../ngxs/utils/strings.js';
+import { TODO_MARKER } from './todo-marker.js';
+
+/** Poziom weryfikacji, którego dowodem jest ten plik. */
+const LEVEL = 'component';
+
+/** Ile słów treści kryterium wchodzi do nazwy scenariusza, gdy obszar nie ma nazwy. */
+const NAME_WORD_LIMIT = 4;
+
+/** Nazwa modułu do importu względnego: nazwa pliku bez rozszerzenia. */
+function moduleNameOf(componentFileName) {
+  return path.basename(String(componentFileName ?? ''), '.ts');
+}
+
+/** Treść w apostrofach z ucieczką apostrofu. */
+function quote(text) {
+  return `'${String(text ?? '').replace(/\\/g, '\\\\').replace(/'/g, "\\'")}'`;
+}
+
+/** Czy typ jest unią samych literałów tekstowych — wtedy wejście ma zamknięty zbiór wartości. */
+function literalUnionOptions(type) {
+  const parts = String(type ?? '').split('|').map((part) => part.trim()).filter(Boolean);
+  if (parts.length < 2) return null;
+  if (!parts.every((part) => /^'[^']*'$/.test(part))) return null;
+  return parts;
+}
+
+/**
+ * Sterownik katalogu dla wejścia o danym typie.
+ * @returns {{control: string}|null} null, gdy z typu nie wynika żaden sterownik.
+ */
+function controlFor(type) {
+  const normalized = String(type ?? '').split('|').map((part) => part.trim()).filter((part) => part && part !== 'null' && part !== 'undefined');
+  const options = literalUnionOptions(type);
+  if (options) return { control: `{ control: 'select', options: [${options.join(', ')}] }` };
+  if (normalized.length !== 1) return null;
+
+  if (normalized[0] === 'boolean') return { control: "{ control: 'boolean' }" };
+  if (normalized[0] === 'number') return { control: "{ control: 'number' }" };
+  if (normalized[0] === 'string') return { control: "{ control: 'text' }" };
+  return null;
+}
+
+/**
+ * Tytuł w katalogu scen: kontekst biblioteki i nazwa komponentu bez sufiksu.
+ *
+ * Kontekst czytany ze ścieżki, bo katalogi bibliotek mają postać
+ * `<baza>/<kontekst>/<typ>[/<nazwa>]` — korzenie baz pochodzą z konwencji
+ * nazewniczej, więc tytuł nie rozjedzie się z nią po jej zmianie.
+ *
+ * @param {string} componentPath — ścieżka pliku komponentu w repozytorium
+ * @param {string} className — nazwa klasy komponentu
+ * @returns {string} np. `Auth/LoginForm`; bez rozpoznanego kontekstu sama nazwa komponentu
+ */
+export function storyTitleFrom(componentPath, className) {
+  const componentName = String(className ?? '').replace(/Component$/, '') || 'Component';
+  const normalized = String(componentPath ?? '').replace(/\\/g, '/');
+
+  const appsMatch = new RegExp(`${LIBRARY_NAMING.appsBase}/[^/]+/([^/]+)/`).exec(normalized);
+  const sharedMatch = new RegExp(`${LIBRARY_NAMING.sharedBase}/([^/]+)/`).exec(normalized);
+  const context = appsMatch?.[1] ?? sharedMatch?.[1] ?? null;
+
+  return context ? `${classify(context)}/${componentName}` : componentName;
+}
+
+/** Nazwa eksportu scenariusza: z nazwy obszaru, a bez niej z treści kryterium. */
+export function storyExportName(topic, text) {
+  const source = topic || String(text ?? '').split(/\s+/).slice(0, NAME_WORD_LIMIT).join(' ');
+  const name = classify(source);
+  if (!name) return 'Scena';
+  return /^[A-Za-z]/.test(name) ? name : `Scena${name}`;
+}
+
+/** Blok `argTypes` z wejść i wyjść; wejście o nieustalonym sterowniku dostaje znacznik. */
+function argTypesBlock(api) {
+  const lines = [];
+
+  for (const input of api.inputs ?? []) {
+    const resolved = controlFor(input.type);
+    if (resolved) {
+      lines.push(`    ${input.name}: ${resolved.control},`);
+    } else {
+      lines.push(`    // ${TODO_MARKER}: dobierz sterownik dla '${input.name}' (typ: ${input.type ?? 'nieustalony'}).`);
+    }
+  }
+  for (const output of api.outputs ?? []) {
+    lines.push(`    ${output.name}: { action: ${quote(output.name)} },`);
+  }
+
+  return lines.length > 0 ? `  argTypes: {\n${lines.join('\n')}\n  },\n` : '';
+}
+
+/** Blok `args` z wartości domyślnych wejść; wejście wymagane nie ma wartości domyślnej. */
+function argsBlock(api) {
+  const lines = (api.inputs ?? [])
+    .filter((input) => input.defaultValue !== null && input.defaultValue !== undefined)
+    .map((input) => `    ${input.name}: ${input.defaultValue},`);
+
+  const required = (api.inputs ?? []).filter((input) => input.required);
+  for (const input of required) {
+    lines.push(`    // ${TODO_MARKER}: podaj wartość wymaganego wejścia '${input.name}' (typ: ${input.type ?? 'nieustalony'}).`);
+  }
+
+  return lines.length > 0 ? `  args: {\n${lines.join('\n')}\n  },\n` : '';
+}
+
+/** Scenariusz jednego kryterium: nazwa z obszaru, treść kryterium w opisie, `play` do napisania. */
+function criterionStory(criterion, topic) {
+  return [
+    `/** ${topic || criterion.text} */`,
+    `export const ${storyExportName(topic, criterion.text)}: Story = {`,
+    `  // ${TODO_MARKER}: dopisz args stanu oraz play() z interakcją i asercjami po roli`,
+    '  // i etykiecie, w tym przejściem klawiaturą; potem usuń ten komentarz.',
+    '};',
+  ].join('\n');
+}
+
+/**
+ * Renderuje treść pliku scen komponentu.
+ *
+ * @param {object} args
+ * @param {{className: string|null, imports: string[], inputs: Array, outputs: Array}} args.api — wynik `parseComponentApi`
+ * @param {string} args.componentFileName — nazwa pliku komponentu (import względny)
+ * @param {string} args.title — tytuł w katalogu scen
+ * @param {Array<{id: string, text: string, verification: string}>} args.criteria — kryteria zadania
+ * @param {Record<string, string>} [args.topics] — nazwy obszarów per identyfikator kryterium
+ * @param {string} [args.templatePath] — nadpisanie ścieżki szablonu tłumaczeń
+ * @returns {{content: string, criteria: Array<{id: string, describe: string}>}|null}
+ *          null, gdy komponentu nie odczytano albo żadne kryterium nie jest dowodzone sceną.
+ */
+export function renderStoriesSkeleton({ api, componentFileName, title, criteria, topics = {}, templatePath = null }) {
+  if (!api?.className) return null;
+
+  const covered = (criteria ?? []).filter((criterion) => criterion.verification === LEVEL);
+  if (covered.length === 0) return null;
+
+  const needsTranslate = (api.imports ?? []).includes('TranslateModule');
+  const translateSetup = needsTranslate
+    ? fs.readFileSync(templatePath ?? path.join(import.meta.dirname, 'templates', 'story-translations.template'), 'utf8')
+    : '';
+
+  const head = ["import type { Meta, StoryObj } from '@storybook/angular';"];
+  if (needsTranslate) {
+    head.push("import { applicationConfig } from '@storybook/angular';");
+    head.push("import { TranslateLoader, type TranslationObject, provideTranslateService } from '@ngx-translate/core';");
+    head.push("import { type Observable, of } from 'rxjs';");
+  }
+
+  const decorators = needsTranslate
+    ? [
+      '  decorators: [',
+      '    applicationConfig({',
+      '      providers: [',
+      '        provideTranslateService({',
+      "          lang: 'pl',",
+      "          fallbackLang: 'pl',",
+      '          loader: { provide: TranslateLoader, useClass: StoryTranslateLoader },',
+      '        }),',
+      '      ],',
+      '    }),',
+      '  ],',
+      '',
+    ].join('\n')
+    : '';
+
+  // Ciało metadanych sklejane bez rozdzielnika: każdy blok kończy się własną linią,
+  // a dodatkowy rozdzielnik zostawiałby puste linie w środku literału obiektu.
+  const metaBody = [decorators, argTypesBlock(api), argsBlock(api)]
+    .filter(Boolean)
+    .join('')
+    .trimEnd();
+
+  const content = [
+    head.join('\n'),
+    '',
+    `import { ${api.className} } from './${moduleNameOf(componentFileName)}';`,
+    '',
+    ...(translateSetup ? [translateSetup] : []),
+    `const meta: Meta<${api.className}> = {`,
+    `  title: ${quote(title)},`,
+    `  component: ${api.className},`,
+    ...(metaBody ? [metaBody] : []),
+    '};',
+    'export default meta;',
+    '',
+    `type Story = StoryObj<${api.className}>;`,
+    '',
+    '/** Stan spoczynkowy — komponent bez interakcji. */',
+    'export const Default: Story = {};',
+    '',
+    covered.map((criterion) => criterionStory(criterion, topics[criterion.id])).join('\n\n'),
+  ].join('\n');
+
+  return {
+    content: `${content.replace(/\n{3,}/g, '\n\n').trimEnd()}\n`,
+    criteria: covered.map((criterion) => ({
+      id: criterion.id,
+      describe: storyExportName(topics[criterion.id], criterion.text),
+    })),
+  };
+}

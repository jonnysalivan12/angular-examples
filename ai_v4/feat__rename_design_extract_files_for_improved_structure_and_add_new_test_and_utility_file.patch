+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+
+import { taskProfile, libraryTypeFor, TASK_PROFILES } from './task-profile.js';
+
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Profil wykonania: sprawdzamy odwzorowanie typu warstwy na sposob dowodzenia
+ * oraz to, ze nierozstrzygniety profil jest NAZWANY, a nie podmieniony na domyslny.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+/** Biblioteki istniejace w kształcie `librariesAll` — po jednej na typ. */
+const EXISTING = [
+  { name: 'frontend-app-auth-ui', tags: { scope: 'frontend-app', type: 'ui' } },
+  { name: 'frontend-app-auth-feature', tags: { scope: 'frontend-app', type: 'feature' } },
+  { name: 'frontend-app-auth-core', tags: { scope: 'frontend-app', type: 'core' } },
+  { name: 'frontend-app-auth-state', tags: { scope: 'frontend-app', type: 'state' } },
+  { name: 'shared-common-util', tags: { scope: 'shared', type: 'util' } },
+  { name: 'shared-common-model', tags: { scope: 'shared', type: 'model' } },
+  { name: 'shared-common-asset', tags: { scope: 'shared', type: 'asset' } },
+  { name: 'shared-common-core-api', tags: { scope: 'shared', type: 'core' } },
+];
+
+/** Plan z jednym zadaniem wskazujacym podana biblioteke. */
+function planFor(library, libraries = []) {
+  return { story: '012-login', binding: { libraries, contracts: [] }, tasks: [{ id: 'T1', library }], acceptanceCriteria: [] };
+}
+
+test('taskProfile: warstwa z widokiem → profil ui', () => {
+  for (const library of ['frontend-app-auth-ui', 'frontend-app-auth-feature']) {
+    const result = taskProfile({ taskId: 'T1', plan: planFor(library), existingLibraries: EXISTING });
+    assert.equal(result.profile, TASK_PROFILES.UI, library);
+    assert.equal(result.source, 'index');
+    assert.equal(result.reason, '');
+  }
+});
+
+test('taskProfile: warstwa z logika runtime → profil business', () => {
+  for (const library of ['frontend-app-auth-core', 'frontend-app-auth-state', 'shared-common-util']) {
+    const result = taskProfile({ taskId: 'T1', plan: planFor(library), existingLibraries: EXISTING });
+    assert.equal(result.profile, TASK_PROFILES.BUSINESS, library);
+  }
+});
+
+test('taskProfile: warstwa bez logiki runtime → profil static', () => {
+  for (const library of ['shared-common-model', 'shared-common-asset']) {
+    const result = taskProfile({ taskId: 'T1', plan: planFor(library), existingLibraries: EXISTING });
+    assert.equal(result.profile, TASK_PROFILES.STATIC, library);
+  }
+});
+
+test('taskProfile: nazwa z segmentem po typie → typ z tagu, nie z ostatniego segmentu', () => {
+  const result = taskProfile({ taskId: 'T1', plan: planFor('shared-common-core-api'), existingLibraries: EXISTING });
+
+  assert.equal(result.type, 'core', "ostatni segment 'api' jest nazwa biblioteki, nie typem");
+  assert.equal(result.profile, TASK_PROFILES.BUSINESS);
+});
+
+test('taskProfile: biblioteka nowa → typ z czesci WIAZACEJ planu', () => {
+  const plan = planFor('frontend-app-export-ui', [
+    { name: 'frontend-app-export-ui', status: 'new', structure: { scope: 'frontend-app', tag: 'ui', context: 'export' } },
+  ]);
+  const result = taskProfile({ taskId: 'T1', plan, existingLibraries: EXISTING });
+
+  assert.equal(result.profile, TASK_PROFILES.UI, 'biblioteki jeszcze nie ma w indeksie — typ musi przyjsc z planu');
+  assert.equal(result.source, 'plan');
+});
+
+test('libraryTypeFor: alias pola typu w planie czytany na rowni z nazwa podstawowa', () => {
+  const plan = planFor('frontend-app-export-state', [
+    { name: 'frontend-app-export-state', status: 'new', structure: { scope: 'frontend-app', type: 'state' } },
+  ]);
+
+  assert.deepEqual(libraryTypeFor({ libraryName: 'frontend-app-export-state', plan }), { type: 'state', source: 'plan' });
+});
+
+test('libraryTypeFor: biblioteka istniejaca wymieniona w planie bez struktury → typ z indeksu', () => {
+  const plan = planFor('frontend-app-auth-ui', [{ name: 'frontend-app-auth-ui', status: 'existing' }]);
+
+  assert.deepEqual(libraryTypeFor({ libraryName: 'frontend-app-auth-ui', plan, existingLibraries: EXISTING }), { type: 'ui', source: 'index' });
+});
+
+test('taskProfile: biblioteka nowa bez pola typu → profil nierozstrzygniety z powodem', () => {
+  const plan = planFor('frontend-app-export-ui', [{ name: 'frontend-app-export-ui', status: 'new' }]);
+  const result = taskProfile({ taskId: 'T1', plan, existingLibraries: EXISTING });
+
+  assert.equal(result.profile, null);
+  assert.match(result.reason, /brak typu/);
+  assert.equal(result.library, 'frontend-app-export-ui', 'powod musi wskazywac biblioteke, ktorej dotyczy');
+});
+
+test('taskProfile: typ bez przypisanego profilu → profil nierozstrzygniety, typ w powodzie', () => {
+  const existing = [{ name: 'frontend-app-auth-widget', tags: { type: 'widget' } }];
+  const result = taskProfile({ taskId: 'T1', plan: planFor('frontend-app-auth-widget'), existingLibraries: existing });
+
+  assert.equal(result.profile, null);
+  assert.equal(result.type, 'widget', 'nierozpoznany typ zostaje w wyniku — inaczej powod nie da sie sprawdzic');
+  assert.match(result.reason, /'widget'/);
+});
+
+test('taskProfile: zadanie poza planem → profil nierozstrzygniety z powodem', () => {
+  const result = taskProfile({ taskId: 'T9', plan: planFor('frontend-app-auth-ui'), existingLibraries: EXISTING });
+
+  assert.equal(result.profile, null);
+  assert.match(result.reason, /'T9' nie istnieje/);
+});
+
+test('taskProfile: zadanie bez biblioteki → profil nierozstrzygniety z powodem', () => {
+  const plan = { story: '012-login', binding: { libraries: [], contracts: [] }, tasks: [{ id: 'T1' }], acceptanceCriteria: [] };
+  const result = taskProfile({ taskId: 'T1', plan, existingLibraries: EXISTING });
+
+  assert.equal(result.profile, null);
+  assert.match(result.reason, /bez biblioteki/);
+});
+
+test('taskProfile: kształt wyniku jednakowy dla rozstrzygnietych i nierozstrzygnietych', () => {
+  const resolved = taskProfile({ taskId: 'T1', plan: planFor('frontend-app-auth-ui'), existingLibraries: EXISTING });
+  const unresolved = taskProfile({ taskId: 'T9', plan: planFor('frontend-app-auth-ui'), existingLibraries: EXISTING });
+
+  assert.deepEqual(Object.keys(resolved).sort(), Object.keys(unresolved).sort(), 'wywolujacy czyta pola, nie rozgalezia sie po kształcie');
+});

@@ -0,0 +1,87 @@
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Czy plik niesie zachowanie, którego brak da się pokazać testem.
+ *
+ * Pytanie o dowód ma sens tylko dla kodu, który COŚ ROBI. Interfejs, typ, token
+ * wstrzykiwania i lista providerów opisują kształt albo połączenie — test na nie
+ * sprawdzałby, że kompilator działa. Zwolnienie po nazwie pliku tego nie rozstrzyga:
+ * `login.request.ts` niesie sam interfejs, a `auth.guard.ts` całą decyzję dostępu,
+ * choć obie nazwy wyglądają tak samo niewinnie.
+ *
+ * Czytamy PARSEREM, nie wzorcem tekstowym: ciało funkcji rozpoznane po nawiasach
+ * myliłoby się z obiektem konfiguracji, a metoda w interfejsie z metodą w klasie.
+ * Plik parsowany osobno, bez programu i bez tsconfigu — pytanie dotyczy kształtu
+ * deklaracji, nie rozstrzygania typów.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+import ts from 'typescript';
+
+/** Dekoratory jednostek, które mają zachowanie z definicji — także bez własnej metody. */
+const BEHAVIOR_DECORATORS = new Set(['Component', 'Directive', 'Pipe', 'State']);
+
+/** Czy ciało istnieje i coś w nim stoi. */
+function hasStatements(body) {
+  return Boolean(body && ts.isBlock(body) && body.statements.length > 0);
+}
+
+/** Nazwa dekoratora klasy w postaci tekstowej. */
+function decoratorNames(node) {
+  return (ts.getDecorators?.(node) ?? [])
+    .map((decorator) => {
+      const call = decorator.expression;
+      const identifier = ts.isCallExpression(call) ? call.expression : call;
+      return ts.isIdentifier(identifier) ? identifier.text : null;
+    })
+    .filter(Boolean);
+}
+
+/**
+ * Czy klasa niesie zachowanie.
+ *
+ * Konstruktor nie wystarcza: w tym repozytorium przypisuje pola akcji i ładunków,
+ * więc uznanie go za zachowanie kazałoby dowodzić przypisania. Klasa z dekoratorem
+ * widoku wystarcza sama — renderuje szablon, choćby nie miała ani jednej metody.
+ */
+function classHasBehavior(node) {
+  if (decoratorNames(node).some((name) => BEHAVIOR_DECORATORS.has(name))) return true;
+
+  return node.members.some((member) => {
+    if (ts.isMethodDeclaration(member) || ts.isGetAccessor(member) || ts.isSetAccessor(member)) {
+      return hasStatements(member.body);
+    }
+    return false;
+  });
+}
+
+/** Czy inicjalizator zmiennej jest funkcją z ciałem. */
+function initializerIsFunction(initializer) {
+  if (!initializer) return false;
+  if (ts.isArrowFunction(initializer) || ts.isFunctionExpression(initializer)) {
+    return ts.isBlock(initializer.body) ? hasStatements(initializer.body) : true;
+  }
+  return false;
+}
+
+/**
+ * Czy treść pliku niesie zachowanie do dowiedzenia.
+ *
+ * @param {string} sourceText — treść pliku źródłowego
+ * @param {string} [fileName] — nazwa do komunikatów parsera
+ * @returns {boolean} false dla plików z samymi typami, tokenami i stałymi
+ */
+export function hasRuntimeBehavior(sourceText, fileName = 'source.ts') {
+  const sourceFile = ts.createSourceFile(fileName, String(sourceText ?? ''), ts.ScriptTarget.Latest, true);
+
+  let found = false;
+  const visit = (node) => {
+    if (found) return;
+
+    if (ts.isFunctionDeclaration(node) && hasStatements(node.body)) found = true;
+    else if (ts.isClassDeclaration(node) && classHasBehavior(node)) found = true;
+    else if (ts.isVariableDeclaration(node) && initializerIsFunction(node.initializer)) found = true;
+
+    if (!found) ts.forEachChild(node, visit);
+  };
+
+  ts.forEachChild(sourceFile, visit);
+  return found;
+}

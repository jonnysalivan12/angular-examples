+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+
+import { parseVitestReport, testCases, loadFailures, isPending } from './vitest-report.js';
+
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Odczyt raportu: statusy pojedynczych przypadkow i pliki, ktore nie doszly
+ * do wykonania — dwie rzeczy, ktorych kod wyjscia polecenia nie rozroznia.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+const REPORT = {
+  numTotalTests: 3,
+  testResults: [
+    {
+      name: 'C:/wt/libs/a/src/lib/login-form/login-form.component.spec.ts',
+      status: 'failed',
+      message: '',
+      assertionResults: [
+        { ancestorTitles: ['LoginFormComponent', 'walidacja pola'], title: 'zgłasza pusty adres', status: 'failed', failureMessages: ['AssertionError: expected false to be true'] },
+        { ancestorTitles: ['LoginFormComponent', 'wysyłka'], title: 'wysyła dane', status: 'todo', failureMessages: [] },
+      ],
+    },
+    {
+      name: 'C:/wt/libs/a/src/lib/session/session.spec.ts',
+      status: 'passed',
+      message: '',
+      assertionResults: [{ ancestorTitles: ['SessionStore'], title: 'trzyma token', status: 'passed', failureMessages: [] }],
+    },
+  ],
+};
+
+test('parseVitestReport: raport otoczony logiem polecenia daje sie odczytac', () => {
+  const output = [
+    '> nx run frontend-app-auth-ui:test',
+    '',
+    JSON.stringify(REPORT),
+    '',
+    'Nx read the output from the cache instead of running the command',
+  ].join('\n');
+
+  const { report, reason } = parseVitestReport(output);
+
+  assert.equal(reason, null);
+  assert.equal(report.testResults.length, 2);
+});
+
+test('parseVitestReport: wyjscie bez raportu to powod, nie wyjatek', () => {
+  const { report, reason } = parseVitestReport('nx: polecenie zakonczone kodem 1');
+
+  assert.equal(report, null);
+  assert.match(reason, /nie zawiera raportu/);
+});
+
+test('parseVitestReport: JSON bez listy plikow nie udaje raportu', () => {
+  const { report, reason } = parseVitestReport('{"error":"config not found"}');
+
+  assert.equal(report, null);
+  assert.match(reason, /testResults/);
+});
+
+test('testCases: przypadki ze wszystkich plikow ze sciezka blokow i statusem', () => {
+  const cases = testCases(REPORT);
+
+  assert.equal(cases.length, 3);
+  assert.deepEqual(cases[0].describePath, ['LoginFormComponent', 'walidacja pola']);
+  assert.equal(cases[0].status, 'failed');
+  assert.equal(cases[1].status, 'todo');
+  assert.match(cases[2].file, /session\.spec\.ts$/);
+});
+
+test('isPending: zapowiedz i pominiecie to przypadki niewykonane', () => {
+  assert.equal(isPending('todo'), true);
+  assert.equal(isPending('skipped'), true);
+  assert.equal(isPending('passed'), false);
+  assert.equal(isPending('failed'), false);
+});
+
+test('loadFailures: plik bez ani jednego przypadku i z porazka to blad ladowania', () => {
+  const failures = loadFailures({
+    testResults: [
+      { name: 'C:/wt/libs/a/x.spec.ts', status: 'failed', message: 'Error: Cannot find module ./x', assertionResults: [] },
+      ...REPORT.testResults,
+    ],
+  });
+
+  assert.equal(failures.length, 1);
+  assert.match(failures[0].file, /x\.spec\.ts$/);
+  assert.match(failures[0].message, /Cannot find module/);
+});
+
+test('loadFailures: plik pusty i zielony to brak pokrycia, nie blad biegu', () => {
+  const failures = loadFailures({
+    testResults: [{ name: 'C:/wt/libs/a/x.spec.ts', status: 'passed', message: '', assertionResults: [] }],
+  });
+
+  assert.deepEqual(failures, []);
+});
+
+test('loadFailures: blad poza plikiem testu wchodzi z pusta nazwa i trescia', () => {
+  const failures = loadFailures({
+    testResults: [],
+    unhandledErrors: [{ message: 'Transform failed', stack: 'Transform failed\n  at libs/a/src/lib/x.component.ts:12' }],
+  });
+
+  assert.equal(failures[0].file, '');
+  assert.match(failures[0].message, /x\.component\.ts/);
+});

+#!/usr/bin/env node
+import { existsSync, readdirSync, readFileSync } from 'fs';
+import { join, relative, resolve, sep } from 'path';
+import { pathToFileURL } from 'url';
+
+import { TAG_AXES } from '../config/library.js';
+import { WORKSPACE_FILES } from '../config/workspace.js';
+
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Pokrycie per aplikacja — jeden pomiar zamiast kilkunastu.
+ *
+ * Każdy projekt pisze własny raport, więc bez scalenia „pokrycie" jest listą
+ * liczb, których nie da się porównać z progiem: biblioteka o dziesięciu liniach
+ * i sto procentach waży w niej tyle samo, co aplikacja z tysiącem linii.
+ * Suma trafień i linii daje jedną liczbę, którą próg ma sens porównywać.
+ *
+ * Zbiór projektów wyznacza oś `scope:` — ta sama, po której liczy się granice
+ * zależności. Aplikacja i jej biblioteki noszą ten sam scope, więc zbiór jest
+ * czytany z tagów, a nie odtwarzany z grafu zależności.
+ *
+ * Zero zależności spoza repozytorium; format lcov czytany po dwóch polach:
+ * `LF` (linie znalezione) i `LH` (linie trafione).
+ *
+ * Użycie:
+ *   node scripts/coverage/lcov-summary.js [--scope=frontend-app] [--format=human|json] [--root=.]
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+/** Katalog, w którym projekty zostawiają raporty (konwencja `reportsDirectory`). */
+const COVERAGE_DIR = 'coverage';
+
+/** Nazwa pliku raportu. */
+const LCOV_FILE = 'lcov.info';
+
+/**
+ * Sumuje linie z jednego raportu lcov.
+ *
+ * @param {string} text — treść pliku lcov
+ * @returns {{linesFound: number, linesHit: number}}
+ */
+export function parseLcov(text) {
+  let linesFound = 0;
+  let linesHit = 0;
+
+  for (const line of String(text ?? '').split('\n')) {
+    const found = /^LF:(\d+)/.exec(line);
+    if (found) {
+      linesFound += Number(found[1]);
+      continue;
+    }
+    const hit = /^LH:(\d+)/.exec(line);
+    if (hit) linesHit += Number(hit[1]);
+  }
+
+  return { linesFound, linesHit };
+}
+
+/**
+ * Scala raporty w jeden pomiar.
+ *
+ * Brak raportów daje `pct: null`, nie zero: „nie zmierzono" i „zmierzono zero"
+ * to dwa różne stany, a bramka progu musi je rozróżniać — inaczej brak biegu
+ * testów wyglądałby jak kod bez pokrycia.
+ *
+ * @param {Array<{project?: string, text: string}>} reports
+ * @returns {{pct: number|null, linesFound: number, linesHit: number, projects: number}}
+ */
+export function aggregateCoverage(reports) {
+  let linesFound = 0;
+  let linesHit = 0;
+
+  for (const report of reports ?? []) {
+    const parsed = parseLcov(report.text);
+    linesFound += parsed.linesFound;
+    linesHit += parsed.linesHit;
+  }
+
+  return {
+    pct: linesFound === 0 ? null : Math.round((linesHit / linesFound) * 10000) / 100,
+    linesFound,
+    linesHit,
+    projects: (reports ?? []).length,
+  };
+}
+
+/**
+ * Scope projektu z jego tagów.
+ * @param {{tags?: string[]}} projectJson
+ * @returns {string|null}
+ */
+export function scopeOf(projectJson) {
+  const tag = (projectJson?.tags ?? []).find((entry) => String(entry).startsWith(TAG_AXES.scope));
+  return tag ? String(tag).slice(TAG_AXES.scope.length) : null;
+}
+
+/* ── Powłoka CLI ───────────────────────────────────────────────────────────── */
+
+/** Katalogi projektów pod podanym korzeniem. */
+function collectProjects(searchRoot) {
+  const results = [];
+
+  function walk(directory) {
+    let entries;
+    try {
+      entries = readdirSync(directory, { withFileTypes: true });
+    } catch {
+      return;
+    }
+
+    if (entries.some((entry) => entry.isFile() && entry.name === WORKSPACE_FILES.project)) {
+      results.push(directory);
+      return;
+    }
+
+    for (const entry of entries) {
+      if (!entry.isDirectory() || entry.name === 'node_modules' || entry.name.startsWith('.')) continue;
+      walk(join(directory, entry.name));
+    }
+  }
+
+  walk(searchRoot);
+  return results;
+}
+
+function parseArgs(argv) {
+  const args = {};
+  for (const token of argv) {
+    const match = /^--([\w-]+)(?:=(.*))?$/.exec(token);
+    if (match) args[match[1]] = match[2] ?? true;
+  }
+  return args;
+}
+
+function main() {
+  const args = parseArgs(process.argv.slice(2));
+  const root = resolve(args.root || '.');
+  const format = args.format || 'human';
+  const wantedScope = args.scope || null;
+
+  const directories = [...collectProjects(join(root, 'libs')), ...collectProjects(join(root, 'apps'))];
+  const reports = [];
+  const missing = [];
+
+  for (const directory of directories) {
+    const projectJson = JSON.parse(readFileSync(join(directory, WORKSPACE_FILES.project), 'utf-8'));
+    if (wantedScope && scopeOf(projectJson) !== wantedScope) continue;
+
+    const relativeDirectory = relative(root, directory).split(sep).join('/');
+    const lcovPath = join(root, COVERAGE_DIR, relativeDirectory, LCOV_FILE);
+    if (!existsSync(lcovPath)) {
+      missing.push(projectJson.name ?? relativeDirectory);
+      continue;
+    }
+    reports.push({ project: projectJson.name ?? relativeDirectory, text: readFileSync(lcovPath, 'utf-8') });
+  }
+
+  const summary = aggregateCoverage(reports);
+  const report = { root, scope: wantedScope, ...summary, missing_reports: missing };
+
+  if (format === 'json') {
+    console.log(JSON.stringify(report, null, 2));
+  } else {
+    console.log(`lcov-summary${wantedScope ? ` — scope:${wantedScope}` : ''}`);
+    console.log(summary.pct === null
+      ? '✗ Nie zmierzono ani jednej linii — czy bieg testów miał włączone pokrycie?'
+      : `pokrycie ${summary.pct}%  (${summary.linesHit}/${summary.linesFound} linii, ${summary.projects} raportów)`);
+    if (missing.length > 0) console.log(`bez raportu: ${missing.join(', ')}`);
+  }
+
+  process.exit(summary.pct === null ? 1 : 0);
+}
+
+// Powłoka rusza wyłącznie przy bezpośrednim uruchomieniu — import w teście
+// ma dać czyste funkcje, nie wywołać CLI i nie ubić procesu przez process.exit.
+if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
+  main();
+}

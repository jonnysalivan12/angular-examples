+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Raport biegu testów — odczyt wyniku vitest w postaci nadającej się do decyzji.
+ *
+ * Bramki fazy testów rozstrzygają dwie rzeczy: DLACZEGO jest czerwono i CZY każde
+ * kryterium ma swój dowód. Obie potrzebują statusów pojedynczych przypadków, a nie
+ * kodu wyjścia polecenia — kod wyjścia jest ten sam dla testu, który opadł na
+ * asercji, i dla pliku, który się nie skompilował, choć znaczą przeciwne rzeczy.
+ *
+ * Plik, który nie doszedł do wykonania testów, jest tu odrębnym rodzajem wyniku,
+ * nie porażką „zerowej liczby testów": bez tego rozróżnienia niedziałający import
+ * wyglądałby jak brak pokrycia, a rozjazd typów jak spełnione żądanie zachowania.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+/** Ile kandydatów na granice obiektu sprawdzić, zanim uznamy wyjście za nieparsowalne. */
+const MAX_JSON_CANDIDATES = 20;
+
+/** Statusy przypadków, które vitest raportuje jako niewykonane. */
+const PENDING_STATUSES = Object.freeze(['todo', 'pending', 'skipped']);
+
+/**
+ * Wycina obiekt JSON z wyjścia polecenia.
+ *
+ * Wyjście bywa otoczone logiem nx, więc czysty `JSON.parse` całości zawodzi.
+ * Kandydaci na początek liczeni od początków linii — nawias w środku zdania logu
+ * nie otwiera obiektu.
+ */
+function extractJson(text) {
+  const value = String(text ?? '');
+  const starts = [];
+  for (let index = value.indexOf('{'); index !== -1 && starts.length < MAX_JSON_CANDIDATES; index = value.indexOf('{', index + 1)) {
+    if (index === 0 || value[index - 1] === '\n' || value[index - 1] === '\r') starts.push(index);
+  }
+
+  for (const start of starts) {
+    let end = value.lastIndexOf('}');
+    for (let attempt = 0; attempt < MAX_JSON_CANDIDATES && end > start; attempt += 1) {
+      try {
+        return JSON.parse(value.slice(start, end + 1));
+      } catch {
+        end = value.lastIndexOf('}', end - 1);
+      }
+    }
+  }
+  return null;
+}
+
+/**
+ * Czyta raport vitest z tekstu (pliku `--outputFile` albo wyjścia polecenia).
+ *
+ * @param {string} text
+ * @returns {{report: object|null, reason: string|null}} `reason` niesie powód
+ *          nieodczytania — brak raportu jest stanem do obsłużenia, nie wyjątkiem.
+ */
+export function parseVitestReport(text) {
+  const parsed = extractJson(text);
+  if (!parsed) return { report: null, reason: 'wyjście biegu testów nie zawiera raportu JSON' };
+  if (!Array.isArray(parsed.testResults)) {
+    return { report: null, reason: 'raport JSON bez listy plików testowych (testResults)' };
+  }
+  return { report: parsed, reason: null };
+}
+
+/**
+ * Płaska lista przypadków ze wszystkich plików raportu.
+ *
+ * @param {object|null} report
+ * @returns {Array<{file: string, describePath: string[], title: string, status: string, failureMessages: string[]}>}
+ */
+export function testCases(report) {
+  const cases = [];
+  for (const fileResult of report?.testResults ?? []) {
+    for (const assertion of fileResult.assertionResults ?? []) {
+      cases.push({
+        file: String(fileResult.name ?? ''),
+        describePath: assertion.ancestorTitles ?? [],
+        title: String(assertion.title ?? ''),
+        status: String(assertion.status ?? ''),
+        failureMessages: assertion.failureMessages ?? [],
+      });
+    }
+  }
+  return cases;
+}
+
+/** Czy status oznacza przypadek zapowiedziany, a nie wykonany. */
+export function isPending(status) {
+  return PENDING_STATUSES.includes(String(status ?? ''));
+}
+
+/**
+ * Pliki, które nie doszły do wykonania ani jednego przypadku.
+ *
+ * Plik bez przypadków i bez porażki nie jest tu wyliczany — pusty plik testowy
+ * to brak pokrycia, którym zajmuje się osobna bramka, a nie błąd biegu.
+ *
+ * @param {object|null} report
+ * @returns {Array<{file: string, message: string}>}
+ */
+export function loadFailures(report) {
+  const failures = [];
+
+  for (const fileResult of report?.testResults ?? []) {
+    const hasCases = (fileResult.assertionResults ?? []).length > 0;
+    const failed = String(fileResult.status ?? '') === 'failed';
+    if (!hasCases && failed) {
+      failures.push({ file: String(fileResult.name ?? ''), message: String(fileResult.message ?? '') });
+    }
+  }
+
+  // Błędy poza plikiem testu (np. wywrócona konfiguracja) nie mają nazwy pliku
+  // w raporcie — ich treść i tak niesie ścieżkę, po której klasyfikuje się przyczynę.
+  for (const unhandled of report?.unhandledErrors ?? []) {
+    const message = typeof unhandled === 'string' ? unhandled : (unhandled?.stack ?? unhandled?.message ?? '');
+    failures.push({ file: '', message: String(message) });
+  }
+
+  return failures;
+}

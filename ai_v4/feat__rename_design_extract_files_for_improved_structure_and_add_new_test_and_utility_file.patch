+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+
+import { parseFigmaRefs } from './figma-refs.js';
+
+const URL_A = 'https://www.figma.com/design/abc123/Projekt?node-id=12-34';
+const URL_B = 'https://www.figma.com/design/xyz789/Inny?node-id=56-78';
+
+test('figma-refs: pojedynczy adres w prozie (z kropką na końcu zdania) → jedno odniesienie', () => {
+  const refs = parseFigmaRefs(`Zaimplementuj ekran zgodnie z makietą ${URL_A}.`);
+  assert.deepEqual(refs, [{ url: URL_A, fileKey: 'abc123', nodeId: '12-34' }]);
+});
+
+test('figma-refs: link markdown → adres wyłuskany bez nawiasu domykającego', () => {
+  const refs = parseFigmaRefs(`Makieta: [logowanie](${URL_A})`);
+  assert.equal(refs.length, 1);
+  assert.equal(refs[0].fileKey, 'abc123');
+  assert.equal(refs[0].nodeId, '12-34');
+});
+
+test('figma-refs: brak adresu Figmy → lista pusta (przepływ nie blokuje UI)', () => {
+  assert.deepEqual(parseFigmaRefs('Zwykła story bez makiety, link https://example.com/x'), []);
+});
+
+test('figma-refs: dwa różne pliki → dwa odniesienia w kolejności wystąpienia', () => {
+  const refs = parseFigmaRefs(`Ekran A ${URL_A} oraz ekran B ${URL_B}`);
+  assert.equal(refs.length, 2);
+  assert.equal(refs[0].fileKey, 'abc123');
+  assert.equal(refs[1].fileKey, 'xyz789');
+});
+
+test('figma-refs: ten sam frame dwa razy → zdedupowane do jednego', () => {
+  const refs = parseFigmaRefs(`${URL_A} ... ${URL_A}`);
+  assert.equal(refs.length, 1);
+});
+
+test('figma-refs: adres bez node-id → pominięty (brak węzła makiety)', () => {
+  assert.deepEqual(parseFigmaRefs('https://www.figma.com/design/abc123/Projekt'), []);
+});
+
+test('figma-refs: jeden adres z wieloma node-id → odniesienie per węzeł', () => {
+  const refs = parseFigmaRefs('https://www.figma.com/design/abc123/P?node-id=1-2&node-id=3-4');
+  assert.equal(refs.length, 2);
+  assert.deepEqual(refs.map((r) => r.nodeId), ['1-2', '3-4']);
+});

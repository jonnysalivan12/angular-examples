@@ -0,0 +1,144 @@
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * API komponentu Angulara — odczyt z drzewa składniowego pliku źródłowego.
+ *
+ * Wejściem jest treść pliku, wyjściem to, czego potrzebuje szkielet testu i sceny:
+ * nazwa klasy, selektor, moduły z `imports` dekoratora oraz wejścia i wyjścia
+ * sygnałowe wraz z typami i wartościami domyślnymi.
+ *
+ * Czytamy PARSEREM, nie wzorcem tekstowym: nazwy pól i typy generyczne bywają
+ * wielolinijkowe, a unia literałów zawiera znaki, na których wyrażenie regularne
+ * się rozjeżdża. Plik jest parsowany osobno, bez programu i bez tsconfigu —
+ * odczyt kształtu API nie wymaga rozstrzygania typów.
+ *
+ * Czego parser nie rozpoznaje, tego NIE zgaduje: pole trafia do `warnings`,
+ * a wynik pozostaje kompletny o tym, co dało się odczytać.
+ *
+ * Zero I/O: treść pliku podaje wywołujący.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+import ts from 'typescript';
+
+/** Fabryki sygnałowe rozpoznawane w polach klasy: nazwa wywołania → rodzaj pola. */
+const SIGNAL_FACTORIES = Object.freeze({
+  /** Wejście opcjonalne — pierwszy argument jest wartością domyślną. */
+  input: 'input',
+  /** Wejście wymagane — bez wartości domyślnej. */
+  'input.required': 'input',
+  /** Wyjście — typ generyczny opisuje emitowaną wartość. */
+  output: 'output',
+  /** Wiązanie dwustronne — jest naraz wejściem i wyjściem. */
+  model: 'model',
+  /** Wiązanie dwustronne bez wartości domyślnej. */
+  'model.required': 'model',
+});
+
+/** Nazwa wywołania w formie tekstowej: `input`, `input.required`, `output`. */
+function calleeName(callExpression, sourceFile) {
+  return callExpression.expression.getText(sourceFile);
+}
+
+/** Treść pierwszego argumentu wywołania albo null, gdy wywołanie jest bezargumentowe. */
+function firstArgumentText(callExpression, sourceFile) {
+  const [first] = callExpression.arguments;
+  return first ? first.getText(sourceFile).trim() : null;
+}
+
+/** Treść pierwszego typu generycznego wywołania albo null, gdy typu nie podano. */
+function firstTypeArgumentText(callExpression, sourceFile) {
+  const [first] = callExpression.typeArguments ?? [];
+  return first ? first.getText(sourceFile).trim() : null;
+}
+
+/** Klasa z dekoratorem `@Component` albo null, gdy plik żadnej nie zawiera. */
+function findComponentClass(sourceFile) {
+  for (const statement of sourceFile.statements) {
+    if (!ts.isClassDeclaration(statement)) continue;
+    const decorators = ts.getDecorators(statement) ?? [];
+    const componentDecorator = decorators.find(
+      (decorator) => ts.isCallExpression(decorator.expression)
+        && decorator.expression.expression.getText(sourceFile) === 'Component',
+    );
+    if (componentDecorator) return { classDeclaration: statement, decorator: componentDecorator };
+  }
+  return null;
+}
+
+/** Wartość właściwości obiektu metadanych dekoratora jako węzeł albo null. */
+function metadataProperty(decorator, sourceFile, propertyName) {
+  const [metadata] = decorator.expression.arguments;
+  if (!metadata || !ts.isObjectLiteralExpression(metadata)) return null;
+
+  for (const property of metadata.properties) {
+    if (!ts.isPropertyAssignment(property)) continue;
+    if (property.name.getText(sourceFile) === propertyName) return property.initializer;
+  }
+  return null;
+}
+
+/**
+ * Odczytuje API komponentu z treści pliku źródłowego.
+ *
+ * @param {string} sourceText — treść pliku `*.component.ts`
+ * @param {object} [options]
+ * @param {string} [options.fileName='component.ts'] — nazwa użyta w komunikatach parsera
+ * @returns {{className: string|null, selector: string|null, imports: string[],
+ *            inputs: Array<{name: string, type: string|null, defaultValue: string|null, required: boolean}>,
+ *            outputs: Array<{name: string, type: string|null}>,
+ *            warnings: string[]}}
+ *          `className` jest `null`, gdy plik nie zawiera klasy z dekoratorem `@Component`
+ *          — wtedy pozostałe kolekcje są puste, a powód stoi w `warnings`.
+ */
+export function parseComponentApi(sourceText, { fileName = 'component.ts' } = {}) {
+  const empty = { className: null, selector: null, imports: [], inputs: [], outputs: [] };
+  const sourceFile = ts.createSourceFile(fileName, String(sourceText ?? ''), ts.ScriptTarget.Latest, true);
+
+  const found = findComponentClass(sourceFile);
+  if (!found) {
+    return { ...empty, warnings: [`${fileName}: brak klasy z dekoratorem @Component`] };
+  }
+
+  const { classDeclaration, decorator } = found;
+  const warnings = [];
+
+  const selectorNode = metadataProperty(decorator, sourceFile, 'selector');
+  const selector = selectorNode && ts.isStringLiteralLike(selectorNode) ? selectorNode.text : null;
+
+  const importsNode = metadataProperty(decorator, sourceFile, 'imports');
+  const imports = importsNode && ts.isArrayLiteralExpression(importsNode)
+    ? importsNode.elements.map((element) => element.getText(sourceFile).trim())
+    : [];
+
+  const inputs = [];
+  const outputs = [];
+
+  for (const member of classDeclaration.members) {
+    if (!ts.isPropertyDeclaration(member) || !member.initializer) continue;
+    if (!ts.isCallExpression(member.initializer)) continue;
+
+    const name = member.name.getText(sourceFile);
+    const callee = calleeName(member.initializer, sourceFile);
+    const kind = SIGNAL_FACTORIES[callee];
+
+    // Pola inicjowane czymkolwiek innym — wstrzyknięcia, sygnały stanu wewnętrznego,
+    // wartości pochodne, zapytania o widok — nie należą do API komponentu, więc
+    // cisza o nich jest poprawna, a nie przemilczeniem.
+    if (!kind) continue;
+
+    const type = firstTypeArgumentText(member.initializer, sourceFile);
+    if (!type) warnings.push(`${name}: ${callee}() bez typu generycznego — typ nieustalony`);
+
+    if (kind === 'input' || kind === 'model') {
+      inputs.push({
+        name,
+        type,
+        defaultValue: firstArgumentText(member.initializer, sourceFile),
+        required: callee.endsWith('.required'),
+      });
+    }
+    if (kind === 'output' || kind === 'model') {
+      outputs.push({ name, type });
+    }
+  }
+
+  return { className: classDeclaration.name?.getText(sourceFile) ?? null, selector, imports, inputs, outputs, warnings };
+}

+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+
+import { measureCoverage } from './coverage.js';
+
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Pomiar pokrycia: bez progu pomijany (bieg z pomiarem kosztuje tyle co cala
+ * weryfikacja), a nieudany pomiar NIE jest zielenia.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+/** Powloka oddajaca odpowiedzi po fragmencie polecenia i zapisujaca wywolania. */
+function fakeExec(responses = {}) {
+  const commands = [];
+  const exec = async (command) => {
+    commands.push(command);
+    const match = Object.keys(responses).find((pattern) => command.includes(pattern));
+    return match ? responses[match] : { exitCode: 0, output: '' };
+  };
+  exec.commands = commands;
+  return exec;
+}
+
+const SUMMARY = (pct) => ({ exitCode: 0, output: `lcov-summary\n${JSON.stringify({ pct, linesHit: 51, linesFound: 100 })}` });
+
+test('measureCoverage: bez progu nic nie jest uruchamiane', async () => {
+  const exec = fakeExec();
+
+  const result = await measureCoverage({ threshold: null, execCommand: exec });
+
+  assert.equal(result.skipped, true);
+  assert.deepEqual(exec.commands, [], 'liczba, ktorej nikt z niczym nie porowna, to czysty wydatek');
+});
+
+test('measureCoverage: pokrycie powyzej progu zamyka bramke bez ustalen', async () => {
+  const exec = fakeExec({ 'lcov-summary': SUMMARY(80) });
+
+  const result = await measureCoverage({ threshold: 70, execCommand: exec });
+
+  assert.equal(result.pct, 80);
+  assert.deepEqual(result.findings, []);
+  assert.ok(exec.commands.some((command) => command.includes('--coverage')));
+});
+
+test('measureCoverage: pokrycie ponizej progu wraca ustaleniem bramki', async () => {
+  const result = await measureCoverage({ threshold: 70, execCommand: fakeExec({ 'lcov-summary': SUMMARY(51) }) });
+
+  assert.equal(result.findings.length, 1);
+  assert.match(result.findings[0].message, /51% poniżej progu polityki aplikacji 70%/);
+});
+
+test('measureCoverage: scope zawezajacy pomiar dopisany do polecenia scalania', async () => {
+  const exec = fakeExec({ 'lcov-summary': SUMMARY(80) });
+
+  await measureCoverage({ scope: 'frontend-app', threshold: 70, execCommand: exec });
+
+  assert.ok(exec.commands.some((command) => command.includes('--scope=frontend-app')));
+});
+
+test('measureCoverage: nieodczytany pomiar to ustalenie, nie zielen', async () => {
+  const result = await measureCoverage({
+    threshold: 70,
+    execCommand: fakeExec({ 'lcov-summary': { exitCode: 1, output: 'nie zmierzono ani jednej linii' } }),
+  });
+
+  assert.equal(result.pct, null);
+  assert.equal(result.findings.length, 1);
+  assert.match(result.findings[0].message, /nie ma czego sprawdzić/);
+});
+
+test('measureCoverage: czerwony bieg testow nie przerywa pomiaru', async () => {
+  const result = await measureCoverage({
+    threshold: 70,
+    execCommand: fakeExec({ '--coverage': { exitCode: 1, output: 'testy czerwone' }, 'lcov-summary': SUMMARY(80) }),
+  });
+
+  assert.equal(result.pct, 80, 'pokrycie liczy sie z tego, co zdazylo powstac — czerwien testow ma wlasna bramke');
+});

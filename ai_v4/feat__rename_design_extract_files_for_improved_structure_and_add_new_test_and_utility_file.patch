+test('loadDesignIrForPlanner: zbudowana rama → YAML z design_ir', async () => {
+  await inTempCwd(async () => {
+    writeArtifact(artifactPaths('006-baner').story, `# Login ${FIG}\n`);
+    await runStage({ featureDir: '006-baner', extractRef: async (ref) => fakeIr(ref.fileKey) });
+
+    const out = loadDesignIrForPlanner('006-baner');
+    assert.match(out, /design_ir/);
+    assert.match(out, /abc/, 'zawiera treść design_ir zbudowanej ramy');

+  assert.equal(api.selector, 'gdprrt-app-badge');
+  assert.deepEqual(api.imports, ['TranslateModule']);
+  assert.deepEqual(api.inputs, [
+    { name: 'loading', type: 'boolean', defaultValue: 'false', required: false },
+    { name: 'serverError', type: 'string | null', defaultValue: 'null', required: false },
+  ]);
+  assert.deepEqual(api.warnings, []);
+});
+
+test('parseComponentApi: unia literalow zostaje jednym typem', () => {
+  const api = parseComponentApi(`
+    @Component({ selector: 'gdprrt-button' })
+    export class ButtonComponent {
+      readonly variant = input<'primary' | 'secondary' | 'ghost'>('primary');
+    }
+  `);
+
+  assert.deepEqual(api.inputs, [
+    { name: 'variant', type: "'primary' | 'secondary' | 'ghost'", defaultValue: "'primary'", required: false },
+  ]);
+});
+
+test('parseComponentApi: wejscie wymagane rozpoznane i bez wartosci domyslnej', () => {
+  const api = parseComponentApi(`
+    @Component({ selector: 'gdprrt-row' })
+    export class RowComponent {
+      readonly item = input.required<Item>();
+    }
+  `);
+
+  assert.deepEqual(api.inputs, [{ name: 'item', type: 'Item', defaultValue: null, required: true }]);
+});
+
+test('parseComponentApi: wyjscia sygnalowe z typem emitowanej wartosci', () => {
+  const api = parseComponentApi(`
+    @Component({ selector: 'gdprrt-form' })
+    export class FormComponent {
+      public readonly loginSubmit = output<LoginCredentials>();
+      readonly closed = output<void>();
+    }
+  `);
+
+  assert.deepEqual(api.outputs, [
+    { name: 'loginSubmit', type: 'LoginCredentials' },
+    { name: 'closed', type: 'void' },
+  ]);
+  assert.deepEqual(api.inputs, [], 'wyjscie nie jest wejsciem');
+});
+
+test('parseComponentApi: wiazanie dwustronne liczy sie po obu stronach', () => {
+  const api = parseComponentApi(`
+    @Component({ selector: 'gdprrt-field' })
+    export class FieldComponent {
+      readonly value = model<string>('');
+    }
+  `);
+
+  assert.deepEqual(api.inputs, [{ name: 'value', type: 'string', defaultValue: "''", required: false }]);
+  assert.deepEqual(api.outputs, [{ name: 'value', type: 'string' }], 'model zmienia wartosc, wiec jest tez wyjsciem');
+});
+
+test('parseComponentApi: pola poza API komponentu sa pomijane bez ostrzezen', () => {
+  const api = parseComponentApi(`
+    @Component({ selector: 'gdprrt-form' })
+    export class FormComponent {
+      private readonly fb = inject(NonNullableFormBuilder);
+      private readonly touched = signal(false);
+      protected readonly label = computed(() => 'x');
+      private readonly field = viewChild<ElementRef>('field');
+      readonly disabled = input<boolean>(false);
+    }
+  `);
+
+  assert.deepEqual(api.inputs.map((input) => input.name), ['disabled']);
+  assert.deepEqual(api.outputs, []);
+  assert.deepEqual(api.warnings, [], 'wstrzykniecia i stan wewnetrzny nie sa brakiem w API');
+});
+
+test('parseComponentApi: brak typu generycznego → ostrzezenie, typ nieustalony', () => {
+  const api = parseComponentApi(`
+    @Component({ selector: 'gdprrt-x' })
+    export class XComponent {
+      readonly clicked = output();
+    }
+  `);
+
+  assert.deepEqual(api.outputs, [{ name: 'clicked', type: null }]);
+  assert.equal(api.warnings.length, 1);
+  assert.match(api.warnings[0], /clicked/);
+});
+
+test('parseComponentApi: plik bez komponentu → puste API z powodem', () => {
+  const api = parseComponentApi('export interface Item { id: string }', { fileName: 'item.ts' });
+
+  assert.equal(api.className, null);
+  assert.deepEqual(api.inputs, []);
+  assert.match(api.warnings[0], /item\.ts.*@Component/);
+});
+
+test('parseComponentApi: realny komponent workspace’u — konwencja repozytorium czytana poprawnie', () => {
+  const api = parseComponentApi(fs.readFileSync(LOGIN_FORM, 'utf8'), { fileName: LOGIN_FORM });
+
+  assert.equal(api.className, 'LoginFormComponent');
+  assert.equal(api.selector, 'gdprrt-app-login-form');
+  assert.ok(api.imports.includes('ReactiveFormsModule'), `moduly dekoratora: ${api.imports.join(', ')}`);
+
+  assert.deepEqual(api.inputs.map((input) => input.name).sort(), ['loading', 'serverError']);
+  assert.deepEqual(api.outputs.map((output) => output.name), ['loginSubmit']);
+  assert.deepEqual(api.warnings, [], 'komponent pisany wg konwencji nie zostawia niczego nieustalonego');
+});

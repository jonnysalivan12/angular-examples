+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+
+import { generateTestSkeletons } from './test-skeletons.js';
+
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Krok maszynowy: komponent dostaje szkielet z trescia, reszta warstw sama
+ * liste plikow do napisania — a mapa kryteriow wychodzi taka sama.

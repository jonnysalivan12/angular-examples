@@ -0,0 +1,174 @@
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Etap makiety — wykrywa linki Figmy w story i składa deterministyczny design_ir.
+ *
+ * Zawsze zapisuje artefakt, żeby wykrywanie postępu po istnieniu pliku nie stanęło:
+ * brak linku → status `no-mockup` (UI nieimplementowane, standardowy szablon);
+ * link → design_ir per rama. Błąd pobrania/parsowania NIE blokuje przepływu —
+ * rama dostaje status błędu, artefakt i tak powstaje.
+ *
+ * Ekstrakcja jest deterministyczna (parseFrame → assembleWholeFrame → walidacja),
+ * bez modelu. I/O Figmy jest w `defaultExtractRef`; parametr `extractRef` pozwala
+ * przejechać etap bez sieci (testy).
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+import fs from 'node:fs';
+
+import yaml from 'yaml';
+
+import { resolveFigmaToken, getNode, getNodes, flattenLocalVariables } from '../../../scripts/figma/figma-client.js';
+import { loadTokenMap, loadDsComponentMap, combineParityResolvers } from '../../../scripts/figma/mappings.js';
+import { createCustomComponentResolver } from '../../../scripts/design-extract/component-resolver.js';
+import { extractWholeFrameIr } from '../../../scripts/design-extract/whole-frame.js';
+import { trimDesignIrForCoder } from '../../../scripts/design-extract/component-slice.js';
+import { getIndex } from '../../../scripts/code-index/index.js';
+import { FIGMA_VARIABLES, FIGMA_MAPPINGS } from '../../../scripts/project-config.js';
+import { artifactPaths, writeYaml } from './paths.js';
+import { parseFigmaRefs } from './figma-refs.js';
+
+const CACHE_DIR = './node_modules/.cache/figma';   // wspólny bufor REST co reszta ekstrakcji
+
+/**
+ * Deterministyczna ekstrakcja design_ir dla jednego odniesienia (prawdziwe I/O Figmy).
+ * Buduje resolver parity (custom z code-index + DS z mapy), wczytuje nazwy tokenów,
+ * pobiera ramę i składa IR. Brak tokenu Figmy → rzuca (wołający degraduje ramę).
+ * @param {{url: string, fileKey: string, nodeId: string}} ref
+ * @returns {Promise<{ir: object, warnings: string[]}>}
+ */
+async function defaultExtractRef(ref) {
+  const token = resolveFigmaToken();
+  if (!token) throw new Error('brak FIGMA_API_KEY — makieta niepobrana');
+
+  const db = getIndex();
+  const mappings = FIGMA_MAPPINGS ?? {};
+  const componentResolver = combineParityResolvers({
+    custom: createCustomComponentResolver({ db }),
+    ds: loadDsComponentMap(mappings.dsComponentMap, { log: { warn: () => {} } }),
+  });
+
+  let variablesById = {};
+  try {
+    const raw = JSON.parse(fs.readFileSync(FIGMA_VARIABLES.exportPath, 'utf8')) || {};
+    variablesById = (raw.meta && raw.meta.variables) ? flattenLocalVariables(raw) : raw;
+  } catch { /* brak/parse-fail export-file → tokeny resolved:false */ }
+  const tokenMap = loadTokenMap(mappings.tokenMap, {
+    log: { warn: () => {} },
+    primitivePattern: mappings.primitiveVarPattern,
+  });
+
+  const { json } = await getNode({ fileKey: ref.fileKey, nodeId: ref.nodeId, token, cacheDir: CACHE_DIR });
+  return extractWholeFrameIr({
+    json,
+    nodeId: ref.nodeId,
+    figmaFile: ref.fileKey,
+    componentResolver,
+    variablesById,
+    tokenMap,
+    fetchComponentNodes: (ids) => getNodes({ fileKey: ref.fileKey, nodeIds: ids, token, cacheDir: CACHE_DIR }),
+  });
+}
+
+/**
+ * @param {object} args
+ * @param {string} args.featureDir — identyfikator funkcjonalności
+ * @param {(message: string) => void} [args.onLog]
+ * @param {(ref: object) => Promise<{ir: object, warnings: string[]}>} [args.extractRef] — port ekstrakcji (I/O wstrzykiwane)
+ * @returns {Promise<{ok: boolean, reason?: string}>}
+ */
+export async function runStage({ featureDir, onLog = () => {}, extractRef = defaultExtractRef }) {
+  const paths = artifactPaths(featureDir);
+  if (!fs.existsSync(paths.story)) return { ok: false, reason: `brak treści story (${paths.story})` };
+
+  const story = fs.readFileSync(paths.story, 'utf8');
+  const refs = parseFigmaRefs(story);
+
+  if (refs.length === 0) {
+    writeYaml(paths.designIr, { design: { status: 'no-mockup', frames: [], open_questions: [] } });
+    onLog('brak linku Figmy w story — UI nieimplementowane, zostaje standardowy szablon');
+    return { ok: true };
+  }
+
+  const frames = [];
+  for (const ref of refs) {
+    try {
+      const { ir, warnings } = await extractRef(ref);
+      frames.push({ ref, design_ir: ir, warnings: warnings ?? [] });
+    } catch (error) {
+      frames.push({ ref, design_ir: null, error: error.message });   // fail-soft: rama zdegradowana, nie stop
+    }
+  }
+
+  const open_questions = [];
+  if (refs.length > 1) {
+    // Wielorama: podział na ekrany/regiony wymaga opisu powiązań w treści; deterministyczna
+    // ekstrakcja go nie wywnioskuje, więc surfacing do człowieka bez blokady.
+    open_questions.push({
+      topic: 'design-frame-relationships',
+      question: `Story wskazuje ${refs.length} ram Figmy. Opisz ich powiązania (który ekran/region jest którym), jeśli nie wynika to jednoznacznie z treści story.`,
+      target: 'analityk',
+    });
+  }
+
+  const built = frames.filter((frame) => frame.design_ir).length;
+  const status = built > 0 ? 'ok' : 'degraded';
+  writeYaml(paths.designIr, { design: { status, frames, open_questions } });
+  onLog(`design_ir z ${built}/${refs.length} ram → ${paths.designIr}`);
+  return { ok: true };
+}
+
+/**
+ * Projekcja artefaktu makiety dla planera: YAML z design_ir zbudowanych ram +
+ * ewentualne pytania o powiązania. Brak artefaktu / status no-mockup / wszystkie
+ * ramy zdegradowane → pusty string (planer dostaje wtedy „(brak makiety)").
+ * @param {string} featureDir
+ * @returns {string}
+ */
+export function loadDesignIrForPlanner(featureDir) {
+  const paths = artifactPaths(featureDir);
+  if (!fs.existsSync(paths.designIr)) return '';
+
+  let design;
+  try {
+    design = yaml.parse(fs.readFileSync(paths.designIr, 'utf8'))?.design;
+  } catch {
+    return '';   // artefakt nieczytelny — planer bez makiety, nie stop
+  }
+
+  if (!design || design.status === 'no-mockup') return '';
+  const built = (design.frames ?? []).filter((frame) => frame.design_ir);
+  if (built.length === 0) return '';   // wszystkie ramy zdegradowane → planer bez makiety
+
+  const payload = {
+    frames: built.map((frame) => ({ source: frame.ref?.url, design_ir: frame.design_ir })),
+    ...(design.open_questions?.length ? { open_questions: design.open_questions } : {}),
+  };
+  return yaml.stringify(payload);
+}
+
+/**
+ * Projekcja artefaktu makiety dla fazy wykonania: odchudzone IR zbudowanych ram.
+ *
+ * Odchudzenie tutaj, a nie przy zadaniu, bo jest wspólne dla wszystkich zadań:
+ * pytania do projektanta, pola procesu i tokeny typografii nie są wsadem żadnego
+ * z nich. Partycja per zadanie następuje później — dopiero ona zna jego zakres.
+ *
+ * @param {string} featureDir
+ * @returns {Array<{source: string|undefined, ir: object}>} pusta lista, gdy makiety
+ *          nie ma, artefakt jest nieczytelny albo wszystkie ramy są zdegradowane.
+ */
+export function loadDesignIrForBuild(featureDir) {
+  const paths = artifactPaths(featureDir);
+  if (!fs.existsSync(paths.designIr)) return [];
+
+  let design;
+  try {
+    design = yaml.parse(fs.readFileSync(paths.designIr, 'utf8'))?.design;
+  } catch {
+    return [];   // artefakt nieczytelny — zadania bez makiety, nie stop
+  }
+
+  if (!design || design.status === 'no-mockup') return [];
+
+  return (design.frames ?? [])
+    .filter((frame) => frame.design_ir)
+    .map((frame) => ({ source: frame.ref?.url, ir: trimDesignIrForCoder(frame.design_ir) }));
+}

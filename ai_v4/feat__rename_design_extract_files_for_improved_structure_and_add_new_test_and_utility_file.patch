+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Faza testów — przebieg osobnej sesji piszącej dowód zachowania.
+ *
+ * Sesja pisze, a rozstrzygają POMIARY: lista zmienionych plików pochodzi z drzewa
+ * roboczego, a nie z deklaracji odpowiedzi, kolor biegu z raportu testów, pokrycie
+ * z mapy przebiegu. Odpowiedź sesji jest tu wyłącznie kanałem eskalacji.
+ *
+ * Trzy rzeczy muszą zajść naraz, żeby faza się udała: tester tknął wyłącznie pliki
+ * testów, bieg jest czerwony Z WŁAŚCIWEGO POWODU i każde kryterium ma dowód, którego
+ * można nie zdać. Brak któregokolwiek wraca rundą naprawczą do testera — z jednym
+ * wyjątkiem: błąd w źródłach nie jest jego pracą i wraca wyżej, do kodera.
+ *
+ * Kroki dotykające dysku i powłoki są WSTRZYKIWANE — moduł nie wie, czym uruchamia
+ * się testy ani skąd bierze się lista zmian.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+import { TESTER } from '../config/global-config.js';
+import { classifyRed, RED_VERDICTS, RED_ROUTES } from './red-verdict.js';
+import { isTestFile } from './test-files.js';
+import { criteriaCoverage } from './criteria-coverage.js';
+import { detectEscalation } from './implementer.js';
+
+/** Powody rundy naprawczej, które nie pochodzą z werdyktu biegu. */
+const NO_CHANGES = 'brak zmian w drzewie roboczym';
+const OUT_OF_SCOPE = 'zmiana poza plikami testów';
+const NO_COVERAGE = 'kryterium bez dowodu';
+
+/** Zamknięcie fazy — kształt wspólny dla sukcesu i każdego zatrzymania. */
+function outcome({ ok, route = null, reason = null, verdict = null, files = [], rounds, transcript, escalated = false, question = null, findings = [] }) {
+  return { ok, route, reason, verdict, files, rounds, transcript, escalated, question, findings };
+}
+
+/** Polecenie rundy naprawczej: co jest nie tak i czego wolno dotknąć. */
+function repairPrompt({ verdict, reason, findings, offending }) {
+  const head = {
+    [NO_CHANGES]: 'Nie zmieniłeś żadnego pliku — testy nie powstały.',
+    [OUT_OF_SCOPE]: `Zmieniłeś pliki spoza fazy testów: ${offending?.join(', ')}. Cofnij te zmiany.`,
+    [NO_COVERAGE]: `Kryteria bez dowodu:\n${(findings ?? []).map((finding) => `- ${finding.message}`).join('\n')}`,
+    [RED_VERDICTS.TEST_COMPILE]: `Plik testu nie doszedł do wykonania: ${reason}`,
+    [RED_VERDICTS.GREEN]: `${reason} Testy mają opisywać zachowanie, którego jeszcze nie ma — szkielet ma puste ciała, więc poprawnie napisany przypadek MUSI opaść.`,
+    [RED_VERDICTS.REGRESSION]: `${reason} Dostosuj zastany test do kontraktu z kryteriów; faza implementacji już go nie tknie.`,
+  }[verdict] ?? String(reason ?? '');
+
+  return (
+    `${head}\n\n` +
+    'Popraw to TERAZ, edytując wyłącznie pliki `*.spec.ts` i `*.stories.ts` z listy plików do wypełnienia. ' +
+    'Po zakończeniu odpowiedz dokładnie: GOTOWE. ' +
+    'Jeśli przyczyna leży w szkielecie źródeł, a nie w teście — odpowiedz w pierwszej linii: ESKALACJA: <czego brakuje i dlaczego>.'
+  );
+}
+
+/**
+ * Prowadzi fazę testów do stanu, w którym testy żądają zachowania, którego nie ma.
+ *
+ * @param {object} args
+ * @param {{ask: (prompt: string) => Promise<{stdout: string}>}} args.session — sesja testera
+ * @param {string} args.brief — brif fazy (`buildTesterBrief`)
+ * @param {() => Promise<{report: object|null, reason: string|null}>} args.runTests — bieg testów wraz z odczytem raportu
+ * @param {() => Promise<string[]>} args.changedFiles — pliki zmienione w drzewie od początku fazy
+ * @param {(paths: string[]) => Promise<Record<string, string>>} [args.readFiles] — treści plików scen
+ * @param {{criteria?: Array}} args.map — mapa przebiegu z generatora skieletów
+ * @param {number} [args.maxRounds] — tury naprawcze testera
+ * @param {(message: string) => void} [args.onLog]
+ * @returns {Promise<{ok: boolean, route: string|null, reason: string|null, verdict: string|null,
+ *          files: string[], rounds: number, transcript: string[], escalated: boolean,
+ *          question: string|null, findings: Array}>}
+ *          `route` wskazuje, czyja jest naprawa, gdy faza się nie udała: `coder` przy
+ *          błędzie w źródłach, `null` gdy decyzja wraca do człowieka.
+ */
+export async function runTesterPhase({
+  session, brief, runTests, changedFiles, readFiles = async () => ({}), map,
+  maxRounds = TESTER.MAX_ROUNDS, onLog = () => {},
+}) {
+  const transcript = [];
+  let rounds = 0;
+  let prompt = brief;
+
+  for (;;) {
+    const response = await session.ask(prompt);
+    transcript.push(response.stdout);
+
+    const escalation = detectEscalation(response.stdout);
+    if (escalation) {
+      onLog(`tester: ESKALACJA → ${escalation}`);
+      return outcome({ ok: false, reason: escalation, rounds, transcript, escalated: true, question: escalation });
+    }
+
+    // Lista z drzewa, nie z odpowiedzi: deklaracja zmienionych plików bywa
+    // niepełna albo hojna, a bramka zamrożenia w fazie implementacji porówna
+    // się właśnie z tym, co w drzewie faktycznie leży.
+    const files = await changedFiles();
+    const offending = files.filter((file) => !isTestFile(file));
+
+    let problem = null;
+    if (files.length === 0) {
+      problem = { verdict: NO_CHANGES, reason: 'faza testów nie zostawiła żadnej zmiany' };
+    } else if (offending.length > 0) {
+      problem = { verdict: OUT_OF_SCOPE, reason: `zmiana poza plikami testów: ${offending.join(', ')}`, offending };
+    }
+
+    let verdict = null;
+    let report = null;
+    if (!problem) {
+      // Bieg testów raz na turę: ten sam raport odpowiada na oba pytania fazy —
+      // dlaczego jest czerwono i czy każde kryterium ma swój dowód.
+      const run = await runTests();
+      report = run.report;
+      verdict = classifyRed({ report, reason: run.reason, testerFiles: files });
+      onLog(`tester: bieg testów → ${verdict.verdict} (${verdict.reason})`);
+
+      if (verdict.verdict === RED_VERDICTS.UNREADABLE) {
+        return outcome({ ok: false, reason: verdict.reason, verdict: verdict.verdict, files, rounds, transcript });
+      }
+      if (verdict.route === RED_ROUTES.CODER) {
+        // Nie zużywa tury testera: naprawa nie jest jego pracą, a on i tak nie ma
+        // czym jej wykonać — źródła są poza plikami, które wolno mu dotknąć.
+        return outcome({ ok: false, route: RED_ROUTES.CODER, reason: verdict.reason, verdict: verdict.verdict, files, rounds, transcript });
+      }
+      if (verdict.route === RED_ROUTES.TESTER) {
+        problem = { verdict: verdict.verdict, reason: verdict.reason };
+      }
+    }
+
+    if (!problem) {
+      const storyFiles = await readFiles(files.filter((file) => file.endsWith('.stories.ts')));
+      const coverage = criteriaCoverage({ map, report, storyFiles });
+      if (!coverage.ok) {
+        onLog(`tester: pokrycie kryteriów → ${coverage.findings.length} braków`);
+        problem = { verdict: NO_COVERAGE, reason: coverage.findings[0].message, findings: coverage.findings };
+      } else {
+        onLog(`tester: czerwień z właściwego powodu, każde kryterium ma dowód (${files.length} plików)`);
+        return outcome({ ok: true, verdict: verdict.verdict, files, rounds, transcript });
+      }
+    }
+
+    if (rounds >= maxRounds) {
+      onLog(`tester: ${problem.reason} — tury naprawcze wyczerpane`);

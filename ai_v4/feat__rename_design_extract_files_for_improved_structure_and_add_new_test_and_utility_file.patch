+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Obecność dowodów — czego wymagamy od pliku źródłowego w zależności od tego,
+ * w jakiej warstwie leży.
+ *
+ * To JEDYNE miejsce z tymi wartościami. Wymóg jest ustalany po TYPIE warstwy,
+ * a nie po nazwie pliku: warstwa mówi, jakiego rodzaju zachowanie tam mieszka,
+ * a rodzaj zachowania rozstrzyga, czym da się je dowieść.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+/** Rodzaje dowodów, których obecność sprawdzamy. */
+export const PROOF_KINDS = Object.freeze({
+  /** Test jednostkowy obok pliku. */
+  SPEC: 'spec',
+  /** Scena Storybooka obok komponentu. */
+  STORIES: 'stories',
+});
+
+/**
+ * Dowody wymagane per typ warstwy.
+ *
+ * `model` i `asset` są zwolnione: pierwsza niesie same kształty danych, druga
+ * pliki bez logiki — nie ma tam zachowania, którego brak mógłby się ujawnić.
+ * Scen wymagamy wyłącznie tam, gdzie jest co obejrzeć, czyli w warstwach z widokiem.
+ */
+export const REQUIRED_PROOFS = Object.freeze({
+  ui: Object.freeze([PROOF_KINDS.SPEC, PROOF_KINDS.STORIES]),
+  feature: Object.freeze([PROOF_KINDS.SPEC, PROOF_KINDS.STORIES]),
+  state: Object.freeze([PROOF_KINDS.SPEC]),
+  core: Object.freeze([PROOF_KINDS.SPEC]),
+  util: Object.freeze([PROOF_KINDS.SPEC]),
+  model: Object.freeze([]),
+  asset: Object.freeze([]),
+});
+
+/**
+ * Pliki, od których nie wymagamy dowodu niezależnie od warstwy (źródła wzorców).
+ *
+ * Wspólny mianownik: plik nie niesie własnego zachowania. Barrel tylko przekazuje
+ * eksporty, deklaracja typów znika w kompilacji, konfiguracja testów jest
+ * rusztowaniem dowodu, nie jego przedmiotem.
+ */
+export const PROOF_EXEMPT_PATTERNS = Object.freeze([
+  '(^|/)index\\.ts$',
+  '\\.model\\.ts$',
+  '\\.d\\.ts$',
+  '(^|/)test-setup\\.ts$',
+  '(^|/)vite\\.config\\.mts$',
+]);
+
+/**
+ * Jednostki zwolnione punktowo — pełna ścieżka od korzenia repozytorium.
+ *
+ * Lista jest jawna z zasady: zwolnienie ma być widoczne w przeglądzie i ginąć
+ * razem z powodem, dla którego powstało. Wzorzec pasujący do wielu plików
+ * ukrywałby kolejne braki, które wejdą pod niego po cichu.
+ */
+export const PROOF_EXEMPT_FILES = Object.freeze([]);

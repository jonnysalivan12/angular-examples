+      errors: [{ messageId: 'identifierInName' }],
+    },
+    {
+      name: 'identyfikator kryterium w nazwie przypadku',
+      code: "it('AC-2: blokuje pola na czas wysyłki', () => {});",
+      errors: [{ messageId: 'identifierInName' }],

@@ -0,0 +1,179 @@
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Fazy zadania — kolejność pracy nad zadaniem, które ma być dowiedzione testem.
+ *
+ * Zadanie idzie: ① szkielet (kształt bez zachowania) → ② skielety testów i scen
+ * (krok maszynowy) → ③ testy (osobna sesja, bez wiedzy o implementacji) →
+ * ④ implementacja do zieleni.
+ *
+ * Kolejność nie jest kwestią stylu. Testy pisane PO implementacji sprawdzają to,
+ * co powstało, zamiast tego, czego żąda kontrakt; testy pisane PRZED szkieletem
+ * nie mają się o co oprzeć i opadają na błędach kompilacji, a nie na braku
+ * zachowania. Szkielet ustawia kształt, testy opisują żądanie, implementacja
+ * odpowiada.
+ *
+ * Przejścia rozstrzyga ten moduł, nie treść odpowiedzi modelu: faza kończy się
+ * wynikiem sprawdzenia, a nie deklaracją, że zrobione.
+ *
+ * Wszystkie kroki są WSTRZYKIWANE. Brak kroku oznacza jego pominięcie, więc
+ * przepływ da się złożyć etapami i przejechać w całości bez sesji ani powłoki.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+import { implementTask, detectEscalation, SKELETON_INSTRUCTION } from './implementer.js';
+
+/** Nazwy faz — kolejność jak w przebiegu, wartości trafiają do wyniku i logu. */
+export const TASK_PHASES = Object.freeze({
+  SKELETON: 'szkielet',
+  SKELETONS_GENERATED: 'skielety-testów',
+  TESTS: 'testy',
+  IMPLEMENTATION: 'implementacja',
+});
+
+/** Adresat naprawy zgłoszony przez fazę testów, gdy przyczyna leży w źródłach. */
+const CODER_ROUTE = 'coder';
+
+/**
+ * Polecenie naprawy szkieletu w trakcie fazy testów.
+ *
+ * Testy są już napisane i od tej chwili zamrożone: przyczyna leży w kształcie,
+ * który szkielet wystawił, więc naprawa dotyczy źródeł. Test dopasowany do
+ * niedziałającego szkieletu przestałby żądać czegokolwiek.
+ */
+function sourceRepairPrompt(reason) {
+  return (
+    `Testy zadania nie mogą się wykonać, bo źródła nie doszły do kompilacji: ${reason}\n\n` +
+    'Napraw szkielet TERAZ. NIE edytuj plików `*.spec.ts` ani `*.stories.ts` — są już napisane ' +
+    'i opisują żądane zachowanie; ich ciała mają nadal opadać na jego braku. ' +
+    'Po zakończeniu odpowiedz dokładnie: GOTOWE. ' +
+    'Jeśli przyczyna leży poza zakresem zadania, odpowiedz w pierwszej linii: ESKALACJA: <co i dlaczego>.'
+  );
+}
+
+/** Wynik fazy, która nie doszła do końca — kształt wspólny z wynikiem całości. */
+function stopped(phase, result) {
+  return {
+    ok: false,
+    phase,
+    escalated: Boolean(result?.escalated),
+    question: result?.question ?? null,
+    reason: result?.reason ?? null,
+    rounds: result?.rounds ?? 0,
+    verification: result?.verification ?? null,
+    transcript: result?.transcript ?? [],
+    deviations: result?.deviations ?? [],
+  };
+}
+
+/**
+ * Prowadzi zadanie przez fazy do zieleni.
+ *
+ * @param {object} args
+ * @param {{ask: (prompt: string) => Promise<{stdout: string}>}} args.session — sesja wieloturowa kodera
+ * @param {string} args.brief — brif zadania
+ * @param {() => Promise<{ok: boolean, steps: Array}>} args.verifySkeleton — sprawdzenie po fazie szkieletu
+ * @param {() => Promise<{ok: boolean, steps: Array}>} args.verifyImplementation — sprawdzenie po implementacji
+ * @param {(() => Promise<{ok: boolean, reason?: string, files?: string[]}>)|null} [args.generateTestSkeletons]
+ *        — krok maszynowy między szkieletem a testami; brak = pomijany
+ * @param {(() => Promise<{ok: boolean, reason?: string, route?: string}>)|null} [args.runTests]
+ *        — faza testów w osobnej sesji wraz z jej bramkami; brak = pomijana.
+ *        `route: 'coder'` znaczy, że przyczyna leży w źródłach, nie w testach
+ * @param {number} [args.maxSourceRepairs=1] — naprawy szkieletu w trakcie fazy testów
+ * @param {number} [args.maxRepairRounds=2]
+ * @param {boolean} [args.canAskHuman=false]
+ * @param {(message: string) => void} [args.onLog]
+ * @returns {Promise<{ok: boolean, phase: string, escalated: boolean, question: string|null,
+ *          reason: string|null, rounds: number, verification: object|null,
+ *          transcript: string[], deviations: Array, phases: string[]}>}
+ *          `phase` niesie fazę, w której przebieg się zatrzymał albo zakończył;
+ *          `phases` to fazy faktycznie wykonane.
+ */
+export async function runTaskPhases({
+  session,
+  brief,
+  verifySkeleton,
+  verifyImplementation,
+  generateTestSkeletons = null,
+  runTests = null,
+  maxSourceRepairs = 1,
+  maxRepairRounds = 2,
+  canAskHuman = false,
+  onLog = () => {},
+}) {
+  const done = [];
+
+  onLog(`fazy: ${TASK_PHASES.SKELETON}`);
+  const skeleton = await implementTask({
+    session,
+    brief,
+    runVerification: verifySkeleton,
+    instruction: SKELETON_INSTRUCTION,
+    maxRepairRounds,
+    canAskHuman,
+    onLog,
+  });
+  done.push(TASK_PHASES.SKELETON);
+  if (!skeleton.ok) return { ...stopped(TASK_PHASES.SKELETON, skeleton), phases: done };
+
+  if (generateTestSkeletons) {
+    onLog(`fazy: ${TASK_PHASES.SKELETONS_GENERATED}`);
+    const generated = await generateTestSkeletons();
+    done.push(TASK_PHASES.SKELETONS_GENERATED);
+    if (!generated.ok) {
+      return { ...stopped(TASK_PHASES.SKELETONS_GENERATED, generated), transcript: skeleton.transcript, phases: done };
+    }
+  }
+
+  const testTranscript = [];
+  if (runTests) {
+    onLog(`fazy: ${TASK_PHASES.TESTS}`);
+    let tests = await runTests();
+
+    // Błąd w źródłach nie jest pracą testera — wraca do tej sesji, która szkielet
+    // zbudowała. Testy zostają nietknięte, więc po naprawie mierzymy to samo żądanie.
+    for (let repair = 1; !tests.ok && tests.route === CODER_ROUTE && repair <= maxSourceRepairs; repair += 1) {
+      onLog(`fazy: źródła nie kompilują się w fazie testów → naprawa szkieletu ${repair}/${maxSourceRepairs}`);
+      const response = await session.ask(sourceRepairPrompt(tests.reason));
+      testTranscript.push(response.stdout);
+
+      const escalation = detectEscalation(response.stdout);
+      if (escalation) {
+        return {
+          ...stopped(TASK_PHASES.TESTS, { escalated: true, question: escalation, reason: escalation }),
+          transcript: [...skeleton.transcript, ...testTranscript],
+          phases: [...done, TASK_PHASES.TESTS],
+        };
+      }
+      tests = await runTests();
+    }
+
+    done.push(TASK_PHASES.TESTS);
+    if (!tests.ok) {
+      return { ...stopped(TASK_PHASES.TESTS, tests), transcript: [...skeleton.transcript, ...testTranscript], phases: done };
+    }
+  }
+
+  onLog(`fazy: ${TASK_PHASES.IMPLEMENTATION}`);
+  const implementation = await implementTask({
+    session,
+    brief,
+    runVerification: verifyImplementation,
+    maxRepairRounds,
+    canAskHuman,
+    onLog,
+  });
+  done.push(TASK_PHASES.IMPLEMENTATION);
+
+  // Odstępstwa i zapis rozmowy z OBU tur modelu: faza szkieletu też bywa miejscem,
+  // w którym plan zostaje odstąpiony, a raport bez tego twierdziłby, że go trzymano.
+  return {
+    ok: implementation.ok,
+    phase: TASK_PHASES.IMPLEMENTATION,
+    escalated: implementation.escalated,
+    question: implementation.question,
+    reason: null,
+    rounds: implementation.rounds,
+    verification: implementation.verification,
+    transcript: [...skeleton.transcript, ...testTranscript, ...implementation.transcript],
+    deviations: [...skeleton.deviations, ...implementation.deviations],
+    phases: done,
+  };
+}

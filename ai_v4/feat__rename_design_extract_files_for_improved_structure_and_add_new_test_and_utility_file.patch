+      projectName: '',
+      directory: '',
+      libraryType,
+      sourceFiles: changedFiles ?? [],
+      exists,
+      readFile,
+    })
+    : [];
+  const ok = violations.length === 0;
+
+  return {
+    id: 'obecność dowodu',
+    command: 'każdy plik z zachowaniem ma test, komponent także scenę',
+    ok,
+    exitCode: ok ? 0 : 1,
+    durationMs: 0,
+    outputTail: ok ? '' : [
+      ...violations.map((violation) => violation.note),
+      '',
+      'Dopisz brakujące pliki. Jeśli jednostka NIE MA zachowania do dowiedzenia',

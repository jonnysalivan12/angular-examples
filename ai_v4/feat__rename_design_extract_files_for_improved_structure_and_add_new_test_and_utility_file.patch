+/** Skrót treści pliku; `null` dla pliku, którego nie ma. */
+function contentDigest(fullPath, fsPort) {
+  if (!fsPort.existsSync(fullPath)) return null;
+  return crypto.createHash('sha1').update(fsPort.readFileSync(fullPath)).digest('hex');
+}
+
+/**
+ * Migawka treści plików drzewa — punkt odniesienia dla FAZY wewnątrz zadania.
+ *
+ * Zadanie ma jeden commit, więc `git status` mierzy całą jego zmianę i nie odróżnia
+ * pracy jednej fazy od pracy poprzedniej. Commit pośredni rozwiązałby to kosztem
+ * zerwania tego pomiaru: pliki zacommitowane zniknęłyby ze statusu, a bramki diffu
+ * po zadaniu zobaczyłyby tylko ogon jego pracy.
+ *
+ * @param {object} args
+ * @param {string} args.worktreePath
+ * @param {string[]} args.files — ścieżki względne korzenia drzewa
+ * @param {object} [args.fsPort]
+ * @returns {Map<string, string|null>}
+ */
+export function fileSnapshot({ worktreePath, files, fsPort = fs }) {
+  const snapshot = new Map();
+  for (const file of files ?? []) {
+    snapshot.set(file, contentDigest(path.join(worktreePath, file), fsPort));
+  }
+  return snapshot;
+}
+
+/**
+ * Pliki, których treść różni się od migawki — także te, których w niej nie było.
+ *
+ * @param {object} args
+ * @param {Map<string, string|null>} args.snapshot — wynik `fileSnapshot`
+ * @param {string[]} args.files — pliki zmienione w drzewie DZIŚ
+ * @param {string} args.worktreePath
+ * @param {object} [args.fsPort]
+ * @returns {string[]}
+ */
+export function changedSince({ snapshot, files, worktreePath, fsPort = fs }) {
+  return (files ?? []).filter((file) => {
+    const before = snapshot.has(file) ? snapshot.get(file) : undefined;
+    return before !== contentDigest(path.join(worktreePath, file), fsPort);
+  });
+}

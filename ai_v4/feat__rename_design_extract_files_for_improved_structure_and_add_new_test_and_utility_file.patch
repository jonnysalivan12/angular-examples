+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Skielety testów w drzewie zadania — krok maszynowy między szkieletem a testami.
+ *
+ * Zero modelu poza jednym: nazwy obszarów dla bloków `describe`. Cała reszta —
+ * które pliki powstają, jakie mają importy, które kryterium dowodzi się testem,
+ * a które sceną — jest wyliczona, więc powtórzenie kroku daje te same bajty.
+ *
+ * Dwa rodzaje zadań obsługiwane osobno, bo mają różne wejście:
+ *   - komponent: API da się odczytać z pliku, więc szkielet powstaje z treścią
+ *     (TestBed, sterowniki wejść, bloki kryteriów) i tester dopisuje same asercje;
+ *   - reszta warstw: nie ma czego parsować, więc powstaje sama LISTA plików do
+ *     napisania wraz z nazwami bloków — mapa kryteriów wychodzi taka sama, bo
+ *     bramka pokrycia szuka bloków po nazwie, nie po pliku.
+ *
+ * Plik, który już istnieje, NIE jest nadpisywany: zastany test to cudza praca,
+ * a nie miejsce po szkielecie.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+import { buildComponentTestSkeletons, resolveDescribeTopics } from '../../../../scripts/generators/component-tests/index.js';
+import { isTestFile } from './test-files.js';
+
+/** Poziomy weryfikacji, które mają dowód w testach. */
+const PROVEN_LEVELS = Object.freeze(['unit', 'component']);
+
+/** Pliki, z których nie powstaje dowód: bez zachowania albo bez własnej treści. */
+const NOT_PROVEN = /(\.model\.ts|\.d\.ts|index\.ts)$/;
+
+/** Ścieżka pliku testu obok pliku źródłowego. */
+function specPathFor(sourcePath) {
+  return sourcePath.replace(/\.ts$/, '.spec.ts');
+}
+
+/** Wpis mapy dla kryterium bez odczytanego API — sam blok, plik do wyboru przez testera. */
+function mapEntry(criterion, topic, file) {
+  return { id: criterion.id, topic: topic ?? null, describe: topic || criterion.text, file, level: criterion.verification };
+}
+
+/**
+ * Zakłada skielety testów dla plików źródłowych zadania.
+ *
+ * @param {object} args
+ * @param {string[]} args.sourceFiles — pliki zmienione w fazie szkieletu
+ * @param {Array<{id: string, text: string, verification: string}>} args.criteria — kryteria planu
+ * @param {(path: string) => string|null} args.readFile — treść pliku drzewa; null gdy nie istnieje
+ * @param {(path: string, content: string) => void} args.writeFile
+ * @param {(path: string) => boolean} args.exists
+ * @param {((prompt: string) => Promise<string>)|null} [args.askTopics] — nazwy obszarów; brak = bloki dostaną treść kryteriów
+ * @param {(message: string) => void} [args.onLog]
+ * @returns {Promise<{ok: boolean, reason: string|null, files: string[], expected: string[], map: object, warnings: string[]}>}
+ *          `files` to skielety zapisane w drzewie, `expected` — pliki, które ma
+ *          napisać tester; obie listy wchodzą do jego brifu.
+ */
+export async function generateTestSkeletons({ sourceFiles, criteria, readFile, writeFile, exists, askTopics = null, onLog = () => {} }) {
+  const proven = (criteria ?? []).filter((criterion) => PROVEN_LEVELS.includes(criterion.verification));
+  if (proven.length === 0) {
+    return { ok: false, reason: 'żadne kryterium planu nie jest dowodzone testem ani sceną', files: [], expected: [], map: { criteria: [] }, warnings: [] };
+  }
+
+  const candidates = (sourceFiles ?? [])
+    .map((file) => String(file).replace(/\\/g, '/'))
+    .filter((file) => file.endsWith('.ts') && !isTestFile(file) && !NOT_PROVEN.test(file));
+  if (candidates.length === 0) {
+    return { ok: false, reason: 'faza szkieletu nie zostawiła pliku, dla którego da się założyć test', files: [], expected: [], map: { criteria: [] }, warnings: [] };
+  }
+
+  const { topics, degraded, reason } = await resolveDescribeTopics({ criteria: proven, ask: askTopics, onLog });
+  if (degraded) onLog(`skielety testów: nazwy obszarów zdegradowane (${reason})`);
+
+  const files = [];
+  const expected = [];
+  const warnings = [];
+  const entries = [];
+  let component = null;
+
+  for (const sourcePath of candidates) {
+    const source = readFile(sourcePath);
+    if (source === null) {
+      warnings.push(`nie odczytano '${sourcePath}'`);
+      continue;
+    }
+
+    const built = buildComponentTestSkeletons({ componentPath: sourcePath, componentSource: source, criteria: proven, topics });
+    warnings.push(...built.warnings);
+
+    // Plik bez odczytanego komponentu nie daje szkieletu — zostaje po nim ścieżka
+    // testu do napisania. Kryteria dopisujemy dopiero, gdy ŻADEN plik zadania nie
+    // okazał się komponentem: inaczej ten sam blok miałby dwa adresy.
+    if (built.map.component === null || built.files.length === 0) {
+      const specPath = specPathFor(sourcePath);
+      if (!exists(specPath)) expected.push(specPath);
+      continue;
+    }
+
+    component = built.map.component;
+    entries.push(...built.map.criteria);
+    for (const file of built.files) {
+      if (exists(file.path)) {
+        onLog(`skielety testów: '${file.path}' już istnieje — nietknięty`);
+        continue;
+      }
+      writeFile(file.path, file.content);
+      files.push(file.path);
+    }
+  }
+
+  if (entries.length === 0) {
+    for (const criterion of proven) entries.push(mapEntry(criterion, topics[criterion.id], expected[0] ?? null));
+  }
+
+  if (files.length === 0 && expected.length === 0) {
+    return { ok: false, reason: 'nie powstał ani jeden plik testu — wszystkie już istnieją albo nie ma dla czego', files, expected, map: { component, criteria: entries }, warnings };
+  }
+
+  onLog(`skielety testów: ${files.length} zapisanych, ${expected.length} do napisania, ${entries.length} kryteriów w mapie`);
+  return { ok: true, reason: null, files, expected, map: { component, criteria: entries }, warnings };
+}

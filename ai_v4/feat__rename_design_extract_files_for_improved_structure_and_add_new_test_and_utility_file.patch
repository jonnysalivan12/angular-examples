+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Skielety testu i scen komponentu — jedno wejście dla wszystkich konsumentów.
+ *
+ * Skielet powstaje z dwóch źródeł, oba już istniejące: API komponentu odczytane
+ * z jego pliku oraz kryteria akceptacji wraz z poziomem, na którym są dowodzone.
+ * Kryterium dowodzone testem jednostkowym trafia do pliku testu, dowodzone sceną
+ * do katalogu scen — plik bez ani jednego kryterium nie powstaje.
+ *
+ * Nazwy obszarów są WEJŚCIEM, nie produktem tego modułu: ustala je ten, kto ma
+ * dostęp do modelu, a tutaj wchodzą gotowe albo wcale. Dzięki temu wywołanie jest
+ * powtarzalne — te same wejścia dają te same bajty.
+ *
+ * Powłoka CLI na końcu pliku działa wyłącznie przy bezpośrednim uruchomieniu
+ * i nie woła żadnego modelu: nazwy obszarów bierze z mapy poprzedniego przebiegu.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+import fs from 'node:fs';
+import path from 'node:path';
+import { pathToFileURL } from 'node:url';
+
+import { parseComponentApi } from './component-api.js';
+import { renderSpecSkeleton } from './spec-skeleton.js';
+import { renderStoriesSkeleton, storyTitleFrom } from './stories-skeleton.js';
+import { buildVerificationMap, topicsFromMap } from './verification-map.js';
+import { parseCommandLine } from '../ngxs/utils/arg-parser.js';
+
+export { parseComponentApi } from './component-api.js';
+export { renderSpecSkeleton } from './spec-skeleton.js';
+export { renderStoriesSkeleton, storyTitleFrom, storyExportName } from './stories-skeleton.js';
+export { buildVerificationMap, topicsFromMap } from './verification-map.js';
+export { TODO_MARKER, hasTodoMarker } from './todo-marker.js';
+export { resolveDescribeTopics, buildTopicsPrompt, parseTopicsOutput } from './describe-topics.js';
+
+/** Ścieżka pliku obok komponentu, z podmienionym sufiksem. */
+function siblingPath(componentPath, suffix) {
+  const directory = path.dirname(componentPath);
+  const base = path.basename(componentPath, '.ts');
+  return path.join(directory, `${base}${suffix}`).replace(/\\/g, '/');
+}
+
+/**
+ * Buduje skielety testu i scen dla jednego komponentu.
+ *
+ * @param {object} args
+ * @param {string} args.componentPath — ścieżka pliku komponentu w repozytorium
+ * @param {string} args.componentSource — treść pliku komponentu
+ * @param {Array<{id: string, text: string, verification: string}>} args.criteria — kryteria zadania
+ * @param {Record<string, string>} [args.topics] — nazwy obszarów per identyfikator kryterium
+ * @param {string} [args.title] — tytuł w katalogu scen; brak = wyprowadzony ze ścieżki
+ * @returns {{files: Array<{path: string, content: string}>, map: object, warnings: string[]}}
+ *          `files` niesie wyłącznie pliki, które mają co zawierać.
+ */
+export function buildComponentTestSkeletons({ componentPath, componentSource, criteria, topics = {}, title = null }) {
+  const api = parseComponentApi(componentSource, { fileName: componentPath });
+  const componentFileName = path.basename(componentPath);
+
+  const specPath = siblingPath(componentPath, '.spec.ts');
+  const storiesPath = siblingPath(componentPath, '.stories.ts');
+
+  const spec = renderSpecSkeleton({ api, componentFileName, criteria, topics });
+  const stories = renderStoriesSkeleton({
+    api,
+    componentFileName,
+    title: title ?? storyTitleFrom(componentPath, api.className),
+    criteria,
+    topics,
+  });
+
+  const files = [];
+  const entries = [];
+  if (spec) {
+    files.push({ path: specPath, content: spec.content });
+    entries.push(...spec.criteria.map((entry) => ({ ...entry, file: specPath, level: 'unit' })));
+  }
+  if (stories) {
+    files.push({ path: storiesPath, content: stories.content });
+    entries.push(...stories.criteria.map((entry) => ({ ...entry, file: storiesPath, level: 'component' })));
+  }
+
+  return {
+    files,
+    map: buildVerificationMap({ component: api.className, entries, topics }),
+    warnings: api.warnings,
+  };
+}
+
+/* ── Powłoka CLI (uruchamiana wyłącznie bezpośrednim `node component-tests/index.js`) ── */
+
+function printUsage() {
+  console.log('Skielety testu i scen komponentu — uruchamiaj z korzenia repozytorium.');
+  console.log('');
+  console.log('Użycie:');
+  console.log('  node scripts/generators/component-tests/index.js \\');
+  console.log('    --component <ścieżka/do/x.component.ts> --criteria <ścieżka/do/kryteriow.json> \\');
+  console.log('    [--map <mapa-poprzedniego-przebiegu.json>] [--title <Kontekst/Nazwa>] [--dry-run]');
+  console.log('');
+  console.log('Plik kryteriów: [{ "id": "AC-1", "text": "...", "verification": "unit|component" }]');
+  console.log('Nazwy obszarów nie są tu nadawane — wchodzą z mapy poprzedniego przebiegu (--map).');
+}
+
+function readJson(filePath) {
+  return JSON.parse(fs.readFileSync(filePath, 'utf8'));
+}
+
+function main() {
+  const { options } = parseCommandLine(process.argv.slice(2));
+
+  if (options.help || !options.component || !options.criteria) {
+    printUsage();
+    process.exitCode = options.help ? 0 : 1;
+    return;
+  }
+
+  const componentPath = String(options.component).replace(/\\/g, '/');
+  const result = buildComponentTestSkeletons({
+    componentPath,
+    componentSource: fs.readFileSync(componentPath, 'utf8'),
+    criteria: readJson(options.criteria),
+    topics: options.map ? topicsFromMap(readJson(options.map)) : {},
+    title: options.title ?? null,
+  });
+
+  for (const warning of result.warnings) console.error(`[component-tests] ${warning}`);
+  if (result.files.length === 0) {
+    console.error('[component-tests] żadne kryterium nie jest dowodzone testem ani sceną — nic nie powstaje');
+    process.exitCode = 1;
+    return;
+  }
+
+  for (const file of result.files) {
+    if (fs.existsSync(file.path)) {
+      console.error(`[component-tests] pominięte — '${file.path}' już istnieje`);
+      continue;
+    }
+    console.log(`[component-tests] ${options.dryRun ? 'wygenerowano (dry-run)' : 'zapisano'}: ${file.path}`);
+    if (!options.dryRun) fs.writeFileSync(file.path, file.content);
+  }
+
+  console.log(JSON.stringify(result.map, null, 2));
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {
+  main();
+}

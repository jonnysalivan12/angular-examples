+  const contracts = {};
+  try {
+    const { nodesById } = await fetchComponentNodes([...targets]);
+    for (const [id, entry] of Object.entries(nodesById ?? {})) {
+      const contract = parseComponentContract(entry?.document?.componentPropertyDefinitions);
+      if (contract) contracts[id] = contract;
+    }

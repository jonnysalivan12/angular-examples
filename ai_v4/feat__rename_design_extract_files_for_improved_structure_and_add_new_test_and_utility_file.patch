@@ -0,0 +1,102 @@
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Scaffold bibliotek planu — krok DETERMINISTYCZNY, jeden dla całego planu.
+ *
+ * Powstanie biblioteki jest w całości wyliczalne z pól semantycznych, więc nie
+ * ma tu sesji ani modelu: nazwę, katalog, alias, prefiks, tagi i weryfikację
+ * produktu dostarcza wspólny generator, a warstwę planu (wybór bibliotek `new`
+ * i tłumaczenie struktury) — fasada `Coder`. Ten liść dokłada wyłącznie przebieg
+ * po WSZYSTKICH bibliotekach planu.
+ *
+ * Biblioteki powstają RAZ, przed pracą nad zadaniami, a nie przy zadaniu, które
+ * pierwsze ich potrzebuje. Dwa zadania jednej fali dopisujące alias importu
+ * pracują w osobnych drzewach roboczych, więc ten sam plik aliasów rozjeżdżałby
+ * się przy scalaniu fali — a alias biblioteki nie należy do zakresu żadnego
+ * zadania, więc nie ma czym takiego rozjazdu rozstrzygnąć.
+ *
+ * Bieg NIE zatrzymuje się na pierwszej porażce: pełna lista bibliotek, które nie
+ * powstały, jest warta więcej niż pierwsza z nich.
+ *
+ * Zero I/O: powłoka, odczyt i zapis plików są wstrzykiwane.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+import { Coder } from '../coder/index.js';
+
+/**
+ * Składa specyfikacje generacji dla bibliotek o statusie `new`, w kolejności
+ * z planu — biblioteki powstają niezależnie od siebie, więc kolejność nie jest
+ * harmonogramem, tylko gwarancją tego samego logu przy każdym uruchomieniu.
+ *
+ * @param {object} plan — znormalizowany plan (`Templates.parsePlan`)
+ * @param {object} [naming] — override konwencji nazewniczej (m.in. `root` do odczytu prefiksu)
+ * @returns {{scaffolds: Array<{libraryName: string, spec: object}>,
+ *            findings: Array<{severity: string, message: string}>}}
+ *          `findings` niesie biblioteki, dla których specyfikacji nie da się złożyć.
+ */
+export function newLibraryScaffolds(plan, naming = {}) {
+  const scaffolds = [];
+  const findings = [];
+
+  for (const library of Coder.scaffoldTargets(plan)) {
+    let spec;
+    try {
+      spec = Coder.scaffoldSpec({ plan, libraryName: library.name, naming });
+    } catch (cause) {
+      findings.push({ severity: 'error', message: cause.message });
+      continue;
+    }
+
+    // Rozbieżność nazwy nie jest literówką do poprawienia w locie: plan i kanon
+    // mówią wtedy o dwóch różnych bibliotekach, a zadania wskazują tę z planu.
+    if (spec.name !== library.name) {
+      findings.push({
+        severity: 'error',
+        message: `nowa biblioteka '${library.name}': kanon z pól strukturalnych daje nazwę '${spec.name}' — plan i kanon mówią o dwóch różnych bibliotekach`,
+      });
+      continue;
+    }
+    scaffolds.push({ libraryName: library.name, spec });
+  }
+
+  return { scaffolds, findings };
+}
+
+/**
+ * Generuje biblioteki planu i weryfikuje każdą przeciw kanonowi. Idempotentna:
+ * istniejący szkielet jest pomijany, ale NADAL weryfikowany.
+ *
+ * @param {object} args
+ * @param {object} args.plan — znormalizowany plan
+ * @param {object} [args.naming] — override konwencji nazewniczej (m.in. `root`)
+ * @param {(command: string) => Promise<{exitCode: number, output: string}>} args.execCommand — powłoka w drzewie docelowym
+ * @param {(path: string) => object|null} args.readJson — ścieżki względne korzenia drzewa docelowego
+ * @param {(path: string, value: object) => void} [args.writeJson] — brak = cele dopisane przez generator zostają
+ * @param {(message: string) => void} [args.onLog]
+ * @returns {Promise<{ok: boolean, libraries: Array<{name: string, skipped: boolean, ok: boolean}>,
+ *          findings: Array<{severity: string, message: string}>}>}
+ *          `libraries` niesie biblioteki tknięte w tym biegu, także pominięte jako istniejące.
+ */
+export async function scaffoldPlanLibraries({ plan, naming = {}, execCommand, readJson, writeJson = null, onLog = () => {} }) {
+  const { scaffolds, findings } = newLibraryScaffolds(plan, naming);
+  const libraries = [];
+
+  if (scaffolds.length === 0 && findings.length === 0) {
+    onLog('scaffold: plan nie wprowadza nowych bibliotek');
+    return { ok: true, libraries, findings };
+  }
+
+  for (const { libraryName, spec } of scaffolds) {
+    const result = await Coder.runScaffold({ spec, execCommand, readJson, writeJson, onLog });
+    libraries.push({ name: libraryName, skipped: result.skipped, ok: result.ok });
+
+    for (const finding of result.findings) {
+      findings.push({ severity: finding.severity, message: `biblioteka '${libraryName}': ${finding.message}` });
+    }
+    if (!result.ok && result.output) {
+      findings.push({ severity: 'error', message: `biblioteka '${libraryName}': wyjście generatora — ${result.output.slice(-2000)}` });
+    }
+  }
+
+  const ok = findings.every((finding) => finding.severity !== 'error');
+  onLog(`scaffold: ${libraries.filter((library) => library.ok).length}/${scaffolds.length} bibliotek zgodnych z kanonem`);
+  return { ok, libraries, findings };
+}

+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Pokrycie kryteriów — czy każde kryterium ma dowód, którego można nie zdać.
+ *
+ * Szkielet zostawia po sobie dwa rodzaje pustki i żadna z nich nie zgłasza się
+ * sama tak samo: zapowiedź `it.todo` jest raportowana jako niewykonana, ale scena
+ * bez interakcji RENDERUJE SIĘ I PRZECHODZI. Dlatego pokrycie testów jednostkowych
+ * czyta się ze statusów biegu, a pokrycie scen z treści pliku i z pozostawionych
+ * znaczników.
+ *
+ * Powiązanie kryterium z blokiem bierze się z mapy przebiegu, nie z nazw w kodzie:
+ * nazwy opisują wyłącznie zachowanie, więc identyfikator kryterium nie ma prawa
+ * w nich wystąpić. Blok, którego mapa nie znajduje, jest zgłaszany jako brak
+ * dowodu — przemianowanie bez aktualizacji mapy zrywa jedyne powiązanie.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+import { TODO_MARKER } from '../../../../scripts/generators/component-tests/todo-marker.js';
+import { testCases, isPending } from './vitest-report.js';
+
+/** Poziomy weryfikacji, których dowód sprawdza ta bramka. */
+const LEVELS = Object.freeze({ UNIT: 'unit', COMPONENT: 'component' });
+
+/** Treść pliku po zakończeniu ścieżki — mapa niesie ścieżki repozytorium, klucze bywają bezwzględne. */
+function contentFor(files, filePath) {
+  const wanted = String(filePath ?? '').replace(/\\/g, '/');
+  if (!wanted) return null;
+  const key = Object.keys(files ?? {}).find((candidate) => {
+    const normalized = String(candidate).replace(/\\/g, '/');
+    return normalized === wanted || normalized.endsWith(wanted) || wanted.endsWith(normalized);
+  });
+  return key === undefined ? null : files[key];
+}
+
+/** Ciało sceny: od jej eksportu do następnego eksportu albo końca pliku. */
+function storyBody(content, exportName) {
+  const start = new RegExp(`export\\s+const\\s+${exportName}\\b`).exec(content ?? '');
+  if (!start) return null;
+  const rest = content.slice(start.index + start[0].length);
+  const next = /\nexport\s+const\s/.exec(rest);
+  return next ? rest.slice(0, next.index) : rest;
+}
+
+/** Dowód kryterium dowodzonego testem jednostkowym: blok istnieje i nie został w zapowiedzi. */
+function unitFindings(criterion, report) {
+  const inBlock = testCases(report).filter((entry) => (entry.describePath ?? []).includes(criterion.describe));
+
+  if (inBlock.length === 0) {
+    return [`blok '${criterion.describe}' nie występuje w biegu testów — przemianowany bez aktualizacji mapy albo usunięty`];
+  }
+
+  const pending = inBlock.filter((entry) => isPending(entry.status));
+  if (pending.length > 0) {
+    return [`blok '${criterion.describe}' został w zapowiedzi: ${pending.map((entry) => `'${entry.title}'`).join(', ')}`];
+  }
+  return [];
+}
+
+/** Dowód kryterium dowodzonego sceną: scena istnieje i ma interakcję. */
+function componentFindings(criterion, storyFiles) {
+  const content = contentFor(storyFiles, criterion.file);
+  if (content === null || content === undefined) {
+    return [`nie odczytano pliku scen '${criterion.file}' — pokrycia kryterium nie da się stwierdzić`];
+  }
+
+  const body = storyBody(content, criterion.describe);
+  if (body === null) {
+    return [`scena '${criterion.describe}' nie istnieje w '${criterion.file}'`];
+  }
+  if (!/\bplay\s*:/.test(body)) {
+    return [`scena '${criterion.describe}' nie ma interakcji play() — renderuje się i przechodzi, więc nie jest dowodem`];
+  }
+  return [];
+}
+
+/**
+ * Sprawdza, czy każde kryterium mapy ma dowód, którego można nie zdać.
+ *
+ * @param {object} args
+ * @param {{criteria?: Array<{id: string, describe: string, file: string, level: string}>}} args.map
+ *        — mapa przebiegu z generatora skieletów
+ * @param {object|null} args.report — raport vitest (`parseVitestReport`)
+ * @param {Record<string, string>} [args.storyFiles] — treści plików scen wg ścieżki
+ * @returns {{ok: boolean, findings: Array<{criterion: string|null, level: string|null, file: string|null, message: string}>}}
+ */
+export function criteriaCoverage({ map, report, storyFiles = {} }) {
+  const findings = [];
+  const criteria = map?.criteria ?? [];
+
+  if (criteria.length === 0) {
+    return { ok: false, findings: [{ criterion: null, level: null, file: null, message: 'mapa przebiegu nie wiąże żadnego kryterium z blokiem testu' }] };
+  }
+
+  for (const criterion of criteria) {
+    const messages = criterion.level === LEVELS.COMPONENT
+      ? componentFindings(criterion, storyFiles)
+      : unitFindings(criterion, report);
+
+    for (const message of messages) {
+      findings.push({ criterion: criterion.id, level: criterion.level, file: criterion.file, message });
+    }
+  }
+
+  // Znacznik liczony RAZ na plik: zostaje po sterowniku wejścia i po wymaganej
+  // wartości, więc powtarzany przy każdym kryterium tego pliku mówiłby to samo N razy.
+  for (const [filePath, content] of Object.entries(storyFiles)) {
+    if (String(content ?? '').includes(TODO_MARKER)) {
+      findings.push({ criterion: null, level: LEVELS.COMPONENT, file: filePath, message: `plik scen '${filePath}' niesie pozostawiony znacznik ${TODO_MARKER}` });
+    }
+  }
+
+  return { ok: findings.length === 0, findings };
+}

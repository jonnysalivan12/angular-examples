+/**
+ * Zamrożenie testów jako KROK weryfikacji: diff fazy implementacji nie zawiera
+ * ani jednego pliku testów.
+ *
+ * Testy powstały PRZED implementacją i opisują żądane zachowanie. Implementacja,
+ * która je poprawia, przestaje być dowodzona — najprostsza droga do zieleni wiedzie
+ * wtedy przez osłabienie asercji, a nie przez napisanie kodu. Dlatego zamrożenie
+ * jest twarde, a nie ostrzeżeniem.
+ *
+ * Wynik podaje OBIE drogi wyjścia, bo test bywa zły nie z winy implementacji:
+ * cofnięcie zmiany albo eskalację, gdy szkielet wystawił błędne API. Rozstrzygnięcie
+ * należy do fazy testów, nie do tej — cicha poprawka testu jest zabroniona.
+ *
+ * Zamrożenie obowiązuje w fazie implementacji JEDNEGO zadania, nie na zawsze:
+ * późniejsze zadanie dostosowuje zastane testy w swojej fazie testów.
+ *
+ * @param {object} args
+ * @param {string[]} args.changedFiles — pliki zmienione w fazie implementacji
+ * @returns {{id: string, command: string, ok: boolean, exitCode: number, durationMs: number, outputTail: string, skipped: boolean}}
+ */
+export function frozenTestsStep({ changedFiles }) {
+  const touched = (changedFiles ?? []).filter(isTestFile);
+  const ok = touched.length === 0;
+
+  return {
+    id: 'zamrożenie testów',
+    command: 'diff fazy implementacji bez plików testów',
+    ok,
+    exitCode: ok ? 0 : 1,
+    durationMs: 0,
+    outputTail: ok ? '' : [
+      `Faza implementacji zmieniła pliki testów: ${touched.map((file) => `'${file}'`).join(', ')}.`,
+      'Testy są zamrożone — opisują zachowanie, które masz dostarczyć, więc ich zmiana kasuje dowód.',
+      '',
+      'Cofnij te zmiany i napraw implementację. Jeśli test żąda czegoś, czego kontrakt NIE przewiduje,',
+      'albo odwołuje się do API, którego szkielet nie wystawia:',
+      'ESKALACJA: <który test, czego żąda i dlaczego jest to sprzeczne z kontraktem>.',
+    ].join('\n'),
+    skipped: false,
+  };
+}
+
+/**
+ * Obecność dowodu jako KROK weryfikacji: każdy plik z zachowaniem zostawiony
+ * przez zadanie ma obok siebie test, a komponent także scenę.
+ *
+ * Pytanie jest inne niż pokrycie kryteriów z fazy testów. Tamto sprawdza, czy
+ * każde KRYTERIUM ma dowód; to sprawdza, czy każdy PLIK go ma — a zadanie zwykle
+ * zostawia więcej plików, niż wymieniają kryteria.
+ *
+ * Liczone WYŁĄCZNIE po plikach zadania, nie po całej bibliotece: zaległości
+ * z przeszłości nie są pracą tego zadania, a bramka, której nie da się spełnić

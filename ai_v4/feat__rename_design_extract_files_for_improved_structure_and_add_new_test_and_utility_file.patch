+
+/**
+ * design_ir z jednej pobranej ramy Figmy.
+ * @param {object} args
+ * @param {object} args.json — odpowiedź REST /nodes dla ramy (już pobrana)
+ * @param {string} args.nodeId — id węzła w formie z myślnikiem (np. "12-34")
+ * @param {object} args.componentResolver — resolver parity (custom+DS)
+ * @param {object} [args.variablesById] — nazwy zmiennych Figmy (tokeny)
+ * @param {object} [args.tokenMap] — mapa nazwa tokenu → CSS var
+ * @param {string} [args.figmaFile] — klucz pliku (do adnotacji źródła)
+ * @param {(ids: string[]) => Promise<{nodesById: object}>} [args.fetchComponentNodes] — dociągnięcie kontraktów
+ * @returns {Promise<{ir: object, warnings: string[]}>} design_ir (status 'ok', bez scope/context) + ostrzeżenia walidacji
+ */
+export async function extractWholeFrameIr({
+  json, nodeId, componentResolver, variablesById = {}, tokenMap, figmaFile, fetchComponentNodes,
+}) {
+  const apiNodeId = toApiNodeId(nodeId);
+  const parsed = parseFrame(json, apiNodeId, { componentResolver, variablesById, tokenMap, figmaFile });
+  const contracts = await fetchComponentContracts(parsed, fetchComponentNodes);
+  const frameSummary = json?.nodes?.[apiNodeId]?.document?.name ?? '';
+
+  const ir = assembleWholeFrame(parsed, { layerId: 'type_ui', frameSummary }, contracts);
+  ir.status = 'ok';
+
+  // Walidacja jak u architekta, ale NIE-fatalna: braki zwracamy jako ostrzeżenia,
+  // a nie stop — degradacją steruje wołający zgodnie z polityką przepływu.
+  const shape = validateDesignIrShape({ design_ir: ir });
+  const closure = shape.valid ? validateClosure({ design_ir: ir }) : { valid: false, errors: [] };
+
+  // Poza flow nie ma podziału owns/context (koncept fazy 1c zależny od story/AC).
+  delete ir.scope;
+  delete ir.context_elements;
+
+  return { ir, warnings: [...shape.errors, ...closure.errors] };
+}

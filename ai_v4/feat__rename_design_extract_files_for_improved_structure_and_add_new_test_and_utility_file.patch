@@ -0,0 +1,53 @@
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Mapa kryteriów — powiązanie kryterium akceptacji z blokiem testu, który je dowodzi.
+ *
+ * Powiązanie żyje OBOK kodu, nie w nim: nazwy i komentarze testów opisują wyłącznie
+ * zachowanie, a identyfikator kryterium przemycony do nazwy stawałby się martwym
+ * odsyłaczem przy pierwszej zmianie z innego zadania.
+ *
+ * Mapa jest dowodem jednego przebiegu, nie kontraktem: nikt jej później nie
+ * utrzymuje, a kolejna zmiana zachowania dostaje własną. Nazwy obszarów są w niej
+ * zapisane, żeby powtórzenie przebiegu je REUŻYŁO — nazwa nadana modelem różni się
+ * między wywołaniami, a wędrujące nazwy bloków wyglądałyby jak zmiana testów.
+ *
+ * Bez serializacji: mapa jest zwykłym obiektem, format pliku wybiera ten, kto ją
+ * zapisuje razem z pozostałymi artefaktami przebiegu.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+/**
+ * Buduje mapę kryteriów dla jednego komponentu.
+ *
+ * @param {object} args
+ * @param {string} args.component — nazwa klasy komponentu
+ * @param {Array<{id: string, describe: string, file: string, level: string}>} args.entries
+ *        — po jednym wpisie na kryterium: blok, plik dowodu i poziom weryfikacji
+ * @param {Record<string, string>} [args.topics] — nazwy obszarów per identyfikator kryterium
+ * @returns {{component: string, criteria: Array<{id: string, topic: string|null, describe: string, file: string, level: string}>}}
+ *          Kryteria w kolejności wejścia; `topic` jest `null`, gdy obszar nie ma nazwy.
+ */
+export function buildVerificationMap({ component, entries, topics = {} }) {
+  return {
+    component,
+    criteria: (entries ?? []).map((entry) => ({
+      id: entry.id,
+      topic: topics[entry.id] ?? null,
+      describe: entry.describe,
+      file: entry.file,
+      level: entry.level,
+    })),
+  };
+}
+
+/**
+ * Wyławia nazwy obszarów z wcześniejszej mapy — wejście powtórzonej generacji.
+ *
+ * @param {{criteria?: Array<{id: string, topic: string|null}>}|null} map — mapa z poprzedniego przebiegu
+ * @returns {Record<string, string>} wyłącznie kryteria z nazwą obszaru
+ */
+export function topicsFromMap(map) {
+  const topics = {};
+  for (const criterion of map?.criteria ?? []) {
+    if (criterion?.id && criterion.topic) topics[criterion.id] = criterion.topic;
+  }
+  return topics;
+}

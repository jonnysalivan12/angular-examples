+async function fetchComponentContracts(parsed, fetchComponentNodes) {
+  const targets = new Set();
+  for (const component of (parsed.components || [])) {
+    if (component.resolved || component.origin === 'library') continue;   // tylko nowe prymitywy custom (to-build)
+    const id = component.component_set_id || component.component_id;       // set (przestrzeń wariantów) > master
+    if (id) targets.add(id);
+  }

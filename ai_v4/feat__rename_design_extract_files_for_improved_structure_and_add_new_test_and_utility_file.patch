@@ -0,0 +1,124 @@
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Bramki na notatce intencji (PK1) — CZYSTE funkcje nad ZNORMALIZOWANĄ notatką.
+ *
+ * Znormalizowana notatka (kontrakt między sesją intencji a tymi bramkami):
+ *
+ *   note = {
+ *     resolutions:  [{ question: string, answer: string }],   // pytanie → odpowiedź człowieka
+ *     delegations:  [{ question: string, proposal: string }],  // „zdecyduj sam" → propozycja
+ *     appliedRules: [{ rule: string, decision: string }],      // reguła źródła prawdy → skutek
+ *     markdown:     string,                                     // wyrenderowana notatka (I5)
+ *   }
+ *
+ * Wynik każdej bramki: lista ustaleń { gate, severity: 'error'|'warn', message }.
+ * Zero I/O — stan sesji (wczytane standardy) i limity wstrzykuje wołający.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+/** Nazwa pliku standardu w treści reguły, np. „design-handoff.md — układ z makiety". */
+const STANDARD_FILE_PATTERN = /\b[a-z0-9][a-z0-9-]*\.md\b/gi;
+
+/** Tworzy ustalenie bramki w jednolitym kształcie. */
+function finding(gate, severity, message) {
+  return { gate, severity, message };
+}
+
+/** Zbiór nazw plików standardów cytowanych w treści reguły (lowercase). */
+function citedStandards(ruleText) {
+  return new Set((String(ruleText ?? '').match(STANDARD_FILE_PATTERN) ?? []).map((file) => file.toLowerCase()));
+}
+
+/** Normalizacja treści pytania do porównania tożsamości (I1). */
+function questionKey(text) {
+  return String(text ?? '').trim().toLowerCase();
+}
+
+/**
+ * I1 — spójność: to samo pytanie nie może być jednocześnie rozstrzygnięte przez
+ * człowieka i delegowane. Kolizja znaczy, że notatka niesie dwie sprzeczne
+ * odpowiedzi na jeden brak.
+ * @param {object} note
+ * @returns {Array} ustalenia
+ */
+export function gateIntentConsistency(note) {
+  const resolved = new Set((note?.resolutions ?? []).map((entry) => questionKey(entry.question)));
+  const findings = [];
+  for (const entry of note?.delegations ?? []) {
+    if (resolved.has(questionKey(entry.question))) {
+      findings.push(finding('I1', 'error', `pytanie „${entry.question}" jest zarazem rozstrzygnięte i delegowane`));
+    }
+  }
+  return findings;
+}
+
+/**
+ * I2 — ugruntowanie reguł: reguła cytująca plik standardu może to robić tylko,
+ * gdy ten standard został wczytany w sesji. Cytat pliku niewczytanego uzasadnia
+ * skutek treścią, której nikt nie sprawdził.
+ * @param {object} note
+ * @param {string[]} standardsLoaded — nazwy standardów wczytanych w sesji
+ * @returns {Array} ustalenia
+ */
+export function gateIntentGrounding(note, standardsLoaded = []) {
+  const loaded = new Set(standardsLoaded.map((file) => file.toLowerCase()));
+  const findings = [];
+  for (const entry of note?.appliedRules ?? []) {
+    for (const file of citedStandards(entry.rule)) {
+      if (loaded.has(file)) continue;
+      findings.push(finding(
+        'I2',
+        'error',
+        `reguła „${entry.rule}" cytuje '${file}', którego NIE wczytano w tej sesji`,
+      ));
+    }
+  }
+  return findings;
+}
+
+/**
+ * I5 — długość: notatka mieści się na jednym ekranie. Przekroczenie znaczy, że
+ * intencja zebrała więcej niż rozstrzygnięcia brakujących decyzji.
+ * @param {object} note
+ * @param {{MAX_LINES: number}} limits
+ * @returns {Array} ustalenia
+ */
+export function gateIntentLength(note, limits) {
+  const lineCount = String(note?.markdown ?? '').split('\n').length;
+  if (lineCount <= limits.MAX_LINES) return [];
+  return [finding('I5', 'error', `notatka ma ${lineCount} linii > limit ${limits.MAX_LINES}`)];
+}
+
+/**
+ * Dzieli reguły na te z pokryciem i te cytujące standard niewczytany w sesji.
+ * Wycięcie reguły bez pokrycia (zamiast unieważnienia notatki) jest zgodne
+ * z traktowaniem faktów bez pokrycia w pakiecie dowodowym.
+ * @param {Array<{rule: string, decision: string}>} appliedRules
+ * @param {string[]} standardsLoaded
+ * @returns {{kept: Array, cut: Array}}
+ */
+export function partitionGroundedRules(appliedRules = [], standardsLoaded = []) {
+  const loaded = new Set(standardsLoaded.map((file) => file.toLowerCase()));
+  const kept = [];
+  const cut = [];
+  for (const entry of appliedRules) {
+    const ungrounded = [...citedStandards(entry.rule)].some((file) => !loaded.has(file));
+    (ungrounded ? cut : kept).push(entry);
+  }
+  return { kept, cut };
+}
+
+/**
+ * Suita bramek notatki intencji I1/I2/I5.
+ * @param {object} note — znormalizowana notatka (kontrakt w nagłówku pliku)
+ * @param {object} [options]
+ * @param {string[]} [options.standardsLoaded] — standardy wczytane w sesji (I2)
+ * @param {{MAX_LINES: number}} options.limits — limity notatki (I5)
+ * @returns {{ok: boolean, findings: Array}}
+ */
+export function intentGates(note, { standardsLoaded = [], limits } = {}) {
+  const findings = [
+    ...gateIntentConsistency(note),
+    ...gateIntentGrounding(note, standardsLoaded),
+    ...gateIntentLength(note, limits),
+  ];
+  return { ok: findings.every((entry) => entry.severity !== 'error'), findings };
+}

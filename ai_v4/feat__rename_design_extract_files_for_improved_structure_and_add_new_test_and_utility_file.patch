+const CRITERIA = [
+  { id: 'AC-1', text: 'puste hasło jest odrzucane', verification: 'unit' },
+  { id: 'AC-2', text: 'przycisk działa z klawiatury', verification: 'component' },
+  { id: 'AC-3', text: 'biblioteka ma tag typu', verification: 'static' },
+];
+
+const COMPONENT_SOURCE = [
+  "import { Component, input, output } from '@angular/core';",
+  '',
+  '@Component({',
+  "  selector: 'app-login-form',",
+  "  template: '',",
+  '})',
+  'export class LoginFormComponent {',
+  '  readonly label = input<string>();',
+  '  readonly submitted = output<void>();',
+  '}',
+].join('\n');
+
+const SERVICE_SOURCE = [
+  "import { Injectable } from '@angular/core';",
+  '',
+  '@Injectable()',
+  'export class SessionService {',
+  '  refresh(): void { throw new Error(\'not implemented\'); }',
+  '}',
+].join('\n');
+
+/** Drzewo w pamieci: odczyt, zapis i sprawdzenie obecnosci. */
+function fakeTree(initial = {}) {
+  const files = { ...initial };
+  return {
+    files,
+    readFile: (path) => files[path] ?? null,
+    writeFile: (path, content) => { files[path] = content; },
+    exists: (path) => path in files,
+  };
+}
+
+const COMPONENT_PATH = 'libs/a/src/lib/login-form/login-form.component.ts';
+const SERVICE_PATH = 'libs/a/src/lib/session/session.service.ts';
+
+test('generateTestSkeletons: komponent dostaje skielety testu i scen wraz z mapa', async () => {
+  const tree = fakeTree({ [COMPONENT_PATH]: COMPONENT_SOURCE });
+
+  const result = await generateTestSkeletons({ sourceFiles: [COMPONENT_PATH], criteria: CRITERIA, ...tree });
+
+  assert.equal(result.ok, true, result.reason ?? '');
+  assert.deepEqual(result.files, [
+    'libs/a/src/lib/login-form/login-form.component.spec.ts',
+    'libs/a/src/lib/login-form/login-form.component.stories.ts',
+  ]);
+  assert.equal(result.map.component, 'LoginFormComponent');
+  assert.deepEqual(result.map.criteria.map((entry) => entry.id), ['AC-1', 'AC-2']);
+  assert.match(tree.files['libs/a/src/lib/login-form/login-form.component.spec.ts'], /it\.todo/);
+});
+
+test('generateTestSkeletons: kryterium dowodzone statycznie nie dostaje pliku ani wpisu', async () => {
+  const tree = fakeTree({ [COMPONENT_PATH]: COMPONENT_SOURCE });
+
+  const result = await generateTestSkeletons({ sourceFiles: [COMPONENT_PATH], criteria: CRITERIA, ...tree });
+
+  assert.ok(!result.map.criteria.some((entry) => entry.id === 'AC-3'));
+});
+
+test('generateTestSkeletons: warstwa bez komponentu dostaje sciezke do napisania i mape po nazwach blokow', async () => {
+  const tree = fakeTree({ [SERVICE_PATH]: SERVICE_SOURCE });
+
+  const result = await generateTestSkeletons({ sourceFiles: [SERVICE_PATH], criteria: CRITERIA, ...tree });
+
+  assert.equal(result.ok, true, result.reason ?? '');
+  assert.deepEqual(result.files, [], 'nie ma czego sparsowac, wiec nie ma czego wygenerowac');
+  assert.deepEqual(result.expected, ['libs/a/src/lib/session/session.service.spec.ts']);
+  assert.deepEqual(result.map.criteria.map((entry) => entry.describe), ['puste hasło jest odrzucane', 'przycisk działa z klawiatury']);
+});
+
+test('generateTestSkeletons: nazwy obszarow z modelu trafiaja do blokow i do mapy', async () => {
+  const tree = fakeTree({ [COMPONENT_PATH]: COMPONENT_SOURCE });
+
+  const result = await generateTestSkeletons({
+    sourceFiles: [COMPONENT_PATH],
+    criteria: CRITERIA,
+    ...tree,
+    askTopics: async () => 'AC-1: walidacja hasła\nAC-2: obsługa klawiatury',
+  });
+
+  assert.deepEqual(result.map.criteria.map((entry) => entry.topic), ['walidacja hasła', 'obsługa klawiatury']);
+  assert.match(tree.files['libs/a/src/lib/login-form/login-form.component.spec.ts'], /describe\('walidacja hasła'/);
+});
+
+test('generateTestSkeletons: nazwa z identyfikatorem odrzucona — blok dostaje tresc kryterium', async () => {
+  const tree = fakeTree({ [COMPONENT_PATH]: COMPONENT_SOURCE });
+
+  const result = await generateTestSkeletons({
+    sourceFiles: [COMPONENT_PATH],
+    criteria: CRITERIA,
+    ...tree,
+    askTopics: async () => 'AC-1: kryterium AC-1\nAC-2: obsługa klawiatury',
+  });
+
+  assert.equal(result.map.criteria[0].topic, null);
+  assert.equal(result.map.criteria[0].describe, 'puste hasło jest odrzucane');
+});
+
+test('generateTestSkeletons: zastany plik testu nietkniety', async () => {
+  const specPath = 'libs/a/src/lib/login-form/login-form.component.spec.ts';
+  const tree = fakeTree({ [COMPONENT_PATH]: COMPONENT_SOURCE, [specPath]: '// praca z poprzedniego zadania' });
+
+  const result = await generateTestSkeletons({ sourceFiles: [COMPONENT_PATH], criteria: CRITERIA, ...tree });
+
+  assert.equal(tree.files[specPath], '// praca z poprzedniego zadania');
+  assert.ok(!result.files.includes(specPath));
+  assert.ok(result.files.includes('libs/a/src/lib/login-form/login-form.component.stories.ts'));
+});
+
+test('generateTestSkeletons: pliki bez zachowania pomijane', async () => {
+  const tree = fakeTree({ 'libs/a/src/index.ts': 'export * from "./lib/x";', 'libs/a/src/lib/user.model.ts': 'export interface User {}' });
+
+  const result = await generateTestSkeletons({
+    sourceFiles: ['libs/a/src/index.ts', 'libs/a/src/lib/user.model.ts'],
+    criteria: CRITERIA,
+    ...tree,
+  });
+
+  assert.equal(result.ok, false);
+  assert.match(result.reason, /nie zostawiła pliku/);
+});
+
+test('generateTestSkeletons: plan bez kryteriow dowodliwych to porazka z powodem', async () => {
+  const tree = fakeTree({ [COMPONENT_PATH]: COMPONENT_SOURCE });
+
+  const result = await generateTestSkeletons({
+    sourceFiles: [COMPONENT_PATH],
+    criteria: [{ id: 'AC-3', text: 'tag typu', verification: 'static' }],
+    ...tree,
+  });
+
+  assert.equal(result.ok, false);
+  assert.match(result.reason, /nie jest dowodzone/);
+});
+
+test('generateTestSkeletons: nieodczytany plik zglaszany, reszta idzie dalej', async () => {
+  const tree = fakeTree({ [COMPONENT_PATH]: COMPONENT_SOURCE });
+
+  const result = await generateTestSkeletons({
+    sourceFiles: ['libs/a/src/lib/znikniety.service.ts', COMPONENT_PATH],
+    criteria: CRITERIA,
+    ...tree,
+  });
+
+  assert.equal(result.ok, true);
+  assert.match(result.warnings.join(' '), /znikniety\.service\.ts/);
+  assert.equal(result.files.length, 2);
+});

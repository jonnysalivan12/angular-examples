@@ -0,0 +1,122 @@
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Szkielety komponentów z makiety — krok DETERMINISTYCZNY przed pracą nad zadaniami.
+ *
+ * Komponent, który makieta każe zbudować, powstaje jednym poleceniem generatora:
+ * styl, strategia wykrywania zmian i prefiks selektora są już zadeklarowane
+ * w repozytorium, więc nie ma tu czego rozstrzygać ani czym się różnić między
+ * przebiegami.
+ *
+ * Gdzie komponent ma powstać, wynika ze SPOTKANIA dwóch źródeł: makieta podaje
+ * nazwę, a zakres zadania katalog. Tylko tam, gdzie oba wskazują to samo, ścieżka
+ * jest pewna — pozostałe nazwy zostają koderowi, bo zgadnięty katalog to plik
+ * w złej bibliotece i przekroczenie zakresu zadania przy pierwszej weryfikacji.
+ *
+ * Istniejący komponent NIE jest generowany ponownie: generator nadpisałby pracę,
+ * którą zastał.
+ *
+ * Zero I/O: powłoka i sprawdzenie obecności pliku są wstrzykiwane.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+import { componentDirsFrom, toComponentDirName } from '../../../scripts/design-extract/component-slice.js';
+
+/** Ścieżka zakresu bez globu i bez końcowego ukośnika. */
+function scopeDirectory(pattern) {
+  return String(pattern ?? '').replace(/\\/g, '/').replace(/\/\*{1,2}$/, '').replace(/\/+$/, '');
+}
+
+/**
+ * Wyznacza komponenty do założenia: nazwa z makiety spotyka katalog z zakresu zadania.
+ *
+ * @param {object} args
+ * @param {object} args.plan — znormalizowany plan
+ * @param {Record<string, Array<{ir: object}>>} args.designFramesByTask — ramy makiety per zadanie
+ * @returns {Array<{taskId: string, componentName: string, directory: string, path: string}>}
+ *          `path` jest ścieżką bez rozszerzenia, jakiej oczekuje generator komponentu;
+ *          lista bez powtórzeń, w kolejności zadań planu.
+ */
+export function componentShellTargets({ plan, designFramesByTask }) {
+  const targets = [];
+  const seen = new Set();
+
+  for (const task of plan?.tasks ?? []) {
+    const frames = designFramesByTask?.[task.id];
+    if (!frames?.length) continue;
+
+    const byDirName = new Map();
+    for (const frame of frames) {
+      for (const definition of frame?.ir?.components_to_build ?? []) {
+        if (definition?.name) byDirName.set(toComponentDirName(definition.name), definition.name);
+      }
+    }
+    if (byDirName.size === 0) continue;
+
+    for (const pattern of task.scope ?? []) {
+      const directory = scopeDirectory(pattern);
+      const [dirName] = componentDirsFrom([pattern]);
+      if (!dirName || !byDirName.has(dirName)) continue;
+
+      const path = `${directory}/${dirName}`;
+      if (seen.has(path)) continue;
+      seen.add(path);
+      targets.push({ taskId: task.id, componentName: byDirName.get(dirName), directory, path });
+    }
+  }
+
+  return targets;
+}
+
+/**
+ * Zakłada szkielety komponentów i sprawdza, czy powstały.
+ *
+ * Bieg NIE zatrzymuje się na pierwszej porażce: pełna lista komponentów, które nie
+ * powstały, jest warta więcej niż pierwsza z nich.
+ *
+ * @param {object} args
+ * @param {Array<{taskId: string, componentName: string, path: string}>} args.targets — wynik `componentShellTargets`
+ * @param {(command: string) => Promise<{exitCode: number, output: string}>} args.execCommand — powłoka w drzewie docelowym
+ * @param {(path: string) => boolean} args.exists — czy plik istnieje w drzewie docelowym
+ * @param {(message: string) => void} [args.onLog]
+ * @returns {Promise<{ok: boolean, shells: Array<{name: string, path: string, skipped: boolean, ok: boolean}>,
+ *          findings: Array<{severity: string, message: string}>}>}
+ */
+export async function scaffoldComponentShells({ targets, execCommand, exists, onLog = () => {} }) {
+  const shells = [];
+  const findings = [];
+
+  if (!targets?.length) {
+    onLog('szkielety komponentów: makieta nie wskazuje komponentów do założenia');
+    return { ok: true, shells, findings };
+  }
+
+  for (const target of targets) {
+    const produces = `${target.path}.component.ts`;
+
+    if (exists(produces)) {
+      onLog(`szkielet komponentu pominięty — '${produces}' już istnieje`);
+      shells.push({ name: target.componentName, path: target.path, skipped: true, ok: true });
+      continue;
+    }
+
+    const command = `npx nx g @nx/angular:component ${target.path}`;
+    onLog(`szkielet komponentu: ${command}`);
+    const result = await execCommand(command);
+
+    const created = result.exitCode === 0 && exists(produces);
+    shells.push({ name: target.componentName, path: target.path, skipped: false, ok: created });
+
+    if (result.exitCode !== 0) {
+      findings.push({
+        severity: 'error',
+        message: `komponent '${target.componentName}': generator zakończył się kodem ${result.exitCode} — ${String(result.output ?? '').slice(-2000)}`,
+      });
+      continue;
+    }
+    if (!created) {
+      findings.push({ severity: 'error', message: `komponent '${target.componentName}': generator nie utworzył '${produces}'` });
+    }
+  }
+
+  const ok = findings.every((finding) => finding.severity !== 'error');
+  onLog(`szkielety komponentów: ${shells.filter((shell) => shell.ok).length}/${targets.length} na miejscu`);
+  return { ok, shells, findings };
+}

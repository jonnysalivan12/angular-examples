+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+
+import { checkTestPresence, libraryTypeOf, isExemptFile } from './test-presence-validator.js';
+
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Obecnosc dowodu: pytanie zadawane po TYPIE warstwy, a zwolnienie rozstrzygane
+ * po tresci pliku — nie po jego nazwie.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+const SERVICE = 'export class ApiService {\n  get(url: string): void { this.http.get(url); }\n}';
+const COMPONENT = "@Component({ selector: 'x', template: '' })\nexport class XComponent {}";
+const INTERFACE = 'export interface LoginRequest { email: string; }';
+
+/** Drzewo w pamieci: obecnosc plikow i ich tresc. */
+function tree(files) {
+  return {
+    exists: (path) => path in files,
+    readFile: (path) => files[path] ?? null,
+  };
+}
+
+test('checkTestPresence: warstwa z logika wymaga testu obok jednostki', () => {
+  const files = { 'libs/a/src/lib/api.service.ts': SERVICE };
+
+  const violations = checkTestPresence({
+    projectName: 'shared-common-core-api',
+    directory: 'libs/a',
+    libraryType: 'core',
+    sourceFiles: Object.keys(files),
+    ...tree(files),
+  });
+

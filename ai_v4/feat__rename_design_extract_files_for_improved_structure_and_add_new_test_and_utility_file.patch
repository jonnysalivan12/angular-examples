+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Które pliki należą do fazy testów.
+ *
+ * Jedno pytanie, dwie bramki o przeciwnych kierunkach: faza testów może dotknąć
+ * WYŁĄCZNIE tych plików, faza implementacji NIE MOŻE dotknąć żadnego z nich.
+ * Dlatego odpowiedź ma jedną definicję — dwie kopie wzorca rozjechałyby się przy
+ * pierwszej zmianie, a wtedy plik dozwolony dla jednej bramki byłby niewidzialny
+ * dla drugiej i zamrożenie przestałoby cokolwiek chronić.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+import { TESTER } from '../config/global-config.js';
+
+/**
+ * Czy ścieżka jest plikiem fazy testów.
+ * @param {string} filePath — ścieżka w dowolnym zapisie separatorów
+ * @returns {boolean}
+ */
+export function isTestFile(filePath) {
+  return new RegExp(TESTER.TEST_FILE_PATTERN).test(String(filePath ?? '').replace(/\\/g, '/'));
+}

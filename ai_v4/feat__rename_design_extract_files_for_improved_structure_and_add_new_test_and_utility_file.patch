+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Bramki notatki intencji I1/I2/I5 — czyste funkcje nad znormalizowaną notatką.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+const LIMITS = { MAX_LINES: 60 };
+
+test('I1: to samo pytanie rozstrzygnięte i delegowane = błąd', () => {
+  const findings = gateIntentConsistency({
+    resolutions: [{ question: 'Limit eksportu?', answer: 'bez limitu' }],
+    delegations: [{ question: ' limit eksportu? ', proposal: '1000' }],
+  });
+  assert.equal(findings.length, 1);
+  assert.equal(findings[0].gate, 'I1');
+  assert.equal(findings[0].severity, 'error');
+});
+
+test('I1: rozłączne pytania = brak ustaleń', () => {
+  const findings = gateIntentConsistency({
+    resolutions: [{ question: 'Limit?', answer: 'x' }],
+    delegations: [{ question: 'Format?', proposal: 'CSV' }],
+  });
+  assert.deepEqual(findings, []);
+});
+
+test('I2: reguła cytująca standard niewczytany = błąd', () => {
+  const findings = gateIntentGrounding(
+    { appliedRules: [{ rule: 'układ z design-handoff.md', decision: 'breakpointy z Figmy' }] },
+    ['security.md'],
+  );
+  assert.equal(findings.length, 1);
+  assert.equal(findings[0].gate, 'I2');
+  assert.match(findings[0].message, /design-handoff\.md/);
+});
+
+test('I2: cytat wczytanego standardu (case-insensitive) przechodzi', () => {
+  const findings = gateIntentGrounding(
+    { appliedRules: [{ rule: 'układ z Design-Handoff.md', decision: 'x' }] },
+    ['design-handoff.md'],
+  );
+  assert.deepEqual(findings, []);
+});
+
+test('I2: reguła bez cytatu pliku nie wymaga pokrycia', () => {
+  const findings = gateIntentGrounding(
+    { appliedRules: [{ rule: 'treści z makiety są finalne', decision: 'etykiety z Figmy' }] },
+    [],
+  );
+  assert.deepEqual(findings, []);
+});
+
+test('I5: notatka ponad limit linii = błąd', () => {

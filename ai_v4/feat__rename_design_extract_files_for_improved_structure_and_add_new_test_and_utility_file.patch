+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+
+import { hasRuntimeBehavior } from './runtime-behavior.js';
+
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Zachowanie do dowiedzenia rozstrzyga TRESC pliku, nie jego nazwa — obie
+ * odpowiedzi maja koszt: falszywe „nie ma" ukrywa brak testu, falszywe „jest"
+ * kaze dowodzic, ze kompilator dziala.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+test('hasRuntimeBehavior: funkcja z cialem to zachowanie', () => {
+  assert.equal(hasRuntimeBehavior('export function suma(a: number, b: number): number { return a + b; }'), true);
+});
+
+test('hasRuntimeBehavior: funkcja strzalkowa przypisana do stalej tez', () => {
+  assert.equal(hasRuntimeBehavior('export const suma = (a: number, b: number) => a + b;'), true);
+});
+
+test('hasRuntimeBehavior: klasa z metoda majaca cialo', () => {
+  const source = [
+    '@Injectable()',
+    'export class ApiService {',
+    '  get(url: string): void { this.http.get(url); }',
+    '}',
+  ].join('\n');
+
+  assert.equal(hasRuntimeBehavior(source), true);
+});
+
+test('hasRuntimeBehavior: sam interfejs to kształt, nie zachowanie', () => {
+  assert.equal(hasRuntimeBehavior('export interface LoginRequest { email: string; password: string; }'), false);
+});
+
+test('hasRuntimeBehavior: interfejs z sygnatura metody nie ma ciala do sprawdzenia', () => {
+  const source = [
+    'export interface GlobalNotificationService {',
+    '  showRateLimitNotification(): void;',
+    '}',
+    "export const TOKEN = new InjectionToken<GlobalNotificationService>('TOKEN');",
+  ].join('\n');
+
+  assert.equal(hasRuntimeBehavior(source), false);
+});
+
+test('hasRuntimeBehavior: alias typu i stala nie sa zachowaniem', () => {
+  assert.equal(hasRuntimeBehavior("export type Status = 'on' | 'off';\nexport const DEFAULT: Status = 'on';"), false);
+});
+
+test('hasRuntimeBehavior: klasa akcji z samym konstruktorem przypisujacym', () => {
+  const source = [
+    'export class AuthLogin {',
+    "  static readonly type = '[Auth] Login';",
+    '  constructor(public readonly payload: AuthLoginRequestPayload) {}',
+    '}',
+  ].join('\n');
+
+  assert.equal(hasRuntimeBehavior(source), false, 'dowodzenie przypisania pola sprawdzaloby jezyk, nie kod');
+});
+
+test('hasRuntimeBehavior: komponent bez metody ma zachowanie — renderuje szablon', () => {
+  const source = [
+    '@Component({',
+    "  selector: 'app-badge',",
+    "  template: '<span>{{ label() }}</span>',",
+    '})',
+    'export class BadgeComponent {',
+    '  readonly label = input<string>();',
+    '}',
+  ].join('\n');
+
+  assert.equal(hasRuntimeBehavior(source), true);
+});
+
+test('hasRuntimeBehavior: pusta metoda nie jest jeszcze zachowaniem', () => {

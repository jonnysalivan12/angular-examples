@@ -0,0 +1,135 @@
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Tematy bloków `describe` — krótka nazwa obszaru dla każdego kryterium.
+ *
+ * Blok `describe` nazywa OBSZAR, a `it` zachowanie. Kryterium akceptacji jest
+ * zdaniem o zachowaniu, więc obszaru nie da się z niego wyliczyć — nazwę nadaje
+ * model, i to jest jego JEDYNA rola: struktura plików, dobór bloków i mapowanie
+ * kryteriów pozostają wyliczone.
+ *
+ * Skoro model tylko nadaje nazwy, jego niedostępność albo zła odpowiedź NIE mogą
+ * zatrzymać generacji: brakujący temat zostaje pusty, a szkielet dostaje wtedy
+ * treść kryterium. Zdegradowana nazwa jest do poprawienia jednym słowem, brak
+ * szkieletu kosztuje całą fazę.
+ *
+ * Nazwa przechodzi walidację, bo cały zysk z niej to zgodność z konwencją:
+ * identyfikator kryterium albo zadania przemycony w nazwie jest odrzucany —
+ * test żyje dłużej niż zadanie, w którym powstał.
+ *
+ * Zero I/O: wywołanie modelu jest wstrzykiwane.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+/** Górna granica długości tematu — dłuższy przepisuje kryterium, zamiast je nazywać. */
+const MAX_TOPIC_LENGTH = 40;
+
+/** Wzorce identyfikatorów, których nazwa nie może nieść. */
+const IDENTIFIER_PATTERNS = Object.freeze([
+  /\bAC[-\s]?\d/i,
+  /\bT\d+\b/,
+  /\bkryterium\b/i,
+  /\bzadani[ae]\b/i,
+]);
+
+/**
+ * Buduje polecenie nazwania obszarów. Deterministyczne: te same kryteria w tej
+ * samej kolejności dają identyczny tekst.
+ *
+ * @param {Array<{id: string, text: string}>} criteria — kryteria akceptacji zadania
+ * @returns {string}
+ */
+export function buildTopicsPrompt(criteria) {
+  const list = (criteria ?? []).map((criterion) => `${criterion.id}: ${criterion.text}`).join('\n');
+
+  return [
+    'Dla każdego kryterium akceptacji podaj KRÓTKĄ nazwę obszaru, którego ono dotyczy.',
+    '',
+    'Zasady:',
+    `- 2–4 słowa, po polsku, maksymalnie ${MAX_TOPIC_LENGTH} znaków;`,
+    '- nazwa obszaru, NIE opis zachowania (obszar: "walidacja hasła", nie "odrzuca za krótkie hasło");',
+    '- bez identyfikatorów kryteriów, zadań i story;',
+    '- kilka kryteriów o tym samym obszarze może dostać tę samą nazwę.',
+    '',
+    'Odpowiedz wyłącznie liniami w postaci `<id>: <nazwa obszaru>`, bez komentarza.',
+    '',
+    'Kryteria:',
+    list,
+  ].join('\n');
+}
+
+/** Czy nazwa nadaje się na temat bloku: niepusta, krótka, bez identyfikatorów. */
+function isUsableTopic(topic) {
+  if (!topic || topic.length > MAX_TOPIC_LENGTH) return false;
+  return !IDENTIFIER_PATTERNS.some((pattern) => pattern.test(topic));
+}
+
+/**
+ * Wyławia tematy z odpowiedzi modelu. Linie nierozpoznane i identyfikatory poza
+ * podanym zbiorem kryteriów są pomijane — odpowiedź bywa opakowana w prozę albo
+ * ogrodzenie bloku kodu, a temat dla nieistniejącego kryterium nie ma adresata.
+ *
+ * @param {string} output — odpowiedź modelu
+ * @param {Array<{id: string}>} criteria — kryteria, dla których temat ma sens
+ * @returns {{topics: Record<string, string>, rejected: string[]}}
+ *          `rejected` niesie tematy odrzucone przez walidację, z powodem w treści.
+ */
+export function parseTopicsOutput(output, criteria) {
+  const known = new Set((criteria ?? []).map((criterion) => criterion.id));
+  const topics = {};
+  const rejected = [];
+
+  for (const line of String(output ?? '').split('\n')) {
+    const match = /^\s*[-*]?\s*([A-Za-z][\w.-]*)\s*:\s*(.+?)\s*$/.exec(line);
+    if (!match) continue;
+
+    const [, id, rawTopic] = match;
+    if (!known.has(id)) continue;
+
+    const topic = rawTopic.replace(/^["'`]|["'`]$/g, '').trim();
+    if (isUsableTopic(topic)) {
+      topics[id] = topic;
+    } else {
+      rejected.push(`${id}: '${topic}' — nazwa za długa albo niesie identyfikator`);
+    }
+  }
+
+  return { topics, rejected };
+}
+
+/**
+ * Nadaje tematy blokom kryteriów. Brak odpowiedzi, błąd wywołania i nazwa odrzucona
+ * przez walidację dają ten sam skutek: kryterium zostaje bez tematu, a wynik mówi
+ * o tym wprost.
+ *
+ * @param {object} args
+ * @param {Array<{id: string, text: string}>} args.criteria
+ * @param {(prompt: string) => Promise<string>} [args.ask] — wywołanie modelu; brak = nazwy nienadawane
+ * @param {(message: string) => void} [args.onLog]
+ * @returns {Promise<{topics: Record<string, string>, degraded: boolean, reason: string}>}
+ *          `degraded` jest prawdą, gdy choć jedno kryterium zostało bez tematu.
+ */
+export async function resolveDescribeTopics({ criteria, ask = null, onLog = () => {} }) {
+  const list = criteria ?? [];
+  if (list.length === 0) return { topics: {}, degraded: false, reason: '' };
+  if (!ask) return { topics: {}, degraded: true, reason: 'nazwy obszarów nienadawane — brak wywołania modelu' };
+
+  let output;
+  try {
+    output = await ask(buildTopicsPrompt(list));
+  } catch (cause) {
+    onLog(`tematy bloków: nazwy nienadane (${cause.message}) — bloki dostaną treść kryteriów`);
+    return { topics: {}, degraded: true, reason: cause.message };
+  }
+
+  const { topics, rejected } = parseTopicsOutput(output, list);
+  for (const entry of rejected) onLog(`tematy bloków: odrzucone ${entry}`);
+
+  const missing = list.filter((criterion) => !topics[criterion.id]).map((criterion) => criterion.id);
+  if (missing.length > 0) {
+    onLog(`tematy bloków: bez nazwy obszaru ${missing.join(', ')} — te bloki dostaną treść kryteriów`);
+  }
+
+  return {
+    topics,
+    degraded: missing.length > 0,
+    reason: missing.length > 0 ? `bez nazwy obszaru: ${missing.join(', ')}` : '',
+  };
+}

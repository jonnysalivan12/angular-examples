+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+
+import { parseLcov, aggregateCoverage, scopeOf } from './lcov-summary.js';
+
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Scalanie pokrycia: bez niego biblioteka o dziesieciu liniach wazy tyle samo
+ * co aplikacja o tysiacu, a prog porownuje sie ze srednia z niczego.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+const LCOV = [
+  'TN:',
+  'SF:libs/a/src/lib/x.ts',
+  'DA:1,1',
+  'LF:10',
+  'LH:8',
+  'end_of_record',
+  'SF:libs/a/src/lib/y.ts',
+  'LF:20',
+  'LH:11',
+  'end_of_record',
+].join('\n');
+
+test('parseLcov: linie sumowane po wszystkich plikach raportu', () => {
+  assert.deepEqual(parseLcov(LCOV), { linesFound: 30, linesHit: 19 });
+});
+
+test('parseLcov: pusta tresc nie wywraca odczytu', () => {
+  assert.deepEqual(parseLcov(''), { linesFound: 0, linesHit: 0 });
+  assert.deepEqual(parseLcov(null), { linesFound: 0, linesHit: 0 });
+});
+
+test('aggregateCoverage: jedna liczba z wielu raportow, wazona liczba linii', () => {
+  const summary = aggregateCoverage([
+    { project: 'mala-biblioteka', text: 'LF:10\nLH:10' },
+    { project: 'duza-aplikacja', text: 'LF:1000\nLH:500' },
+  ]);
+
+  assert.equal(summary.linesFound, 1010);
+  assert.equal(summary.linesHit, 510);
+  assert.equal(summary.pct, 50.5, 'srednia z procentow dalaby 75% — mala biblioteka wazylaby tyle co aplikacja');
+  assert.equal(summary.projects, 2);
+});
+
+test('aggregateCoverage: brak raportow to brak pomiaru, nie zero', () => {
+  const summary = aggregateCoverage([]);
+
+  assert.equal(summary.pct, null, '„nie zmierzono" i „zmierzono zero" to dwa rozne stany');
+  assert.equal(summary.linesFound, 0);
+});
+
+test('aggregateCoverage: raport bez ani jednej linii tez nie jest zerem', () => {
+  assert.equal(aggregateCoverage([{ text: 'TN:\nend_of_record' }]).pct, null);
+});
+
+test('scopeOf: scope czytany z tagu, brak tagu to brak odpowiedzi', () => {
+  assert.equal(scopeOf({ tags: ['scope:frontend-app', 'type:ui'] }), 'frontend-app');

+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import yaml from 'yaml';
+
+import { runStage, loadDesignIrForPlanner } from './design.js';
+import { artifactPaths, writeArtifact } from './paths.js';
+import { inTempCwd } from './testing.js';
+
+const FIG = 'https://www.figma.com/design/abc/P?node-id=1-2';
+const FIG2 = 'https://www.figma.com/design/xyz/Q?node-id=3-4';
+
+function readDesign(featureDir) {
+  return yaml.parse(fs.readFileSync(artifactPaths(featureDir).designIr, 'utf8')).design;
+}
+
+const fakeIr = (name) => ({ ir: { layer: 'type_ui', status: 'ok', layout: { role: name }, components_to_build: [] }, warnings: [] });
+
+test('design: brak linku Figmy → status no-mockup, przepływ nie blokuje', async () => {
+  await inTempCwd(async () => {
+    writeArtifact(artifactPaths('006-baner').story, '# Story\n\nZwykła funkcja bez makiety.\n');
+    const result = await runStage({
+      featureDir: '006-baner',
+      extractRef: async () => { throw new Error('nie powinno być wołane bez linku'); },
+    });
+
+    assert.equal(result.ok, true);
+    const design = readDesign('006-baner');
+    assert.equal(design.status, 'no-mockup');
+    assert.deepEqual(design.frames, []);
+  });
+});
+
+test('design: jeden link → design_ir jednej ramy, status ok, bez open_questions', async () => {
+  await inTempCwd(async () => {
+    writeArtifact(artifactPaths('006-baner').story, `# Login\n\nZaimplementuj zgodnie z makietą ${FIG}.\n`);
+    const result = await runStage({ featureDir: '006-baner', extractRef: async (ref) => fakeIr(ref.fileKey) });
+
+    assert.equal(result.ok, true);
+    const design = readDesign('006-baner');
+    assert.equal(design.status, 'ok');
+    assert.equal(design.frames.length, 1);
+    assert.equal(design.frames[0].ref.fileKey, 'abc');
+    assert.ok(design.frames[0].design_ir);
+    assert.deepEqual(design.open_questions, []);
+  });
+});
+
+test('design: dwa linki → dwie ramy + open_question o powiązania', async () => {
+  await inTempCwd(async () => {
+    writeArtifact(artifactPaths('006-baner').story, `# Ekrany\n\nEkran A ${FIG} oraz ekran B ${FIG2}.\n`);
+    const result = await runStage({ featureDir: '006-baner', extractRef: async (ref) => fakeIr(ref.fileKey) });
+
+    assert.equal(result.ok, true);
+    const design = readDesign('006-baner');
+    assert.equal(design.frames.length, 2);
+    assert.equal(design.open_questions.length, 1);
+    assert.equal(design.open_questions[0].topic, 'design-frame-relationships');
+  });
+});
+
+test('design: błąd ekstrakcji ramy → rama zdegradowana, artefakt powstaje, przepływ nie blokuje', async () => {
+  await inTempCwd(async () => {
+    writeArtifact(artifactPaths('006-baner').story, `# Login\n\nMakieta ${FIG}.\n`);
+    const result = await runStage({
+      featureDir: '006-baner',
+      extractRef: async () => { throw new Error('brak FIGMA_API_KEY — makieta niepobrana'); },
+    });
+
+    assert.equal(result.ok, true, 'błąd makiety nie blokuje etapu');
+    const design = readDesign('006-baner');
+    assert.equal(design.status, 'degraded');
+    assert.equal(design.frames[0].design_ir, null);
+    assert.match(design.frames[0].error, /FIGMA_API_KEY/);
+  });
+});
+
+test('design: brak story.md → krok nieukończony', async () => {
+  await inTempCwd(async () => {
+    const result = await runStage({ featureDir: '006-baner', extractRef: async () => fakeIr('x') });
+    assert.equal(result.ok, false);

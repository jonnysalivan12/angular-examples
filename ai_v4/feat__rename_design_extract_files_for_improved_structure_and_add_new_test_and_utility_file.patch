+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Profil wykonania zadania — CZYSTA funkcja nad znormalizowanym planem.
+ *
+ * Profil mówi, czym zadanie ma być dowiedzione, i wynika z typu biblioteki:
+ * typ rozstrzyga, co w danej warstwie jest obserwowalne. Warstwa z widokiem
+ * wymaga dowodu wizualnego, warstwa z logiką runtime — dowodu zachowania,
+ * warstwa bez logiki runtime — kompilacji i lintu.
+ *
+ * Typ NIE jest wyprowadzany z nazwy biblioteki. Nazwa składa się z segmentów
+ * `<scope>-<kontekst>-<typ>[-<nazwa>]`, więc ostatni segment bywa nazwą, nie
+ * typem: `shared-common-core-api` ma typ `core`, a nie `api`. Źródłem jest tag
+ * biblioteki z indeksu kodu, a dla bibliotek jeszcze nieistniejących — pole
+ * typu z części WIĄŻĄCEJ planu, w tej samej kolejności źródeł co bramka granic
+ * (`gates/plan-gates.js`, `gateBoundaries`).
+ *
+ * Nierozstrzygnięty profil nie jest zgadywany ani podmieniany na domyślny:
+ * wynik niesie wtedy `profile: null` i powód, bo zadanie dowodzone niewłaściwym
+ * sposobem wygląda jak dowiedzione.
+ *
+ * Zero I/O: lista bibliotek istniejących jest wstrzykiwana.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+/** Zamknięty zbiór profilów wykonania. */
+export const TASK_PROFILES = Object.freeze({
+  /** Warstwa z widokiem: dowód wizualny w izolacji + dostępność. */
+  UI: 'ui',
+  /** Warstwa z logiką runtime: dowód zachowania testem. */
+  BUSINESS: 'business',
+  /** Warstwa bez logiki runtime: dowodem jest kompilacja i lint. */
+  STATIC: 'static',
+});
+
+/** Profil per typ biblioteki; typ bez wpisu nie ma przypisanego profilu. */
+const PROFILE_BY_LIBRARY_TYPE = Object.freeze({
+  /** Warstwy niosące szablon i style. */
+  ui: TASK_PROFILES.UI,
+  feature: TASK_PROFILES.UI,
+  /** Warstwy niosące logikę wykonywaną w czasie działania aplikacji. */
+  core: TASK_PROFILES.BUSINESS,
+  state: TASK_PROFILES.BUSINESS,
+  util: TASK_PROFILES.BUSINESS,
+  /** Warstwy niosące same typy albo zasoby — bez logiki do wykonania. */
+  model: TASK_PROFILES.STATIC,
+  asset: TASK_PROFILES.STATIC,
+});
+
+/** Przycina wartość do niepustego stringa; wszystko inne daje pusty string. */
+function clean(value) {
+  return typeof value === 'string' ? value.trim() : '';
+}
+
+/**
+ * Rozwiązuje typ biblioteki: pole typu z części WIĄŻĄCEJ dla bibliotek o statusie
+ * `new`, w pozostałych przypadkach tag z indeksu kodu.
+ *
+ * Pole typu w planie nazywa się `tag`; przyjmowany jest też alias `type`, bo bez
+ * niego inny zapis tej samej osi znikałby PO CICHU — brak pola jest tu
+ * nieodróżnialny od braku danych, a nie błędem.
+ *
+ * @param {object} args
+ * @param {string} args.libraryName — nazwa projektu nx
+ * @param {object} [args.plan] — znormalizowany plan (`Templates.parsePlan`)
+ * @param {Array<{name: string, tags?: {type?: string}}>} [args.existingLibraries] — kształt `librariesAll`
+ * @returns {{type: string|null, source: 'plan'|'index'|null}} `source` mówi, skąd
+ *          wzięty jest typ; oba pola są `null`, gdy typu nie ma w żadnym źródle.
+ */
+export function libraryTypeFor({ libraryName, plan, existingLibraries = [] }) {
+  const name = clean(libraryName);
+  if (!name) return { type: null, source: null };
+
+  const planned = (plan?.binding?.libraries ?? []).find((library) => library.name === name);
+  const declaredType = clean(planned?.structure?.tag ?? planned?.structure?.type);
+  if (planned?.status === 'new' && declaredType) {
+    return { type: declaredType, source: 'plan' };
+  }
+
+  const indexed = (existingLibraries ?? []).find((library) => library.name === name);
+  const indexedType = clean(indexed?.tags?.type);
+  return indexedType ? { type: indexedType, source: 'index' } : { type: null, source: null };
+}
+
+/**
+ * Wylicza profil wykonania zadania.
+ *
+ * Kształt wyniku jest jeden dla wszystkich przypadków — także nierozstrzygniętych,
+ * więc wywołujący czyta `profile` i `reason`, a nie rozgałęzia się po kształcie.
+ *
+ * @param {object} args
+ * @param {string} args.taskId — identyfikator zadania w planie
+ * @param {object} args.plan — znormalizowany plan (`Templates.parsePlan`)
+ * @param {Array<{name: string, tags?: {type?: string}}>} [args.existingLibraries] — kształt `librariesAll`
+ * @returns {{taskId: string, library: string|null, type: string|null,
+ *            source: 'plan'|'index'|null, profile: string|null, reason: string}}
+ *          `profile` to wartość z `TASK_PROFILES` albo `null`; `reason` jest pusty
+ *          wyłącznie przy rozstrzygniętym profilu.
+ */
+export function taskProfile({ taskId, plan, existingLibraries = [] }) {
+  const id = clean(taskId);
+  const unresolved = (library, reason) => ({ taskId: id, library, type: null, source: null, profile: null, reason });
+
+  const task = (plan?.tasks ?? []).find((candidate) => candidate.id === id);
+  if (!task) return unresolved(null, `zadanie '${id}' nie istnieje w planie`);
+
+  const library = clean(task.library);
+  if (!library) return unresolved(null, `zadanie '${id}' bez biblioteki — typ warstwy nieznany`);
+
+  const { type, source } = libraryTypeFor({ libraryName: library, plan, existingLibraries });
+  if (!type) {
+    return unresolved(library, `biblioteka '${library}': brak typu w indeksie kodu i w części WIĄŻĄCEJ planu`);
+  }
+
+  const profile = PROFILE_BY_LIBRARY_TYPE[type];
+  if (!profile) {
+    return { taskId: id, library, type, source, profile: null, reason: `biblioteka '${library}': typ '${type}' nie ma przypisanego profilu wykonania` };
+  }
+
+  return { taskId: id, library, type, source, profile, reason: '' };
+}

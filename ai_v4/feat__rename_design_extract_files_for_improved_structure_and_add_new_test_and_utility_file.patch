+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Wykrywanie odniesień do makiet Figmy w treści story.
+ *
+ * Deterministyczne: wyłuskuje adresy figma.com z prozy (także z linków markdown)
+ * i rozkłada każdy na parę plik+węzeł przez parseFigmaUrl. Zwraca listę odniesień
+ * bez duplikatów; brak adresu → lista pusta (żaden etap się nie zatrzymuje).
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+import { parseFigmaUrl } from '../../../scripts/figma/figma-client.js';
+
+// Adres figma.com do granicy: biały znak albo domykający nawias/nawias kątowy/
+// kwadratowy — łapie linki markdown i adresy osadzone w prozie.
+const FIGMA_URL = /https?:\/\/(?:www\.)?figma\.com\/[^\s)>\]]+/gi;
+
+/**
+ * Odniesienia do makiet wyłuskane z treści story.
+ * @param {string} storyText — treść story
+ * @returns {Array<{url: string, fileKey: string, nodeId: string}>} jedno odniesienie
+ *          per węzeł; zdedupowane po parze (fileKey, nodeId); puste gdy brak makiety.
+ */
+export function parseFigmaRefs(storyText) {
+  const urls = String(storyText ?? '').match(FIGMA_URL) ?? [];
+  const refs = [];
+  const seen = new Set();
+  for (const raw of urls) {
+    const url = raw.replace(/[.,;:]+$/, '');   // odetnij interpunkcję zdania doklejoną do adresu
+    const { fileKey, nodeIds } = parseFigmaUrl(url);
+    if (!fileKey) continue;                     // adres bez klucza pliku — nie jest odniesieniem makiety
+    for (const nodeId of nodeIds) {
+      const key = `${fileKey}|${nodeId}`;
+      if (seen.has(key)) continue;              // ten sam frame wspomniany wielokrotnie
+      seen.add(key);
+      refs.push({ url, fileKey, nodeId });
+    }
+  }
+  return refs;
+}

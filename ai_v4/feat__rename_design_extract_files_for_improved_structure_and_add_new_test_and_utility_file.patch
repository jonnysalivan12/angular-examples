+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Brif fazy testów — CHUDA projekcja planu na wejście osobnej sesji.
+ *
+ * Chuda z powodu, nie z oszczędności: sesja, która zna drogę implementacji,
+ * sprawdza to, co zamierza powstać, zamiast tego, czego żąda kontrakt. Dlatego
+ * brif nie niesie sekcji KROKI planu ani niczego, co opisuje sposób wykonania.
+ *
+ * Wchodzi wyłącznie to, wobec czego test ma być dowodem: kryteria z poziomem
+ * weryfikacji, wiążące minimum planu, pliki szkieletu do wypełnienia, pliki
+ * źródłowe do przeczytania, wycinek makiety i standardy testowania.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+import { Templates } from '../templates/index.js';
+import { bindingExcerptFor } from './brief.js';
+
+/**
+ * Poziomy weryfikacji, dla których faza testów ma co napisać. Kryterium dowodzone
+ * statycznie nie ma tu dowodu do napisania, więc nie zajmuje uwagi testera.
+ */
+const PROVEN_LEVELS = Object.freeze(['unit', 'component']);
+
+/** Lista markdown z tablicy ścieżek, '(brak)' dla pustej. */
+function bulletList(values) {
+  const list = (values ?? []).filter(Boolean);
+  return list.length > 0 ? list.map((value) => `- ${value}`).join('\n') : '(brak)';
+}
+
+/**
+ * Buduje brif fazy testów (szablon tester-brief.template.md).
+ *
+ * @param {object} args
+ * @param {object} args.plan — znormalizowany plan (Templates.parsePlan)
+ * @param {string} args.taskId
+ * @param {string[]} args.skeletonFiles — pliki testów i scen z gotowym szkieletem
+ * @param {string[]} [args.filesToWrite] — pliki testów, które tester ma napisać od zera
+ * @param {{criteria?: Array<{describe: string, level: string}>}} [args.map] — mapa przebiegu;
+ *        źródło nazw bloków, które muszą wystąpić dosłownie
+ * @param {string[]} [args.sourceFiles] — pliki źródłowe zadania po fazie szkieletu
+ * @param {string} [args.designSlice='(brak)'] — wycinek design_ir dla zadania
+ * @param {Array<{file: string, text: string}>} [args.standards] — standardy wchodzące treścią
+ * @returns {string} markdown brifu
+ * @throws {Error} gdy zadanie o podanym id nie istnieje w planie albo nie ma czego testować.
+ */
+export function buildTesterBrief({
+  plan, taskId, skeletonFiles = [], filesToWrite = [], map = null,
+  sourceFiles = [], designSlice = '(brak)', standards = [],
+}) {
+  const task = (plan.tasks ?? []).find((candidate) => candidate.id === taskId);
+  if (!task) {
+    throw new Error(`buildTesterBrief: zadanie '${taskId}' nie istnieje w planie '${plan.story}'`);
+  }
+  if (skeletonFiles.length === 0 && filesToWrite.length === 0) {
+    throw new Error(`buildTesterBrief: zadanie '${taskId}' nie ma ani jednego pliku testów do napisania`);
+  }
+
+  const criteria = (plan.acceptanceCriteria ?? [])
+    .filter((criterion) => PROVEN_LEVELS.includes(criterion.verification))
+    .map((criterion) => `- (${criterion.verification}): ${criterion.text}`)
+    .join('\n');
+
+  const standardsText = (standards ?? [])
+    .map((standard) => `### ${standard.file}\n${standard.text}`)
+    .join('\n\n');
+
+  // Nazwy bloków podawane ZAWSZE, także gdy stoją już w szkielecie: to samo
+  // brzmienie w dwóch miejscach jest tańsze niż blok przemianowany po drodze,
+  // bo mapa przebiegu nie ma jak takiej zmiany dogonić.
+  const blockNames = (map?.criteria ?? []).map((criterion) => `${criterion.describe} (${criterion.level})`);
+
+  return Templates.renderTemplate(Templates.loadTemplate('tester-brief.template.md'), {
+    TASK_ID: task.id,
+    TASK_TITLE: task.title ?? task.id,
+    STORY_ID: plan.story,
+    SKELETON_FILES: bulletList(skeletonFiles),
+    FILES_TO_WRITE: bulletList(filesToWrite),
+    BLOCK_NAMES: bulletList(blockNames),
+    SOURCE_FILES: bulletList(sourceFiles),
+    // Identyfikatory kryteriów celowo nieobecne: nazwa testu nie ma prawa ich
+    // nieść, a wsad, który je pokazuje, kusi do wpisania ich w kod.
+    ACCEPTANCE_CRITERIA: criteria || '(brak)',
+    BINDING_EXCERPT: bindingExcerptFor(plan, task),
+    DESIGN_SLICE: designSlice,
+    STANDARDS: standardsText || '(brak)',
+  });
+}

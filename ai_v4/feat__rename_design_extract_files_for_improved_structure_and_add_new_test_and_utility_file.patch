@@ -0,0 +1,105 @@
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Szkielet testu jednostkowego komponentu — treść pliku `*.component.spec.ts`.
+ *
+ * Szkielet niesie WYŁĄCZNIE strukturę: zestaw modułów do `TestBed`, blok na każde
+ * kryterium dowodzone testem jednostkowym i zapowiedź przypadku w `it.todo`.
+ * Asercje są celowo nieobecne — pisze je ktoś, kto nie zna implementacji.
+ *
+ * Zapowiedź `it.todo` jest raportowana jako niedokończona, nigdy jako zaliczona,
+ * więc pusty szkielet nie da się pomylić z pokrytym kryterium.
+ *
+ * Szkielet nie deklaruje pól współdzielonych między testami: pole przypisane
+ * i nieczytane jest naruszeniem lintu, a szkielet ma być zielony na kompilacji
+ * i lincie od pierwszego uruchomienia.
+ *
+ * Moduły `TestBed` biorą się z tego, co komponent sam deklaruje w `imports`:
+ * komponent samodzielny wnosi swoje zależności, więc dokładamy jedynie te, które
+ * w teście wymagają własnej konfiguracji.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+import path from 'node:path';
+
+import { renderTemplateFile } from '../ngxs/utils/template.js';
+import { TODO_MARKER } from './todo-marker.js';
+
+/** Moduły z `imports` komponentu, które w teście wymagają własnej konfiguracji. */
+const MODULES_NEEDING_SETUP = Object.freeze({
+  /** Tłumaczenia: bez korzenia potoki `translate` nie mają skąd wziąć słownika. */
+  TranslateModule: { testBed: 'TranslateModule.forRoot()', importFrom: '@ngx-translate/core' },
+});
+
+/** Poziom weryfikacji, którego dowodem jest ten plik. */
+const LEVEL = 'unit';
+
+/** Nazwa modułu do importu względnego: nazwa pliku bez rozszerzenia. */
+function moduleNameOf(componentFileName) {
+  return path.basename(String(componentFileName ?? ''), '.ts');
+}
+
+/** Treść w apostrofach z ucieczką apostrofu — nazwy bloków pochodzą z prozy kryteriów. */
+function quote(text) {
+  return `'${String(text ?? '').replace(/\\/g, '\\\\').replace(/'/g, "\\'")}'`;
+}
+
+/**
+ * Blok jednego kryterium: nazwa obszaru na `describe`, treść kryterium w zapowiedzi.
+ *
+ * Gdy obszar nie ma nazwy, `describe` dostaje treść kryterium — blok bez nazwy byłby
+ * nie do przypisania w raporcie, a treść kryterium jest zawsze pod ręką.
+ */
+function criterionBlock(criterion, topic) {
+  const describeName = topic || criterion.text;
+  return [
+    `  describe(${quote(describeName)}, () => {`,
+    `    // ${TODO_MARKER}: rozbij na przypadki, ciało każdego opisz sekcjami given/when/then,`,
+    `    // po czym usuń ten komentarz.`,
+    `    it.todo(${quote(criterion.text)});`,
+    '  });',
+  ].join('\n');
+}
+
+/**
+ * Renderuje treść pliku testu jednostkowego.
+ *
+ * @param {object} args
+ * @param {{className: string|null, imports: string[]}} args.api — wynik `parseComponentApi`
+ * @param {string} args.componentFileName — nazwa pliku komponentu (import względny)
+ * @param {Array<{id: string, text: string, verification: string}>} args.criteria — kryteria zadania
+ * @param {Record<string, string>} [args.topics] — nazwy obszarów per identyfikator kryterium
+ * @param {string} [args.templatePath] — nadpisanie ścieżki szablonu
+ * @returns {{content: string, criteria: Array<{id: string, describe: string}>}|null}
+ *          null, gdy komponentu nie odczytano albo żadne kryterium nie jest dowodzone
+ *          testem jednostkowym — pusty plik testu udawałby pokrycie.
+ */
+export function renderSpecSkeleton({ api, componentFileName, criteria, topics = {}, templatePath = null }) {
+  if (!api?.className) return null;
+
+  const covered = (criteria ?? []).filter((criterion) => criterion.verification === LEVEL);
+  if (covered.length === 0) return null;
+
+  const setupModules = (api.imports ?? []).filter((moduleName) => MODULES_NEEDING_SETUP[moduleName]);
+  // Zakończenie linią przy niepustej liście: import lokalny komponentu zostaje
+  // oddzielony pustą linią od importów zewnętrznych, jak w pozostałych plikach.
+  const importLines = setupModules
+    .map((moduleName) => `import { ${moduleName} } from '${MODULES_NEEDING_SETUP[moduleName].importFrom}';`)
+    .join('\n');
+  const extraImports = importLines ? `${importLines}\n` : '';
+
+  const testBedImports = [
+    api.className,
+    ...setupModules.map((moduleName) => MODULES_NEEDING_SETUP[moduleName].testBed),
+  ].join(', ');
+
+  const content = renderTemplateFile(templatePath ?? path.join(import.meta.dirname, 'templates', 'spec.template'), {
+    CLASS: api.className,
+    COMPONENT_MODULE: moduleNameOf(componentFileName),
+    EXTRA_IMPORTS: extraImports,
+    TESTBED_IMPORTS: testBedImports,
+    CRITERIA_BLOCKS: covered.map((criterion) => criterionBlock(criterion, topics[criterion.id])).join('\n\n'),
+  });
+
+  return {
+    content: content.replace(/\n{3,}/g, '\n\n'),
+    criteria: covered.map((criterion) => ({ id: criterion.id, describe: topics[criterion.id] || criterion.text })),
+  };
+}

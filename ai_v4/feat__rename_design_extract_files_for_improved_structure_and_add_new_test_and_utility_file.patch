+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+
+import { classifyRed, RED_VERDICTS, RED_ROUTES } from './red-verdict.js';
+import { isTestFile } from './test-files.js';
+
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Werdykt czerwieni: ten sam kod wyjscia znaczy co innego zaleznie od tego,
+ * co i gdzie opadlo — a kazdy z tych stanow naprawia kto inny.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+const TESTER_FILES = ['libs/a/src/lib/login-form/login-form.component.spec.ts'];
+
+/** Raport z jednym plikiem testu i podanymi przypadkami. */
+function reportWith(cases, { file = 'C:/wt/libs/a/src/lib/login-form/login-form.component.spec.ts' } = {}) {
+  return {
+    testResults: [{
+      name: file,
+      status: cases.some((entry) => entry.status === 'failed') ? 'failed' : 'passed',
+      message: '',
+      assertionResults: cases.map((entry) => ({
+        ancestorTitles: entry.describe ?? ['LoginFormComponent'],
+        title: entry.title ?? 'przypadek',
+        status: entry.status,
+        failureMessages: entry.status === 'failed' ? ['Error: not implemented'] : [],
+      })),
+    }],
+  };

+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Znacznik pracy do dokończenia w testach i scenach.
+ *
+ * Znacznik ma jedną definicję, bo piszą go generatory, a czyta bramka pokrycia:
+ * dwie kopie literału rozjechałyby się przy pierwszej zmianie i bramka przestałaby
+ * widzieć to, co generator zostawił.
+ *
+ * Rodzina wspólna z pozostałymi znacznikami repozytorium (`FORGE-*-TODO`) —
+ * niedokończona scena RENDERUJE SIĘ I PRZECHODZI, więc bez znacznika jej pustka
+ * nie wychodzi na jaw sama.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+/** Treść znacznika. */
+export const TODO_MARKER = 'FORGE-TEST-TODO';
+
+/**
+ * Czy tekst zawiera znacznik pracy do dokończenia.
+ * @param {string} text
+ * @returns {boolean}
+ */
+export function hasTodoMarker(text) {
+  return String(text ?? '').includes(TODO_MARKER);
+}

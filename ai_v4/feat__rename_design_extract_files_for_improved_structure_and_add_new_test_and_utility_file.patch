+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Znaczniki pracy do dokończenia — zbiórka z gałęzi story.
+ *
+ * Generatory i koderzy zostawiają w kodzie znaczniki `FORGE-<RODZAJ>-TODO` tam,
+ * gdzie czegoś nie da się rozstrzygnąć maszynowo: brakuje tokenu w mapie, klucz
+ * tłumaczenia nie ma jeszcze wartości, scena czeka na interakcję. Każdy z nich
+ * jest pracą, o której NIKT się nie dowie, jeśli nie zostanie policzona: kod
+ * z takim komentarzem kompiluje się, przechodzi lint i wygląda na skończony.
+ *
+ * Dlatego zbiórka jest krokiem recenzji, a nie zaleceniem w standardzie. Wynik
+ * idzie do raportu jako JEDNO zadanie do rozważenia, nie jako lista uwag —
+ * decyzja o jego podjęciu należy do człowieka na punkcie kontrolnym.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+/** Znacznik wraz z rodzajem i treścią wskazówki; rodzaj bywa z cyfrą (`I18N`). */
+const MARKER_PATTERN = /FORGE-([A-Z0-9]+)-TODO\s*:?\s*(.*)$/;
+
+/** Pliki, w których znacznik jest treścią dokumentu, a nie pracą do wykonania. */
+const NOT_CODE = /\.(md|mdx)$/i;
+
+/**
+ * Zbiera znaczniki z podanych plików.
+ *
+ * @param {object} args
+ * @param {string[]} args.files — pliki do przejrzenia (ścieżki względne korzenia)
+ * @param {(path: string) => string|null} args.readFile — treść pliku; null = pominięty
+ * @returns {Array<{file: string, line: number, kind: string, note: string}>}
+ *          w kolejności plików i linii
+ */
+export function collectTodoMarkers({ files, readFile }) {
+  const markers = [];
+
+  for (const file of files ?? []) {
+    const path = String(file).replace(/\\/g, '/');
+    if (NOT_CODE.test(path)) continue;
+
+    const content = readFile(path);
+    if (content === null || content === undefined) continue;
+
+    for (const [index, text] of String(content).split('\n').entries()) {
+      const match = MARKER_PATTERN.exec(text);
+      if (!match) continue;
+      markers.push({ file: path, line: index + 1, kind: match[1], note: match[2].trim() });
+    }
+  }
+
+  return markers;
+}
+
+/**
+ * Renderuje sekcję raportu ze znalezionymi znacznikami.
+ *
+ * Znaczniki grupowane po RODZAJU, nie po pliku: praca nad tokenami i praca nad
+ * tłumaczeniami to dwa różne zadania dla dwóch różnych osób, a rozrzucenie ich
+ * po plikach ukrywałoby, ile jest każdej z nich.
+ *
+ * @param {Array<{file: string, line: number, kind: string, note: string}>} markers
+ * @returns {string} pusty tekst, gdy nie ma czego zgłaszać
+ */
+export function renderTodoFollowUp(markers) {
+  if ((markers ?? []).length === 0) return '';
+
+  const byKind = new Map();
+  for (const marker of markers) {
+    if (!byKind.has(marker.kind)) byKind.set(marker.kind, []);
+    byKind.get(marker.kind).push(marker);
+  }
+
+  const lines = [
+    '## Praca do dokończenia (znaczniki w kodzie)',
+    '',
+    `Gałąź niesie ${markers.length} znaczników w ${new Set(markers.map((marker) => marker.file)).size} plikach. `
+    + 'Kod z nimi kompiluje się i przechodzi lint, więc bez tej listy nikt by się o nich nie dowiedział.',
+    '',
+  ];
+
+  for (const [kind, entries] of byKind) {
+    lines.push(`**FORGE-${kind}-TODO — ${entries.length}**`, '');
+    lines.push(...entries.map((entry) => `- \`${entry.file}:${entry.line}\`${entry.note ? ` — ${entry.note}` : ''}`));
+    lines.push('');
+  }
+
+  lines.push('Do rozważenia jako JEDNO zadanie następcze, nie jako poprawki w tej story.', '');
+  return lines.join('\n');
+}

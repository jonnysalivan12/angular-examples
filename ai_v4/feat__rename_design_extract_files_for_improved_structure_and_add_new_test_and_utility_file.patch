+#!/usr/bin/env node
+import { spawn } from 'child_process';
+import { existsSync, readdirSync, readFileSync, rmSync } from 'fs';
+import { createServer } from 'http';
+import { join, resolve } from 'path';
+
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Bieg scen z axe — jedno polecenie zamiast łańcucha trzech.
+ *
+ * Test-runner Storybooka potrzebuje ADRESU, pod którym sceny są serwowane, więc
+ * sam bieg to zawsze trzy kroki: zbuduj katalog scen, postaw na nim serwer,
+ * uruchom test-runner, a potem posprzątaj. Rozpisane w `package.json` te trzy
+ * kroki wymagają dwóch dodatkowych paczek (uruchamiacza równoległego i czekania
+ * na port) i tak czy owak zostawiają wiszący serwer, gdy bieg padnie.
+ *
+ * Tutaj serwer jest procesem potomnym z jawnym sprzątaniem, a port wybierany
+ * dynamicznie — drzewa robocze zadań biegną RÓWNOLEGLE, więc stały port
+ * oznaczałby, że drugie zadanie wchodzi na sceny pierwszego.
+ *
+ * Użycie:
+ *   node scripts/storybook/run-scenes.mjs --project=<projekt nx> [--config-dir=<ścieżka>]
+ *                                        [--skip-if-missing] [--keep-build]
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+/** Katalog wyjściowy buildu scen (konwencja `outputDir` w project.json). */
+const OUTPUT_ROOT = 'dist/storybook';
+
+/** Ile milisekund czekamy, aż serwer scen zacznie odpowiadać. */
+const SERVER_TIMEOUT_MS = 30_000;
+
+function parseArgs(argv) {
+  const args = {};
+  for (const token of argv) {
+    const match = /^--([\w-]+)(?:=(.*))?$/.exec(token);
+    if (match) args[match[1]] = match[2] ?? true;
+  }
+  return args;
+}
+
+/** Uruchamia polecenie, przepuszczając jego wyjście; zwraca kod wyjścia. */
+function run(command, args, options = {}) {
+  return new Promise((resolveRun) => {
+    const child = spawn(command, args, { stdio: 'inherit', shell: true, ...options });
+    child.on('close', (code) => resolveRun(code ?? 1));
+  });
+}
+
+/**
+ * Katalog konfiguracji scen projektu — czytany z jego `project.json`.
+ *
+ * Test-runner ładuje `main.js` sam, niezależnie od zbudowanego katalogu, więc
+ * bez wskazania szuka go w `.storybook` korzenia repozytorium, którego tu nie ma.
+ */
+function configDirOf(root, project) {
+  const found = [];
+
+  function walk(directory) {
+    let entries;
+    try {
+      entries = readdirSync(directory, { withFileTypes: true });
+    } catch {
+      return;
+    }
+
+    if (entries.some((entry) => entry.isFile() && entry.name === 'project.json')) {
+      found.push(join(directory, 'project.json'));
+      return;
+    }
+    for (const entry of entries) {
+      if (!entry.isDirectory() || entry.name === 'node_modules' || entry.name.startsWith('.')) continue;
+      walk(join(directory, entry.name));
+    }
+  }
+
+  walk(join(root, 'libs'));
+  walk(join(root, 'apps'));
+
+  for (const file of found) {
+    try {
+      const projectJson = JSON.parse(readFileSync(file, 'utf-8'));
+      if (projectJson.name !== project) continue;
+      return projectJson.targets?.['build-storybook']?.options?.configDir ?? null;
+    } catch {
+      // niepoprawny project.json nie jest sprawą tego skryptu
+    }
+  }
+  return null;
+}
+
+/** Wolny port systemowy — dwa drzewa robocze nie mogą walczyć o ten sam. */
+function freePort() {
+  return new Promise((resolvePort, rejectPort) => {
+    const probe = createServer();
+    probe.once('error', rejectPort);
+    probe.listen(0, '127.0.0.1', () => {
+      const { port } = probe.address();
+      probe.close(() => resolvePort(port));
+    });
+  });
+}
+
+/** Czeka, aż adres zacznie odpowiadać; false po upływie limitu. */
+async function waitForServer(url, timeoutMs) {
+  const deadline = Date.now() + timeoutMs;
+
+  while (Date.now() < deadline) {
+    try {
+      const response = await fetch(url, { method: 'HEAD' });
+      if (response.ok || response.status === 404) return true;
+    } catch {
+      // serwer jeszcze nie wstał — próbujemy dalej
+    }
+    await new Promise((tick) => setTimeout(tick, 300));
+  }
+  return false;
+}
+
+async function main() {
+  const args = parseArgs(process.argv.slice(2));
+  const project = args.project;
+  if (!project) {
+    console.error('run-scenes: podaj --project=<projekt nx>');
+    process.exit(2);
+  }
+
+  const root = resolve(args.root || '.');
+  const outputDir = join(root, OUTPUT_ROOT, project);
+
+  const configDir = args['config-dir'] ?? configDirOf(root, project);
+  if (!configDir) {
+    // Pominięcie jest GŁOŚNE i wyłącznie na żądanie: konfiguracja scen powstaje
+    // raz na bibliotekę i nie jest pracą pojedynczego zadania, ale jej brak musi
+    // zostawić ślad — cicha zieleń wyglądałaby jak sprawdzone sceny.
+    if (args['skip-if-missing']) {
+      console.warn(`[sceny] projekt '${project}' nie ma konfiguracji scen — krok POMINIĘTY, nie zaliczony`);
+      process.exit(0);
+    }
+    console.error(`run-scenes: nie ustalono katalogu konfiguracji scen dla '${project}' — podaj --config-dir`);
+    process.exit(2);
+  }
+
+  console.log(`[sceny] budowanie katalogu scen: ${project}`);
+  const built = await run('npx', ['nx', 'build-storybook', project, '--configuration=ci'], { cwd: root });
+  if (built !== 0) {
+    console.error('[sceny] katalog scen nie powstał — bieg przerwany');
+    process.exit(built);
+  }
+  if (!existsSync(outputDir)) {
+    console.error(`[sceny] brak katalogu '${outputDir}' mimo zerowego kodu wyjścia`);
+    process.exit(1);
+  }
+
+  const port = await freePort();
+  const url = `http://127.0.0.1:${port}`;
+  console.log(`[sceny] serwer scen na ${url}`);
+  const server = spawn('npx', ['http-server', outputDir, '--port', String(port), '--silent'], { shell: true, cwd: root });
+
+  let exitCode = 1;
+  try {
+    if (!await waitForServer(url, SERVER_TIMEOUT_MS)) {
+      console.error(`[sceny] serwer nie odpowiedział w ${SERVER_TIMEOUT_MS / 1000}s`);
+      process.exit(1);
+    }
+
+    console.log('[sceny] bieg scen z axe');
+    exitCode = await run('npx', ['test-storybook', '--url', url, '--config-dir', configDir, '--maxWorkers=2'], { cwd: root });
+  } finally {
+    server.kill();
+    if (!args.keepBuild) rmSync(outputDir, { recursive: true, force: true });
+  }
+
+  process.exit(exitCode);
+}
+
+main();

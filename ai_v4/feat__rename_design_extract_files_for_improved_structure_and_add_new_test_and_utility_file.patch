+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+
+import yaml from 'yaml';
+
+import { designSliceFor, usesPhases, vitestCommand, readTestReport } from './coder-task.js';
+import { TASK_PROFILES } from './task-profile.js';
+
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Wycinek makiety dla zadania: partycja zakresem zadania, pelna rama gdy nie ma
+ * pewnego dopasowania, i jawne „(brak)" zamiast pustki.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+const FRAME = Object.freeze({
+  source: 'https://figma/login',
+  ir: {
+    layer: 'type_ui',
+    scope: { owns: [{ layer_name: 'LoginPage', kind: 'build' }] },
+    layout: { layer_name: 'LoginPage', children: [{ layer_name: 'LoginForm', ref: 'LoginForm' }] },
+    components_to_build: [{ name: 'LoginForm' }, { name: 'Badge' }],
+  },
+});
+
+test('designSliceFor: zakres zadania wybiera definicje jego komponentu', () => {
+  const slice = designSliceFor({
+    designFrames: [FRAME],
+    task: { scope: ['libs/apps/frontend-app/auth/ui/src/lib/login-form/**'] },
+  });
+  const parsed = yaml.parse(slice);
+
+  assert.equal(parsed.frames.length, 1);
+  assert.equal(parsed.frames[0].source, 'https://figma/login');
+  assert.deepEqual(parsed.frames[0].design_ir.components_to_build.map((entry) => entry.name), ['LoginForm']);
+  assert.equal(parsed.frames[0].design_ir.layout, undefined, 'definicja komponentu jest samowystarczalna');
+});
+
+test('designSliceFor: zakres kontenera zostawia layout bez definicji dzieci', () => {
+  const slice = designSliceFor({
+    designFrames: [FRAME],
+    task: { scope: ['libs/apps/frontend-app/auth/feature/src/lib/login-page/**'] },
+  });
+  const parsed = yaml.parse(slice);
+
+  assert.equal(parsed.frames[0].design_ir.layout.layer_name, 'LoginPage');
+  assert.deepEqual(parsed.frames[0].design_ir.components_to_build, []);
+});
+
+test('designSliceFor: zakres bez dopasowania → pelna rama, nie pustka', () => {
+  const slice = designSliceFor({
+    designFrames: [FRAME],
+    task: { scope: ['libs/apps/frontend-app/auth/state/src/lib'] },
+  });
+  const parsed = yaml.parse(slice);
+
+  assert.deepEqual(parsed.frames[0].design_ir.components_to_build.map((entry) => entry.name), ['LoginForm', 'Badge']);
+});
+
+test('designSliceFor: brak ram → jawne (brak)', () => {
+  assert.equal(designSliceFor({ designFrames: [], task: { scope: ['libs/x/**'] } }), '(brak)');
+  assert.equal(designSliceFor({ task: {} }), '(brak)', 'brak pola nie moze znaczyc pustego wycinka');
+});
+
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Droga zadania i pomiar biegu testow.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+test('usesPhases: warstwy z zachowaniem ida protokolem faz', () => {
+  assert.equal(usesPhases(TASK_PROFILES.UI), true);
+  assert.equal(usesPhases(TASK_PROFILES.BUSINESS), true);
+});
+
+test('usesPhases: warstwa bez logiki i profil nierozstrzygniety ida jedna tura', () => {
+  assert.equal(usesPhases(TASK_PROFILES.STATIC), false, 'nie ma zachowania, ktorego brak moglby opasc na czerwono');
+  assert.equal(usesPhases(null), false, 'faza testow na zgadnietym profilu kosztuje sesje bez pewnosci, ze jest czego dowodzic');
+});
+
+test('vitestCommand: bieg z raportem do pliku i bez pamieci podrecznej', () => {
+  const command = vitestCommand({ project: 'frontend-app-auth-ui', reportPath: 'C:\\tmp\\raport.json' });
+
+  assert.match(command, /^npx nx test frontend-app-auth-ui /);
+  assert.match(command, /--skip-nx-cache/, 'raport lezy poza wynikami projektu — z pamieci nie odtworzylby sie plik');
+  assert.match(command, /--outputFile="C:\/tmp\/raport\.json"/);
+});
+
+test('readTestReport: plik raportu ma pierwszenstwo przed wyjsciem polecenia', () => {
+  const result = readTestReport({
+    reportPath: '/tmp/raport.json',
+    output: 'nx: cokolwiek',
+    readFile: (file) => (file === '/tmp/raport.json' ? '{"testResults":[]}' : null),
+  });
+
+  assert.deepEqual(result.report.testResults, []);
+  assert.equal(result.reason, null);
+});
+
+test('readTestReport: bez pliku czytane jest wyjscie polecenia', () => {
+  const result = readTestReport({
+    reportPath: '/tmp/raport.json',
+    output: 'log nx\n{"testResults":[{"name":"a.spec.ts","status":"failed","assertionResults":[]}]}',
+    readFile: () => null,
+  });
+
+  assert.equal(result.report.testResults.length, 1);
+});
+
+test('readTestReport: brak jednego i drugiego to powod, nie cisza', () => {
+  const result = readTestReport({ reportPath: '/tmp/raport.json', output: 'bieg sie wywrocil', readFile: () => null });
+
+  assert.equal(result.report, null);
+  assert.match(result.reason, /nie zawiera raportu/);
+});
+
+test('designSliceFor: kazda rama partycjonowana osobno', () => {
+  const second = { source: 'https://figma/badge', ir: { components_to_build: [{ name: 'Badge' }] } };
+  const slice = designSliceFor({
+    designFrames: [FRAME, second],
+    task: { scope: ['libs/shared/common/ui/src/lib/badge/**'] },
+  });
+  const parsed = yaml.parse(slice);
+
+  assert.equal(parsed.frames.length, 2);
+  assert.deepEqual(parsed.frames.map((frame) => frame.design_ir.components_to_build.map((entry) => entry.name)), [['Badge'], ['Badge']]);
+});

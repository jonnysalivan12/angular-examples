+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+
+import { resolveDescribeTopics, buildTopicsPrompt, parseTopicsOutput } from './describe-topics.js';
+
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Nazwy obszarow: model adnotuje gotowa strukture, wiec jego cisza i zle
+ * odpowiedzi MUSZA konczyc sie degradacja, nie zatrzymaniem generacji.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+const CRITERIA = [
+  { id: 'AC-1', text: 'Poprawne logowanie ustanawia sesje i nawiguje do /workspace-selection' },
+  { id: 'AC-2', text: '401 pokazuje komunikat, haslo czyszczone, brak nawigacji' },
+];
+
+test('buildTopicsPrompt: te same kryteria → identyczne polecenie', () => {
+  assert.equal(buildTopicsPrompt(CRITERIA), buildTopicsPrompt(CRITERIA));
+  assert.match(buildTopicsPrompt(CRITERIA), /AC-1: Poprawne logowanie/);
+});
+
+test('resolveDescribeTopics: nazwy obszarow z odpowiedzi modelu', async () => {
+  const result = await resolveDescribeTopics({
+    criteria: CRITERIA,
+    ask: async () => 'AC-1: logowanie poprawne\nAC-2: bledne dane logowania',
+  });
+
+  assert.deepEqual(result.topics, { 'AC-1': 'logowanie poprawne', 'AC-2': 'bledne dane logowania' });
+  assert.equal(result.degraded, false);
+});
+
+test('resolveDescribeTopics: brak wywolania modelu → degradacja, nie wyjatek', async () => {
+  const result = await resolveDescribeTopics({ criteria: CRITERIA });
+
+  assert.deepEqual(result.topics, {});
+  assert.equal(result.degraded, true);
+  assert.match(result.reason, /brak wywołania modelu|brak wywolania modelu/);
+});
+
+test('resolveDescribeTopics: blad wywolania → degradacja z powodem', async () => {
+  const logs = [];
+  const result = await resolveDescribeTopics({
+    criteria: CRITERIA,
+    ask: async () => { throw new Error('limit kredytow'); },
+    onLog: (message) => logs.push(message),
+  });
+
+  assert.deepEqual(result.topics, {});
+  assert.equal(result.degraded, true);
+  assert.match(result.reason, /limit kredytow/);
+  assert.match(logs.join('\n'), /nazwy nienadane/);
+});
+
+test('resolveDescribeTopics: czesc kryteriow bez nazwy → degradacja, reszta zachowana', async () => {
+  const result = await resolveDescribeTopics({
+    criteria: CRITERIA,
+    ask: async () => 'AC-1: logowanie poprawne',
+  });
+
+  assert.deepEqual(result.topics, { 'AC-1': 'logowanie poprawne' });
+  assert.equal(result.degraded, true);
+  assert.match(result.reason, /AC-2/);
+});
+
+test('resolveDescribeTopics: nazwa z identyfikatorem kryterium odrzucona', async () => {
+  const logs = [];
+  const result = await resolveDescribeTopics({
+    criteria: CRITERIA,
+    ask: async () => 'AC-1: kryterium AC-1\nAC-2: bledne dane logowania',
+    onLog: (message) => logs.push(message),
+  });
+
+  assert.deepEqual(Object.keys(result.topics), ['AC-2'], 'identyfikator w nazwie testu jest zakazany');
+  assert.match(logs.join('\n'), /odrzucone AC-1/);
+});
+
+test('resolveDescribeTopics: nazwa przepisujaca cale kryterium odrzucona', async () => {
+  const result = await resolveDescribeTopics({
+    criteria: CRITERIA,
+    ask: async () => `AC-1: ${CRITERIA[0].text}\nAC-2: bledne dane`,
+  });
+
+  assert.deepEqual(Object.keys(result.topics), ['AC-2'], 'temat ma nazywac obszar, nie powtarzac zdania');
+});
+
+test('parseTopicsOutput: proza i ogrodzenie bloku kodu wokol odpowiedzi nie przeszkadzaja', () => {
+  const { topics } = parseTopicsOutput('Oto nazwy:\n```\nAC-1: logowanie poprawne\n```\nGotowe.', CRITERIA);
+
+  assert.deepEqual(topics, { 'AC-1': 'logowanie poprawne' });
+});
+
+test('parseTopicsOutput: temat dla nieznanego kryterium pomijany', () => {
+  const { topics } = parseTopicsOutput('AC-9: cos zupelnie innego\nAC-1: logowanie poprawne', CRITERIA);
+
+  assert.deepEqual(topics, { 'AC-1': 'logowanie poprawne' });
+});
+
+test('resolveDescribeTopics: brak kryteriow → brak wywolania modelu', async () => {
+  let called = false;
+  const result = await resolveDescribeTopics({ criteria: [], ask: async () => { called = true; return ''; } });
+
+  assert.deepEqual(result.topics, {});
+  assert.equal(result.degraded, false, 'nie ma czego nazwac, wiec nic nie jest zdegradowane');
+  assert.equal(called, false, 'bez kryteriow nie placimy za wywolanie');
+});

+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Pomiar pokrycia story — jedna liczba dla aplikacji, raz na gałąź scalającą.
+ *
+ * Bramka progu istnieje od dawna (`Gates.gateCoverage`), ale nikt jej nie karmił:
+ * pokrycie liczone per zadanie porównywałoby z progiem liczbę opisującą jedną
+ * bibliotekę, a próg dotyczy całości. Ten moduł dostarcza pomiar z właściwego
+ * poziomu i dopiero on ożywia bramkę.
+ *
+ * Bez ustawionego progu pomiar jest POMIJANY, nie wykonywany „na zapas": bieg
+ * testów z pokryciem kosztuje tyle co cała weryfikacja story, więc liczba, której
+ * nikt z niczym nie porówna, byłaby czystym wydatkiem.
+ *
+ * Powłokę wstrzykuje wywołujący.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+import { COVERAGE } from '../config/global-config.js';
+import { Gates } from '../gates/index.js';
+
+/**
+ * Mierzy pokrycie i porównuje z progiem polityki aplikacji.
+ *
+ * @param {object} args
+ * @param {string|null} [args.scope] — oś `scope:` aplikacji; brak = wszystkie projekty
+ * @param {number|null} [args.threshold] — próg w procentach; `null` = pomiar pominięty
+ * @param {(command: string) => Promise<{exitCode: number, output: string}>} args.execCommand
+ * @param {(message: string) => void} [args.onLog]
+ * @returns {Promise<{skipped: boolean, pct: number|null, findings: Array<{gate: string, severity: string, message: string}>}>}
+ *          Nieudany pomiar NIE jest zieleniem: wraca jako ustalenie, bo brak liczby
+ *          i liczba poniżej progu znaczą co innego niż spełniony próg.
+ */
+export async function measureCoverage({ scope = null, threshold = COVERAGE.THRESHOLD, execCommand, onLog = () => {} }) {
+  if (threshold === null || threshold === undefined) {
+    return { skipped: true, pct: null, findings: [] };
+  }
+
+  onLog(`pokrycie: bieg testów z pomiarem (próg ${threshold}%)`);
+  const run = await execCommand(COVERAGE.COMMAND);
+  if (run.exitCode !== 0) {
+    onLog('pokrycie: bieg testów zakończony czerwono — pomiar liczony z tego, co powstało');
+  }
+
+  const summaryCommand = scope ? `${COVERAGE.SUMMARY_COMMAND} --scope=${scope}` : COVERAGE.SUMMARY_COMMAND;
+  const summary = await execCommand(summaryCommand);
+
+  let parsed = null;
+  try {
+    parsed = JSON.parse(summary.output.slice(summary.output.indexOf('{')));
+  } catch {
+    parsed = null;
+  }
+
+  if (!parsed || typeof parsed.pct !== 'number') {
+    return {
+      skipped: false,
+      pct: null,
+      findings: [{
+        gate: 'G9',
+        severity: 'error',
+        message: `pokrycia nie zmierzono — bramka progu ${threshold}% nie ma czego sprawdzić: ${summary.output.slice(-400)}`,
+      }],
+    };
+  }
+
+  onLog(`pokrycie: ${parsed.pct}% (${parsed.linesHit}/${parsed.linesFound} linii)`);
+  return {
+    skipped: false,
+    pct: parsed.pct,
+    findings: Gates.gateCoverage({ coverage: { pct: parsed.pct }, threshold }),
+  };
+}

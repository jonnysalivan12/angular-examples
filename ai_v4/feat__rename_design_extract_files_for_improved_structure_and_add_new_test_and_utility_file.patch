+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+
+import { extractWholeFrameIr } from './whole-frame.js';
+
+const NODE_ID = '1642-2883';      // forma z myślnikiem (jak z linku Figmy)
+const API_NODE_ID = '1642:2883';  // forma z dwukropkiem (klucz w odpowiedzi REST)
+
+function buildFrame() {
+  const button = { id: 'btn:1', name: 'PrimaryButton', type: 'INSTANCE', componentId: 'cmp:btn', children: [] };
+  const root = { id: API_NODE_ID, name: 'Ekran logowania', type: 'FRAME', layoutMode: 'VERTICAL', children: [button] };
+  return {
+    nodes: {
+      [API_NODE_ID]: {
+        document: root,
+        components: { 'cmp:btn': { name: 'PrimaryButton', remote: false } },
+        componentSets: {},
+      },
+    },
+  };
+}
+
+const componentResolver = { resolve: () => null };  // wszystko custom (brak parity w rejestrze)
+
+test('whole-frame: cała rama → status ok, bez scope/context, z layoutem i komponentem do zbudowania', async () => {
+  const { ir, warnings } = await extractWholeFrameIr({
+    json: buildFrame(), nodeId: NODE_ID, componentResolver, variablesById: {}, figmaFile: 'fixture',
+    fetchComponentNodes: async () => ({ nodesById: {} }),
+  });
+
+  assert.equal(ir.status, 'ok');
+  assert.equal(ir.scope, undefined, 'poza flow: brak bloku scope');
+  assert.equal(ir.context_elements, undefined, 'poza flow: brak context_elements');
+  assert.ok(ir.layout, 'layout rozwinięty dla owned frame');
+  assert.ok(Array.isArray(ir.components_to_build) && ir.components_to_build.length >= 1, 'custom bez parity → do zbudowania');
+  assert.ok(Array.isArray(warnings));
+});
+
+test('whole-frame: brak funkcji dociągania kontraktów → nadal składa (agregat z instancji)', async () => {
+  const { ir } = await extractWholeFrameIr({
+    json: buildFrame(), nodeId: NODE_ID, componentResolver, figmaFile: 'fixture',
+  });
+  assert.equal(ir.status, 'ok');
+});

+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+
+import { renderStoriesSkeleton, storyExportName } from './stories-skeleton.js';
+
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Szkielet scen: oprawa wywiedziona z API komponentu, po jednej scenie na
+ * kryterium dowodzone scena, i znacznik przy kazdej scenie bez interakcji —
+ * bo scena bez play() PRZECHODZI, wiec jej pustka nie wyjdzie na jaw sama.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+const API = Object.freeze({
+  className: 'LoginFormComponent',
+  imports: ['ReactiveFormsModule', 'TranslateModule'],
+  inputs: [
+    { name: 'loading', type: 'boolean', defaultValue: 'false', required: false },
+    { name: 'serverError', type: 'string | null', defaultValue: 'null', required: false },
+  ],
+  outputs: [{ name: 'loginSubmit', type: 'LoginCredentials' }],
+  warnings: [],
+});
+
+const CRITERIA = Object.freeze([
+  { id: 'AC-1', text: 'Poprawne logowanie nawiguje do wyboru workspace', verification: 'component' },
+  { id: 'AC-3', text: 'Walidacja dlugosci pol', verification: 'unit' },
+]);
+
+function render(overrides = {}) {
+  return renderStoriesSkeleton({
+    api: API,
+    componentFileName: 'login-form.component.ts',
+    title: 'Auth/LoginForm',
+    criteria: CRITERIA,
+    ...overrides,
+  });
+}
+
+test('renderStoriesSkeleton: komponent z tlumaczeniami dostaje loader i dostawce', () => {
+  const { content } = render();
+
+  assert.match(content, /const STORY_TRANSLATIONS = \{/);
+  assert.match(content, /class StoryTranslateLoader implements TranslateLoader/);
+  assert.match(content, /provideTranslateService\(\{/);
+  assert.match(content, /FORGE-I18N-TODO/, 'tresci z makiety wnosi implementacja, nie szkielet');
+});
+
+test('renderStoriesSkeleton: komponent bez tlumaczen → oprawa bez loadera', () => {
+  const { content } = render({ api: { ...API, imports: ['ReactiveFormsModule'] } });
+
+  assert.doesNotMatch(content, /StoryTranslateLoader/);
+  assert.doesNotMatch(content, /@ngx-translate/);
+  assert.doesNotMatch(content, /decorators/);
+});
+
+test('renderStoriesSkeleton: sterowniki wejsc wywiedzione z typow, wyjscie jako akcja', () => {
+  const { content } = render();
+
+  assert.match(content, /loading: \{ control: 'boolean' \},/);
+  assert.match(content, /serverError: \{ control: 'text' \},/);
+  assert.match(content, /loginSubmit: \{ action: 'loginSubmit' \},/);
+});
+
+test('renderStoriesSkeleton: unia literalow → wybor z zamknietego zbioru', () => {
+  const { content } = render({
+    api: { ...API, inputs: [{ name: 'variant', type: "'primary' | 'secondary'", defaultValue: "'primary'", required: false }], outputs: [] },
+  });
+
+  assert.match(content, /variant: \{ control: 'select', options: \['primary', 'secondary'\] \},/);
+});
+
+test('renderStoriesSkeleton: typ bez sterownika → znacznik, nie zgadywanie', () => {
+  const { content } = render({
+    api: { ...API, inputs: [{ name: 'item', type: 'Item', defaultValue: null, required: true }], outputs: [] },
+  });
+
+  assert.match(content, /FORGE-TEST-TODO: dobierz sterownik dla 'item' \(typ: Item\)/);
+  assert.doesNotMatch(content, /item: \{ control/);
+});
+
+test('renderStoriesSkeleton: wejscie wymagane → znacznik w args', () => {
+  const { content } = render({
+    api: { ...API, inputs: [{ name: 'item', type: 'Item', defaultValue: null, required: true }], outputs: [] },
+  });
+
+  assert.match(content, /FORGE-TEST-TODO: podaj wartosc wymaganego wejscia 'item'|FORGE-TEST-TODO: podaj wartość wymaganego wejścia 'item'/);
+});
+
+test('renderStoriesSkeleton: wartosci domyslne wejsc trafiaja do args', () => {
+  const { content } = render();
+
+  assert.match(content, /args: \{\n {4}loading: false,\n {4}serverError: null,\n {2}\},/);
+});
+
+test('renderStoriesSkeleton: scena na kryterium dowodzone scena, kryteria jednostkowe pominiete', () => {
+  const { content, criteria } = render({ topics: { 'AC-1': 'logowanie poprawne' } });
+
+  assert.deepEqual(criteria, [{ id: 'AC-1', describe: 'LogowaniePoprawne' }]);
+  assert.match(content, /export const LogowaniePoprawne: Story = \{/);
+  assert.doesNotMatch(content, /Walidacja/, 'poziom unit dowodzi test jednostkowy, nie scena');
+});
+
+test('renderStoriesSkeleton: kazda scena kryterium nosi znacznik z przejsciem klawiatura', () => {
+  const { content } = render();
+
+  assert.equal((content.match(/FORGE-TEST-TODO: dopisz args/g) ?? []).length, 1);
+  assert.match(content, /przejściem klawiaturą|przejsciem klawiatura/);
+});
+
+test('renderStoriesSkeleton: scena spoczynkowa jest zawsze', () => {
+  assert.match(render().content, /export const Default: Story = \{\};/);
+});
+
+test('renderStoriesSkeleton: zadne kryterium sceniczne → brak pliku', () => {
+  assert.equal(render({ criteria: [CRITERIA[1]] }), null, 'pusty katalog scen udawalby dowod');

+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Wycinek IR dla jednej implementacji — CZYSTE transformacje. Zero I/O, zero LLM.
+ *
+ * ODCHUDZENIE: z IR schodzą pola, których implementacja nie czyta — pytania do
+ * projektanta, pola procesu ekstrakcji, klucze tożsamości węzłów Figmy oraz tokeny
+ * typografii. Węzły referują token po nazwie, a jego implementacja (styl i element
+ * semantyczny) należy do biblioteki komponentów, nie do makiety.
+ *
+ * PARTYCJA: IR całej ramy niesie definicje wszystkich komponentów naraz, więc bez
+ * podziału każda implementacja dostawałaby też definicje pozostałych. Podział idzie
+ * po rozdziale UŻYCIE/DEFINICJA:
+ *   - implementacja KOMPONENTU → jego wpis `components_to_build`, bez `layout`
+ *     (definicja jest samowystarczalna),
+ *   - implementacja KONTENERA   → `layout` z referencjami dzieci, bez definicji
+ *     (dzieci mają własne implementacje),
+ *   - brak pewnego dopasowania  → PEŁNY IR; wsad okrojony po omacku byłby gorszy
+ *     niż wsad za duży.
+ *
+ * Który komponent jest budowany, rozstrzygają ŚCIEŻKI pracy: nazwa katalogu
+ * komponentu albo ostatni segment zakresu. Kandydat, który nie odpowiada żadnej
+ * nazwie z IR, jest po prostu pomijany — dopasowanie jest jedynym sędzią, więc
+ * nadmiarowy kandydat nie może niczego zepsuć.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+/**
+ * Klucze tożsamości węzłów Figmy — służą porównywaniu drzew między ekstrakcjami,
+ * implementacja ich nie czyta. Usuwane REKURENCYJNIE z całego IR.
+ */
+const FIGMA_INTERNAL_KEYS = new Set([
+  'component_id',
+  'component_key',
+  'style_key',
+  'def_hash',
+  'structural_sig',
+  'style_fingerprint',
+]);
+
+/** Segmenty ścieżek, które są strukturą katalogów, a nie nazwą komponentu. */
+const STRUCTURAL_SEGMENTS = new Set(['src', 'lib', 'app', 'apps', 'libs', 'assets']);
+
+/** Głęboka kopia z pominięciem podanych kluczy (na dowolnej głębokości). */
+function deepOmit(value, keys) {
+  if (Array.isArray(value)) return value.map((entry) => deepOmit(entry, keys));
+  if (value && typeof value === 'object') {
+    const out = {};
+    for (const [key, entry] of Object.entries(value)) {
+      if (keys.has(key)) continue;
+      out[key] = deepOmit(entry, keys);
+    }
+    return out;
+  }
+  return value;
+}
+
+/**
+ * Odchudza IR do wsadu implementacji: zdejmuje pytania do projektanta, pola procesu,
+ * tokeny typografii i klucze tożsamości węzłów. Zwraca NOWY obiekt; wejście nie jest
+ * mutowane, a wartość nieobiektowa wraca bez zmian.
+ *
+ * @param {object|null} ir
+ * @returns {object|null}
+ */
+export function trimDesignIrForCoder(ir) {
+  if (!ir || typeof ir !== 'object') return ir;
+
+  const out = deepOmit(ir, FIGMA_INTERNAL_KEYS);
+  delete out.source_frames;
+  delete out.status;
+  delete out.open_questions;
+  delete out.typography_tokens;
+  return out;
+}
+
+/**
+ * Nazwa komponentu → nazwa jego katalogu: CamelCase, PascalCase i podkreślenia
+ * sprowadzone do zapisu kebab, którym posługują się katalogi komponentów.
+ * @param {string} value
+ * @returns {string}
+ */
+export function toComponentDirName(value) {
+  return String(value || '')
+    .replace(/([a-z0-9])([A-Z])/g, '$1-$2')
+    .replace(/([A-Z]+)([A-Z][a-z])/g, '$1-$2')
+    .replace(/[\s_]+/g, '-')
+    .toLowerCase();
+}
+
+/**
+ * Nazwy katalogów komponentów wyłuskane ze ścieżek pracy.
+ *
+ * Rozpoznawane są dwa zapisy: ścieżka pliku komponentu (`.../<katalog>/<nazwa>.component.ts`)
+ * oraz zakres katalogu, także z globem na końcu (`.../<katalog>/**`). Segmenty
+ * strukturalne odpadają, bo nie są nazwą żadnego komponentu.
+ *
+ * @param {string[]} paths — ścieżki plików albo wzorce zakresu
+ * @returns {Set<string>} nazwy w zapisie kebab
+ */
+export function componentDirsFrom(paths) {
+  const dirs = new Set();
+
+  for (const raw of paths ?? []) {
+    const normalized = String(raw ?? '').replace(/\\/g, '/').trim();
+    if (!normalized) continue;
+
+    const fileMatch = /\/([^/]+)\/[^/]+\.component\.(?:ts|html|scss)$/.exec(normalized);
+    if (fileMatch) {
+      dirs.add(fileMatch[1]);
+      continue;
+    }
+
+    const withoutGlob = normalized.replace(/\/\*{1,2}$/, '').replace(/\/+$/, '');
+    const lastSegment = withoutGlob.split('/').pop();
+    if (lastSegment && !STRUCTURAL_SEGMENTS.has(lastSegment) && !lastSegment.includes('*') && !lastSegment.includes('.')) {
+      dirs.add(lastSegment);
+    }
+  }
+  return dirs;
+}
+
+/**
+ * Partycjonuje odchudzone IR do wsadu jednej implementacji.
+ *
+ * @param {object|null} ir — IR po `trimDesignIrForCoder`
+ * @param {{paths?: string[]}} work — ścieżki pracy: pliki albo zakresy
+ * @returns {object|null} nowy obiekt, a przy braku pewnego dopasowania wejściowe IR
+ */
+export function sliceDesignIrForTask(ir, work) {
+  if (!ir || typeof ir !== 'object') return ir;
+
+  const dirs = componentDirsFrom(work?.paths);
+  if (dirs.size === 0) return ir;
+
+  const owns = (ir.scope?.owns || []).map((entry) => entry?.layer_name).filter(Boolean);
+  const rootName = ir.layout?.layer_name;
+  const buildsRoot = owns.some((name) => dirs.has(toComponentDirName(name))) || (rootName && dirs.has(toComponentDirName(rootName)));
+
+  const definitions = Array.isArray(ir.components_to_build) ? ir.components_to_build : [];
+  const matched = definitions.filter((definition) => definition?.name && dirs.has(toComponentDirName(definition.name)));
+
+  if (!buildsRoot && matched.length === 0) return ir;
+
+  const out = { ...ir };
+  if (buildsRoot) {
+    out.components_to_build = [];
+  } else {
+    out.components_to_build = matched;
+    delete out.layout;
+  }
+  return out;
+}

+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Dziennik przebiegu zadania — zapis tego, co działo się po kolei.
+ *
+ * Wynik zadania mówi, JAK się skończyło: zielono czy czerwono, po ilu turach,
+ * z jakim OSTATNIM biegiem weryfikacji. Nie mówi, przez co zadanie przeszło —
+ * na czym padł bieg przedostatni, jaki werdykt dostała faza testów, czy nazwy
+ * obszarów zdegradowały. Ta wiedza istniała wyłącznie w narracji na konsoli,
+ * która znika razem z terminalem.
+ *
+ * Dziennik zbiera ją w kolejności zdarzeń i oddaje jako dane. Jest zapisem
+ * JEDNEGO przebiegu, nie stanem projektu: nikt go nie utrzymuje ani nie czyta
+ * programowo, więc kształt wpisu wolno zmieniać razem z tym, co warto wiedzieć.
+ *
+ * Strumień zdarzeń sesji modelu tu NIE wchodzi — leży we własnym pliku
+ * diagnostycznym, a przepisany drugi raz przykryłby to, co dziennik ma pokazać.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+import { Coder } from '../coder/index.js';
+
+/** Ile znaków komunikatu porażki zachowujemy per przypadek. */
+const FAILURE_MESSAGE_LIMIT = 800;
+
+/** Rodzaje wpisów dziennika. */
+export const AUDIT_ENTRIES = Object.freeze({
+  NOTE: 'przebieg',
+  SKELETONS: 'skielety-testów',
+  TEST_RUN: 'bieg-testów',
+  TESTER_PHASE: 'faza-testów',
+  VERIFICATION: 'weryfikacja',
+});
+
+/**
+ * Streszczenie biegu testów: statusy przypadków zamiast całego raportu.
+ *
+ * Raport vitesta ma kilkaset kilobajtów i leży w katalogu tymczasowym, gdzie
+ * nadpisuje go następna tura. Do pytania „co się wtedy nie udało" wystarczają
+ * liczby i komunikaty porażek, a te mieszczą się w dzienniku.
+ *
+ * @param {{report: object|null, reason: string|null}} run
+ * @returns {{total: number|null, passed: number|null, failed: number|null,
+ *           pending: number|null, failures: Array, reason: string|null}}
+ */
+function summarizeRun({ report = null, reason = null }) {
+  // Brak raportu i bieg bez ani jednego przypadku to dwa różne stany: liczby
+  // zostają puste, żeby „nie zmierzono" nie wyglądało jak „zmierzono zero".
+  if (!report) return { total: null, passed: null, failed: null, pending: null, failures: [], reason };
+
+  const cases = Coder.testCases(report);
+  const failures = cases
+    .filter((testCase) => testCase.status === 'failed')
+    .map((testCase) => ({
+      file: testCase.file,
+      describePath: testCase.describePath,
+      title: testCase.title,
+      message: String(testCase.failureMessages?.[0] ?? '').slice(0, FAILURE_MESSAGE_LIMIT),
+    }));
+
+  return {
+    total: cases.length,
+    passed: cases.filter((testCase) => testCase.status === 'passed').length,
+    failed: failures.length,
+    pending: cases.filter((testCase) => Coder.isPending(testCase.status)).length,
+    failures,
+    reason,
+  };
+}
+
+/**
+ * Zakłada dziennik jednego zadania.
+ *
+ * @param {object} args
+ * @param {string} args.storyId
+ * @param {string} args.taskId
+ * @param {string|null} [args.library]
+ * @param {string|null} [args.profile]
+ * @param {() => number} [args.now] — zegar; wstrzykiwany, bo czas jest danymi wpisu
+ * @returns {{note: Function, skeletons: Function, testRun: Function,
+ *           testerPhase: Function, verification: Function, finish: Function}}
+ */
+export function createTaskAudit({ storyId, taskId, library = null, profile = null, now = () => Date.now() }) {
+  const startedAt = now();
+  const entries = [];
+  let criteriaMap = null;
+
+  const add = (kind, data) => entries.push({ at: now() - startedAt, kind, ...data });
+
+  return {
+    /** Zdanie narracji przebiegu — to samo, które idzie na konsolę. */
+    note(message) {
+      add(AUDIT_ENTRIES.NOTE, { message: String(message ?? '') });
+    },
+
+    /**
+     * Produkt kroku maszynowego wraz z mapą kryteriów.
+     *
+     * Mapa jest jedynym powiązaniem kryterium z blokiem testu — same testy
+     * identyfikatorów nie noszą, więc bez niej po przebiegu nie da się
+     * odpowiedzieć, co czego dowodziło.
+     */
+    skeletons(result) {
+      criteriaMap = result?.map ?? null;
+      add(AUDIT_ENTRIES.SKELETONS, {
+        ok: Boolean(result?.ok),
+        reason: result?.reason ?? null,
+        files: result?.files ?? [],
+        expected: result?.expected ?? [],
+        warnings: result?.warnings ?? [],
+      });
+    },
+
+    /** Bieg testów — statusy przypadków, nie cały raport. */
+    testRun(run) {
+      add(AUDIT_ENTRIES.TEST_RUN, summarizeRun(run ?? {}));
+    },
+
+    /** Zamknięcie fazy testów: werdykt, adresat naprawy, braki pokrycia. */
+    testerPhase(outcome) {
+      add(AUDIT_ENTRIES.TESTER_PHASE, {
+        ok: Boolean(outcome?.ok),
+        verdict: outcome?.verdict ?? null,
+        route: outcome?.route ?? null,
+        reason: outcome?.reason ?? null,
+        rounds: outcome?.rounds ?? 0,
+        escalated: Boolean(outcome?.escalated),
+        files: outcome?.files ?? [],
+        findings: (outcome?.findings ?? []).map((finding) => finding?.message ?? String(finding)),
+      });
+    },
+
+    /**
+     * Bieg weryfikacji wraz z krokami.
+     *
+     * Zwraca wynik NIETKNIĘTY, żeby dało się owinąć wywołanie w miejscu, w którym
+     * i tak jest zwracane: dziennik nie może wymuszać zmiany przepływu, który opisuje.
+     *
+     * @param {string} label — która faza pytała
+     * @param {{ok: boolean, steps: Array}} result
+     * @returns {{ok: boolean, steps: Array}} ten sam wynik
+     */
+    verification(label, result) {
+      add(AUDIT_ENTRIES.VERIFICATION, {
+        label,
+        ok: Boolean(result?.ok),
+        steps: (result?.steps ?? []).map((step) => ({
+          id: step.id,
+          command: step.command,
+          ok: Boolean(step.ok),
+          exitCode: step.exitCode ?? null,
+          durationMs: step.durationMs ?? 0,
+          skipped: Boolean(step.skipped),
+          outputTail: step.outputTail ?? '',
+        })),
+      });
+      return result;
+    },
+
+    /**
+     * Zamknięty dziennik: podsumowanie, mapa kryteriów, kolejność zdarzeń.
+     * @param {object} [summary] — jak skończyło się zadanie
+     * @returns {object}
+     */
+    finish(summary = {}) {
+      return { storyId, taskId, library, profile, summary, criteriaMap, entries };
+    },
+  };
+}

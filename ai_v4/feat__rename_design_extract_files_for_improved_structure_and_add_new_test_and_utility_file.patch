+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+
+import { scaffoldPlanLibraries, newLibraryScaffolds } from './scaffold.js';
+
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Scaffold bibliotek planu: przebieg po WSZYSTKICH bibliotekach. Kanon nazw,
+ * komenda generatora i weryfikacja produktu maja wlasne testy przy generatorze —
+ * tutaj sprawdzamy sam przebieg: co jest generowane, co pomijane i czego nie
+ * przemilcza.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+/** Konwencja bez I/O workspace: prefiks aplikacji podany wprost. */
+const NAMING = { prefixByScope: { 'frontend-app': 'gdprrt-app' } };
+
+/** Wpis nowej biblioteki czesci WIAZACEJ. */
+function newLibrary(name, structure) {
+  return { name, status: 'new', structure };
+}
+
+/** Plan z podanymi wpisami bibliotek. */
+function planWith(libraries) {
+  return { story: '012-login', binding: { libraries, contracts: [] }, tasks: [], acceptanceCriteria: [] };
+}
+
+/** Specyfikacja kanoniczna pierwszej nowej biblioteki planu — do przygotowania atrapy drzewa. */
+function firstSpec(plan) {
+  return newLibraryScaffolds(plan, NAMING).scaffolds[0].spec;
+}
+
+/**
+ * Atrapa drzewa plikow JSON + powloki, ktora symuluje generacje: wykonanie komendy
+ * `nx g` zapisuje produkt zgodny z kanonem. `failFor` psuje samo wykonanie.
+ */
+function fakeTree({ plan, existing = {}, failFor = [] } = {}) {
+  const files = new Map(Object.entries(existing));
+  const commands = [];
+  const specByName = new Map((plan ? newLibraryScaffolds(plan, NAMING).scaffolds : []).map(({ spec }) => [spec.name, spec]));
+
+  const execCommand = async (command) => {
+    commands.push(command);
+    const name = /--name=([^\s]+)/.exec(command)?.[1];
+    if (failFor.includes(name)) return { exitCode: 1, output: `nx: nie udalo sie utworzyc ${name}` };
+
+    const spec = specByName.get(name);
+    if (spec) {
+      files.set(spec.produces, { name: spec.name, tags: [...spec.tags] });
+      const tsconfig = files.get('tsconfig.base.json') ?? { compilerOptions: { paths: {} } };
+      tsconfig.compilerOptions.paths[spec.importPath] = [`${spec.directory}/src/index.ts`];
+      files.set('tsconfig.base.json', tsconfig);
+    }
+    return { exitCode: 0, output: '' };
+  };
+
+  return {
+    commands,
+    execCommand,
+    readJson: (filePath) => files.get(filePath) ?? null,
+    writeJson: (filePath, value) => files.set(filePath, value),
+  };
+}
+
+/** Drzewo, w ktorym biblioteka juz istnieje — `project` pozwala ja zepsuc. */
+function treeWithLibrary(plan, project) {
+  const spec = firstSpec(plan);
+  return fakeTree({
+    plan,
+    existing: {
+      [spec.produces]: project ?? { name: spec.name, tags: [...spec.tags] },
+      'tsconfig.base.json': { compilerOptions: { paths: { [spec.importPath]: [`${spec.directory}/src/index.ts`] } } },
+    },
+  });
+}
+
+test('scaffold: plan bez nowych bibliotek → nic nie jest generowane', async () => {
+  const tree = fakeTree();
+  const plan = planWith([{ name: 'shared-common-util', status: 'existing' }]);
+
+  const result = await scaffoldPlanLibraries({ plan, naming: NAMING, ...tree });
+
+  assert.equal(result.ok, true);
+  assert.deepEqual(result.libraries, []);
+  assert.deepEqual(tree.commands, [], 'istniejaca biblioteka nie jest generowana ponownie');
+});
+
+test('scaffold: nowa biblioteka → generacja i zgodnosc z kanonem', async () => {
+  const plan = planWith([newLibrary('shared-common-util', { scope: 'shared', tag: 'util', context: 'common' })]);
+  const tree = fakeTree({ plan });
+
+  const result = await scaffoldPlanLibraries({ plan, naming: NAMING, ...tree });
+
+  assert.equal(result.ok, true, JSON.stringify(result.findings));
+  assert.deepEqual(result.libraries, [{ name: 'shared-common-util', skipped: false, ok: true }]);
+  assert.equal(tree.commands.length, 1);
+  assert.match(tree.commands[0], /--tags=scope:shared,type:util,context:common/, 'bramka granic liczy zaleznosci z tagow');
+});
+
+test('scaffold: produkt juz istnieje → pominiete, ale NADAL weryfikowane', async () => {
+  const plan = planWith([newLibrary('shared-common-util', { scope: 'shared', tag: 'util', context: 'common' })]);
+  const tree = treeWithLibrary(plan);
+
+  const result = await scaffoldPlanLibraries({ plan, naming: NAMING, ...tree });
+
+  assert.equal(result.ok, true);
+  assert.deepEqual(result.libraries, [{ name: 'shared-common-util', skipped: true, ok: true }]);
+  assert.deepEqual(tree.commands, [], 'ponowna generacja nadpisalaby prace w istniejacym szkielecie');
+});
+
+test('scaffold: istniejacy szkielet niezgodny z kanonem → czerwono, powod wskazuje biblioteke', async () => {
+  const plan = planWith([newLibrary('shared-common-util', { scope: 'shared', tag: 'util', context: 'common' })]);
+  const tree = treeWithLibrary(plan, { name: 'util-common', tags: ['scope:shared', 'type:util', 'context:common'] });
+
+  const result = await scaffoldPlanLibraries({ plan, naming: NAMING, ...tree });
+
+  assert.equal(result.ok, false);
+  assert.match(result.findings[0].message, /biblioteka 'shared-common-util'/);
+  assert.match(result.findings[0].message, /nazwa projektu 'util-common'/);
+});
+
+test('scaffold: nowa biblioteka bez pol strukturalnych → ustalenie, generator nietkniety', async () => {
+  const tree = fakeTree();
+
+  const result = await scaffoldPlanLibraries({
+    plan: planWith([{ name: 'shared-common-util', status: 'new' }]),
+    naming: NAMING,
+    ...tree,
+  });
+
+  assert.equal(result.ok, false);
+  assert.match(result.findings[0].message, /shared-common-util/);
+  assert.deepEqual(tree.commands, [], 'bez pol semantycznych nie ma czego generowac');
+});
+
+test('scaffold: nazwa w planie rozna od kanonu → ustalenie zamiast cichej generacji', async () => {
+  const tree = fakeTree();
+
+  const result = await scaffoldPlanLibraries({
+    plan: planWith([newLibrary('util-common-shared', { scope: 'shared', tag: 'util', context: 'common' })]),
+    naming: NAMING,
+    ...tree,
+  });
+
+  assert.equal(result.ok, false);
+  assert.match(result.findings[0].message, /dwoch roznych bibliotekach|dwóch różnych bibliotekach/);
+  assert.deepEqual(tree.commands, [], 'zgadywanie, ktora biblioteka jest ta wlasciwa, jest zakazane');
+});
+
+test('scaffold: generator konczy sie bledem → czerwono z wyjsciem polecenia', async () => {
+  const plan = planWith([newLibrary('shared-common-util', { scope: 'shared', tag: 'util', context: 'common' })]);
+  const tree = fakeTree({ plan, failFor: ['shared-common-util'] });
+
+  const result = await scaffoldPlanLibraries({ plan, naming: NAMING, ...tree });
+
+  assert.equal(result.ok, false);
+  const messages = result.findings.map((finding) => finding.message).join('\n');
+  assert.match(messages, /kodem 1/);
+  assert.match(messages, /nie udalo sie utworzyc/, 'czlowiek dostaje wyjscie polecenia, nie sam kod wyjscia');
+});
+
+test('scaffold: porazka jednej biblioteki nie zatrzymuje pozostalych', async () => {
+  const plan = planWith([
+    newLibrary('shared-common-util', { scope: 'shared', tag: 'util', context: 'common' }),
+    newLibrary('shared-common-model', { scope: 'shared', tag: 'model', context: 'common' }),
+  ]);
+  const tree = fakeTree({ plan, failFor: ['shared-common-util'] });
+
+  const result = await scaffoldPlanLibraries({ plan, naming: NAMING, ...tree });
+
+  assert.equal(result.ok, false);
+  assert.equal(tree.commands.length, 2, 'pelna lista brakow po jednym przebiegu, nie po jednym na biblioteke');
+  assert.deepEqual(result.libraries.map((library) => library.ok), [false, true]);
+});
+
+test('newLibraryScaffolds: kolejnosc generacji zgodna z kolejnoscia w planie', () => {
+  const plan = planWith([
+    newLibrary('shared-common-model', { scope: 'shared', tag: 'model', context: 'common' }),
+    newLibrary('shared-common-util', { scope: 'shared', tag: 'util', context: 'common' }),
+  ]);
+
+  const { scaffolds } = newLibraryScaffolds(plan, NAMING);
+
+  assert.deepEqual(scaffolds.map((entry) => entry.libraryName), ['shared-common-model', 'shared-common-util']);
+});

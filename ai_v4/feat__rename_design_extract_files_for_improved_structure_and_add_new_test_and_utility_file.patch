+
+import { RULE_NAME, rule } from './test-naming.js';
+
+/**
+ * Reguła patrzy wyłącznie na nazwę bloku, więc przypadki są krótkimi wywołaniami
+ * `describe`/`it`. Sprawdzane jest OBOJE: że identyfikator procesu wytwórczego
+ * zostaje zgłoszony i że nazwa domenowa z liczbą przechodzi bez zgłoszenia.
+ */
+const ruleTester = new RuleTester();
+
+ruleTester.run(RULE_NAME, rule, {
+  valid: [
+    {
+      name: 'nazwa opisujaca zachowanie',
+      code: "describe('walidacja hasła', () => { it('odrzuca hasło krótsze niż 8 znaków', () => {}); });",
+    },
+    {
+      name: 'liczba w nazwie domenowej nie jest identyfikatorem',
+      code: "it('akceptuje hasło o długości dokładnie 8 znaków', () => {});",
+    },
+    {
+      name: 'nazwa klasy w bloku najwyzszego poziomu',
+      code: "describe('LoginFormComponent', () => {});",
+    },
+    {
+      name: 'wywolanie spoza rodziny blokow testu',
+      code: "expect('T3-AC1').toBe('T3-AC1');",
+    },
+    {
+      name: 'nazwa wyliczana nie jest sprawdzana',
+      code: 'describe(nazwaBloku, () => {});',
+    },

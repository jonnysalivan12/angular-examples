+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+
+import { createTaskAudit, AUDIT_ENTRIES } from './task-audit.js';
+
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Dziennik przebiegu zadania: kolejnosc zdarzen, historia napraw i streszczenie
+ * biegow testow. Zegar wstrzykiwany — czas jest danymi wpisu, wiec test go ustala.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+/** Zegar sterowany testem: kazdy odczyt przesuwa czas o 10 ms. */
+function tickingClock() {
+  let value = 1000;
+  return () => { value += 10; return value; };
+}
+
+function audit(overrides = {}) {
+  return createTaskAudit({ storyId: '008-login', taskId: 'T3', library: 'ui-auth', profile: 'ui', now: tickingClock(), ...overrides });
+}
+
+const RED_RUN = Object.freeze({
+  ok: false,
+  steps: [
+    { id: 'affected', command: 'npx nx affected -t lint,test,build', ok: false, exitCode: 1, durationMs: 900, outputTail: 'AssertionError: oczekiwano bledu' },
+    { id: 'naming', command: 'node scripts/validators/library-naming-validator.js', ok: false, exitCode: null, durationMs: 0, outputTail: '', skipped: true },
+  ],
+});
+
+const GREEN_RUN = Object.freeze({ ok: true, steps: [{ id: 'affected', command: 'npx nx affected', ok: true, exitCode: 0, durationMs: 800, outputTail: '' }] });
+
+test('createTaskAudit: narracja zapisana w kolejnosci zdarzen', () => {
+  const journal = audit();
+  journal.note('fazy: szkielet');
+  journal.verification('szkielet', GREEN_RUN);
+  journal.note('fazy: testy');
+
+  const { entries } = journal.finish();
+  assert.deepEqual(entries.map((entry) => entry.kind), [AUDIT_ENTRIES.NOTE, AUDIT_ENTRIES.VERIFICATION, AUDIT_ENTRIES.NOTE]);
+  assert.equal(entries[0].message, 'fazy: szkielet');
+  assert.ok(entries[0].at < entries[2].at, 'wpis niesie czas od startu zadania');
+});
+
+test('createTaskAudit: kazdy bieg weryfikacji zostaje — takze ten naprawiony', () => {
+  const journal = audit();
+  journal.verification('implementacja', RED_RUN);
+  journal.note('implementator: RED w \'affected\' → tura naprawcza 1/2');
+  journal.verification('implementacja', GREEN_RUN);
+
+  const runs = journal.finish().entries.filter((entry) => entry.kind === AUDIT_ENTRIES.VERIFICATION);
+  assert.equal(runs.length, 2, 'wynik zadania niesie tylko bieg ostatni — dziennik ma historie');
+  assert.equal(runs[0].ok, false);
+  assert.match(runs[0].steps[0].outputTail, /AssertionError/, 'powod porazki zostaje razem z krokiem');
+  assert.equal(runs[0].steps[1].skipped, true, 'krok pominiety po pierwszej porazce jest widoczny jako pominiety');
+  assert.equal(runs[1].ok, true);
+});
+
+test('audit.verification: wynik wraca nietkniety — dziennik nie zmienia przeplywu', () => {
+  const returned = audit().verification('zadanie', GREEN_RUN);
+
+  assert.equal(returned, GREEN_RUN);
+});
+
+test('createTaskAudit: bieg testow streszczony statusami, nie calym raportem', () => {
+  const journal = audit();
+  journal.testRun({
+    report: {
+      testResults: [{
+        name: 'login-form.component.spec.ts',
+        assertionResults: [
+          { ancestorTitles: ['walidacja loginu'], title: 'odrzuca pusty login', status: 'failed', failureMessages: ['A'.repeat(2000), 'drugi komunikat'] },
+          { ancestorTitles: ['walidacja loginu'], title: 'przyjmuje poprawny login', status: 'passed', failureMessages: [] },
+          { ancestorTitles: ['wysylka'], title: 'blokuje przycisk w trakcie', status: 'todo', failureMessages: [] },
+        ],
+      }],
+    },
+    reason: null,
+  });
+
+  const [entry] = journal.finish().entries;
+  assert.equal(entry.kind, AUDIT_ENTRIES.TEST_RUN);
+  assert.deepEqual([entry.total, entry.passed, entry.failed, entry.pending], [3, 1, 1, 1]);
+  assert.equal(entry.failures.length, 1);
+  assert.deepEqual(entry.failures[0].describePath, ['walidacja loginu']);
+  assert.equal(entry.failures[0].message.length, 800, 'komunikat przyciety — dziennik ma byc do czytania');
+});
+
+test('createTaskAudit: brak raportu to powod, a nie zero przypadkow', () => {
+  const journal = audit();
+  journal.testRun({ report: null, reason: 'wyjscie biegu testow nie zawiera raportu JSON' });
+
+  const [entry] = journal.finish().entries;
+  assert.equal(entry.total, null, '„nie zmierzono" i „zmierzono zero" to dwa rozne stany');
+  assert.match(entry.reason, /nie zawiera raportu/);
+});
+
+test('createTaskAudit: faza testow zostaje z werdyktem i adresatem naprawy', () => {
+  const journal = audit();
+  journal.testerPhase({
+    ok: false,
+    verdict: 'src_compile',
+    route: 'coder',
+    reason: 'blad kompilacji w login-form.component.ts',
+    rounds: 1,
+    files: ['login-form.component.spec.ts'],
+    findings: [{ message: 'kryterium bez dowodu' }],
+  });
+
+  const [entry] = journal.finish().entries;
+  assert.equal(entry.kind, AUDIT_ENTRIES.TESTER_PHASE);
+  assert.equal(entry.verdict, 'src_compile');
+  assert.equal(entry.route, 'coder', 'adresat naprawy jest tym, o co pyta sie po przebiegu');
+  assert.deepEqual(entry.findings, ['kryterium bez dowodu']);
+});
+
+test('createTaskAudit: mapa kryteriow przezywa przebieg', () => {
+  const map = { component: 'LoginFormComponent', criteria: [{ id: 'AC-1', describe: 'walidacja loginu', file: 'login-form.component.spec.ts', level: 'unit' }] };
+  const journal = audit();
+  journal.skeletons({ ok: true, map, files: ['login-form.component.spec.ts'], expected: [], warnings: ['nie odczytano API wejsc'] });
+
+  const finished = journal.finish();
+  assert.deepEqual(finished.criteriaMap, map, 'testy nie nosza identyfikatorow — bez mapy nie wiadomo, co czego dowodzilo');
+  assert.deepEqual(finished.entries[0].warnings, ['nie odczytano API wejsc']);
+});
+
+test('createTaskAudit: dziennik zamkniety niesie podsumowanie obok zdarzen', () => {
+  const journal = audit();
+  journal.note('fazy: implementacja');
+
+  const finished = journal.finish({ ok: true, phases: ['szkielet', 'testy', 'implementacja'], rounds: 1, durationMs: 90_000 });
+  assert.deepEqual(
+    { storyId: finished.storyId, taskId: finished.taskId, library: finished.library, profile: finished.profile },
+    { storyId: '008-login', taskId: 'T3', library: 'ui-auth', profile: 'ui' },
+  );
+  assert.equal(finished.summary.ok, true);
+  assert.deepEqual(finished.summary.phases, ['szkielet', 'testy', 'implementacja']);
+  assert.equal(finished.entries.length, 1);
+});

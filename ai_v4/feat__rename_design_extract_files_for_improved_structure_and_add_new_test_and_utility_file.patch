+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Werdykt czerwieni — dlaczego bieg testów jest czerwony i kto ma to naprawić.
+ *
+ * Czerwień po fazie testów jest OCZEKIWANA: testy opisują zachowanie, którego
+ * jeszcze nie ma. Ale ten sam kod wyjścia daje też plik, który się nie kompiluje,
+ * i test zastany, który przestał przechodzić — a każdy z tych stanów naprawia kto
+ * inny. Bez rozróżnienia implementacja dostawałaby do naprawy cudzy błąd, albo
+ * — gorzej — pusty test przechodziłby za dowód zachowania.
+ *
+ * Rozstrzygnięcia są ułożone od najbardziej blokującego: dopóki plik się nie
+ * ładuje, nie wiadomo nic o pokryciu; dopóki zastane zachowanie jest zepsute,
+ * nowa czerwień nie jest jedynym celem implementacji.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+import { testCases, loadFailures } from './vitest-report.js';
+import { isTestFile } from './test-files.js';
+
+/** Rozstrzygnięcia biegu testów po fazie testów. */
+export const RED_VERDICTS = Object.freeze({
+  /** Testy fazy opadły na wykonaniu — czerwień z właściwego powodu. */
+  ASSERTION: 'assertion',
+  /** Plik testu nie doszedł do wykonania. */
+  TEST_COMPILE: 'test_compile',
+  /** Źródła nie doszły do wykonania. */
+  SRC_COMPILE: 'src_compile',
+  /** Zastane zachowanie przestało przechodzić. */
+  REGRESSION: 'regression',
+  /** Nic nie opadło — testy nie żądają zachowania, którego nie ma. */
+  GREEN: 'green',
+  /** Wyniku biegu nie dało się odczytać. */
+  UNREADABLE: 'unreadable',
+});
+
+/** Adresaci rundy naprawczej. */
+export const RED_ROUTES = Object.freeze({
+  TESTER: 'tester',
+  CODER: 'coder',
+});
+
+/** Ścieżki plików repozytorium wyławiane z komunikatu błędu. */
+const PATH_IN_TEXT = /(?:[A-Za-z]:)?[\w@.\-/\\]*[\w-]\.(?:ts|mts|cts|html|scss)/g;
+
+/** Katalogi, których ścieżki nie wskazują winowajcy w repozytorium. */
+const FOREIGN_PATH = /(^|[/\\])(node_modules|dist)([/\\]|$)/;
+
+/**
+ * Czy ścieżka z raportu wskazuje jeden z podanych plików.
+ *
+ * Raport niesie ścieżki bezwzględne drzewa roboczego, a listy z `git diff` są
+ * względne wobec jego korzenia — porównanie po zakończeniu ścieżki jest jedynym
+ * wspólnym mianownikiem, który nie wymaga znajomości korzenia.
+ */
+function matchesAny(reportPath, files) {
+  const normalized = String(reportPath ?? '').replace(/\\/g, '/');
+  return files.some((file) => {
+    const candidate = String(file ?? '').replace(/\\/g, '/');
+    return candidate.length > 0 && normalized.endsWith(candidate);
+  });
+}
+
+/**
+ * Miejsce błędu ładowania: pierwsza ścieżka repozytorium z komunikatu.
+ *
+ * Pierwsza, bo komunikat zaczyna się od miejsca WYSTĄPIENIA, a dalsze linie stosu
+ * niosą już drogę wywołania — plik testu odwołujący się do nieistniejącej metody
+ * ma w stosie także plik komponentu, choć naprawa należy do testu.
+ * Ograniczenie: brak modułu wskazany bez rozszerzenia zostaje przypisany plikowi,
+ * który go importował.
+ */
+function blameFile(failure) {
+  const found = String(failure.message ?? '').match(PATH_IN_TEXT) ?? [];
+  const own = found.find((candidate) => !FOREIGN_PATH.test(candidate.replace(/\\/g, '/')));
+  return own ?? failure.file ?? '';
+}
+
+/**
+ * Rozstrzyga, dlaczego bieg jest czerwony i do kogo wraca naprawa.
+ *
+ * @param {object} args
+ * @param {object|null} args.report — raport vitest (`parseVitestReport`)
+ * @param {string|null} [args.reason] — powód nieodczytania raportu
+ * @param {string[]} [args.testerFiles] — pliki testów z diffu fazy; pusta lista
+ *        znaczy „nie rozróżniamy", więc każdy plik liczy się jako plik fazy
+ * @returns {{verdict: string, route: string|null, reason: string, file: string|null}}
+ *          `route` jest `null`, gdy nie ma czego kierować do naprawy: przy poprawnej
+ *          czerwieni i przy wyniku nieodczytanym (ten drugi wraca do człowieka).
+ */
+export function classifyRed({ report, reason = null, testerFiles = [] }) {
+  if (!report) {
+    return { verdict: RED_VERDICTS.UNREADABLE, route: null, reason: reason ?? 'brak raportu biegu testów', file: null };
+  }
+
+  const failures = loadFailures(report);
+  if (failures.length > 0) {
+    const file = blameFile(failures[0]);
+    const inTest = isTestFile(file);
+    return {
+      verdict: inTest ? RED_VERDICTS.TEST_COMPILE : RED_VERDICTS.SRC_COMPILE,
+      route: inTest ? RED_ROUTES.TESTER : RED_ROUTES.CODER,
+      reason: `plik '${file || '(nieustalony)'}' nie doszedł do wykonania testów: ${failures[0].message.split('\n')[0]}`,
+      file: file || null,
+    };
+  }
+
+  const cases = testCases(report);
+  const failed = cases.filter((entry) => entry.status === 'failed');
+  const ownFile = (entry) => testerFiles.length === 0 || matchesAny(entry.file, testerFiles);
+
+  const regressions = failed.filter((entry) => !ownFile(entry));
+  if (regressions.length > 0) {
+    return {
+      verdict: RED_VERDICTS.REGRESSION,
+      route: RED_ROUTES.TESTER,
+      reason: `zastany test przestał przechodzić: '${regressions[0].title}' (${regressions[0].file})`,
+      file: regressions[0].file,
+    };
+  }
+
+  const own = failed.filter(ownFile);
+  if (own.length > 0) {
+    return {
+      verdict: RED_VERDICTS.ASSERTION,
+      route: null,
+      reason: `czerwień z właściwego powodu — ${own.length} przypadków opadło na braku zachowania`,
+      file: null,
+    };
+  }
+
+  return {
+    verdict: RED_VERDICTS.GREEN,
+    route: RED_ROUTES.TESTER,
+    reason: 'żaden test nie opadł — testy nie żądają zachowania, którego jeszcze nie ma',
+    file: null,
+  };
+}

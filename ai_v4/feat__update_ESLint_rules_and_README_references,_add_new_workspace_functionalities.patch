+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import path from 'node:path';
+
+import { PRODUCT_BASES, WORKSPACE_FILES, workspaceRootOf } from './workspace.js';
+
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Polozenie projektow i korzen drzewa — po tym narzedzia wiedza, gdzie szukac
+ * projektow i wzgledem czego liczyc sciezki.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+test('PRODUCT_BASES: projekty stoja w apps i libs', () => {
+  assert.deepEqual([...PRODUCT_BASES], ['apps', 'libs']);
+});
+
+test('workspaceRootOf: korzen to najblizszy katalog z plikiem aliasow', () => {
+  const root = path.join('C:', 'repo');
+  const exists = (candidate) => candidate === path.join(root, WORKSPACE_FILES.tsconfigBase);
+
+  assert.equal(workspaceRootOf(path.join(root, 'libs', 'shared', 'common', 'util'), { exists }), root);
+});
+
+test('workspaceRootOf: znaleziony korzen jest NAJBLIZSZY, nie najwyzszy', () => {
+  const outer = path.join('C:', 'repo');
+  const inner = path.join(outer, 'scripts', 'eslint-rules', '__fixtures__');
+  const exists = (candidate) => candidate === path.join(outer, WORKSPACE_FILES.tsconfigBase)
+    || candidate === path.join(inner, WORKSPACE_FILES.tsconfigBase);
+
+  assert.equal(
+    workspaceRootOf(path.join(inner, 'libs', 'shared'), { exists }),
+    inner,
+    'przyklad testowy udaje wlasne drzewo — gdyby wygral korzen repozytorium, sciezki liczylyby sie wzgledem niego',
+  );
+});
+
+test('workspaceRootOf: sciezka poza repozytorium daje null, nie zgadywany korzen', () => {
+  assert.equal(workspaceRootOf(path.join('C:', 'gdzie-indziej', 'projekt'), { exists: () => false }), null);
+});
+
+test('workspaceRootOf: brak sciezki daje null', () => {
+  assert.equal(workspaceRootOf('', { exists: () => true }), null);
+});

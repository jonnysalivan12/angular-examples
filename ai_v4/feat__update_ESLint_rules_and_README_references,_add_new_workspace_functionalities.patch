+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Reguła: nazwa bloku testu opisuje zachowanie, nie miejsce w procesie wytwórczym.
+ *
+ * Identyfikator zadania, kryterium akceptacji albo story w nazwie `describe`/`it`
+ * jest odsyłaczem do czegoś, co żyje krócej niż test: zadanie zamyka się po jednym
+ * przebiegu, a test zostaje i bywa zmieniany przez kolejne. Po pierwszej takiej
+ * zmianie nazwa wskazuje już nie to, co dowodzi (docs/standards/testing.md#test-naming).
+ *
+ * Powiązanie kryterium z blokiem żyje obok kodu, w mapie przebiegu — nie w nazwie.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+/** Nazwa reguły w konfiguracji: `eslint-rules/test-naming`. */
+export const RULE_NAME = 'test-naming';
+
+/** Wywołania, których pierwszy argument jest nazwą bloku. */
+const BLOCK_CALLS = new Set(['describe', 'it', 'test', 'suite', 'bench']);
+
+/** Identyfikatory procesu wytwórczego: `T3`, `AC-1`, `T3-AC1`, `US-008`. */
+const IDENTIFIER_PATTERNS = [
+  /\bT\d+\b/,
+  /\bAC[-\s]?\d/i,
+  /\bUS[-\s]?\d/i,
+];
+
+/** Nazwa funkcji wywołania, także w postaci `describe.only` czy `it.each`. */
+function calleeName(callee) {
+  if (!callee) return null;
+  if (callee.type === 'Identifier') return callee.name;
+  if (callee.type === 'MemberExpression') return calleeName(callee.object);
+  if (callee.type === 'CallExpression') return calleeName(callee.callee);
+  if (callee.type === 'TaggedTemplateExpression') return calleeName(callee.tag);
+  return null;
+}
+
+/** Tekst nazwy bloku; `null`, gdy nazwa nie jest stałym tekstem. */
+function blockName(argument) {
+  if (!argument) return null;
+  if (argument.type === 'Literal') return typeof argument.value === 'string' ? argument.value : null;
+  // Wstawki szablonu są nieznane statycznie — sprawdzamy same człony stałe.
+  if (argument.type === 'TemplateLiteral') return argument.quasis.map((quasi) => quasi.value.cooked ?? '').join(' ');
+  return null;
+}
+
+export const rule = {
+  meta: {
+    type: 'problem',
+    docs: {
+      description: 'Nazwy bloków testów opisują zachowanie, bez identyfikatorów zadań, kryteriów i story.',
+    },
+    schema: [],
+    messages: {
+      identifierInName: "Nazwa bloku testu niesie identyfikator '{{identifier}}': {{name}}. Nazwij ZACHOWANIE — identyfikator zadania żyje krócej niż test (testing.md#test-naming).",
+    },
+  },
+  create(context) {
+    return {
+      CallExpression(node) {
+        const name = BLOCK_CALLS.has(calleeName(node.callee) ?? '') ? blockName(node.arguments[0]) : null;
+        if (!name) return;
+
+        const found = IDENTIFIER_PATTERNS.map((pattern) => pattern.exec(name)).find(Boolean);
+        if (!found) return;
+
+        context.report({
+          node: node.arguments[0],
+          messageId: 'identifierInName',
+          data: { identifier: found[0], name },
+        });

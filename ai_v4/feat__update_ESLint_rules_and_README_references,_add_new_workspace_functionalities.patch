@@ -0,0 +1,26 @@
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Sprawdzarka reguł podpięta pod `node:test`.
+ *
+ * `RuleTester` sam zgłasza przypadki do biegacza testów, ale musi wiedzieć, jak
+ * ten biegacz się nazywa — domyślnie szuka globalnych `describe`/`it`, których
+ * `node:test` nie ustawia. Podstawienie stoi w jednym miejscu, bo inaczej każdy
+ * plik testów reguł powtarzałby te cztery linijki i pierwszy zapomniany kończyłby
+ * się biegiem, który nic nie sprawdza, a wygląda na zielony.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+import { after, describe, it } from 'node:test';
+
+import { RuleTester } from '@typescript-eslint/rule-tester';
+import jsoncParser from 'jsonc-eslint-parser';
+
+RuleTester.afterAll = after;
+RuleTester.describe = describe;
+RuleTester.it = it;
+RuleTester.itOnly = it.only;
+
+export { RuleTester };
+
+/** Sprawdzarka dla reguł wiszących na `project.json` — plik jest danymi, nie kodem. */
+export function projectJsonRuleTester() {
+  return new RuleTester({ languageOptions: { parser: jsoncParser } });
+}

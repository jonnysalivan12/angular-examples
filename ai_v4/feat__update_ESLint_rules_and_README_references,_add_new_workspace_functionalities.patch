+import { projectJsonRuleTester } from './rule-tester.js';
+import { RULE_NAME, rule } from './boundary-tags.js';
+
+/* ─────────────────────────────────────────────────────────────────────────── *
+ * Regula czyta wylacznie tresc `project.json` i reguly granic podane opcja,
+ * wiec przypadki nie potrzebuja zadnego pliku na dysku.
+ * ─────────────────────────────────────────────────────────────────────────── */
+
+/** Reguly granic podstawione wprost — w repozytorium przychodza ta sama opcja. */
+const depConstraints = [
+  { sourceTag: 'scope:shared', onlyDependOnLibsWithTags: ['scope:shared'] },
+  { sourceTag: 'type:util', onlyDependOnLibsWithTags: ['type:util'] },
+  { sourceTag: 'context:common', onlyDependOnLibsWithTags: ['context:common'] },
+];
+
+const options = [{ depConstraints }];
+
+const ruleTester = projectJsonRuleTester();
+
+ruleTester.run(RULE_NAME, rule, {
+  valid: [
+    {
+      name: 'kazdy tag projektu ma regule',
+      code: '{ "name": "shared-common-util", "tags": ["scope:shared", "type:util", "context:common"] }',
+      options,
+    },
+    {
+      name: 'projekt bez tagow nie ma czego naruszyc',
+      code: '{ "name": "shared-common-util" }',
+      options,
+    },
+    {
+      name: 'tagi z regul, ktorych projekt nie nosi, nie sa jego problemem',
+      code: '{ "name": "shared-common-util", "tags": ["scope:shared"] }',
+      options,
+    },
+  ],
+  invalid: [
+    {
+      name: 'tag bez odpowiadajacej reguly',
+      code: '{ "name": "frontend-app-e2e", "tags": ["scope:shared", "type:e2e"] }',
+      options,
+      errors: [{ messageId: 'tagWithoutRule' }],
+    },
